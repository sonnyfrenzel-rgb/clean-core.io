          "token": null
        }
      ],
      "id": "CC-031-B02",
      "text": "Nach erfolgreicher Änderung wird ein entferntes System über die eingegebene Destination benachrichtigt. Welches System und was dort geschieht, ist aus der Scheibe nicht ableitbar."
    },
    {
      "anchors": [
        {
          "expressionPath": null,
          "file": "source.abap",
          "line": 17,
          "raw": "source.abap:17",
          "token": null
        },
        {
