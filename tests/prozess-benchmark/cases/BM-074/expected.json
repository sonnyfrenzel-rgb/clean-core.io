  "businessStatements": [
    {
      "id": "BM-074-B01",
      "text": "Die Eingangsverarbeitung erhält ein Paket von LIMS-IDocs und verarbeitet sie einzeln; ein IDoc eines anderen Nachrichtentyps bricht die Verarbeitung mit der Ausnahme WRONG_FUNCTION_CALLED ab.",
      "anchors": [
        {
          "file": "idoc_input_zqmres.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:28"
        },
        {
          "file": "idoc_input_zqmres.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:29"
        },
        {
          "file": "idoc_input_zqmres.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:30"
        }
      ]
    },
    {
      "id": "BM-074-B02",
      "text": "Aus den Segmenten werden der Kopf (Prüflos, Vorgang, Labor, Meldungswunsch) und die Merkmalsergebnisse (Merkmalnummer, Mittelwert, Bewertung) übernommen; unbekannte Segmente werden ignoriert.",
      "anchors": [
        {
          "file": "idoc_input_zqmres.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:35"
        },
        {
          "file": "idoc_input_zqmres.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:36"
        }
      ]
    },
    {
      "id": "BM-074-B03",
      "text": "Fehlen Kopf oder Merkmale, gilt das IDoc als unvollständig.",
      "anchors": [
        {
          "file": "lzqm_limsf01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:14"
        }
      ]
    },
    {
      "id": "BM-074-B04",
      "text": "Ein unbekanntes Prüflos wird mit „Prueflos … unbekannt“ abgelehnt.",
      "anchors": [
        {
          "file": "lzqm_limsf01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:19"
        },
        {
          "file": "lzqm_limsf01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:21"
        }
      ]
    },
    {
      "id": "BM-074-B05",
      "text": "Hat das Prüflos bereits einen Verwendungsentscheid, werden keine Ergebnisse mehr angenommen.",
      "anchors": [
        {
          "file": "lzqm_limsf01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:27"
        },
        {
          "file": "lzqm_limsf01.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:30"
        }
      ]
    },
    {
      "id": "BM-074-B06",
      "text": "Der gemeldete Vorgang muss zum Prüflos gehören, sonst wird das IDoc abgelehnt.",
      "anchors": [
        {
          "file": "lzqm_limsf01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:35"
        },
        {
          "file": "lzqm_limsf01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:38"
        }
      ]
    },
    {
      "id": "BM-074-B07",
      "text": "Ein abgelehntes IDoc erhält Status 51 mit dem Ablehnungsgrund und das Paketergebnis wird auf Fehler gesetzt; es geht mit dem nächsten IDoc weiter.",
      "anchors": [
        {
          "file": "idoc_input_zqmres.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:48"
        },
        {
          "file": "idoc_input_zqmres.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:49"
        },
        {
          "file": "idoc_input_zqmres.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:51"
        }
      ]
    },
    {
      "id": "BM-074-B08",
      "text": "Die Merkmalsergebnisse werden mit Mittelwert und Bewertung als abgeschlossen und bewertet zum Prüflosvorgang erfasst, mit einem Vermerk des Labors.",
      "anchors": [
        {
          "file": "idoc_input_zqmres.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:55"
        },
        {
          "file": "lzqm_limsf01.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:58"
        },
        {
          "file": "lzqm_limsf01.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:71"
        }
      ]
    },
    {
      "id": "BM-074-B09",
      "text": "Scheitert die Erfassung, wird die offene Datenbank-LUW zurückgerollt und das IDoc erhält Status 51 mit dem BAPI-Fehlertext.",
      "anchors": [
        {
          "file": "lzqm_limsf01.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:81"
        },
        {
          "file": "idoc_input_zqmres.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:56"
        },
        {
          "file": "idoc_input_zqmres.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:57"
        },
        {
          "file": "idoc_input_zqmres.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:58"
        }
      ]
    },
    {
      "id": "BM-074-B10",
      "text": "Wünscht das LIMS eine Meldung und ist mindestens ein Merkmal zurückgewiesen, wird zum Prüflos eine Qualitätsmeldung der Art Z3 angelegt und gesichert; scheitert das Anlegen, bleibt das IDoc trotzdem erfolgreich.",
      "anchors": [
        {
          "file": "idoc_input_zqmres.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:64"
        },
        {
          "file": "lzqm_limsf01.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:101"
        },
        {
          "file": "lzqm_limsf01.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:110"
        },
        {
          "file": "lzqm_limsf01.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:115"
        }
      ]
    },
    {
      "id": "BM-074-B11",
      "text": "Erfolgreich verarbeitete IDocs erhalten Status 53 mit der Anzahl erfasster Ergebnisse und gegebenenfalls der Meldungsnummer.",
      "anchors": [
        {
          "file": "idoc_input_zqmres.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "idoc_input_zqmres.abap:68"
        },
        {
          "file": "lzqm_limsf01.abap",
          "line": 126,
          "token": null,
          "expressionPath": null,
          "raw": "lzqm_limsf01.abap:126"
        }
      ]
    }
  ],
