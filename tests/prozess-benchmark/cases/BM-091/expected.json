  "businessStatements": [
    {
      "id": "BM-091-B01",
      "text": "Es werden die nicht zum Löschen vorgemerkten Kunden der gewählten Nummern und Kontengruppen gelesen.",
      "anchors": [
        {
          "file": "zcvi_precheck.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck.abap:51"
        }
      ]
    },
    {
      "id": "BM-091-B02",
      "text": "Gibt es keine, wird das gemeldet und der Lauf beendet.",
      "anchors": [
        {
          "file": "zcvi_precheck.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck.abap:57"
        },
        {
          "file": "zcvi_precheck.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck.abap:58"
        },
        {
          "file": "zcvi_precheck.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck.abap:59"
        }
      ]
    },
    {
      "id": "BM-091-B03",
      "text": "Kunden, zu denen bereits ein Geschäftspartner verknüpft ist, werden nicht geprüft.",
      "anchors": [
        {
          "file": "zcvi_precheck.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck.abap:63"
        },
        {
          "file": "zcvi_precheck.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck.abap:69"
        },
        {
          "file": "zcvi_precheck.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck.abap:71"
        }
      ]
    },
    {
      "id": "BM-091-B04",
      "text": "Ist der Länderschlüssel des Kunden unbekannt, wird ein Fehler vermerkt und die Länderprüfung für diesen Kunden beendet.",
      "anchors": [
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:11"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:15"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:16"
        }
      ]
    },
    {
      "id": "BM-091-B05",
      "text": "Weicht die Länge der Postleitzahl von der für das Land vorgeschriebenen Länge ab, wird ein Fehler vermerkt.",
      "anchors": [
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:21"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:22"
        }
      ]
    },
    {
      "id": "BM-091-B06",
      "text": "Fehlt bei einem Kunden in einem EU-Land die Umsatzsteuer-Id, wird eine Warnung vermerkt.",
      "anchors": [
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:26"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:27"
        }
      ]
    },
    {
      "id": "BM-091-B07",
      "text": "Hat der Kunde keine Adresse in der zentralen Adressverwaltung, wird ein Fehler vermerkt.",
      "anchors": [
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:37"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:39"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:40"
        }
      ]
    },
    {
      "id": "BM-091-B08",
      "text": "Liegt der letzte Verkaufsbeleg des Kunden vor der Grenze von eingegebenen Jahren – oder gibt es keinen –, wird der Kunde als inaktiv vermerkt.",
      "anchors": [
        {
          "file": "zcvi_precheck.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck.abap:49"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:50"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:53"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:54"
        }
      ]
    },
    {
      "id": "BM-091-B09",
      "text": "Nur mit gesetzter Bereinigungsoption werden alle inaktiven Kunden direkt im Kundenstamm zum Löschen vorgemerkt und festgeschrieben.",
      "anchors": [
        {
          "file": "zcvi_precheck.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck.abap:79"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:79"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:84"
        }
      ]
    },
    {
      "id": "BM-091-B10",
      "text": "Zum Schluss werden alle Befunde als ALV-Liste angezeigt.",
      "anchors": [
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:95"
        },
        {
          "file": "zcvi_precheck_f01.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zcvi_precheck_f01.abap:104"
        }
      ]
    }
  ],
