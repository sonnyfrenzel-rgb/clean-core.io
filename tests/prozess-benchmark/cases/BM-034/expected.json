  "businessStatements": [
    {
      "id": "BM-034-B01",
      "text": "Zu Beginn wird ein Anwendungsprotokoll für die Konsignationsabrechnung mit 90 Tagen Aufbewahrung angelegt.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung.abap:40"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:10"
        }
      ]
    },
    {
      "id": "BM-034-B02",
      "text": "Es werden die Lieferanten mit aktiver Konsignationsvereinbarung und die noch nicht abgerechneten Konsignationsentnahmen der gewählten Buchungskreise, Lieferanten und Buchungsdaten gelesen.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:21"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:24"
        }
      ]
    },
    {
      "id": "BM-034-B03",
      "text": "Entnahmen von Lieferanten ohne aktive Vereinbarung werden verworfen.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:34"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:36"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:37"
        }
      ]
    },
    {
      "id": "BM-034-B04",
      "text": "Bleibt nichts übrig, wird gemeldet, dass nichts abzurechnen ist, eine Warnung protokolliert, das Protokoll gesichert und der Lauf beendet.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung.abap:42"
        },
        {
          "file": "zmm_konsi_abrechnung.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung.abap:43"
        },
        {
          "file": "zmm_konsi_abrechnung.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung.abap:44"
        },
        {
          "file": "zmm_konsi_abrechnung.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung.abap:45"
        },
        {
          "file": "zmm_konsi_abrechnung.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung.abap:46"
        }
      ]
    },
    {
      "id": "BM-034-B05",
      "text": "Die Entnahmen werden je Lieferant und Buchungskreis gruppiert und ihr Wert summiert.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:50"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:56"
        }
      ]
    },
    {
      "id": "BM-034-B06",
      "text": "Liegt die Summe unter dem vereinbarten Mindestbetrag des Lieferanten, wird die Abrechnung verschoben und das protokolliert.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:62"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:63"
        }
      ]
    },
    {
      "id": "BM-034-B07",
      "text": "Sonst wird je Lieferant eine CSV-Entnahmeaufstellung mit Datum, Materialbeleg, Material, Menge, Einheit, Wert und Währung für das Lieferantenportal geschrieben.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:92"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:99"
        }
      ]
    },
    {
      "id": "BM-034-B08",
      "text": "Lässt sich die Datei nicht öffnen, wird der Lieferant mit Fehler protokolliert und nicht abgerechnet.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:93"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:69"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:70"
        }
      ]
    },
    {
      "id": "BM-034-B09",
      "text": "Ist Abrechnen gewählt und kein Testlauf, wird die Standard-Konsignationsabrechnung für Buchungskreis und Lieferant gestartet.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:74"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:117"
        }
      ]
    },
    {
      "id": "BM-034-B10",
      "text": "Danach wird gezählt, wie viele Entnahmen im Zeitraum noch offen sind: keine bedeutet erfolgreich abgerechnet, sonst wird die Zahl offener von den übergebenen Entnahmen als Fehler protokolliert.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:122"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:127"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 128,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:128"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 131,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:131"
        }
      ]
    },
    {
      "id": "BM-034-B11",
      "text": "Ohne Abrechnung oder im Testlauf wird nur protokolliert, dass die Aufstellung erzeugt wurde.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:78"
        }
      ]
    },
    {
      "id": "BM-034-B12",
      "text": "Alle Meldungen landen im Anwendungsprotokoll, das am Ende gespeichert und festgeschrieben wird.",
      "anchors": [
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 145,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:145"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 157,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:157"
        },
        {
          "file": "zmm_konsi_abrechnung_f01.abap",
          "line": 162,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_konsi_abrechnung_f01.abap:162"
        }
      ]
    }
  ],
