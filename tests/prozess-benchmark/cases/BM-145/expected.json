  "businessStatements": [
    {
      "id": "BM-145-B01",
      "text": "Ob die Auswertung laufen darf, entscheidet ein Schalter in der Variablentabelle.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:11"
        }
      ]
    },
    {
      "id": "BM-145-B02",
      "text": "Ist der Schalter nicht gesetzt, endet das Programm mit einem Hinweis — außer für den fest eingetragenen Benutzer HRADMIN01, für den die Auswertung immer läuft.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:13"
        },
        {
          "file": "source.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:14"
        },
        {
          "file": "source.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:15"
        }
      ]
    },
    {
      "id": "BM-145-B03",
      "text": "Es werden die Qualifikationszuordnungen von Personen gelesen, deren Gültigkeit zwischen heute und dem Ende des eingegebenen Zeitfensters endet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        }
      ]
    },
    {
      "id": "BM-145-B04",
      "text": "Jede ablaufende Qualifikation wird mit Personalnummer, Qualifikations-ID und Ablaufdatum ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        }
      ]
    }
  ],
