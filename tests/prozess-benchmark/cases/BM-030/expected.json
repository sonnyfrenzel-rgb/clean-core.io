  "businessStatements": [
    {
      "id": "BM-030-B01",
      "text": "Der Nachschublauf wird für Lagernummer und Lagertyp exklusiv gesperrt; läuft bereits einer, endet der Baustein mit der Ausnahme LOCKED.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        },
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        }
      ]
    },
    {
      "id": "BM-030-B02",
      "text": "Es werden alle nicht gelöschten Materialien mit festem Lagerplatz im Kommissionier-Lagertyp gelesen; betrachtet werden nur solche mit gepflegter Mindestmenge.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        },
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        }
      ]
    },
    {
      "id": "BM-030-B03",
      "text": "Je Fixplatz wird die verfügbare Menge aller Quants des Materials auf diesem Platz summiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        }
      ]
    },
    {
      "id": "BM-030-B04",
      "text": "Liegt sie nicht unter der Mindestmenge, ist kein Nachschub nötig.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:51"
        }
      ]
    },
    {
      "id": "BM-030-B05",
      "text": "Die Nachschubmenge ist die im Lagertyp gepflegte Nachschubmenge, sonst die Differenz bis zur Maximalmenge des Platzes.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        },
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        }
      ]
    },
    {
      "id": "BM-030-B06",
      "text": "Für diese Menge wird mit der WM-Bewegungsart (Vorschlag 319) ein Transportauftrag mit dem Fixplatz als Nachplatz angelegt und sofort festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        }
      ]
    },
    {
      "id": "BM-030-B07",
      "text": "Jeder angelegte Transportauftrag wird gezählt und mit Nummer, Material und Platz protokolliert, jeder gescheiterte mit Material und Fehlernummer.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:80"
        },
        {
          "file": "source.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:81"
        },
        {
          "file": "source.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:85"
        }
      ]
    },
    {
      "id": "BM-030-B08",
      "text": "Am Ende wird die Sperre freigegeben und die Anzahl der Transportaufträge mit dem Protokoll zurückgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:91"
        }
      ]
    }
  ],
