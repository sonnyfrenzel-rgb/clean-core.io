  "businessStatements": [
    {
      "id": "BM-094-B01",
      "text": "Es werden die aktiven Routen je Nachrichtentyp geladen.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch.abap:34"
        }
      ]
    },
    {
      "id": "BM-094-B02",
      "text": "Es werden höchstens die eingegebene Anzahl neuer oder noch zu wiederholender Nachrichten der gewählten Typen in Eingangsreihenfolge gelesen; gibt es keine, endet der Lauf mit einer Meldung.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch.abap:37"
        },
        {
          "file": "zif_inbox_dispatch.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch.abap:42"
        },
        {
          "file": "zif_inbox_dispatch.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch.abap:43"
        }
      ]
    },
    {
      "id": "BM-094-B03",
      "text": "Für den Lauf wird ein Anwendungslog angelegt, das nach 30 Tagen gelöscht werden darf.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch.abap:51"
        }
      ]
    },
    {
      "id": "BM-094-B04",
      "text": "Jede Nachricht wird gesperrt; ist sie von einem parallelen Job gesperrt, wird sie übersprungen.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch.abap:61"
        },
        {
          "file": "zif_inbox_dispatch.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch.abap:68"
        }
      ]
    },
    {
      "id": "BM-094-B05",
      "text": "Gibt es für den Nachrichtentyp keine aktive Route, gilt die Nachricht als fehlerhaft.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:16"
        },
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:18"
        },
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:20"
        }
      ]
    },
    {
      "id": "BM-094-B06",
      "text": "Bei Routingart F wird der konfigurierte Funktionsbaustein mit der Nachricht aufgerufen und liefert Returncode und Meldung; eine klassische Ausnahme gilt als Fehler.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:27"
        },
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:35"
        },
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:37"
        }
      ]
    },
    {
      "id": "BM-094-B07",
      "text": "Bei Routingart P wird die konfigurierte FORM-Routine im konfigurierten Programm aufgerufen, sofern sie existiert.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:42"
        }
      ]
    },
    {
      "id": "BM-094-B08",
      "text": "Bei Routingart S wird der konfigurierte Report mit der Nachrichten-Id gestartet und die Nachricht danach als erfolgreich betrachtet.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:46"
        },
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:47"
        }
      ]
    },
    {
      "id": "BM-094-B09",
      "text": "Eine unbekannte Routingart gilt als Fehler.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:50"
        }
      ]
    },
    {
      "id": "BM-094-B10",
      "text": "Bei Erfolg erhält die Nachricht Status S mit Verarbeitungsdatum, was sofort festgeschrieben wird.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:60"
        },
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:61"
        },
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:64"
        }
      ]
    },
    {
      "id": "BM-094-B11",
      "text": "Bei einem Fehler werden die Änderungen des Verarbeiters verworfen.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:69"
        }
      ]
    },
    {
      "id": "BM-094-B12",
      "text": "Solange Wiederholungen übrig sind, erhält die Nachricht Status R mit erhöhtem Zähler und Fehlertext.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:70"
        },
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:71"
        }
      ]
    },
    {
      "id": "BM-094-B13",
      "text": "Ist die letzte Wiederholung verbraucht, erhält sie Status E und der Fehler wird mit Nachrichten-Id und -typ ins Anwendungslog geschrieben.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:76"
        },
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:80"
        },
        {
          "file": "zif_inbox_dispatch_f01.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch_f01.abap:99"
        }
      ]
    },
    {
      "id": "BM-094-B14",
      "text": "Nach der Verarbeitung wird die Sperre der Nachricht freigegeben.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch.abap:76"
        }
      ]
    },
    {
      "id": "BM-094-B15",
      "text": "Am Ende wird das Anwendungslog gesichert und festgeschrieben.",
      "anchors": [
        {
          "file": "zif_inbox_dispatch.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch.abap:82"
        },
        {
          "file": "zif_inbox_dispatch.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zif_inbox_dispatch.abap:87"
        }
      ]
    }
  ],
