  "businessStatements": [
    {
      "id": "BM-293-B01",
      "text": "Das Terminal startet mit seiner Kennung das Werkerbild.",
      "anchors": [
        {
          "file": "zpp_terminal.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal.abap:15"
        },
        {
          "file": "zpp_terminal.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal.abap:17"
        }
      ]
    },
    {
      "id": "BM-293-B02",
      "text": "Abmelden löscht Werker, Ausweis und Vorgang aus der Terminalsitzung und ruft das Werkerbild neu auf; Zurück beendet die Transaktion.",
      "anchors": [
        {
          "file": "zpp_terminal.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal.abap:27"
        },
        {
          "file": "zpp_terminal.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal.abap:30"
        },
        {
          "file": "zpp_terminal.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal.abap:32"
        }
      ]
    },
    {
      "id": "BM-293-B03",
      "text": "Für alle anderen Funktionscodes bestimmt eine Fabrik den Arbeitsschritt: Anmelden, Vorgang starten oder Vorgang beenden; jeder andere Code wird als unbekannte Funktion abgewiesen.",
      "anchors": [
        {
          "file": "zpp_terminal.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal.abap:36"
        },
        {
          "file": "zpp_terminal_c02.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:102"
        },
        {
          "file": "zpp_terminal_c02.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:112"
        }
      ]
    },
    {
      "id": "BM-293-B04",
      "text": "Beim Anmelden wird der aktive Werker zum gelesenen Ausweis mit Werk und Arbeitsplatz gesucht; ist der Ausweis unbekannt oder inaktiv, wird das gemeldet.",
      "anchors": [
        {
          "file": "zpp_terminal_c01.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c01.abap:30"
        },
        {
          "file": "zpp_terminal_c01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c01.abap:35"
        },
        {
          "file": "zpp_terminal_c01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c01.abap:36"
        }
      ]
    },
    {
      "id": "BM-293-B05",
      "text": "Nach erfolgreicher Anmeldung werden Personalnummer, Werk und Arbeitsplatz in die Terminalsitzung übernommen und die Sitzung mit Datum und Uhrzeit für die Anwesenheitsauswertung gespeichert.",
      "anchors": [
        {
          "file": "zpp_terminal_c01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c01.abap:45"
        }
      ]
    },
    {
      "id": "BM-293-B06",
      "text": "Start und Ende eines Vorgangs setzen eine Anmeldung voraus; ohne angemeldeten Werker wird der Schritt abgewiesen.",
      "anchors": [
        {
          "file": "zpp_terminal_c02.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:26"
        },
        {
          "file": "zpp_terminal_c02.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:27"
        }
      ]
    },
    {
      "id": "BM-293-B07",
      "text": "Der Fertigungsvorgang muss existieren und am Arbeitsplatz des angemeldeten Werkers eingeplant sein, sonst wird er abgewiesen.",
      "anchors": [
        {
          "file": "zpp_terminal_c02.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:31"
        },
        {
          "file": "zpp_terminal_c02.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:60"
        },
        {
          "file": "zpp_terminal_c02.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:66"
        },
        {
          "file": "zpp_terminal_c02.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:71"
        }
      ]
    },
    {
      "id": "BM-293-B08",
      "text": "Als Zeitereignis wird beim Starten Bearbeitungsbeginn (B10), beim Beenden Bearbeitungsende (B40) mit Werker, Werk und aktuellem Zeitpunkt zum Vorgang zurückgemeldet.",
      "anchors": [
        {
          "file": "zpp_terminal_c02.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:33"
        },
        {
          "file": "zpp_terminal_c02.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:85"
        },
        {
          "file": "zpp_terminal_c02.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:95"
        },
        {
          "file": "zpp_terminal_c02.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:41"
        }
      ]
    },
    {
      "id": "BM-293-B09",
      "text": "Meldet der BAPI Fehler oder Abbruch, wird seine Meldung als abgewiesener Schritt angezeigt; sonst wird synchron festgeschrieben.",
      "anchors": [
        {
          "file": "zpp_terminal_c02.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:47"
        },
        {
          "file": "zpp_terminal_c02.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal_c02.abap:54"
        }
      ]
    },
    {
      "id": "BM-293-B10",
      "text": "Nach einer Anmeldung begrüßt das Terminal den Werker mit seiner Personalnummer, nach einem Zeitereignis bestätigt es Auftrag und Vorgang.",
      "anchors": [
        {
          "file": "zpp_terminal.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal.abap:38"
        },
        {
          "file": "zpp_terminal.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal.abap:39"
        },
        {
          "file": "zpp_terminal.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal.abap:41"
        }
      ]
    },
    {
      "id": "BM-293-B11",
      "text": "Jeder abgewiesene Schritt wird als Statusmeldung in Fehleroptik angezeigt, ohne das Werkerbild zu verlassen.",
      "anchors": [
        {
          "file": "zpp_terminal.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_terminal.abap:44"
        }
      ]
    }
  ],
