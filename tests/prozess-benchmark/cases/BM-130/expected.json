  "businessStatements": [
    {
      "id": "BM-130-B01",
      "text": "Es werden die neu importierten, noch ungeprüften Devisengeschäfte des Buchungskreises vom Handelstag gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:24"
        }
      ]
    },
    {
      "id": "BM-130-B02",
      "text": "Gibt es keine, endet die Prüfung mit der Ausnahme „nichts zu tun“.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        }
      ]
    },
    {
      "id": "BM-130-B03",
      "text": "Die zulässige Abweichung beträgt für Kassageschäfte 0,5 %, für Termingeschäfte 1,5 % und für alle anderen Geschäftsarten 0,25 %.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        }
      ]
    },
    {
      "id": "BM-130-B04",
      "text": "Für jedes Geschäft wird der Mittelkurs (Kurstyp M) des Handelstags für das Währungspaar ermittelt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        }
      ]
    },
    {
      "id": "BM-130-B05",
      "text": "Ist kein Mittelkurs vorhanden, wird das Geschäft zur manuellen Prüfung gekennzeichnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:51"
        },
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        }
      ]
    },
    {
      "id": "BM-130-B06",
      "text": "Liegt die prozentuale Abweichung des Geschäftskurses vom Mittelkurs über der Toleranz, wird das Geschäft als auffällig gekennzeichnet und an die Überwachung gemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        },
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        },
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-130-B07",
      "text": "Sonst gilt das Geschäft als marktgerecht geprüft.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:63"
        }
      ]
    },
    {
      "id": "BM-130-B08",
      "text": "Der Prüfstatus aller Geschäfte wird gespeichert und die Anzahl auffälliger Geschäfte zurückgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        },
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        }
      ]
    }
  ],
