  "businessStatements": [
    {
      "id": "BM-047-B01",
      "text": "Vor dem Buchen wird geprüft, ob der Anwender im Buchungskreis Belege anlegen darf; ohne Berechtigung endet die Methode mit einer Fehlermeldung.",
      "anchors": [
        {
          "file": "zcl_fi_accrual.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:28"
        },
        {
          "file": "zcl_fi_accrual.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:31"
        },
        {
          "file": "zcl_fi_accrual.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:34"
        }
      ]
    },
    {
      "id": "BM-047-B02",
      "text": "Es werden die Abgrenzungen des Buchungskreises für Geschäftsjahr und Periode gelesen, die noch keine Belegnummer haben.",
      "anchors": [
        {
          "file": "zcl_fi_accrual.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:38"
        }
      ]
    },
    {
      "id": "BM-047-B03",
      "text": "Als Beleg- und Buchungsdatum dient der letzte Kalendertag des Periodenmonats; Geschäftsjahr und Kalenderjahr werden dabei gleichgesetzt.",
      "anchors": [
        {
          "file": "zcl_fi_accrual.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:44"
        },
        {
          "file": "zcl_fi_accrual.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:105"
        }
      ]
    },
    {
      "id": "BM-047-B04",
      "text": "Je Abgrenzung wird ein Sachkontenbeleg der Belegart SA gebildet: Soll auf das Aufwandskonto mit Kostenstelle, Haben auf das Abgrenzungskonto, jeweils mit dem Abgrenzungsbetrag.",
      "anchors": [
        {
          "file": "zcl_fi_accrual.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:55"
        },
        {
          "file": "zcl_fi_accrual.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:59"
        }
      ]
    },
    {
      "id": "BM-047-B05",
      "text": "Im Testlauf wird der Beleg nur geprüft, im Echtlauf zur Buchung übergeben; alle Rückmeldungen gehen an den Aufrufer.",
      "anchors": [
        {
          "file": "zcl_fi_accrual.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:64"
        },
        {
          "file": "zcl_fi_accrual.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:65"
        },
        {
          "file": "zcl_fi_accrual.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:73"
        }
      ]
    },
    {
      "id": "BM-047-B06",
      "text": "Liefert die Prüfung oder Buchung eine Fehler- oder Abbruchmeldung, wird zurückgerollt und mit der nächsten Abgrenzung fortgefahren.",
      "anchors": [
        {
          "file": "zcl_fi_accrual.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:85"
        },
        {
          "file": "zcl_fi_accrual.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:86"
        }
      ]
    },
    {
      "id": "BM-047-B07",
      "text": "Im Echtlauf werden Belegnummer und ein Stornodatum zum Folgetag in die Abgrenzung zurückgeschrieben und zusammen mit der Buchung per Commit mit Warten festgeschrieben.",
      "anchors": [
        {
          "file": "zcl_fi_accrual.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:90"
        },
        {
          "file": "zcl_fi_accrual.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:94"
        },
        {
          "file": "zcl_fi_accrual.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_accrual.abap:95"
        }
      ]
    }
  ],
