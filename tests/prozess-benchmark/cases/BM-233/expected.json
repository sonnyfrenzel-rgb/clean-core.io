  "businessStatements": [
    {
      "id": "BM-233-B01",
      "text": "Der Kopf des angegebenen Kontoauszugs wird gelesen; fehlt er, endet der Baustein mit der Ausnahme AUSZUG_NICHT_GEFUNDEN.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:22"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:24"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:25"
        }
      ]
    },
    {
      "id": "BM-233-B02",
      "text": "Ohne Berechtigung für Kontoauszüge im Buchungskreis endet der Baustein mit Fehlermeldung und der Ausnahme KEINE_BERECHTIGUNG.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:28"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:31"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:32"
        }
      ]
    },
    {
      "id": "BM-233-B03",
      "text": "Es werden die Zahlungseingänge (Habenposten) des Auszugs gelesen, deren Nebenbuchbuchung noch aussteht.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:36"
        }
      ]
    },
    {
      "id": "BM-233-B04",
      "text": "Gibt es keine, wird ein Hinweis zurückgegeben und der Baustein verlassen.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:40"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:41"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:43"
        }
      ]
    },
    {
      "id": "BM-233-B05",
      "text": "Im Echtlauf wird die Buchungsschnittstelle für Buchungen per Transaktion im Hintergrund geöffnet und am Ende geschlossen.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:46"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:47"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:86"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:87"
        }
      ]
    },
    {
      "id": "BM-233-B06",
      "text": "Für jeden Zahlungseingang wird in der ersten Verwendungszweckzeile eine Rechnungsnummer der Form RE plus acht Ziffern gesucht; ohne Treffer gilt kein Posten als gefunden.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:56"
        },
        {
          "file": "lzfi_ebsf01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:18"
        },
        {
          "file": "lzfi_ebsf01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:23"
        },
        {
          "file": "lzfi_ebsf01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:25"
        },
        {
          "file": "lzfi_ebsf01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:26"
        }
      ]
    },
    {
      "id": "BM-233-B07",
      "text": "Mit der Rechnungsnummer werden offene Soll-Posten von Debitoren im Buchungskreis des Auszugs mit dieser Referenz gesucht.",
      "anchors": [
        {
          "file": "lzfi_ebsf01.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:30"
        }
      ]
    },
    {
      "id": "BM-233-B08",
      "text": "Wird kein Posten gefunden, wird eine Warnung protokolliert; werden mehrere gefunden, ebenfalls.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:59"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:61"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:82"
        }
      ]
    },
    {
      "id": "BM-233-B09",
      "text": "Bei genau einem Posten wird nur ausgeglichen, wenn sein Betrag dem Zahlungsbetrag entspricht; sonst wird eine Betragsdifferenz gemeldet.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:65"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:66"
        }
      ]
    },
    {
      "id": "BM-233-B10",
      "text": "Im Testlauf wird nur protokolliert, dass ausgeglichen würde.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:69"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:70"
        }
      ]
    },
    {
      "id": "BM-233-B11",
      "text": "Im Echtlauf wird der Zahlungseingang als Beleg der Art DZ auf das Bankkonto des Auszugs gebucht und der Debitorenposten dabei ausgeglichen.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:73"
        },
        {
          "file": "lzfi_ebsf01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:69"
        },
        {
          "file": "lzfi_ebsf01.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:85"
        }
      ]
    },
    {
      "id": "BM-233-B12",
      "text": "Scheitert die Buchung, wird ein Fehler protokolliert und keine Belegnummer zurückgegeben; sonst wird die Belegnummer protokolliert.",
      "anchors": [
        {
          "file": "lzfi_ebsf01.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:102"
        },
        {
          "file": "lzfi_ebsf01.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:103"
        },
        {
          "file": "lzfi_ebsf01.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:104"
        },
        {
          "file": "lzfi_ebsf01.abap",
          "line": 109,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsf01.abap:109"
        }
      ]
    },
    {
      "id": "BM-233-B13",
      "text": "Mit Belegnummer wird die Auszugsposition als nachgebucht gekennzeichnet und gezählt.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:74"
        },
        {
          "file": "lzfi_ebsu01.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:75"
        }
      ]
    },
    {
      "id": "BM-233-B14",
      "text": "Die gesammelten Meldungen und die Zahl der Ausgleiche gehen an den Aufrufer zurück.",
      "anchors": [
        {
          "file": "lzfi_ebsu01.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ebsu01.abap:90"
        }
      ]
    }
  ],
