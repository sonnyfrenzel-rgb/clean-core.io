  "businessStatements": [
    {
      "id": "BM-208-B01",
      "text": "Der Nachtjob selektiert alle gesperrten, nicht gelöschten Bestellungen der gewählten Belegarten und Einkäufergruppen.",
      "anchors": [
        {
          "file": "zmm_po_approval_f01.abap",
          "line": 6,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_f01.abap:6"
        }
      ]
    },
    {
      "id": "BM-208-B02",
      "text": "Gibt es keine solche Bestellung, meldet der Job das und endet.",
      "anchors": [
        {
          "file": "zmm_po_approval.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval.abap:16"
        },
        {
          "file": "zmm_po_approval.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval.abap:17"
        },
        {
          "file": "zmm_po_approval.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval.abap:18"
        }
      ]
    },
    {
      "id": "BM-208-B03",
      "text": "Je Bestellung wird der Nettowert der nicht gelöschten Positionen ermittelt.",
      "anchors": [
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:63"
        }
      ]
    },
    {
      "id": "BM-208-B04",
      "text": "Bestellungen bis 5.000 gehen direkt in die Freigabe, größere zuerst in die Budgetprüfung.",
      "anchors": [
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:67"
        }
      ]
    },
    {
      "id": "BM-208-B05",
      "text": "Für die Budgetprüfung wird das Restbudget der Einkäufergruppe im laufenden Jahr gelesen; ohne Budgetsatz wird die Bestellung als Fehler protokolliert.",
      "anchors": [
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:88"
        },
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:91"
        },
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:92"
        }
      ]
    },
    {
      "id": "BM-208-B06",
      "text": "Reicht das Restbudget, wird es um den Bestellwert gemindert und die Bestellung geht in die Freigabe.",
      "anchors": [
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:95"
        },
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:97"
        }
      ]
    },
    {
      "id": "BM-208-B07",
      "text": "Reicht es nicht, wird die Ablehnung mit Grund BUDGET, Wert und Datum vermerkt; die Bestellung bleibt gesperrt.",
      "anchors": [
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 138,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:138"
        }
      ]
    },
    {
      "id": "BM-208-B08",
      "text": "Die Freigabe erfolgt mit dem Freigabecode Z1; schlägt sie fehl, wird die Bestellung als Fehler protokolliert.",
      "anchors": [
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:110"
        },
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 119,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:119"
        },
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 120,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:120"
        }
      ]
    },
    {
      "id": "BM-208-B09",
      "text": "Eine erfolgreiche Freigabe wird festgeschrieben, zusammen mit einer zuvor vorgemerkten Budgetminderung.",
      "anchors": [
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 123,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:123"
        }
      ]
    },
    {
      "id": "BM-208-B10",
      "text": "Nach der Freigabe wird ein Workflow-Ereignis zur Bestellung erzeugt, das den Besteller benachrichtigen soll, und die Freigabe gezählt und ausgegeben.",
      "anchors": [
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:81"
        },
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 148,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:148"
        },
        {
          "file": "zmm_po_approval_c01.abap",
          "line": 157,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_c01.abap:157"
        }
      ]
    },
    {
      "id": "BM-208-B11",
      "text": "Fehler werden mit Bestellnummer und Text rot ausgegeben und gezählt; der Job fährt mit der nächsten Bestellung fort.",
      "anchors": [
        {
          "file": "zmm_po_approval_f01.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_f01.abap:24"
        },
        {
          "file": "zmm_po_approval_f01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval_f01.abap:31"
        }
      ]
    },
    {
      "id": "BM-208-B12",
      "text": "Am Ende gibt der Job die Anzahl der Freigaben und der Fehler aus.",
      "anchors": [
        {
          "file": "zmm_po_approval.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_approval.abap:27"
        }
      ]
    }
  ],
