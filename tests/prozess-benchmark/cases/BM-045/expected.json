        {
          "file": "source.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:16"
        }
      ]
    },
    {
      "id": "BM-045-B02",
      "text": "Es werden die Ist-Summensätze (Werttyp 04, Version 000) der Kostenstelle für das gewählte Geschäftsjahr gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:17"
        }
      ]
    },
    {
      "id": "BM-045-B03",
      "text": "Ohne Istkosten erhält der Anwender einen Hinweis und die Auswertung endet.",
