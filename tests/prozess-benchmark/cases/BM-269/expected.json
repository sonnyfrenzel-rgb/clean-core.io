  "businessStatements": [
    {
      "id": "BM-269-B01",
      "text": "Es werden die offenen, vom MES übergebenen Rückmeldungen (Status N) der gewählten Werke und Aufträge nach Auftrag und Vorgang sortiert gelesen; gibt es keine, endet der Report mit einem Hinweis.",
      "anchors": [
        {
          "file": "zpp_conf_parallel.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:30"
        },
        {
          "file": "zpp_conf_parallel.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:35"
        },
        {
          "file": "zpp_conf_parallel.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:36"
        },
        {
          "file": "zpp_conf_parallel.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:37"
        }
      ]
    },
    {
      "id": "BM-269-B02",
      "text": "Die Servergruppe für die Parallelverarbeitung wird initialisiert; ist sie nicht nutzbar, bricht der Report mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zpp_conf_parallel.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:40"
        },
        {
          "file": "zpp_conf_parallel.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:53"
        },
        {
          "file": "zpp_conf_parallel.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:54"
        }
      ]
    },
    {
      "id": "BM-269-B03",
      "text": "Die Rückmeldungen werden zu Paketen der gewählten Größe zusammengefasst; jedes volle Paket und das Restpaket werden abgeschickt.",
      "anchors": [
        {
          "file": "zpp_conf_parallel.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:57"
        },
        {
          "file": "zpp_conf_parallel.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:61"
        },
        {
          "file": "zpp_conf_parallel.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:62"
        }
      ]
    },
    {
      "id": "BM-269-B04",
      "text": "Jedes Paket wird als eigener asynchroner Task in der Servergruppe gebucht, ohne dass der Report auf das Ergebnis wartet.",
      "anchors": [
        {
          "file": "zpp_conf_parallel_f01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel_f01.abap:15"
        },
        {
          "file": "zpp_conf_parallel_f01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel_f01.abap:28"
        }
      ]
    },
    {
      "id": "BM-269-B05",
      "text": "Sind keine Workprozesse frei, wartet der Report bis zu fünf Sekunden auf einen zurückkehrenden Task und versucht es erneut.",
      "anchors": [
        {
          "file": "zpp_conf_parallel_f01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel_f01.abap:26"
        },
        {
          "file": "zpp_conf_parallel_f01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel_f01.abap:32"
        }
      ]
    },
    {
      "id": "BM-269-B06",
      "text": "Ist die Servergruppe gestört, wird das Paket stattdessen synchron im eigenen Prozess gebucht.",
      "anchors": [
        {
          "file": "zpp_conf_parallel_f01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel_f01.abap:35"
        }
      ]
    },
    {
      "id": "BM-269-B07",
      "text": "Für jede Rückmeldung des Pakets wird eine Rückmeldung zum Fertigungsauftragsvorgang mit Gutmenge, Ausschuss, Leistung, Buchungsdatum und Endrückmeldekennzeichen gebucht.",
      "anchors": [
        {
          "file": "z_pp_conf_package.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "z_pp_conf_package.abap:16"
        },
        {
          "file": "z_pp_conf_package.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "z_pp_conf_package.abap:27"
        }
      ]
    },
    {
      "id": "BM-269-B08",
      "text": "Scheitert die Buchung, wird sie zurückgerollt und der Staging-Satz mit Fehlertext auf Status E gesetzt.",
      "anchors": [
        {
          "file": "z_pp_conf_package.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "z_pp_conf_package.abap:35"
        },
        {
          "file": "z_pp_conf_package.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "z_pp_conf_package.abap:36"
        },
        {
          "file": "z_pp_conf_package.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "z_pp_conf_package.abap:37"
        }
      ]
    },
    {
      "id": "BM-269-B09",
      "text": "Gelingt sie, wird der Staging-Satz mit Rückmeldenummer und -zähler auf Status P gesetzt und zusammen mit der Rückmeldung festgeschrieben.",
      "anchors": [
        {
          "file": "z_pp_conf_package.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "z_pp_conf_package.abap:43"
        },
        {
          "file": "z_pp_conf_package.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "z_pp_conf_package.abap:48"
        }
      ]
    },
    {
      "id": "BM-269-B10",
      "text": "Am Paketende werden noch offene Statusänderungen festgeschrieben und die Zahl gebuchter und fehlerhafter Rückmeldungen zurückgegeben.",
      "anchors": [
        {
          "file": "z_pp_conf_package.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "z_pp_conf_package.abap:54"
        },
        {
          "file": "z_pp_conf_package.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "z_pp_conf_package.abap:56"
        }
      ]
    },
    {
      "id": "BM-269-B11",
      "text": "Endet ein Task, werden seine Ergebnisse abgeholt und aufsummiert; bei System- oder Kommunikationsfehler wird das Paket als gestört gezählt und gemeldet, seine Sätze bleiben offen für den nächsten Lauf.",
      "anchors": [
        {
          "file": "zpp_conf_parallel_f01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel_f01.abap:56"
        },
        {
          "file": "zpp_conf_parallel_f01.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel_f01.abap:65"
        },
        {
          "file": "zpp_conf_parallel_f01.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel_f01.abap:68"
        }
      ]
    },
    {
      "id": "BM-269-B12",
      "text": "Nach dem Versand wartet der Report, bis alle gestarteten Tasks zurückgemeldet haben, und gibt die Zahl gesendeter Pakete, gebuchter und fehlerhafter Rückmeldungen sowie gestörter Pakete aus.",
      "anchors": [
        {
          "file": "zpp_conf_parallel.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:68"
        },
        {
          "file": "zpp_conf_parallel.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_conf_parallel.abap:70"
        }
      ]
    }
  ],
