  "businessStatements": [
    {
      "id": "BM-109-B01",
      "text": "Es werden Kunde und Material aller Lieferungen gelesen, deren Warenausgang im eingegebenen Zeitraum vollständig gebucht ist; jede Kombination aus Kunde und Material zählt einmal.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        },
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        }
      ]
    },
    {
      "id": "BM-109-B02",
      "text": "Ohne solche Lieferungen endet der Lauf.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        },
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        }
      ]
    },
    {
      "id": "BM-109-B03",
      "text": "Zu den gelieferten Materialien werden die zugeordneten realen Stoffe ermittelt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        }
      ]
    },
    {
      "id": "BM-109-B04",
      "text": "Nur wenn Gefahrstoffe gefunden wurden, wird gelesen, welche Kunden das Sicherheitsdatenblatt zu diesen Stoffen bereits erhalten haben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:53"
        },
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        }
      ]
    },
    {
      "id": "BM-109-B05",
      "text": "Lieferpositionen ohne zugeordneten realen Stoff werden übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        },
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        }
      ]
    },
    {
      "id": "BM-109-B06",
      "text": "Hat der Kunde das Sicherheitsdatenblatt zum Stoff schon erhalten, wird die Kombination übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        },
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        }
      ]
    },
    {
      "id": "BM-109-B07",
      "text": "Jede fällige Kombination wird vorgemerkt und mit Kunde, Stoff und Lieferung als „SDB fällig“ gelistet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:74"
        }
      ]
    },
    {
      "id": "BM-109-B08",
      "text": "Ohne Versandkennzeichen oder ohne fällige Kombination endet der Lauf nach der Liste.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        },
        {
          "file": "source.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:78"
        }
      ]
    },
    {
      "id": "BM-109-B09",
      "text": "Mit Versandkennzeichen wird ein Hintergrundjob ZEHS_SDB_VERSAND angelegt, die fälligen Kombinationen werden unter der Jobnummer in der Datenbank abgelegt, der Versandreport wird in den Job eingeplant und der Job zum sofortigen Start freigegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:81"
        },
        {
          "file": "source.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:88"
        },
        {
          "file": "source.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:89"
        },
        {
          "file": "source.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:92"
        }
      ]
    }
  ],
