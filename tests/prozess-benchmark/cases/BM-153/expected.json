  "businessStatements": [
    {
      "id": "BM-153-B01",
      "text": "Wird die Übersicht für einen anderen als den angemeldeten Benutzer angefordert, muss der Aufrufer eine Vertretungsberechtigung haben, sonst wird die Anfrage abgewiesen.",
      "anchors": [
        {
          "file": "z_mss_team_absences.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "z_mss_team_absences.abap:24"
        },
        {
          "file": "z_mss_team_absences.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "z_mss_team_absences.abap:25"
        },
        {
          "file": "z_mss_team_absences.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "z_mss_team_absences.abap:27"
        },
        {
          "file": "z_mss_team_absences.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "z_mss_team_absences.abap:28"
        }
      ]
    },
    {
      "id": "BM-153-B02",
      "text": "Zum Benutzer wird über den Kommunikationssatz die Personalnummer der Führungskraft im Zeitraum ermittelt; ohne Zuordnung wird die Anfrage abgewiesen.",
      "anchors": [
        {
          "file": "z_mss_team_absences.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "z_mss_team_absences.abap:33"
        },
        {
          "file": "z_mss_team_absences.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "z_mss_team_absences.abap:38"
        },
        {
          "file": "z_mss_team_absences.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "z_mss_team_absences.abap:39"
        }
      ]
    },
    {
      "id": "BM-153-B03",
      "text": "Über den Auswertungsweg der Leiterplanstelle werden die Personen der geleiteten Einheit ermittelt, ohne die Führungskraft selbst.",
      "anchors": [
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:52"
        },
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:70"
        }
      ]
    },
    {
      "id": "BM-153-B04",
      "text": "Liefert die Struktur nichts oder bleibt niemand übrig, wird die Teamliste verworfen und die Anfrage mit „keine Führungskraft“ abgewiesen.",
      "anchors": [
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:65"
        },
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:73"
        },
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:76"
        },
        {
          "file": "z_mss_team_absences.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "z_mss_team_absences.abap:48"
        }
      ]
    },
    {
      "id": "BM-153-B05",
      "text": "Für jedes Teammitglied wird die organisatorische Zuordnung am Ende des Zeitraums gelesen; fehlt sie, bleibt das Mitglied unberücksichtigt.",
      "anchors": [
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:88"
        },
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:89"
        },
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:100"
        }
      ]
    },
    {
      "id": "BM-153-B06",
      "text": "Hat der aufrufende Benutzer für dessen Personalbereich, Mitarbeitergruppe, -kreis und Organisationsschlüssel keine Leseberechtigung auf Abwesenheiten, wird das Mitglied ausgeblendet und mitgezählt.",
      "anchors": [
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:105"
        },
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 143,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:143"
        },
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 106,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:106"
        }
      ]
    },
    {
      "id": "BM-153-B07",
      "text": "Für berechtigte Mitglieder werden die Abwesenheiten im Zeitraum gelesen und ihre Abwesenheitstage summiert.",
      "anchors": [
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:111"
        },
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 126,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:126"
        }
      ]
    },
    {
      "id": "BM-153-B08",
      "text": "Jedes Mitglied wird ohne Abwesenheit als „FREI“, bei mehr als zehn Tagen als „HOCH“ und sonst als „NORMAL“ eingestuft.",
      "anchors": [
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 129,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:129"
        }
      ]
    },
    {
      "id": "BM-153-B09",
      "text": "Die Übersicht wird nach Abwesenheitstagen absteigend sortiert und mit der Zahl ausgeblendeter Mitarbeiter an das Portal zurückgegeben.",
      "anchors": [
        {
          "file": "zcl_mss_team_reader.abap",
          "line": 137,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mss_team_reader.abap:137"
        },
        {
          "file": "z_mss_team_absences.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "z_mss_team_absences.abap:51"
        },
        {
          "file": "z_mss_team_absences.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "z_mss_team_absences.abap:52"
        }
      ]
    }
  ],
