  "businessStatements": [
    {
      "id": "BM-142-B01",
      "text": "Zur am Terminal gelesenen Ausweisnummer wird die Personalnummer ermittelt, deren Ausweissatz am Buchungstag gültig ist.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:15"
        }
      ]
    },
    {
      "id": "BM-142-B02",
      "text": "Ist der Ausweis am Buchungstag keinem Mitarbeiter zugeordnet, wird die Anfrage mit „Ausweis unbekannt“ abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:19"
        },
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-142-B03",
      "text": "Für den gefundenen Mitarbeiter wird der Beschäftigungsstatus am Buchungstag gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        }
      ]
    },
    {
      "id": "BM-142-B04",
      "text": "Ist der Mitarbeiter nicht aktiv beschäftigt, wird die Personalnummer gelöscht und die Anfrage mit „Mitarbeiter nicht aktiv“ abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-142-B05",
      "text": "Andernfalls erhält das Terminal die Personalnummer zurück.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    }
  ],
