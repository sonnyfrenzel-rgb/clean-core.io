  "businessStatements": [
    {
      "id": "BM-170-B01",
      "text": "Es werden Transporte der gewählten Transportdispostellen und Transportarten gelesen, deren Beladung beendet, die aber noch nicht abgefertigt sind; mit dem Kennzeichen „heute“ nur solche mit Ladeende heute.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        },
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        }
      ]
    },
    {
      "id": "BM-170-B02",
      "text": "Gibt es keine, wird dies ausgegeben und die Verarbeitung der Transporte übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        },
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:31"
        }
      ]
    },
    {
      "id": "BM-170-B03",
      "text": "Für jeden Transport wird der Status „Abfertigung“ per Änderungs-BAPI gesetzt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        }
      ]
    },
    {
      "id": "BM-170-B04",
      "text": "Schlägt die Änderung fehl, wird sie zurückgerollt; ist der Transport gesperrt, wird zwei Sekunden gewartet und höchstens dreimal insgesamt versucht, bei anderen Fehlern sofort aufgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        },
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        },
        {
          "file": "source.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:53"
        }
      ]
    },
    {
      "id": "BM-170-B05",
      "text": "Bleibt ein Fehler, wird der Transport mit Fehlertext gelistet und gezählt; sonst wird die Abfertigung festgeschrieben und gezählt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        },
        {
          "file": "source.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:63"
        }
      ]
    },
    {
      "id": "BM-170-B06",
      "text": "Am Ende werden die Anzahl abgefertigter und fehlerhafter Transporte ausgegeben; gab es Fehler, bricht der Job mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        },
