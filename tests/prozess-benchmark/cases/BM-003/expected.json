      "id": "BM-003-B01",
      "text": "Der Mindermengenzuschlag ist zunächst null.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:10"
        }
      ]
    },
    {
      "id": "BM-003-B02",
      "text": "Für Verkaufsorganisation und Warengruppe der Position wird die gepflegte Mindestmenge mit ihrem Zuschlag gesucht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:12"
        }
      ]
    },
    {
      "id": "BM-003-B03",
      "text": "Ist keine Mindestmengenregel gepflegt, bleibt der Zuschlag null.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:15"
        }
      ]
    },
    {
      "id": "BM-003-B04",
      "text": "Liegt die Positionsmenge unter der Mindestmenge, wird der feste Zuschlagsbetrag als Konditionswert übernommen, unabhängig von der Menge.",
