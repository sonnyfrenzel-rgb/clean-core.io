  "businessStatements": [
    {
      "id": "BM-053-B01",
      "text": "Der Ergebnisposten wird zunächst unverändert zurückgegeben; nur für den Ergebnisbereich ZGO1 wird der Exit aktiv.",
      "anchors": [
        {
          "file": "zxkkeu11.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "zxkkeu11.abap:10"
        },
        {
          "file": "zxkkeu11.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "zxkkeu11.abap:11"
        },
        {
          "file": "zxkkeu11.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zxkkeu11.abap:12"
        }
      ]
    },
    {
      "id": "BM-053-B02",
      "text": "Welche Merkmale abgeleitet werden, hängt vom Ableitungsschritt ab: Vertriebsregion (U-REG), Ergebnissegment (U-SEG) oder Key-Account-Manager (U-KAM); andere Schritte ändern nichts.",
      "anchors": [
        {
          "file": "zxkkeu11.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zxkkeu11.abap:15"
        }
      ]
    },
    {
      "id": "BM-053-B03",
      "text": "Ohne Kunde im Ergebnisposten, etwa bei Sachkontenbuchungen, bleibt die Vertriebsregion leer, ohne dass die Ableitung scheitert.",
      "anchors": [
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:33"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:36"
        }
      ]
    },
    {
      "id": "BM-053-B04",
      "text": "Wurde die Region eines Kunden in derselben Sitzung schon ermittelt, wird sie aus dem Puffer übernommen.",
      "anchors": [
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:39"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:40"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:43"
        }
      ]
    },
    {
      "id": "BM-053-B05",
      "text": "Sonst werden Land und Region aus dem Kundenstamm gelesen; existiert der Kunde nicht, scheitert die Ableitung.",
      "anchors": [
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:46"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:48"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:49"
        }
      ]
    },
    {
      "id": "BM-053-B06",
      "text": "Aus der kundeneigenen Regionszuordnung wird der zum Ableitungsdatum gültige Eintrag gesucht, wobei ein Eintrag für die genaue Region vor dem landesweiten Eintrag '*' und der jüngste Gültigkeitsbeginn zuerst gilt.",
      "anchors": [
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:53"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:61"
        }
      ]
    },
    {
      "id": "BM-053-B07",
      "text": "Ist keine Zuordnung gepflegt, wird die Auffangregion SONST gesetzt; die ermittelte Region wird in den Ergebnisposten geschrieben und für den Kunden gepuffert.",
      "anchors": [
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:58"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:59"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:64"
        }
      ]
    },
    {
      "id": "BM-053-B08",
      "text": "Für das Segment werden Sparte und Materialgruppe des Materials gelesen; die Materialnummer wird dabei auf 18 Stellen gekürzt.",
      "anchors": [
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:76"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:77"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:78"
        }
      ]
    },
    {
      "id": "BM-053-B09",
      "text": "Liefert das Material keine Sparte, gilt die Sparte des Ergebnispostens.",
      "anchors": [
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:81"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:82"
        }
      ]
    },
    {
      "id": "BM-053-B10",
      "text": "Das Segment wird zuerst über Kundengruppe des Vertriebsbereichs und Sparte bestimmt, ersatzweise über die Materialgruppe; findet sich keine Zuordnung, scheitert die Ableitung.",
      "anchors": [
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:85"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:92"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:95"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:96"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:99"
        },
        {
          "file": "zcl_co_pa_derive.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_pa_derive.abap:100"
        }
      ]
    },
    {
      "id": "BM-053-B11",
      "text": "Als Key-Account-Manager wird der Partner mit der Rolle ZM im Vertriebsbereich des Kunden übernommen; fehlt er, bleibt das Merkmal leer, ohne Fehler.",
      "anchors": [
        {
          "file": "zxkkeu11.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zxkkeu11.abap:24"
        },
        {
          "file": "zxkkeu11.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zxkkeu11.abap:30"
        },
        {
          "file": "zxkkeu11.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zxkkeu11.abap:31"
        }
      ]
    },
    {
      "id": "BM-053-B12",
      "text": "Ist ein Ableitungsschritt gescheitert, wird das der Ableitungsstrategie als Fehler gemeldet; der Ergebnisposten mit den abgeleiteten Merkmalen wird in jedem Fall zurückgegeben.",
      "anchors": [
        {
          "file": "zxkkeu11.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zxkkeu11.abap:39"
        },
        {
          "file": "zxkkeu11.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zxkkeu11.abap:40"
        },
        {
          "file": "zxkkeu11.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zxkkeu11.abap:42"
        }
      ]
    }
  ],
