  "businessStatements": [
    {
      "id": "BM-114-B01",
      "text": "Ohne Berechtigung zum Anlegen von Unfällen im Werk wird die Meldung mit Fehler zurückgewiesen.",
      "anchors": [
        {
          "file": "z_ehs_unfall_anlegen.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "z_ehs_unfall_anlegen.abap:17"
        },
        {
          "file": "z_ehs_unfall_anlegen.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "z_ehs_unfall_anlegen.abap:20"
        },
        {
          "file": "z_ehs_unfall_anlegen.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "z_ehs_unfall_anlegen.abap:23"
        }
      ]
    },
    {
      "id": "BM-114-B02",
      "text": "Fehlen Personalnummer oder Unfalldatum, wird die Meldung abgelehnt.",
      "anchors": [
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:46"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:47"
        }
      ]
    },
    {
      "id": "BM-114-B03",
      "text": "Der verunfallte Mitarbeiter muss am Unfalltag aktiv beschäftigt sein, sonst wird die Meldung abgelehnt.",
      "anchors": [
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:53"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:59"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:60"
        }
      ]
    },
    {
      "id": "BM-114-B04",
      "text": "Nach der Prüfung wird ein Empfänger für die Meldung des erfassten Unfalls angemeldet.",
      "anchors": [
        {
          "file": "z_ehs_unfall_anlegen.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "z_ehs_unfall_anlegen.abap:29"
        }
      ]
    },
    {
      "id": "BM-114-B05",
      "text": "Der Unfall erhält eine Nummer aus dem Nummernkreis ZEHS_UNF; ist keine Nummer erhältlich, wird die Meldung abgelehnt.",
      "anchors": [
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:71"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:79"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:80"
        }
      ]
    },
    {
      "id": "BM-114-B06",
      "text": "Der Unfall wird mit Status T bei tödlichem Ausgang, M bei mehr als drei Ausfalltagen und sonst E gespeichert; scheitert das Speichern, wird die Meldung abgelehnt.",
      "anchors": [
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:88"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:93"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:94"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:95"
        }
      ]
    },
    {
      "id": "BM-114-B07",
      "text": "Meldepflichtig ist ein Unfall mit tödlichem Ausgang oder mehr als drei Tagen Arbeitsunfähigkeit.",
      "anchors": [
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:100"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:114"
        }
      ]
    },
    {
      "id": "BM-114-B08",
      "text": "Für meldepflichtige Unfälle wird die Mitgliedsnummer der Berufsgenossenschaft des Werks gelesen; fehlt sie, wird die ganze Meldung abgelehnt.",
      "anchors": [
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:101"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:122"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 125,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:125"
        },
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 126,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:126"
        }
      ]
    },
    {
      "id": "BM-114-B09",
      "text": "Sonst wird die Unfallanzeige an die Berufsgenossenschaft als offen mit Frist drei Tage nach dem Unfalldatum vorgemerkt.",
      "anchors": [
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 135,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:135"
        }
      ]
    },
    {
      "id": "BM-114-B10",
      "text": "Der erfasste Unfall wird mit Nummer und Meldepflicht bekannt gemacht.",
      "anchors": [
        {
          "file": "zcl_ehs_unfall.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall.abap:105"
        }
      ]
    },
    {
      "id": "BM-114-B11",
      "text": "Darauf wird für das Unfallobjekt ein Workflow-Ereignis ausgelöst, MELDEPFLICHTIG oder ERFASST.",
      "anchors": [
        {
          "file": "zcl_ehs_unfall_handler.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall_handler.abap:24"
        },
        {
          "file": "zcl_ehs_unfall_handler.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall_handler.abap:27"
        }
      ]
    },
    {
      "id": "BM-114-B12",
      "text": "Bei meldepflichtigen Unfällen erhält der Verteiler der Sicherheitsfachkräfte eine Mail mit Hinweis auf die Dreitagesfrist; ein Versandfehler bleibt folgenlos.",
      "anchors": [
        {
          "file": "zcl_ehs_unfall_handler.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall_handler.abap:34"
        },
        {
          "file": "zcl_ehs_unfall_handler.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ehs_unfall_handler.abap:45"
        }
      ]
    },
    {
      "id": "BM-114-B13",
      "text": "Gelingt die Erfassung, wird alles festgeschrieben und die Unfallnummer mit Erfolgsmeldung zurückgegeben.",
      "anchors": [
        {
          "file": "z_ehs_unfall_anlegen.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "z_ehs_unfall_anlegen.abap:31"
        }
      ]
    },
    {
      "id": "BM-114-B14",
      "text": "Bei jeder Ablehnung werden alle Änderungen zurückgenommen und der Fehlertext zurückgegeben.",
      "anchors": [
        {
          "file": "z_ehs_unfall_anlegen.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "z_ehs_unfall_anlegen.abap:34"
        },
        {
          "file": "z_ehs_unfall_anlegen.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "z_ehs_unfall_anlegen.abap:35"
        }
      ]
    }
  ],
