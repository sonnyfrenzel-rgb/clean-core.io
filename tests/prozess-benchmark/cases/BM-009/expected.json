          "expressionPath": null,
          "raw": "source.abap:38"
        }
      ]
    },
    {
      "id": "BM-009-B03",
      "text": "Die Mail nennt Bestellnummer des Kunden, Nettowert und Währung des Auftrags.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        }
      ]
    },
    {
      "id": "BM-009-B04",
      "text": "Bei der Probeausgabe am Bildschirm wird nur die Empfängeradresse angezeigt und nichts versendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        },
