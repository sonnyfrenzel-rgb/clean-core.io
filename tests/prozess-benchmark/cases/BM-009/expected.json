  "businessStatements": [
    {
      "id": "BM-009-B01",
      "text": "Zur Nachricht wird der zugehörige Kundenauftrag gelesen; fehlt er, wird Fehler 010 protokolliert und die Nachricht als fehlerhaft beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        },
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:24"
        },
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        }
      ]
    },
    {
      "id": "BM-009-B02",
      "text": "Empfänger ist die Standard-E-Mail-Adresse des Nachrichtenpartners aus dem Kundenstamm; fehlt sie, wird Fehler 011 protokolliert und die Nachricht als fehlerhaft beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        },
