  "businessStatements": [
    {
      "id": "BM-111-B01",
      "text": "Der eingegebene Einstiegsplatz wird bei der Eingabe geprüft; existiert er nicht, wird die Eingabe mit Fehlermeldung abgewiesen.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:42"
        },
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:44"
        },
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:45"
        }
      ]
    },
    {
      "id": "BM-111-B02",
      "text": "Aus der Platzart- und der Werksauswahl wird eine Zusatzbedingung für die Platzlesung gebildet; ohne Auswahl gilt keine Einschränkung.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:51"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:12"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:13"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:15"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:19"
        }
      ]
    },
    {
      "id": "BM-111-B03",
      "text": "Die Struktur wird ab dem Einstiegsplatz Ebene für Ebene aufgelöst; der Einstiegsplatz selbst erscheint nicht in der Liste.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:52"
        }
      ]
    },
    {
      "id": "BM-111-B04",
      "text": "Ist die Höchstebene erreicht, wird für den Platz der Hinweis „weitere Ebenen“ ausgegeben und nicht weiter aufgelöst.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:38"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:39"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:40"
        }
      ]
    },
    {
      "id": "BM-111-B05",
      "text": "Zu einem Platz werden die direkt untergeordneten Plätze mit Text in Anmeldesprache gelesen, eingeschränkt durch die Zusatzbedingung, und nach Platznummer sortiert.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:43"
        }
      ]
    },
    {
      "id": "BM-111-B06",
      "text": "Untergeordnete Plätze mit aktivem Systemstatus „inaktiv“ werden samt ihrem gesamten Teilbaum ausgelassen.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:51"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:55"
        }
      ]
    },
    {
      "id": "BM-111-B07",
      "text": "Jeder übrige Platz wird eingerückt nach Ebene mit Text gelistet und gezählt.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:60"
        }
      ]
    },
    {
      "id": "BM-111-B08",
      "text": "Ist die Equipmentanzeige gewählt, werden die aktuell direkt am Platz eingebauten Equipments ohne Unterequipments mit Kurztext gelesen, eingerückt gelistet und gezählt.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:66"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:67"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:84"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:92"
        },
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:97"
        }
      ]
    },
    {
      "id": "BM-111-B09",
      "text": "Danach wird der Platz selbst als Ausgangspunkt der nächsten Ebene aufgelöst.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum_f01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum_f01.abap:69"
        }
      ]
    },
    {
      "id": "BM-111-B10",
      "text": "Am Ende der Liste werden die Anzahl gelisteter Plätze und Equipments ausgegeben.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:57"
        }
      ]
    },
    {
      "id": "BM-111-B11",
      "text": "Ein Doppelklick auf ein Equipment öffnet dessen Anzeige, ein Doppelklick auf einen Platz die Platzanzeige, jeweils ohne Einstiegsbild.",
      "anchors": [
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:63"
        },
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:64"
        },
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:65"
        },
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:66"
        },
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:67"
        },
        {
          "file": "zpm_tplatz_baum.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_tplatz_baum.abap:68"
        }
      ]
    }
  ],
