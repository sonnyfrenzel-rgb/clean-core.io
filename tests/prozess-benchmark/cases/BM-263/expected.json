  "businessStatements": [
    {
      "id": "BM-263-B01",
      "text": "Das externe Lager meldet einen Wareneingang zu einer Bestellung über einen Inbound-Proxy.",
      "anchors": [
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:17"
        }
      ]
    },
    {
      "id": "BM-263-B02",
      "text": "Ist die Nachrichten-ID bereits im Eingangsprotokoll, wird nicht erneut gebucht, sondern der vorhandene Materialbeleg mit Status DUPLICATE zurückgemeldet.",
      "anchors": [
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:33"
        },
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:36"
        },
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:38"
        },
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:39"
        }
      ]
    },
    {
      "id": "BM-263-B03",
      "text": "Existiert die Bestellung nicht oder ist sie gelöscht, wird die Nachricht mit einer Fault-Nachricht „Bestellung … unbekannt“ abgelehnt.",
      "anchors": [
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:42"
        },
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:45"
        },
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:46"
        }
      ]
    },
    {
      "id": "BM-263-B04",
      "text": "Jede gemeldete Position mit positiver Menge wird als Wareneingang zur Bestellposition (Bewegungsart 101) mit Werk und Lagerort übernommen; Positionen ohne positive Menge werden übergangen.",
      "anchors": [
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:56"
        },
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:57"
        },
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:63"
        }
      ]
    },
    {
      "id": "BM-263-B05",
      "text": "Der Wareneingang wird mit Buchungsdatum und Lieferscheinnummer als Materialbeleg gebucht.",
      "anchors": [
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:72"
        }
      ]
    },
    {
      "id": "BM-263-B06",
      "text": "Meldet die Buchung einen Fehler, wird sie zurückgerollt und die Nachricht mit dem Fehlertext als Fault abgelehnt.",
      "anchors": [
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:83"
        },
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:86"
        },
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:87"
        },
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_in.abap:88"
        }
      ]
    },
    {
      "id": "BM-263-B07",
      "text": "Sonst wird die Buchung festgeschrieben, die Nachrichten-ID mit Materialbeleg protokolliert und der Materialbeleg mit Status POSTED zurückgemeldet.",
      "anchors": [
        {
          "file": "zcl_mm_gr_in.abap",
          "line": 93,
