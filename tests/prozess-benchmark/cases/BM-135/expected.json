  "businessStatements": [
    {
      "id": "BM-135-B01",
      "text": "Die Tabelle, aus der die Zinssätze kommen, wird aus der Variablentabelle gelesen; ist keine gepflegt, gilt das Tagesfixing.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 9,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:9"
        },
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:12"
        },
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:13"
        }
      ]
    },
    {
      "id": "BM-135-B02",
      "text": "Es werden die am Stichtag fälligen Festgelder des Buchungskreises gelesen, für die eine aktive Rollover-Regel mit neuer Laufzeit besteht.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:21"
        }
      ]
    },
    {
      "id": "BM-135-B03",
      "text": "Gibt es keine, wird ein Hinweis ausgegeben und der Lauf beendet.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover.abap:37"
        },
        {
          "file": "ztrm_festgeld_rollover.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover.abap:38"
        },
        {
          "file": "ztrm_festgeld_rollover.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover.abap:39"
        }
      ]
    },
    {
      "id": "BM-135-B04",
      "text": "Je Festgeld wird der Zinssatz für Währung und neue Laufzeit am Stichtag aus der Zinsquelle gelesen; fehlt er, wird das Geschäft zur manuellen Bearbeitung protokolliert.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:42"
        },
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:46"
        }
      ]
    },
    {
      "id": "BM-135-B05",
      "text": "Der Nominalbetrag des fälligen Geschäfts wird aus seinem Kapitalzugang gelesen.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:52"
        }
      ]
    },
    {
      "id": "BM-135-B06",
      "text": "Im Testlauf wird nur der ermittelte Zinssatz protokolliert.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:57"
        }
      ]
    },
    {
      "id": "BM-135-B07",
      "text": "Im Echtlauf wird beim selben Partner ein neues Festgeld über den Nominalbetrag vom Stichtag bis Stichtag plus Laufzeit zum ermittelten Zinssatz angelegt.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:62"
        }
      ]
    },
    {
      "id": "BM-135-B08",
      "text": "Meldet die Anlage einen Fehler, wird zurückgerollt und die Fehlermeldung protokolliert; sonst wird festgeschrieben und das neue Geschäft protokolliert.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:78"
        },
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:79"
        },
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:83"
        }
      ]
    },
    {
      "id": "BM-135-B09",
      "text": "Wurden im Echtlauf neue Geschäfte angelegt und ist die Buchung gewünscht, wird der Treasury-Buchungslauf für Buchungskreis und Stichtag als sofort startender Hintergrundjob eingeplant.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover.abap:46"
        },
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:103"
        },
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:115"
        },
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 119,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:119"
        }
      ]
    },
    {
      "id": "BM-135-B10",
      "text": "Kann der Job nicht angelegt werden, erscheint ein Hinweis und es wird nichts eingeplant; ob die Freigabe des Jobs gelingt, wird nicht geprüft.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:110"
        },
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:111"
        }
      ]
    },
    {
      "id": "BM-135-B11",
      "text": "Zum Schluss werden je Festgeld altes und neues Geschäft, Zinssatz und Ergebnistext gelistet.",
      "anchors": [
        {
          "file": "ztrm_festgeld_rollover_f01.abap",
          "line": 134,
          "token": null,
          "expressionPath": null,
          "raw": "ztrm_festgeld_rollover_f01.abap:134"
        }
      ]
    }
  ],
