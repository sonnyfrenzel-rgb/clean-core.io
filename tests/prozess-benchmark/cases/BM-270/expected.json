  "businessStatements": [
    {
      "id": "BM-270-B01",
      "text": "Nur wer Hintergrundjobs freigeben darf, kann die Kontoauszugs-Nachtkette einplanen; sonst bricht der Report mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zfi_bank_chain.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:15"
        },
        {
          "file": "zfi_bank_chain.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:18"
        },
        {
          "file": "zfi_bank_chain.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:19"
        }
      ]
    },
    {
      "id": "BM-270-B02",
      "text": "Ist bereits ein Job der Kette geplant, freigegeben, startbereit oder aktiv, wird nichts eingeplant und nur darauf hingewiesen.",
      "anchors": [
        {
          "file": "zfi_bank_chain.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:23"
        },
        {
          "file": "zfi_bank_chain.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:26"
        },
        {
          "file": "zfi_bank_chain.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:27"
        },
        {
          "file": "zfi_bank_chain.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:28"
        }
      ]
    },
    {
      "id": "BM-270-B03",
      "text": "Die Kette erhält Startdatum und Startzeit für ihren ersten Schritt.",
      "anchors": [
        {
          "file": "zfi_bank_chain.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:31"
        }
      ]
    },
    {
      "id": "BM-270-B04",
      "text": "Als erster Schritt wird der Import des elektronischen Kontoauszugs zum Starttermin eingeplant.",
      "anchors": [
        {
          "file": "zfi_bank_chain.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:34"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:90"
        }
      ]
    },
    {
      "id": "BM-270-B05",
      "text": "Als zweiter Schritt wird der kundeneigene Ausgleich eingeplant, der nur startet, wenn der Import erfolgreich beendet wurde.",
      "anchors": [
        {
          "file": "zfi_bank_chain.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:37"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:101"
        }
      ]
    },
    {
      "id": "BM-270-B06",
      "text": "Auf Wunsch wird als dritter Schritt die Mail an das Treasury eingeplant, die nach dem Ausgleich startet, auch wenn dieser gescheitert ist.",
      "anchors": [
        {
          "file": "zfi_bank_chain.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:41"
        },
        {
          "file": "zfi_bank_chain.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:42"
        }
      ]
    },
    {
      "id": "BM-270-B07",
      "text": "Vor jedem Schritt wird geprüft, ob die Variante ZNIGHT für den Report existiert; fehlt sie, scheitert die Einplanung.",
      "anchors": [
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:52"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 145,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:145"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 153,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:153"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 154,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:154"
        }
      ]
    },
    {
      "id": "BM-270-B08",
      "text": "Jeder Schritt wird als eigener Job angelegt und der jeweilige Report mit seiner Variante als Jobschritt eingeplant; lässt sich der Job nicht anlegen, scheitert die Einplanung.",
      "anchors": [
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:55"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:62"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:63"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:69"
        }
      ]
    },
    {
      "id": "BM-270-B09",
      "text": "Lässt sich der Report nicht einplanen, wird der leere Job gelöscht und die Einplanung scheitert.",
      "anchors": [
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:73"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:75"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:82"
        }
      ]
    },
    {
      "id": "BM-270-B10",
      "text": "Der erste Schritt wird zum Starttermin freigegeben, jeder weitere als Nachfolger des vorherigen Jobs; scheitert die Freigabe, scheitert die Einplanung.",
      "anchors": [
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:88"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:111"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:112"
        }
      ]
    },
    {
      "id": "BM-270-B11",
      "text": "Scheitert irgendein Schritt, werden alle bereits eingeplanten Jobs der Kette gelöscht, der Fehlertext angezeigt und der Report verlassen.",
      "anchors": [
        {
          "file": "zfi_bank_chain.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:48"
        },
        {
          "file": "zcl_fi_job_chain.abap",
          "line": 125,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_job_chain.abap:125"
        },
        {
          "file": "zfi_bank_chain.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:49"
        },
        {
          "file": "zfi_bank_chain.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:50"
        }
      ]
    },
    {
      "id": "BM-270-B12",
      "text": "Bei Erfolg werden alle eingeplanten Jobs mit Name und Nummer als „eingeplant“ ausgegeben.",
      "anchors": [
        {
          "file": "zfi_bank_chain.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:53"
        },
        {
          "file": "zfi_bank_chain.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bank_chain.abap:54"
        }
      ]
    }
  ],
