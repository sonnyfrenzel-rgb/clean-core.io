  "businessStatements": [
    {
      "id": "BM-161-B01",
      "text": "Es werden die Ablesungen der ausgewählten Zähler im eingegebenen Ablesezeitraum gelesen und je Zähler nach Ablesedatum sortiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        }
      ]
    },
    {
      "id": "BM-161-B02",
      "text": "Mit jedem neuen Zähler beginnt die Verbrauchsrechnung ohne Vorablesung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        }
      ]
    },
    {
      "id": "BM-161-B03",
      "text": "Nur Ablesungen mit Ablesestatus 1 werden berücksichtigt; alle anderen werden übergangen und zählen auch nicht als Vorablesung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    },
    {
      "id": "BM-161-B04",
      "text": "Liegt eine Vorablesung vor, wird der Verbrauch als Differenz der Zählerstände (Vorkommastellen) berechnet und mit Zähler, Ablesedatum und Zählerstand ausgegeben.",
