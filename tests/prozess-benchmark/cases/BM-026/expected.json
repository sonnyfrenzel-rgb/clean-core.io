  "businessStatements": [
    {
      "id": "BM-026-B01",
      "text": "Es werden die Bestellanforderungen des Werks und der Einkaufsorganisation gelesen, die den gewählten Freigabestand haben, noch nicht bearbeitet, nicht gelöscht und einem festen Lieferanten zugeordnet sind.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-026-B02",
      "text": "Gibt es keine, wird „Keine offenen Banfen“ gemeldet und die Verarbeitung beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        },
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        },
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        }
      ]
    },
    {
      "id": "BM-026-B03",
      "text": "Die Banfen werden nach festem Lieferanten gruppiert; je Lieferant entsteht genau eine Bestellung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        },
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        }
      ]
    },
    {
      "id": "BM-026-B04",
      "text": "Der Bestellkopf erhält Bestellart, Lieferant und Einkaufsorganisation aus der Selektion, Buchungskreis 1000 und Einkäufergruppe 001 fest.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        }
      ]
    },
    {
      "id": "BM-026-B05",
      "text": "Jede Banf des Lieferanten wird zu einer Bestellposition in Zehnerschritten mit Bezug auf Banf-Nummer und -Position und der Banf-Menge.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        }
      ]
    },
    {
      "id": "BM-026-B06",
      "text": "Die Bestellung wird über das Standard-BAPI angelegt, im Testlauf nur simuliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        }
      ]
    },
    {
      "id": "BM-026-B07",
      "text": "Enthält die Rückmeldung einen Fehler, wird zurückgerollt, für den Lieferanten „keine Bestellung angelegt“ protokolliert und mit dem nächsten Lieferanten fortgefahren.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:81"
        },
        {
          "file": "source.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:82"
        },
        {
          "file": "source.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:83"
        }
      ]
    },
    {
      "id": "BM-026-B08",
      "text": "Im Testlauf wird nur die Anzahl der Positionen je Lieferant ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:87"
        },
        {
          "file": "source.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:88"
        }
      ]
    },
    {
      "id": "BM-026-B09",
      "text": "Im Echtlauf wird die Bestellung synchron festgeschrieben und die neue Bestellnummer je Lieferant ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:90"
        },
        {
          "file": "source.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:93"
        }
      ]
    }
  ],
