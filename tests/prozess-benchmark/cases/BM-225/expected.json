  "businessStatements": [
    {
      "id": "BM-225-B01",
      "text": "Es werden die offenen Umbuchungsvormerkungen des Buchungskreises für Periode und Geschäftsjahr gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        }
      ]
    },
    {
      "id": "BM-225-B02",
      "text": "Gibt es keine, erscheint ein Hinweis und die Verarbeitung endet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        },
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-225-B03",
      "text": "Je Vormerkung wird ein Sachkontenbeleg der Belegart SA aufgebaut: das Von-Konto mit Von-Kostenstelle wird mit dem Betrag entlastet, das Nach-Konto mit Nach-Kostenstelle belastet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        },
        {
          "file": "source.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:101"
        },
        {
          "file": "source.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:104"
        }
      ]
    },
    {
      "id": "BM-225-B04",
      "text": "Der Beleg wird zuerst geprüft; meldet die Prüfung einen Fehler, wird das protokolliert und die Vormerkung bleibt offen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        },
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        },
        {
          "file": "source.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:46"
        }
      ]
    },
    {
      "id": "BM-225-B05",
      "text": "Besteht der Beleg die Prüfung, wird er gebucht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        }
      ]
    },
    {
      "id": "BM-225-B06",
      "text": "Scheitert die Buchung, wird zurückgerollt und der Fehler protokolliert; die Vormerkung bleibt offen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        },
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        },
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        }
      ]
    },
    {
      "id": "BM-225-B07",
      "text": "Nach erfolgreicher Buchung wird festgeschrieben, die Vormerkung mit Status B und der Belegnummer versehen und die Belegnummer protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:66"
        },
