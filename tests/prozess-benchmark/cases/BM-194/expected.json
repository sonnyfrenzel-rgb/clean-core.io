  "businessStatements": [
    {
      "id": "BM-194-B01",
      "text": "Es werden die Werke der Selektion gelesen, für die Integrationsmodelle erzeugt werden sollen.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:65"
        }
      ]
    },
    {
      "id": "BM-194-B02",
      "text": "Gibt es keines der Werke, wird das im Protokoll vermerkt und die Verarbeitung direkt beim Sichern des Protokolls fortgesetzt.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:67"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:68"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:69"
        }
      ]
    },
    {
      "id": "BM-194-B03",
      "text": "Je Werk wird ein Integrationsmodell aus Präfix und Werksnummer benannt und mit der vorgegebenen Variante für das APO-Zielsystem, die Anwendung PPDS und genau dieses Werk generiert.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:74"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:85"
        }
      ]
    },
    {
      "id": "BM-194-B04",
      "text": "Liefert die Generierung kein Protokoll, wird das Werk als fehlerhaft protokolliert und übersprungen.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:90"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:96"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:97"
        }
      ]
    },
    {
      "id": "BM-194-B05",
      "text": "Das Generierungsprotokoll wird in Text umgewandelt und nach dem ersten Vorkommen von „Fehler“ oder „Error“ durchsucht.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:102"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 116,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:116"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:117"
        }
      ]
    },
    {
      "id": "BM-194-B06",
      "text": "Enthält das Protokoll einen Fehlertext, wird das Modell nicht aktiviert und das Werk als fehlerhaft protokolliert.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 123,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:123"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 124,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:124"
        }
      ]
    },
    {
      "id": "BM-194-B07",
      "text": "Im Testlauf wird das Modell nur generiert, nicht aktiviert, und das so protokolliert.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 128,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:128"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 129,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:129"
        }
      ]
    },
    {
      "id": "BM-194-B08",
      "text": "Andernfalls wird das generierte Integrationsmodell für das APO-Zielsystem aktiviert und als aktiviert protokolliert, ohne das Aktivierungsprotokoll auszuwerten.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 135,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:135"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 143,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:143"
        }
      ]
    },
    {
      "id": "BM-194-B09",
      "text": "Nur im Echtlauf wird nach der eingestellten Wartezeit geprüft, ob die Übertragung ins APO in den CIF-Ausgangsqueues hängt.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 148,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:148"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 151,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:151"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 153,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:153"
        }
      ]
    },
    {
      "id": "BM-194-B10",
      "text": "Zum APO-Zielsystem wird die RFC-Destination bestimmt, und es werden die CIF-Queues zu dieser Destination mit Status SYSFAIL, CPICERR oder STOP gelesen.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 169,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:169"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 172,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:172"
        }
      ]
    },
    {
      "id": "BM-194-B11",
      "text": "Gibt es keine fehlerhaften Queues, wird „CIF-Queues ohne Fehler“ protokolliert.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 176,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:176"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 177,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:177"
        }
      ]
    },
    {
      "id": "BM-194-B12",
      "text": "Je fehlerhafter Queue wird eine Fehlerzeile mit der Anzahl der hängenden LUWs protokolliert.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 183,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:183"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 188,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:188"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 189,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:189"
        }
      ]
    },
    {
      "id": "BM-194-B13",
      "text": "Alle gesammelten Meldungen werden in einem Anwendungsprotokoll zum APO-Zielsystem und Tagesdatum gesichert, das 30 Tage aufbewahrt wird.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 213,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:213"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 222,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:222"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 232,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:232"
        }
      ]
    },
    {
      "id": "BM-194-B14",
      "text": "Im Dialog wird das Protokoll anschließend angezeigt, im Hintergrundjob nicht.",
      "anchors": [
        {
          "file": "zapo_cif_imod.abap",
          "line": 238,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:238"
        },
        {
          "file": "zapo_cif_imod.abap",
          "line": 239,
          "token": null,
          "expressionPath": null,
          "raw": "zapo_cif_imod.abap:239"
        }
      ]
    },
    {
      "id": "BM-194-B15",
      "text": "Bei der Übertragung von Materialstammdaten ins APO wird für den Benutzer CIF_ADMIN nichts gefiltert.",
      "anchors": [
        {
          "file": "zxcifuu01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:27"
        },
        {
          "file": "zxcifuu01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:28"
        }
      ]
    },
    {
      "id": "BM-194-B16",
      "text": "Ohne zu übertragende Material-Werks-Kombinationen endet der Filter sofort.",
      "anchors": [
        {
          "file": "zxcifuu01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:31"
        },
        {
          "file": "zxcifuu01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:32"
        }
      ]
    },
    {
      "id": "BM-194-B17",
      "text": "Es werden die ausgeschlossenen Dispositionsmerkmale je Werk sowie die Werksdaten der zu übertragenden Materialien gelesen.",
      "anchors": [
        {
          "file": "zxcifuu01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:35"
        },
        {
          "file": "zxcifuu01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:37"
        }
      ]
    },
    {
      "id": "BM-194-B18",
      "text": "Material-Werks-Kombinationen ohne Werksdaten werden unverändert übertragen.",
      "anchors": [
        {
          "file": "zxcifuu01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:45"
        },
        {
          "file": "zxcifuu01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:48"
        }
      ]
    },
    {
      "id": "BM-194-B19",
      "text": "Hat das Material im Werk ein ausgeschlossenes Dispositionsmerkmal, wird es für dieses Werk aus der Übertragung ins APO entfernt; der Materialkopf bleibt in der Übertragung.",
      "anchors": [
        {
          "file": "zxcifuu01.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:54"
        },
        {
          "file": "zxcifuu01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:57"
        },
        {
          "file": "zxcifuu01.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zxcifuu01.abap:59"
        }
      ]
    }
  ],
