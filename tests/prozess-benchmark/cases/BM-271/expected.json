  "businessStatements": [
    {
      "id": "BM-271-B01",
      "text": "Im Normallauf werden die zum Stichtag aktiven Mitarbeiter der Selektion bestimmt, im Nachsendelauf nur die Mitarbeiter, die in der Warteschlange auf einen neuen Versuch warten.",
      "anchors": [
        {
          "file": "zhr_emp_send.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:21"
        },
        {
          "file": "zhr_emp_send.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:22"
        },
        {
          "file": "zhr_emp_send.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:25"
        }
      ]
    },
    {
      "id": "BM-271-B02",
      "text": "Gibt es keine Mitarbeiter, endet der Report mit einem Hinweis.",
      "anchors": [
        {
          "file": "zhr_emp_send.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:31"
        },
        {
          "file": "zhr_emp_send.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:32"
        },
        {
          "file": "zhr_emp_send.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:33"
        }
      ]
    },
    {
      "id": "BM-271-B03",
      "text": "Für jeden Mitarbeiter wird eine Stammdatennachricht an den externen Payroll-Dienstleister übergeben.",
      "anchors": [
        {
          "file": "zhr_emp_send.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:40"
        },
        {
          "file": "zhr_emp_send.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:42"
        },
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:45"
        }
      ]
    },
    {
      "id": "BM-271-B04",
      "text": "Die Nachricht enthält Name, Vorname und Geburtsdatum zum Stichtag; fehlen die Daten zur Person, wird der Mitarbeiter mit fachlichem Fehler nicht gesendet.",
      "anchors": [
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:61"
        },
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:72"
        },
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:74"
        }
      ]
    },
    {
      "id": "BM-271-B05",
      "text": "Buchungskreis, Werk und Kostenstelle kommen aus der organisatorischen Zuordnung zum Stichtag; fehlt sie, wird der Mitarbeiter mit fachlichem Fehler nicht gesendet.",
      "anchors": [
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:82"
        },
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:87"
        },
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:88"
        }
      ]
    },
    {
      "id": "BM-271-B06",
      "text": "Die Kostenstelle wird nur für Angestellte (Mitarbeitergruppe 1) übermittelt.",
      "anchors": [
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:94"
        },
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:95"
        }
      ]
    },
    {
      "id": "BM-271-B07",
      "text": "Ist das Senden technisch gestört, wird ein wiederholbarer Sendefehler gemeldet.",
      "anchors": [
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:47"
        }
      ]
    },
    {
      "id": "BM-271-B08",
      "text": "Wurde die Nachricht übergeben, wird der Mitarbeiter aus der Warteschlange genommen.",
      "anchors": [
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:53"
        }
      ]
    },
    {
      "id": "BM-271-B09",
      "text": "Nur technische Fehler gelten als wiederholbar; fachliche Fehler nicht.",
      "anchors": [
        {
          "file": "zhr_emp_send.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:45"
        },
        {
          "file": "zcx_hr_send_error.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zcx_hr_send_error.abap:18"
        },
        {
          "file": "zcx_hr_send_temporary.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zcx_hr_send_temporary.abap:18"
        }
      ]
    },
    {
      "id": "BM-271-B10",
      "text": "Bei technischem Fehler wird der Mitarbeiter mit Fehlertext und um eins erhöhter Versuchszahl in die Warteschlange gestellt; nach mehr als fünf Versuchen wird der Eintrag aufgegeben und muss manuell geklärt werden.",
      "anchors": [
        {
          "file": "zhr_emp_send.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:46"
        },
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:103"
        },
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 109,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:109"
        },
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:111"
        },
        {
          "file": "zcl_hr_emp_sender.abap",
          "line": 113,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_emp_sender.abap:113"
        }
      ]
    },
    {
      "id": "BM-271-B11",
      "text": "Bei fachlichem Fehler werden Personalnummer und Fehlertext in der Liste ausgegeben.",
      "anchors": [
        {
          "file": "zhr_emp_send.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:51"
        }
      ]
    },
    {
      "id": "BM-271-B12",
      "text": "Erst am Ende werden alle übergebenen Nachrichten und Warteschlangenänderungen festgeschrieben und die Zahl gesendeter, eingereihter und fehlerhafter Mitarbeiter ausgegeben.",
      "anchors": [
        {
          "file": "zhr_emp_send.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:57"
        },
        {
          "file": "zhr_emp_send.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_emp_send.abap:58"
        }
      ]
    }
  ],
