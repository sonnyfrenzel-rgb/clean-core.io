  "businessStatements": [
    {
      "id": "BM-093-B01",
      "text": "Zu Beginn werden die Überstundengrenzen je Personalbereich geladen, die im gewählten Monat gelten.",
      "anchors": [
        {
          "file": "zhr_ot_eval.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:37"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:36"
        }
      ]
    },
    {
      "id": "BM-093-B02",
      "text": "Es werden alle Mitarbeiter gelesen, die im Monat einer der gewählten Organisationseinheiten und Personalbereiche zugeordnet sind; ohne Treffer endet der Lauf mit einer Meldung.",
      "anchors": [
        {
          "file": "zhr_ot_eval.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:42"
        },
        {
          "file": "zhr_ot_eval.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:48"
        },
        {
          "file": "zhr_ot_eval.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:49"
        }
      ]
    },
    {
      "id": "BM-093-B03",
      "text": "Mitarbeiter, deren Anwesenheiten der Benutzer nicht lesen darf, werden übersprungen.",
      "anchors": [
        {
          "file": "zhr_ot_eval.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:55"
        },
        {
          "file": "zhr_ot_eval.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:68"
        }
      ]
    },
    {
      "id": "BM-093-B04",
      "text": "Ohne Sollarbeitszeit zum Monatsende erhält der Mitarbeiter den Status E mit Hinweistext und wird nicht weiter bewertet.",
      "anchors": [
        {
          "file": "zcl_hr_overtime.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:56"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:67"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:68"
        }
      ]
    },
    {
      "id": "BM-093-B05",
      "text": "Personalbereich und Organisationseinheit werden aus der organisatorischen Zuordnung zum Monatsende übernommen.",
      "anchors": [
        {
          "file": "zcl_hr_overtime.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:74"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:86"
        }
      ]
    },
    {
      "id": "BM-093-B06",
      "text": "Die Ist-Stunden ergeben sich aus den Anwesenheiten plus der erfassten Mehrarbeit des Monats, jeweils ohne gesperrte Sätze.",
      "anchors": [
        {
          "file": "zcl_hr_overtime.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:90"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:95"
        }
      ]
    },
    {
      "id": "BM-093-B07",
      "text": "Das Soll wird vereinfacht aus den Wochenstunden geteilt durch fünf mal der Zahl der Arbeitstage (fünf Siebtel der Kalendertage) berechnet, ohne Feiertage.",
      "anchors": [
        {
          "file": "zcl_hr_overtime.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:101"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:102"
        }
      ]
    },
    {
      "id": "BM-093-B08",
      "text": "Die Überstunden sind Ist plus Mehrarbeit minus Soll.",
      "anchors": [
        {
          "file": "zcl_hr_overtime.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:103"
        }
      ]
    },
    {
      "id": "BM-093-B09",
      "text": "Als Grenze gilt die des Personalbereichs; ist keine hinterlegt, gelten 20 Stunden.",
      "anchors": [
        {
          "file": "zcl_hr_overtime.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:105"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 107,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:107"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 109,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:109"
        }
      ]
    },
    {
      "id": "BM-093-B10",
      "text": "Über der Grenze ist die Ampel rot, über 80 Prozent der Grenze gelb, sonst grün.",
      "anchors": [
        {
          "file": "zcl_hr_overtime.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:112"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 113,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:113"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:115"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:117"
        }
      ]
    },
    {
      "id": "BM-093-B11",
      "text": "Nur bei roter Ampel und gewählter Alarmierung wird ein Alarm ausgelöst.",
      "anchors": [
        {
          "file": "zhr_ot_eval.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:73"
        },
        {
          "file": "zhr_ot_eval.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:74"
        }
      ]
    },
    {
      "id": "BM-093-B12",
      "text": "Je Mitarbeiter und Monat wird höchstens ein Alarm ausgelöst; ein bereits protokollierter Alarm wird nicht wiederholt.",
      "anchors": [
        {
          "file": "zcl_hr_overtime.abap",
          "line": 126,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:126"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 129,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:129"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 130,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:130"
        }
      ]
    },
    {
      "id": "BM-093-B13",
      "text": "Ein neuer Alarm wird mit Überstunden, Grenze, Datum und Benutzer protokolliert und löst das Workflow-Ereignis LIMITEXCEEDED für die Führungskraft aus.",
      "anchors": [
        {
          "file": "zcl_hr_overtime.abap",
          "line": 140,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:140"
        },
        {
          "file": "zcl_hr_overtime.abap",
          "line": 143,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_overtime.abap:143"
        }
      ]
    },
    {
      "id": "BM-093-B14",
      "text": "Wurden Alarme ausgelöst, werden sie festgeschrieben.",
      "anchors": [
        {
          "file": "zhr_ot_eval.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:80"
        },
        {
          "file": "zhr_ot_eval.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:81"
        }
      ]
    },
    {
      "id": "BM-093-B15",
      "text": "Zum Schluss wird die Überstundenampel aller bewerteten Mitarbeiter als ALV-Liste angezeigt.",
      "anchors": [
        {
          "file": "zhr_ot_eval.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_ot_eval.abap:84"
        }
      ]
    }
  ],
