  "businessStatements": [
    {
      "id": "BM-143-B01",
      "text": "Es werden die aktiven Organisationseinheiten der Planvariante gelesen, die am Stichtag gültig sind und in die Auswahl fallen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:15"
        }
      ]
    },
    {
      "id": "BM-143-B02",
      "text": "Zu diesen Organisationseinheiten werden die am Stichtag gültigen Beziehungen „wird geleitet von“ zu einer Planstelle gelesen; wurde keine Organisationseinheit gefunden, liest die Abfrage alle solchen Beziehungen der Planvariante, ohne dass sich die Ausgabe dadurch ändert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:19"
        }
      ]
    },
    {
      "id": "BM-143-B03",
      "text": "Für jede Organisationseinheit wird nachgeschlagen, ob eine Leitungsbeziehung besteht; nur Einheiten ohne Leitung werden weiterverarbeitet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        },
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        }
      ]
    },
    {
      "id": "BM-143-B04",
      "text": "Organisationseinheiten ohne leitende Planstelle werden mit Objekt-ID und Kurztext ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 29,
