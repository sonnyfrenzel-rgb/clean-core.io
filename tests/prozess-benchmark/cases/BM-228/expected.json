  "businessStatements": [
    {
      "id": "BM-228-B01",
      "text": "Die Leistungstabelle wird für Kostenrechnungskreis und Geschäftsjahr gesperrt; ist sie bereits gesperrt, endet der Baustein mit der Ausnahme GESPERRT.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:25"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:33"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:34"
        }
      ]
    },
    {
      "id": "BM-228-B02",
      "text": "Es werden die noch offenen Leistungsmeldungen der Periode gelesen; gibt es keine, wird die Sperre freigegeben und der Baustein endet mit der Ausnahme KEINE_DATEN.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:37"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:42"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:43"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:47"
        }
      ]
    },
    {
      "id": "BM-228-B03",
      "text": "Für jede Meldung müssen Sender- und Empfängerkostenstelle heute gültig sein; sonst wird eine Warnung gesammelt und die Meldung nicht verrechnet.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:51"
        },
        {
          "file": "lzco_leistungf01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungf01.abap:15"
        },
        {
          "file": "lzco_leistungf01.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungf01.abap:20"
        },
        {
          "file": "lzco_leistungf01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungf01.abap:21"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:52"
        }
      ]
    },
    {
      "id": "BM-228-B04",
      "text": "Die Leistungsart muss heute gültig sein; sonst wird eine Warnung gesammelt und die Meldung nicht verrechnet.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:55"
        },
        {
          "file": "lzco_leistungf01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungf01.abap:35"
        },
        {
          "file": "lzco_leistungf01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungf01.abap:39"
        },
        {
          "file": "lzco_leistungf01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungf01.abap:40"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:56"
        }
      ]
    },
    {
      "id": "BM-228-B05",
      "text": "Gültige Meldungen werden zu Verrechnungspositionen mit Sender, Leistungsart, Empfänger und Menge.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:59"
        }
      ]
    },
    {
      "id": "BM-228-B06",
      "text": "Bleibt keine verrechenbare Position, wird eine Fehlermeldung zurückgegeben, die Sperre freigegeben und der Baustein ohne Buchung verlassen.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:67"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:68"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:70"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:74"
        }
      ]
    },
    {
      "id": "BM-228-B07",
      "text": "Die Positionen werden als Leistungsverrechnungsbeleg des Tages gebucht, Warnungen werden ignoriert.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:83"
        }
      ]
    },
    {
      "id": "BM-228-B08",
      "text": "Meldet die Buchung einen Fehler, wird sie verworfen und alle offenen Meldungen der Periode erhalten den Status fehlerhaft.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:93"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:96"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:97"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:98"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:103"
        }
      ]
    },
    {
      "id": "BM-228-B09",
      "text": "Im Testlauf wird die Buchung nicht festgeschrieben und eine Testlaufmeldung zurückgegeben.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 106,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:106"
        }
      ]
    },
    {
      "id": "BM-228-B10",
      "text": "Im Echtlauf wird der Beleg festgeschrieben, die Belegnummer zurückgegeben und alle offenen Meldungen der Periode als verrechnet mit Belegnummer gekennzeichnet.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 108,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:108"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:112"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 118,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:118"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 119,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:119"
        }
      ]
    },
    {
      "id": "BM-228-B11",
      "text": "Die gesammelten Meldungen werden an den Aufrufer zurückgegeben und die Sperre freigegeben.",
      "anchors": [
        {
          "file": "lzco_leistungu01.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:122"
        },
        {
          "file": "lzco_leistungu01.abap",
          "line": 124,
          "token": null,
          "expressionPath": null,
          "raw": "lzco_leistungu01.abap:124"
        }
      ]
    }
  ],
