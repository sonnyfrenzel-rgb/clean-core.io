  "businessStatements": [
    {
      "id": "BM-171-B01",
      "text": "Die CSV-Datei der Ablesefirma wird vom Applikationsserver gelesen; lässt sie sich nicht öffnen, bricht der Lauf mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:13"
        },
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:14"
        },
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:15"
        }
      ]
    },
    {
      "id": "BM-171-B02",
      "text": "Jede Zeile wird in Gerät, Zählwerk, Ablesedatum, Zählerstand und Hinweis zerlegt.",
      "anchors": [
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:18"
        },
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:23"
        }
      ]
    },
    {
      "id": "BM-171-B03",
      "text": "Enthält die Datei keine Sätze, endet der Lauf mit einem als Fehler angezeigten Hinweis.",
      "anchors": [
        {
          "file": "zisu_ablupload.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:39"
        },
        {
          "file": "zisu_ablupload.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:40"
        },
        {
          "file": "zisu_ablupload.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:41"
        }
      ]
    },
    {
      "id": "BM-171-B04",
      "text": "Zu Beginn der Liste werden Dateiname und Testkennzeichen ausgegeben.",
      "anchors": [
        {
          "file": "zisu_ablupload.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:45"
        },
        {
          "file": "zisu_ablupload.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:46"
        }
      ]
    },
    {
      "id": "BM-171-B05",
      "text": "Ein Zählerstand, der nicht als Zahl lesbar ist, macht den Satz fehlerhaft (Fehler 030).",
      "anchors": [
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:49"
        },
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:51"
        }
      ]
    },
    {
      "id": "BM-171-B06",
      "text": "Ein Ablesedatum in der Zukunft macht den Satz fehlerhaft (Fehler 031).",
      "anchors": [
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:55"
        }
      ]
    },
    {
      "id": "BM-171-B07",
      "text": "Ein im System unbekanntes Gerät macht den Satz fehlerhaft (Fehler 032).",
      "anchors": [
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:60"
        },
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:62"
        }
      ]
    },
    {
      "id": "BM-171-B08",
      "text": "Die beiden letzten Ablesungen desselben Zählwerks werden gelesen; liegt der neue Stand unter dem letzten, gilt der Satz als Zählerrücklauf und ist fehlerhaft (Fehler 033).",
      "anchors": [
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:67"
        },
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:74"
        }
      ]
    },
    {
      "id": "BM-171-B09",
      "text": "Weicht der neue Tagesverbrauch um mehr als die Toleranz in Prozent vom Tagesverbrauch der Vorperiode ab, wird nur eine Warnung gelistet; der Satz bleibt gültig.",
      "anchors": [
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:81"
        },
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:87"
        },
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:88"
        },
        {
          "file": "zisu_ablupload_f01.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload_f01.abap:89"
        }
      ]
    },
    {
      "id": "BM-171-B10",
      "text": "Fehlerhafte Sätze werden mit Fehlernummer gelistet, gezählt und nicht hochgeladen.",
      "anchors": [
        {
          "file": "zisu_ablupload.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:51"
        },
        {
          "file": "zisu_ablupload.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:53"
        }
      ]
    },
    {
      "id": "BM-171-B11",
      "text": "Nur ohne Testkennzeichen wird jeder gültige Satz als Ablesebeleg per BAPI hochgeladen.",
      "anchors": [
        {
          "file": "zisu_ablupload.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:58"
        },
        {
          "file": "zisu_ablupload.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:65"
        }
      ]
    },
    {
      "id": "BM-171-B12",
      "text": "Meldet das BAPI einen Fehler, wird zurückgerollt und der Satz mit der Fehlermeldung gelistet; sonst wird der Ablesebeleg sofort festgeschrieben und gezählt.",
      "anchors": [
        {
          "file": "zisu_ablupload.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:69"
        },
        {
          "file": "zisu_ablupload.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:70"
        },
        {
          "file": "zisu_ablupload.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:72"
        },
        {
          "file": "zisu_ablupload.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:74"
        }
      ]
    },
    {
      "id": "BM-171-B13",
      "text": "Nach dem letzten Satz werden die Anzahl gelesener, fehlerhafter und hochgeladener Sätze ausgegeben – außer der letzte Satz war fehlerhaft.",
      "anchors": [
        {
          "file": "zisu_ablupload.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:81"
        },
        {
          "file": "zisu_ablupload.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zisu_ablupload.abap:83"
        }
      ]
    }
  ],
