  "businessStatements": [
    {
      "id": "BM-174-B01",
      "text": "Geprüft werden nur Auslieferungen, und nicht im Anzeigemodus.",
      "anchors": [
        {
          "file": "mv50afz1.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:11"
        },
        {
          "file": "mv50afz1.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:12"
        },
        {
          "file": "mv50afz1.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:13"
        }
      ]
    },
    {
      "id": "BM-174-B02",
      "text": "Die Exportprüfung wird mit Lieferkopf und Lieferpositionen aufgerufen und liefert ein Ergebnis O (frei), S (gesperrt) oder F (technischer Fehler).",
      "anchors": [
        {
          "file": "mv50afz1.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:16"
        },
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:19"
        }
      ]
    },
    {
      "id": "BM-174-B03",
      "text": "Ist in der Variablentabelle keine RFC-Destination zum GTS-System gepflegt, gilt die Lieferung ohne Prüfung als frei.",
      "anchors": [
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:22"
        },
        {
          "file": "lzgtsf01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "lzgtsf01.abap:12"
        },
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:23"
        }
      ]
    },
    {
      "id": "BM-174-B04",
      "text": "Für den Benutzer GTS_TEST und im System DEV gilt die Lieferung ohne Prüfung als frei.",
      "anchors": [
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:28"
        }
      ]
    },
    {
      "id": "BM-174-B05",
      "text": "Liegt das Land des Warenempfängers in Deutschland, gilt die Lieferung ohne Prüfung als frei.",
      "anchors": [
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:32"
        },
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:34"
        }
      ]
    },
    {
      "id": "BM-174-B06",
      "text": "Für GTS werden alle nicht gelöschten Lieferpositionen mit positiver Liefermenge mit Material, Warennummer, Menge und Einheit aufbereitet; gibt es keine, gilt die Lieferung als frei.",
      "anchors": [
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:38"
        },
        {
          "file": "lzgtsf01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "lzgtsf01.abap:25"
        },
        {
          "file": "lzgtsf01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "lzgtsf01.abap:26"
        },
        {
          "file": "lzgtsf01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "lzgtsf01.abap:27"
        },
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:39"
        }
      ]
    },
    {
      "id": "BM-174-B07",
      "text": "Das GTS-System prüft die Lieferung synchron per RFC und gibt Status und Text zurück; bei Kommunikations- oder Systemfehler ist das Ergebnis F mit der Fehlermeldung.",
      "anchors": [
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:43"
        },
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:57"
        },
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:58"
        }
      ]
    },
    {
      "id": "BM-174-B08",
      "text": "Jede tatsächlich an GTS gestellte Prüfung wird mit Lieferung, Zeitpunkt, Ergebnis, Text und Benutzer protokolliert.",
      "anchors": [
        {
          "file": "z_gts_export_pruefung.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "z_gts_export_pruefung.abap:62"
        },
        {
          "file": "lzgtsf01.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "lzgtsf01.abap:54"
        }
      ]
    },
    {
      "id": "BM-174-B09",
      "text": "Ist die Lieferung gesperrt (S), erhält sie die Liefersperre GT und der Anwender eine Information.",
      "anchors": [
        {
          "file": "mv50afz1.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:26"
        },
        {
          "file": "mv50afz1.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:27"
        },
        {
          "file": "mv50afz1.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:28"
        }
      ]
    },
    {
      "id": "BM-174-B10",
      "text": "Ist GTS nicht erreichbar (F), wird im Dialog das Sichern mit Fehlermeldung verhindert; im Hintergrund wird die Lieferung mit Liefersperre GT gesichert.",
      "anchors": [
        {
          "file": "mv50afz1.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:29"
        },
        {
          "file": "mv50afz1.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:30"
        },
        {
          "file": "mv50afz1.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:31"
        },
        {
          "file": "mv50afz1.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:33"
        }
      ]
    },
    {
      "id": "BM-174-B11",
      "text": "In allen anderen Fällen wird eine vorhandene Liefersperre GT wieder entfernt.",
      "anchors": [
        {
          "file": "mv50afz1.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:34"
        },
        {
          "file": "mv50afz1.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:36"
        },
        {
          "file": "mv50afz1.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1.abap:37"
        }
      ]
    }
  ],
