  "businessStatements": [
    {
      "id": "BM-108-B01",
      "text": "Es werden nicht gekündigte Kontrakte (Belegtyp G) der Selektion ermittelt, deren Laufzeit zwischen heute und der eingegebenen Anzahl Tage endet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    },
    {
      "id": "BM-108-B02",
      "text": "Gibt es keine solchen Verträge, endet der Lauf mit einer Hinweismeldung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        },
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        },
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        }
      ]
    },
    {
      "id": "BM-108-B03",
      "text": "Die Verlängerungsregeln je Vertragsart werden gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        }
      ]
    },
    {
      "id": "BM-108-B04",
      "text": "Die Verträge werden je Kunde verarbeitet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        },
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        }
      ]
    },
    {
      "id": "BM-108-B05",
      "text": "Verträge, für deren Vertragsart keine Verlängerungsregel gepflegt ist, werden übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:51"
        },
        {
          "file": "source.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:53"
        }
      ]
    },
    {
      "id": "BM-108-B06",
      "text": "Das neue Laufzeitende ist das alte Ende plus die in der Regel gepflegten Tage, ohne gepflegte Tage plus 365 Tage.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        }
      ]
    },
    {
      "id": "BM-108-B07",
      "text": "Im Echtlauf wird das Laufzeitende des Vertrags auf das neue Datum geändert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        },
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        }
      ]
    },
    {
      "id": "BM-108-B08",
      "text": "Meldet die Änderung einen Fehler, wird sie zurückgenommen und der Vertrag als fehlgeschlagen gelistet; sonst wird sie festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        },
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        },
        {
          "file": "source.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:74"
        },
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        }
      ]
    },
    {
      "id": "BM-108-B09",
      "text": "Jeder verlängerte Vertrag wird mit altem und neuem Laufzeitende gelistet, je Kunde folgt eine Summenzeile mit der Anzahl.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:82"
        },
        {
          "file": "source.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:84"
        }
      ]
    }
  ],
