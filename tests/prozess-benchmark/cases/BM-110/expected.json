  "businessStatements": [
    {
      "id": "BM-110-B01",
      "text": "Mit der Funktion „Prüfen“ wird die Kalibrierung bewertet; ohne Sollwert wird mit Fehlermeldung abgebrochen und das Bild bleibt eingabebereit.",
      "anchors": [
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:17"
        },
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:18"
        },
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:19"
        }
      ]
    },
    {
      "id": "BM-110-B02",
      "text": "Die prozentuale Abweichung des Istwerts vom Sollwert wird berechnet.",
      "anchors": [
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:21"
        }
      ]
    },
    {
      "id": "BM-110-B03",
      "text": "Liegt die Abweichung innerhalb der Toleranz, ist das Ergebnis „in Ordnung“, sonst „nicht in Ordnung“.",
      "anchors": [
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:23"
        }
      ]
    },
    {
      "id": "BM-110-B04",
      "text": "Beim Sichern ohne vorherige Bewertung wird mit Fehlermeldung abgebrochen.",
      "anchors": [
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:26"
        },
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:27"
        },
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:28"
        }
      ]
    },
    {
      "id": "BM-110-B05",
      "text": "Das Kalibrierergebnis wird mit Datum und Prüfer in der Ergebnistabelle gespeichert.",
      "anchors": [
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:32"
        }
      ]
    },
    {
      "id": "BM-110-B06",
      "text": "Ist das Ergebnis „nicht in Ordnung“, wird am Prüfmittel-Equipment der Anwenderstatus E0003 gesetzt.",
      "anchors": [
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:34"
        },
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:36"
        }
      ]
    },
    {
      "id": "BM-110-B07",
      "text": "Zusätzlich wird zum Equipment eine Instandhaltungsmeldung der Art M2 „Kalibrierung nicht in Ordnung“ angelegt und gesichert.",
      "anchors": [
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:44"
        },
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_kalib_i01.abap:52"
        }
      ]
    },
    {
      "id": "BM-110-B08",
      "text": "Alle Änderungen werden festgeschrieben, der Prüfer erhält eine Erfolgsmeldung und das Bild wird für das nächste Prüfmittel geleert.",
      "anchors": [
        {
          "file": "mzpm_kalib_i01.abap",
          "line": 58,
