  "businessStatements": [
    {
      "id": "BM-147-B01",
      "text": "Für den Personalteilbereich des Mitarbeiters wird die am Auswertungstag gültige Nachtzuschlagsregel gelesen; gibt es keine, entsteht kein Zuschlag.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        },
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        },
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        }
      ]
    },
    {
      "id": "BM-147-B02",
      "text": "Die Zeitpaare des Tages werden durchlaufen, wobei nur Anwesenheiten berücksichtigt werden.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-147-B03",
      "text": "Je Zeitpaar werden die Minuten nach 22 Uhr und vor 6 Uhr als Nachtanteil berechnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        },
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        },
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        },
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        }
      ]
    },
    {
      "id": "BM-147-B04",
      "text": "Zeitpaare, deren Nachtanteil unter der vereinbarten Mindestdauer liegt, zählen nicht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        },
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        }
      ]
    },
    {
      "id": "BM-147-B05",
      "text": "Die übrigen Nachtminuten werden zu einer Tagessumme addiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        }
      ]
    },
    {
      "id": "BM-147-B06",
      "text": "Ergibt sich keine Nachtzeit, wird die Funktion ohne Zuschlag verlassen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        },
        {
          "file": "source.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:51"
        }
      ]
    },
    {
      "id": "BM-147-B07",
      "text": "Sonst wird für den Tag eine Zeitlohnart mit den Nachtstunden gebildet, bei Dauernachtschicht mit der eigenen Lohnart für den erhöhten Satz, und an die Abrechnung übergeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        },
