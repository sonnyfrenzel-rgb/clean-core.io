  "businessStatements": [
    {
      "id": "BM-054-B01",
      "text": "Die Hauswährung des Buchungskreises wird ermittelt.",
      "anchors": [
        {
          "file": "zfi_fxval.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval.abap:40"
        }
      ]
    },
    {
      "id": "BM-054-B02",
      "text": "Die Bewertung wird für Buchungskreis und Stichtag gesperrt, damit sie nicht parallel läuft; ist sie schon gesperrt, bricht der Report mit Hinweis auf den Sperrenden ab.",
      "anchors": [
        {
          "file": "zfi_fxval.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval.abap:44"
        },
        {
          "file": "zfi_fxval.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval.abap:52"
        },
        {
          "file": "zfi_fxval.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval.abap:53"
        }
      ]
    },
    {
      "id": "BM-054-B03",
      "text": "Bewertet werden alle Kreditorenposten in Fremdwährung, die bis zum Stichtag gebucht wurden und am Stichtag offen waren: heute noch offene und nach dem Stichtag ausgeglichene.",
      "anchors": [
        {
          "file": "zfi_fxval_f01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:12"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:19"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:25"
        }
      ]
    },
    {
      "id": "BM-054-B04",
      "text": "Gibt es keine solchen Posten, wird das gemeldet und der Report endet.",
      "anchors": [
        {
          "file": "zfi_fxval.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval.abap:57"
        },
        {
          "file": "zfi_fxval.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval.abap:58"
        },
        {
          "file": "zfi_fxval.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval.abap:59"
        }
      ]
    },
    {
      "id": "BM-054-B05",
      "text": "Jeder Posten wird vorzeichengerecht (Haben negativ) mit dem Kurstyp der Selektion zum Stichtag in Hauswährung umgerechnet.",
      "anchors": [
        {
          "file": "zfi_fxval_f01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:47"
        }
      ]
    },
    {
      "id": "BM-054-B06",
      "text": "Die Differenz zwischen neuem und gebuchtem Hauswährungsbetrag wird je Währung aufsummiert.",
      "anchors": [
        {
          "file": "zfi_fxval_f01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:69"
        }
      ]
    },
    {
      "id": "BM-054-B07",
      "text": "Fehlt für eine Währung der Kurs, wird die ganze Währung gemeldet und nicht bewertet.",
      "anchors": [
        {
          "file": "zfi_fxval_f01.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:61"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:73"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:75"
        }
      ]
    },
    {
      "id": "BM-054-B08",
      "text": "Nur im Echtlauf werden die Differenzen gebucht, und zwar ein Beleg je Währung; Währungen ohne Differenz werden übergangen.",
      "anchors": [
        {
          "file": "zfi_fxval.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval.abap:64"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:92"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:93"
        }
      ]
    },
    {
      "id": "BM-054-B09",
      "text": "Ein Kursverlust wird als Aufwand gegen das Korrekturkonto der Verbindlichkeiten gebucht, ein Kursgewinn vom Korrekturkonto gegen Ertrag, jeweils mit dem Betrag der Differenz in Hauswährung.",
      "anchors": [
        {
          "file": "zfi_fxval_f01.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:98"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:99"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:102"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 120,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:120"
        }
      ]
    },
    {
      "id": "BM-054-B10",
      "text": "Enthält die Rückmeldung der Buchung eine Fehlermeldung, wird zurückgerollt und der Fehlschlag für die Währung gemeldet.",
      "anchors": [
        {
          "file": "zfi_fxval_f01.abap",
          "line": 130,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:130"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 131,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:131"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 132,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:132"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 133,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:133"
        }
      ]
    },
    {
      "id": "BM-054-B11",
      "text": "Bei Erfolg wird ein Protokollsatz mit Belegschlüssel und Differenz angelegt, gemeinsam mit dem Beleg festgeschrieben und die Belegnummer gemeldet.",
      "anchors": [
        {
          "file": "zfi_fxval_f01.abap",
          "line": 143,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:143"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 144,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:144"
        },
        {
          "file": "zfi_fxval_f01.abap",
          "line": 147,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval_f01.abap:147"
        }
      ]
    },
    {
      "id": "BM-054-B12",
      "text": "Nach der Buchung wird die Sperre freigegeben, und die Differenzen je Währung werden aufgelistet.",
      "anchors": [
        {
          "file": "zfi_fxval.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval.abap:68"
        },
        {
          "file": "zfi_fxval.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_fxval.abap:75"
        }
      ]
    }
  ],
