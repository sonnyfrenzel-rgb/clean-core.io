  "businessStatements": [
    {
      "id": "BM-023-B01",
      "text": "Vor dem Verbuchen eines Materialbelegs werden alle Positionen geprüft, aber nur Verschrottungen und deren Stornos (Bewegungsart 551/552) werden betrachtet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 3,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:3"
        },
        {
          "file": "source.abap",
          "line": 9,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:9"
        },
        {
          "file": "source.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:10"
        }
      ]
    },
    {
      "id": "BM-023-B02",
      "text": "Liegt der Buchungswert einer Verschrottungsposition über 5.000 in Hauswährung, müssen Bewegungsgrund und Kostenstelle gefüllt sein.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:11"
        },
        {
          "file": "source.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:12"
        }
      ]
    },
    {
      "id": "BM-023-B03",
      "text": "Fehlt eines davon, wird mit Material und Wert eine Fehlermeldung ausgegeben und die Buchung damit abgebrochen.",
