  "businessStatements": [
    {
      "id": "BM-010-B01",
      "text": "Es werden die offenen Soll-Posten ohne Sonderhauptbuchkennzeichen der ausgewählten Buchungskreise und Kunden gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        }
      ]
    },
    {
      "id": "BM-010-B02",
      "text": "Nur Posten, deren Fälligkeit (Basisdatum plus Skontotage 1) mehr als die eingegebene Anzahl Tage zurückliegt, werden je Kunde aufsummiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        },
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        }
      ]
    },
    {
      "id": "BM-010-B03",
      "text": "Kunden, deren überfällige Summe unter dem Mindestbetrag liegt, bleiben unberührt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        }
      ]
    },
    {
      "id": "BM-010-B04",
      "text": "Hat der Kunde bereits eine Auftragssperre, wird das nur protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:49"
        },
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        },
        {
          "file": "source.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:51"
        }
      ]
    },
    {
      "id": "BM-010-B05",
      "text": "Im Testlauf werden die Sperrkandidaten mit Betrag nur aufgelistet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        },
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        }
      ]
    },
    {
      "id": "BM-010-B06",
      "text": "Im Echtlauf wird der Kundenstamm gesperrt; ist er gerade in Bearbeitung, wird der Kunde übersprungen und der Bearbeiter protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:65"
        },
        {
          "file": "source.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:66"
        }
      ]
    },
    {
      "id": "BM-010-B07",
      "text": "Sonst erhält der Kunde die zentrale Auftragssperre 07, die Kundensperre wird wieder freigegeben und der Vorgang protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:69"
        },
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        },
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        }
      ]
    },
    {
      "id": "BM-010-B08",
      "text": "Am Ende werden alle gesetzten Sperren festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:76"
        }
      ]
    }
