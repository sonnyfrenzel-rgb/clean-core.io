  "businessStatements": [
    {
      "id": "BM-011-B01",
      "text": "Es werden alle nicht abgesagten Positionen von Kundenaufträgen der gewählten Verkaufsorganisationen, Werke und Materialien gelesen, die noch nicht voll beliefert sind.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:14"
        }
      ]
    },
    {
      "id": "BM-011-B02",
      "text": "Zu diesen Positionen werden alle Einteilungen gelesen und die bestätigte Menge je Position summiert.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:29"
        },
        {
          "file": "zsd_backorder_f01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:36"
        },
        {
          "file": "zsd_backorder_f01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:38"
        }
      ]
    },
    {
      "id": "BM-011-B03",
      "text": "Die unbestätigte Restmenge ist Auftragsmenge minus bestätigter Menge.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:40"
        }
      ]
    },
    {
      "id": "BM-011-B04",
      "text": "Als Rückstand bleiben nur Positionen mit unbestätigter Restmenge, deren Wunschlieferdatum aus dem Auftragskopf spätestens am Stichtag liegt.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:42"
        }
      ]
    },
    {
      "id": "BM-011-B05",
      "text": "Die Rückstände werden je Material und Werk nach Lieferpriorität, dann nach Wunschtermin geordnet.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:50"
        }
      ]
    },
    {
      "id": "BM-011-B06",
      "text": "Gibt es keine Rückstände, erscheint ein Hinweis; das Protokoll wird trotzdem angezeigt, dann leer.",
      "anchors": [
        {
          "file": "zsd_backorder.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder.abap:19"
        },
        {
          "file": "zsd_backorder.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder.abap:20"
        },
        {
          "file": "zsd_backorder.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder.abap:21"
        },
        {
          "file": "zsd_backorder.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder.abap:25"
        }
      ]
    },
    {
      "id": "BM-011-B07",
      "text": "Für jede neue Kombination aus Material und Werk wird der frei verwendbare Bestand über alle Lagerorte des Werks ermittelt.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:63"
        },
        {
          "file": "zsd_backorder_f01.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:65"
        }
      ]
    },
    {
      "id": "BM-011-B08",
      "text": "Ist der Bestand erschöpft, wird die Position mit „Kein freier Bestand“ protokolliert und nicht bearbeitet.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:70"
        }
      ]
    },
    {
      "id": "BM-011-B09",
      "text": "Jede Position erhält als Zuteilung das Minimum aus ihrer Restmenge und dem verbleibenden freien Bestand; der freie Bestand sinkt um diese Zuteilung.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:77"
        },
        {
          "file": "zsd_backorder_f01.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:78"
        }
      ]
    },
    {
      "id": "BM-011-B10",
      "text": "Im Testlauf wird die geplante Zuteilung nur protokolliert.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:80"
        }
      ]
    },
    {
      "id": "BM-011-B11",
      "text": "Im Echtlauf wird der Kundenauftrag gesperrt; ist er in Bearbeitung, wird die Position mit Fehler protokolliert und übersprungen.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:104"
        },
        {
          "file": "zsd_backorder_f01.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:111"
        },
        {
          "file": "zsd_backorder_f01.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:115"
        }
      ]
    },
    {
      "id": "BM-011-B12",
      "text": "Die erste Einteilung der Position wird auf den Stichtag und die volle Auftragsmenge geändert, sodass die Standard-Verfügbarkeitsprüfung neu bestätigt.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 128,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:128"
        }
      ]
    },
    {
      "id": "BM-011-B13",
      "text": "Lehnt der Auftrag die Änderung mit einem Fehler ab, wird sie verworfen und „Änderung abgelehnt“ protokolliert.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 139,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:139"
        },
        {
          "file": "zsd_backorder_f01.abap",
          "line": 140,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:140"
        },
        {
          "file": "zsd_backorder_f01.abap",
          "line": 141,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:141"
        }
      ]
    },
    {
      "id": "BM-011-B14",
      "text": "Sonst wird die Änderung synchron festgeschrieben und „Neu eingeplant“ mit der Zuteilungsmenge protokolliert.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 146,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:146"
        }
      ]
    },
    {
      "id": "BM-011-B15",
      "text": "Danach wird die Auftragssperre wieder gelöst.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 154,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:154"
        }
      ]
    },
    {
      "id": "BM-011-B16",
      "text": "Am Ende wird das Verteilprotokoll mit Auftrag, Position, Material, Zuteilung, Status und Meldung als ALV-Liste angezeigt.",
      "anchors": [
        {
          "file": "zsd_backorder_f01.abap",
          "line": 171,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_backorder_f01.abap:171"
        }
      ]
    }
  ],
