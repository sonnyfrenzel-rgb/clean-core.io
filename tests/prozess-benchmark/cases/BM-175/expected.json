  "businessStatements": [
    {
      "id": "BM-175-B01",
      "text": "Es werden Bonusabsprachen der gewählten Verkaufsorganisationen und Absprachenarten gelesen, die vor dem Stichtag abgelaufen sind und den Status offen oder A haben.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:33"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:11"
        }
      ]
    },
    {
      "id": "BM-175-B02",
      "text": "Gibt es keine, endet der Lauf mit einem Hinweis.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:34"
        },
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:35"
        },
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:36"
        }
      ]
    },
    {
      "id": "BM-175-B03",
      "text": "Die Absprachen werden je Absprachenart gesammelt; mit jeder neuen Art beginnt eine neue Sammlung.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:40"
        },
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:41"
        }
      ]
    },
    {
      "id": "BM-175-B04",
      "text": "Eine Absprache ohne Freigabe des Vertriebscontrollings wird mit Hinweis gelistet und nicht abgerechnet.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:30"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:32"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:33"
        }
      ]
    },
    {
      "id": "BM-175-B05",
      "text": "Ist für die Absprachenart eine Zusatzprüfung hinterlegt, wird die dort genannte Routine eines anderen Programms gerufen, sofern sie existiert; lehnt sie ab, wird die Absprache mit Hinweis übergangen.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:39"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:43"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:46"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:47"
        }
      ]
    },
    {
      "id": "BM-175-B06",
      "text": "Geprüfte Absprachen werden in die Sammlung der Absprachenart aufgenommen.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:46"
        }
      ]
    },
    {
      "id": "BM-175-B07",
      "text": "Am Ende jeder Absprachenart listet der Testlauf die gesammelten Absprachen; im Echtlauf wird für eine nicht leere Sammlung die Sammelabrechnung als Job eingeplant.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:49"
        },
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:50"
        },
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:51"
        },
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:53"
        }
      ]
    },
    {
      "id": "BM-175-B08",
      "text": "Lässt sich der Job nicht öffnen, bricht der Lauf mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:61"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:68"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:69"
        }
      ]
    },
    {
      "id": "BM-175-B09",
      "text": "Die Standard-Sammelabrechnung wird mit den gesammelten Absprachenummern im Job eingeplant und der Job sofort freigegeben.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:72"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:77"
        }
      ]
    },
    {
      "id": "BM-175-B10",
      "text": "Scheitert die Freigabe, wird der Job als nicht freigegeben gelistet und nicht protokolliert.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:84"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:85"
        }
      ]
    },
    {
      "id": "BM-175-B11",
      "text": "Jeder freigegebene Job wird mit Jobname, Absprachenart, Datum, Anzahl und Benutzer protokolliert, gezählt und gelistet.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:95"
        },
        {
          "file": "zsd_bonus_endabr_f01.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr_f01.abap:97"
        }
      ]
    },
    {
      "id": "BM-175-B12",
      "text": "Im Echtlauf wird am Ende die Zahl der eingeplanten Jobs ausgegeben.",
      "anchors": [
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:58"
        },
        {
          "file": "zsd_bonus_endabr.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_endabr.abap:60"
        }
      ]
    }
  ],
