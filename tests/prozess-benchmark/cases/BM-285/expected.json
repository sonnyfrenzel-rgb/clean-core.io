  "businessStatements": [
    {
      "id": "BM-285-B01",
      "text": "Mit Zurück kehrt der Werker vom Vorgangsdetail in die Vorgangsliste 0100 zurück.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:17"
        },
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-285-B02",
      "text": "Beim Rückmelden wird geprüft, ob Gutmenge und Ausschuss zusammen die offene Vorgangsmenge übersteigen; dann bricht eine Fehlermeldung mit der offenen Menge ab, eine Überlieferung ist nicht zulässig.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        },
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        },
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        }
      ]
    },
    {
      "id": "BM-285-B03",
      "text": "Ist die Rückmeldung als Endrückmeldung gekennzeichnet, muss der Werker in einer Rückfrage bestätigen, dass der Vorgang endgültig abgeschlossen wird; ohne Bestätigung wird nichts zurückgemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        },
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-285-B04",
      "text": "Die Rückmeldung mit Gutmenge, Ausschuss, Abweichungsursache, Endrückmeldekennzeichen, Text und Tagesdatum als Buchungsdatum wird per BAPI zum Auftragsvorgang angelegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        }
      ]
    },
    {
      "id": "BM-285-B05",
      "text": "Meldet der BAPI einen Fehler oder Abbruch, wird dessen Meldungstext als Informationsmeldung in Fehleroptik angezeigt und die Verarbeitung ohne Festschreiben beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:82"
        },
        {
          "file": "source.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:84"
        },
        {
          "file": "source.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:85"
        }
      ]
    },
    {
      "id": "BM-285-B06",
      "text": "Andernfalls wird die Rückmeldung synchron festgeschrieben und Auftrag und Vorgang als Erfolgsmeldung ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:88"
        },
        {
          "file": "source.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:92"
        }
      ]
    }
  ],
