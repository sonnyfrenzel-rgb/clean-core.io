        }
      ]
    },
    {
      "id": "BM-044-B02",
      "text": "Der Fremdwährungsbetrag wird zum übergebenen Datum mit dem Durchschnittskurs (Kurstyp M) in die Hauswährung umgerechnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        }
      ]
    },
    {
      "id": "BM-044-B03",
      "text": "Scheitert die Umrechnung, etwa weil kein Kurs gepflegt ist, bricht der Baustein mit NO_RATE ab.",
