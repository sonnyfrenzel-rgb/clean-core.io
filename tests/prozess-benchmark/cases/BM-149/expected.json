  "businessStatements": [
    {
      "id": "BM-149-B01",
      "text": "Es werden die genehmigten, noch nicht zur Abrechnung freigegebenen Reisen der Mitarbeiter gelesen, die aktuell dem eingegebenen Buchungskreis angehören.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:16"
        }
      ]
    },
    {
      "id": "BM-149-B02",
      "text": "Gibt es keine solche Reise, endet der Lauf mit einem Hinweis.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        },
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        }
      ]
    },
    {
      "id": "BM-149-B03",
      "text": "Zu den Reisen werden die erfassten Belege gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        }
      ]
    },
    {
      "id": "BM-149-B04",
      "text": "Reisen ohne Beleg werden nicht freigegeben, sondern in der Liste als „ohne Belege“ ausgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        },
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        },
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        },
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        }
      ]
    },
    {
      "id": "BM-149-B05",
      "text": "Im Echtlauf wird jede Reise mit Beleg direkt in der Reisetabelle auf „abzurechnen“ gesetzt, und ihr Mitarbeiter wird für die Abrechnung vorgemerkt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        },
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        }
      ]
    },
    {
      "id": "BM-149-B06",
      "text": "Im Testlauf oder wenn keine Reise freigegeben wurde, endet der Lauf ohne Job.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        }
      ]
    },
    {
      "id": "BM-149-B07",
      "text": "Sonst werden die Statusänderungen festgeschrieben und ein Hintergrundjob angelegt; scheitert das, bricht der Lauf mit Fehlermeldung ab, während die Freigaben bestehen bleiben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        },
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        },
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        }
      ]
    },
    {
      "id": "BM-149-B08",
      "text": "In den Job wird die Standard-Reiseabrechnung mit der Variante ZMONAT für alle vorgemerkten Mitarbeiter eingestellt und der Job zum Sofortstart freigegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:71"
        },
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        }
      ]
    },
    {
      "id": "BM-149-B09",
      "text": "Zum Schluss werden Jobname und Jobnummer ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:84"
        }
      ]
    }
  ],
