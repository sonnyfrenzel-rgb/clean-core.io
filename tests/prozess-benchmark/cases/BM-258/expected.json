  "businessStatements": [
    {
      "id": "BM-258-B01",
      "text": "Als Zeitraum werden die letzten 365 Tage bis heute vorgeschlagen.",
      "anchors": [
        {
          "file": "zmm_abc_report.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:19"
        }
      ]
    },
    {
      "id": "BM-258-B02",
      "text": "Die Grenze für A muss unter der Grenze für B liegen und B darf 100 % nicht übersteigen; sonst bleibt das Selektionsbild mit Fehlermeldung stehen.",
      "anchors": [
        {
          "file": "zmm_abc_report.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:22"
        },
        {
          "file": "zmm_abc_report.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:23"
        }
      ]
    },
    {
      "id": "BM-258-B03",
      "text": "Gibt es zu den gewählten Werken keinen Werkseintrag, endet der Lauf mit der Meldung ZMM_ABC 011.",
      "anchors": [
        {
          "file": "zmm_abc_report.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:27"
        },
        {
          "file": "zmm_abc_report.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:30"
        },
        {
          "file": "zmm_abc_report.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:31"
        }
      ]
    },
    {
      "id": "BM-258-B04",
      "text": "Mehrere Werke werden auf Wunsch parallel in der RFC-Servergruppe parallel_generators analysiert, sonst nacheinander.",
      "anchors": [
        {
          "file": "zmm_abc_report.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:41"
        },
        {
          "file": "zmm_abc_report.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:42"
        },
        {
          "file": "zmm_abc_report.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:44"
        }
      ]
    },
    {
      "id": "BM-258-B05",
      "text": "Jedes Werk wird als eigene Aufgabe gestartet; ist keine Sitzung frei, wird bis zu 10 Sekunden gewartet und erneut versucht, ist die Gruppe nicht erreichbar, wird das Werk im eigenen Prozess gerechnet.",
      "anchors": [
        {
          "file": "zcl_mm_abc_runner.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_runner.abap:84"
        },
        {
          "file": "zcl_mm_abc_runner.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_runner.abap:101"
        },
        {
          "file": "zcl_mm_abc_runner.abap",
          "line": 107,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_runner.abap:107"
        },
        {
          "file": "zcl_mm_abc_runner.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_runner.abap:110"
        }
      ]
    },
    {
      "id": "BM-258-B06",
      "text": "Nach dem Verteilen wird höchstens 30 Minuten auf alle Aufgaben gewartet; das Ergebnis jeder beendeten Aufgabe wird abgeholt, abgebrochene Werke erhalten den Status ABBRUCH.",
      "anchors": [
        {
          "file": "zcl_mm_abc_runner.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_runner.abap:127"
        },
        {
          "file": "zcl_mm_abc_runner.abap",
          "line": 135,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_runner.abap:135"
        },
        {
          "file": "zcl_mm_abc_runner.abap",
          "line": 143,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_runner.abap:143"
        },
        {
          "file": "zcl_mm_abc_runner.abap",
          "line": 145,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_runner.abap:145"
        }
      ]
    },
    {
      "id": "BM-258-B07",
      "text": "Der Verbrauchswert eines Materials ist der Hauswährungswert seiner Warenausgänge an Kostenstelle, Auftrag und Lieferung (201, 261, 601) abzüglich deren Stornos im Zeitraum; nur Materialien mit positivem Verbrauch zählen.",
      "anchors": [
        {
          "file": "z_mm_abc_werk.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_abc_werk.abap:20"
        },
        {
          "file": "zcl_mm_abc_amdp.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_amdp.abap:50"
        }
      ]
    },
    {
      "id": "BM-258-B08",
      "text": "Hat ein Werk keinen Verbrauch, wird es mit Status LEER zurückgemeldet und nichts gespeichert.",
      "anchors": [
        {
          "file": "z_mm_abc_werk.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_abc_werk.abap:27"
        },
        {
          "file": "z_mm_abc_werk.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_abc_werk.abap:29"
        }
      ]
    },
    {
      "id": "BM-258-B09",
      "text": "Die Materialien werden nach Verbrauchswert absteigend sortiert; bis zum kumulierten Anteil der A-Grenze sind sie A, bis zur B-Grenze B, der Rest C.",
      "anchors": [
        {
          "file": "z_mm_abc_werk.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_abc_werk.abap:32"
        },
        {
          "file": "zcl_mm_abc_amdp.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_amdp.abap:67"
        },
        {
          "file": "zcl_mm_abc_amdp.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_abc_amdp.abap:75"
        }
      ]
    },
    {
      "id": "BM-258-B10",
      "text": "Das Ergebnis je Material wird mit Wert, kumuliertem Anteil und Klasse zum Stichtag (Periodenende) gespeichert.",
      "anchors": [
        {
          "file": "z_mm_abc_werk.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_abc_werk.abap:45"
        }
      ]
    },
    {
      "id": "BM-258-B11",
      "text": "Auf Wunsch wird das ABC-Kennzeichen jedes Materials im Werkssegment des Materialstamms direkt überschrieben; danach wird festgeschrieben.",
      "anchors": [
        {
          "file": "z_mm_abc_werk.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_abc_werk.abap:47"
        },
        {
          "file": "z_mm_abc_werk.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_abc_werk.abap:50"
        },
        {
          "file": "z_mm_abc_werk.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_abc_werk.abap:56"
        }
      ]
    },
    {
      "id": "BM-258-B12",
      "text": "Je Werk werden Anzahl der A-, B- und C-Materialien und der Wert der A-Materialien zurückgemeldet.",
      "anchors": [
        {
          "file": "z_mm_abc_werk.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_abc_werk.abap:59"
        }
      ]
    },
    {
      "id": "BM-258-B13",
      "text": "Am Ende erscheinen die Summen je Werk mit Status als ALV-Liste, im Hintergrund ersatzweise als einfache Liste.",
      "anchors": [
        {
          "file": "zmm_abc_report.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:61"
        },
        {
          "file": "zmm_abc_report.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:64"
        },
        {
          "file": "zmm_abc_report.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_abc_report.abap:68"
        }
      ]
    }
  ],
