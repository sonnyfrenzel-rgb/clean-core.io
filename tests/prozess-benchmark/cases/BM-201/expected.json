  "businessStatements": [
    {
      "id": "BM-201-B01",
      "text": "Für den eingegebenen Debitor und Kreditkontrollbereich werden die Kreditstammdaten gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-201-B02",
      "text": "Das Limit gilt als überschritten, wenn ein Kreditstammsatz existiert und offene Aufträge plus Forderungen das Kreditlimit übersteigen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:24"
        }
      ]
    },
    {
      "id": "BM-201-B03",
      "text": "Bei Überschreitung wird der Debitor mit dem Hinweis „Kreditlimit überschritten“ ausgegeben; sonst endet der Report ohne Ausgabe.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
