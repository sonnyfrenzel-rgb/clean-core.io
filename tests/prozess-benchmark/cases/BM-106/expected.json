  "businessStatements": [
    {
      "id": "BM-106-B01",
      "text": "Die BDE-Datei mit Zählerständen wird vom Applikationsserver geöffnet; ist sie nicht lesbar, bricht der Lauf mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        }
      ]
    },
    {
      "id": "BM-106-B02",
      "text": "Die Datei wird Satz für Satz bis zum Dateiende gelesen und in Messpunkt, Datum, Uhrzeit und Zählerstand zerlegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        },
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        },
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        }
      ]
    },
    {
      "id": "BM-106-B03",
      "text": "Ein Zählerstand, der sich nicht in eine Zahl umwandeln lässt, wird als fehlerhafter Satz gemeldet und übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        },
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        }
      ]
    },
    {
      "id": "BM-106-B04",
      "text": "Jeder Zählerstand wird gegen den letzten Stand des Messpunkts plausibilisiert; ist er kleiner, wird er gemeldet und übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-106-B05",
      "text": "Im Testlauf wird nur der ermittelte Zuwachs ausgegeben, es entsteht kein Messbeleg.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:63"
        },
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        }
      ]
    },
    {
      "id": "BM-106-B06",
      "text": "Im Echtlauf wird zu jedem gültigen Zählerstand ein Messbeleg mit Herkunft BDE-Upload angelegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        }
      ]
    },
    {
      "id": "BM-106-B07",
      "text": "Schlägt das Anlegen fehl, wird der Fehler zum Messpunkt ausgegeben und der Satz übersprungen; sonst wird der Messbeleg sofort festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:83"
        },
        {
          "file": "source.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:84"
        },
        {
          "file": "source.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:87"
        }
      ]
    },
    {
      "id": "BM-106-B08",
      "text": "Am Dateiende wird die Datei geschlossen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:90"
        }
      ]
    }
  ],
