  "businessStatements": [
    {
      "id": "BM-090-B01",
      "text": "Der Lauf setzt die Berechtigung zum Archivieren des Objekts ZIF_LOG voraus; fehlt sie, bricht er ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:19"
        },
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        },
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:24"
        }
      ]
    },
    {
      "id": "BM-090-B02",
      "text": "Es werden abgeschlossene oder abgebrochene Schnittstellenprotokolle der gewählten Schnittstellen gelesen, die älter als die Verweildauer sind.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-090-B03",
      "text": "Gibt es keine, wird das gemeldet und der Lauf beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        },
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        },
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        }
      ]
    },
    {
      "id": "BM-090-B04",
      "text": "Eine Archivierungssitzung wird geöffnet; eine Archivdatei entsteht nur im Echtlauf.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        },
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        }
      ]
    },
    {
      "id": "BM-090-B05",
      "text": "Je Protokoll werden Kopf und alle Positionen als ein Archivobjekt geschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        },
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        }
      ]
    },
    {
      "id": "BM-090-B06",
      "text": "Kann ein Archivobjekt nicht gesichert werden, bricht der Lauf mit der Protokoll-ID ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:66"
        },
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        },
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        }
      ]
    },
    {
      "id": "BM-090-B07",
      "text": "Zum Schluss wird die Archivdatei geschlossen und die Anzahl archivierter Protokolle mit dem Testkennzeichen ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 78,
          "token": null,
