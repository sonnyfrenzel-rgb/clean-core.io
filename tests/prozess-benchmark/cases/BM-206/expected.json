  "businessStatements": [
    {
      "id": "BM-206-B01",
      "text": "Die angegebene Referenzrechnung wird gelesen; fehlt sie oder ist sie storniert, bricht die Vorprüfung mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:83"
        },
        {
          "file": "source.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:84"
        },
        {
          "file": "source.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:85"
        }
      ]
    },
    {
      "id": "BM-206-B02",
      "text": "Die Retourenanfrage durchläuft eine Kette von Prüfungen in fester Reihenfolge: zuerst Rückgabefrist, dann Menge.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-206-B03",
      "text": "Die Rückgabe ist nur innerhalb von 30 Tagen nach dem Fakturadatum zulässig.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        }
      ]
    },
    {
      "id": "BM-206-B04",
      "text": "Die Rückgabemenge darf die für das Material auf der Rechnung fakturierte Menge nicht übersteigen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        },
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        }
      ]
    },
    {
      "id": "BM-206-B05",
      "text": "Schlägt eine Prüfung fehl, wird der Name der Prüfung als Ablehnungsgrund ausgegeben und die Kette abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        },
        {
          "file": "source.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:76"
        },
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        }
      ]
    },
    {
      "id": "BM-206-B06",
      "text": "Bestehen alle Prüfungen, wird gemeldet, dass die Retoure zulässig ist und ein Retourenauftrag angelegt werden kann.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:95"
        },
        {
          "file": "source.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:96"
        }
      ]
    }
  ],
