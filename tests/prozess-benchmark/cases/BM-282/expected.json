  "businessStatements": [
    {
      "id": "BM-282-B01",
      "text": "Hat der Prüfer noch nichts erfasst, wird das Erfassungsbild ohne Rückfrage verlassen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:10"
        },
        {
          "file": "source.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:11"
        }
      ]
    },
    {
      "id": "BM-282-B02",
      "text": "Sind Ergebnisse erfasst, wird der Prüfer in einem Bestätigungsdialog gefragt, ob er die Erfassung abbrechen und die Ergebnisse verwerfen will; voreingestellt ist „Nein“.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:14"
        }
      ]
    },
    {
      "id": "BM-282-B03",
      "text": "Bestätigt er mit „Ja“, wird ihm per Statusmeldung angezeigt, dass die Erfassung zum Prüflos verworfen wurde, und das Bild wird verlassen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        }
      ]
    },
    {
      "id": "BM-282-B04",
      "text": "Bei „Nein“ bleibt das Modul ohne Wirkung, nur der Funktionscode wird zurückgesetzt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 33,
