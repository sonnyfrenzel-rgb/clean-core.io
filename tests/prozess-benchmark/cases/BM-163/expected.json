  "businessStatements": [
    {
      "id": "BM-163-B01",
      "text": "Es werden die Handling Units gelesen, die der eingegebenen Auslieferung zugeordnet sind.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:12"
        }
      ]
    },
    {
      "id": "BM-163-B02",
      "text": "Zu diesen Handling Units werden die Packpositionen gelesen; hat die Lieferung keine Handling Unit, liest der Zugriff sämtliche Packpositionen des Systems.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-163-B03",
      "text": "Je Handling Unit werden externe HU-Nummer, Packmittel und Bruttogewicht ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        }
      ]
    },
    {
      "id": "BM-163-B04",
      "text": "Darunter werden nur die Materialpositionen der Handling Unit mit Material, Charge und verpackter Menge gelistet; untergeordnete Handling Units erscheinen nicht als Inhalt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
