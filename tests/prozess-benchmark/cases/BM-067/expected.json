  "businessStatements": [
    {
      "id": "BM-067-B01",
      "text": "Es werden Störmeldungen der Art M1 aus den gewählten Planungswerken selektiert, denen noch kein Auftrag zugeordnet ist.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        }
      ]
    },
    {
      "id": "BM-067-B02",
      "text": "Gibt es keine solche Meldung, wird ein Hinweis ausgegeben und der Lauf beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        },
        {
          "file": "source.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:53"
        },
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        }
      ]
    },
    {
      "id": "BM-067-B03",
      "text": "Meldungen ohne Equipment werden übersprungen und als übersprungen protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        }
      ]
    },
    {
      "id": "BM-067-B04",
      "text": "Für jede übrige Meldung wird eine Batch-Input-Mappe für IW31 mit Auftragsart PM01, Meldungsbezug, Planungswerk und Meldungskurztext als Auftragskurztext aufgebaut.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        },
        {
          "file": "source.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:91"
        }
      ]
    },
    {
      "id": "BM-067-B05",
      "text": "Die Auftragsanlage läuft über IW31 im gewählten Batch-Input-Modus mit synchroner Verbuchung; die Meldungen der Transaktion werden gesammelt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        }
      ]
    },
    {
      "id": "BM-067-B06",
      "text": "Enthalten die Meldungen eine Fehlermeldung, wird die Meldung mit dem Fehlertext protokolliert, sonst als verarbeitet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        },
        {
