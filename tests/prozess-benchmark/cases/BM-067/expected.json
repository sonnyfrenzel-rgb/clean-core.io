        },
        {
          "file": "source.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:81"
        }
      ]
    },
    {
      "id": "BM-067-B07",
      "text": "Am Ende werden Anzahl verarbeiteter und fehlerhafter Meldungen ausgegeben.",
