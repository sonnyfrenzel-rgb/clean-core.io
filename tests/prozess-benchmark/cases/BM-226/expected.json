  "businessStatements": [
    {
      "id": "BM-226-B01",
      "text": "Es werden die zum Stichtag gültigen organisatorischen Zuordnungen der Mitarbeiter in den gewählten Personalbereichen gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        }
      ]
    },
    {
      "id": "BM-226-B02",
      "text": "Für jeden Mitarbeiter werden die zum Stichtag gültigen Bankverbindungen gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-226-B03",
      "text": "Fehlt die Hauptbankverbindung, wird der Mitarbeiter mit dem Befund „Keine Hauptbankverbindung“ in die Prüfliste aufgenommen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:76"
        },
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        },
        {
          "file": "source.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:80"
        }
      ]
    },
    {
      "id": "BM-226-B04",
      "text": "Hat die Hauptbankverbindung keine IBAN, wird der Mitarbeiter mit Bankschlüssel und dem Befund „IBAN fehlt“ aufgenommen; sonst nicht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:83"
        },
        {
          "file": "source.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:85"
        }
      ]
    },
    {
      "id": "BM-226-B05",
      "text": "Gibt es keinen Befund, erscheint eine Erfolgsmeldung und der Report endet ohne Liste.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        },
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        },
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        }
      ]
    },
    {
      "id": "BM-226-B06",
      "text": "Die Befunde werden als ALV-Liste angezeigt; scheitert der Listenaufbau, wird der Fehler als Information gemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        },
