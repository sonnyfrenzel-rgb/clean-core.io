  "businessStatements": [
    {
      "id": "BM-008-B01",
      "text": "Existiert der Auftrag nicht, wird die Fehlermeldung 301 zurückgegeben und keine Lieferung angelegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    },
    {
      "id": "BM-008-B02",
      "text": "Hat der Auftrag eine Liefersperre, wird mit Meldung 302 und der Sperre abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        },
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        }
      ]
    },
    {
      "id": "BM-008-B03",
      "text": "Ist der Auftrag kreditgesperrt oder nur teilweise freigegeben (Kreditstatus B oder C), wird mit Meldung 303 abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        },
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        },
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        }
      ]
    },
    {
      "id": "BM-008-B04",
      "text": "Liefervorlage sind alle nicht abgesagten Positionen mit ihrer vollen Auftragsmenge; gibt es keine, endet der Baustein mit der Warnung 304.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:51"
        },
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        }
      ]
    },
    {
      "id": "BM-008-B05",
      "text": "Zu diesen Positionen wird für die Versandstelle und das Stichtagsdatum eine Auslieferung angelegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:63"
        }
      ]
    },
    {
      "id": "BM-008-B06",
      "text": "Enthält das Ergebnis eine Fehlermeldung oder ist Testlauf gesetzt, wird die Lieferanlage zurückgerollt und keine Lieferungsnummer zurückgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:75"
        },
        {
          "file": "source.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:76"
        },
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        }
      ]
    },
    {
      "id": "BM-008-B07",
      "text": "Sonst wird die Lieferung synchron festgeschrieben und ihre Nummer zurückgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:80"
        }
      ]
    }
  ],
