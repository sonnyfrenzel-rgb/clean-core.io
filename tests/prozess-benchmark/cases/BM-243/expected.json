  "businessStatements": [
    {
      "id": "BM-243-B01",
      "text": "Nach einer Änderung an Gewicht oder Route werden die Kopfdaten der betroffenen Sendungen gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    },
    {
      "id": "BM-243-B02",
      "text": "Sendungen ohne Route und bereits abgerechnete Sendungen werden nicht neu bewertet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        }
      ]
    },
    {
      "id": "BM-243-B03",
      "text": "Für jede übrige Sendung wird der am Tagesdatum gültige Kundentarif zu Route und Versandart gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:46"
        }
      ]
    },
    {
      "id": "BM-243-B04",
      "text": "Ohne gültigen Tarif erhält die Sendung die Warnung ZTM_SEND 021 und ihre Frachtkosten bleiben unverändert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:51"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        }
      ]
    },
    {
      "id": "BM-243-B05",
      "text": "Die Gewichtsfracht ergibt sich aus dem Tarifsatz je angefangene 100 kg Bruttogewicht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:66"
        }
      ]
    },
    {
      "id": "BM-243-B06",
      "text": "Liegt sie unter der Mindestfracht des Tarifs, wird die Mindestfracht angesetzt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:69"
        },
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        }
      ]
    },
    {
      "id": "BM-243-B07",
      "text": "Für Gefahrgutsendungen wird der prozentuale Gefahrgutzuschlag des Tarifs aufgeschlagen, nach der Mindestfrachtprüfung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:74"
        },
        {
          "file": "source.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:75"
        }
      ]
    },
    {
      "id": "BM-243-B08",
      "text": "Die Frachtkosten werden netto mit der Tarifwährung, ersatzweise EUR, in die Sendung zurückgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:84"
        }
      ]
    }
  ],
