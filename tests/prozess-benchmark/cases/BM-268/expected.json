  "businessStatements": [
    {
      "id": "BM-268-B01",
      "text": "Der Delta-Beginn ist das Datum des letzten Laufs dieser Schnittstelle; beim ersten Lauf werden Bestellungen ab gestern berücksichtigt.",
      "anchors": [
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 9,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:9"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:11"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:13"
        }
      ]
    },
    {
      "id": "BM-268-B02",
      "text": "Es werden nicht gelöschte Bestellungen der gewählten Bestellarten, Lieferanten und Einkaufsorganisationen selektiert, deren Anlagedatum ab dem Delta-Beginn liegt, samt ihren Positionen.",
      "anchors": [
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:21"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:27"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:28"
        }
      ]
    },
    {
      "id": "BM-268-B03",
      "text": "Ohne Bestellungen endet der Report mit einem Hinweis.",
      "anchors": [
        {
          "file": "zmm_po_idoc_out.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out.abap:12"
        },
        {
          "file": "zmm_po_idoc_out.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out.abap:13"
        },
        {
          "file": "zmm_po_idoc_out.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out.abap:14"
        }
      ]
    },
    {
      "id": "BM-268-B04",
      "text": "Für jede Bestellung wird geprüft, ob mit dem Lieferanten eine Ausgangs-Partnervereinbarung für ZPORDERS besteht; fehlt sie, wird die Bestellung mit „kein Partnerprofil“ ins Ergebnis übernommen und nicht gesendet.",
      "anchors": [
        {
          "file": "zmm_po_idoc_out.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out.abap:18"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:40"
        },
        {
          "file": "zmm_po_idoc_out.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out.abap:19"
        },
        {
          "file": "zmm_po_idoc_out.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out.abap:22"
        }
      ]
    },
    {
      "id": "BM-268-B05",
      "text": "Zur Bestellung wird ein IDoc mit Kopfsegment (Nummer, Belegdatum, Währung, Einkäufergruppe) und je nicht gelöschter Position einem Positionssegment (Material, Menge, Einheit, Nettopreis) aufgebaut.",
      "anchors": [
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:79"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:81"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:85"
        }
      ]
    },
    {
      "id": "BM-268-B06",
      "text": "Im Testlauf wird nichts gesendet; die Bestellung erscheint mit „Testlauf - nicht gesendet“ im Ergebnis.",
      "anchors": [
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:93"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:94"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:96"
        }
      ]
    },
    {
      "id": "BM-268-B07",
      "text": "Im Echtlauf wird das Bestell-IDoc an den Lieferanten erzeugt; schlägt das fehl, wird zurückgerollt und „Fehler beim Erzeugen“ vermerkt, sonst festgeschrieben und die IDoc-Nummer vermerkt.",
      "anchors": [
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:99"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:111"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:112"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:115"
        }
      ]
    },
    {
      "id": "BM-268-B08",
      "text": "Im Echtlauf wird nach dem Durchlauf das heutige Datum als letzter Lauf gespeichert, unabhängig davon, ob einzelne Bestellungen gescheitert sind.",
      "anchors": [
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 129,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:129"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 132,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:132"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 133,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:133"
        }
      ]
    },
    {
      "id": "BM-268-B09",
      "text": "Zum Schluss wird das Ergebnis je Bestellung als ALV-Liste angezeigt; gelingt das nicht, erscheint ein Hinweis.",
      "anchors": [
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 143,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:143"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 146,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:146"
        },
        {
          "file": "zmm_po_idoc_out_f01.abap",
          "line": 148,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_po_idoc_out_f01.abap:148"
        }
      ]
    }
  ],
