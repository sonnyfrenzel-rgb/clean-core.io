  "businessStatements": [
    {
      "id": "BM-154-B01",
      "text": "Es werden alle zur Genehmigung eingereichten Reisen mit ihrem Datum gelesen und für sie die Summe der erfassten Belege gebildet.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 6,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:6"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:14"
        }
      ]
    },
    {
      "id": "BM-154-B02",
      "text": "Je Reise werden die Tage seit dem Reisedatum und der Belegbetrag festgehalten; eine Reise ohne Beleg erhält den Betrag null.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:23"
        }
      ]
    },
    {
      "id": "BM-154-B03",
      "text": "Liegt keine Reise in Genehmigung, endet der Lauf mit einem Hinweis.",
      "anchors": [
        {
          "file": "ztv_approval_monitor.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor.abap:33"
        },
        {
          "file": "ztv_approval_monitor.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor.abap:34"
        },
        {
          "file": "ztv_approval_monitor.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor.abap:35"
        }
      ]
    },
    {
      "id": "BM-154-B04",
      "text": "Als Genehmiger gilt der Leiter der heutigen Organisationseinheit des Reisenden; Reisen ohne Organisationszuordnung werden gekennzeichnet und nicht weiter bearbeitet.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:38"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:48"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:52"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:67"
        }
      ]
    },
    {
      "id": "BM-154-B05",
      "text": "Ist der Reisende selbst der Leiter, wird statt eines echten Genehmigers die Platzhalter-Personalnummer 99999999 eingetragen.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:55"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:56"
        }
      ]
    },
    {
      "id": "BM-154-B06",
      "text": "Die unbearbeiteten Reisen werden je Genehmiger gemeinsam betrachtet.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:89"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:93"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:94"
        }
      ]
    },
    {
      "id": "BM-154-B07",
      "text": "Eine Reise bis zum Kleinbetragsgrenzwert, die mindestens die Frist für automatische Genehmigung wartet, wird automatisch genehmigt – auch wenn sie schon eskalationsreif wäre.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:95"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:96"
        }
      ]
    },
    {
      "id": "BM-154-B08",
      "text": "Im Testlauf wird die automatische Genehmigung nur vermerkt; im Echtlauf wird die Reise genehmigt und bei Fehlermeldung zurückgerollt und als Fehler markiert, sonst festgeschrieben.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:114"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 118,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:118"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 124,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:124"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 125,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:125"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 128,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:128"
        }
      ]
    },
    {
      "id": "BM-154-B09",
      "text": "Andere Reisen, die die Eskalationsfrist erreicht haben, werden zur Eskalation vorgemerkt, solche über der Erinnerungsfrist zur Erinnerung.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:97"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:100"
        }
      ]
    },
    {
      "id": "BM-154-B10",
      "text": "Hat ein bekannter Genehmiger Reisen zur Erinnerung, erhält er eine Sammelmail mit allen diesen Reisen.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:105"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 106,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:106"
        }
      ]
    },
    {
      "id": "BM-154-B11",
      "text": "Für jeden Genehmiger mit eskalierten Reisen wird dessen eigener Vorgesetzter ermittelt und erhält eine Eskalationsmail; ohne Zuordnung oder ohne anderen Vorgesetzten entfällt die Eskalation.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 140,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:140"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 142,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:142"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 155,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:155"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 156,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:156"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 159,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:159"
        }
      ]
    },
    {
      "id": "BM-154-B12",
      "text": "Mails werden nur im Echtlauf und nur an Empfänger mit hinterlegter Mailadresse versendet und je Mail festgeschrieben; ein Sendefehler wird nur gemeldet.",
      "anchors": [
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 172,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:172"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 173,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:173"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 178,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:178"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 191,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:191"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 192,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:192"
        },
        {
          "file": "ztv_approval_monitor_f01.abap",
          "line": 194,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor_f01.abap:194"
        }
      ]
    },
    {
      "id": "BM-154-B13",
      "text": "Zum Schluss werden alle Reisen mit Wartetagen, Betrag, Genehmiger und ergriffener Aktion als Liste angezeigt.",
      "anchors": [
        {
          "file": "ztv_approval_monitor.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "ztv_approval_monitor.abap:40"
        },
        {
