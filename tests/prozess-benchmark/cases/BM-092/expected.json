  "businessStatements": [
    {
      "id": "BM-092-B01",
      "text": "Es werden alle neuen Webshop-Registrierungen des gewählten Erfassungszeitraums gelesen; gibt es keine, endet der Lauf mit einer Meldung.",
      "anchors": [
        {
          "file": "zsd_webshop_cust.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:51"
        },
        {
          "file": "zsd_webshop_cust.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:54"
        },
        {
          "file": "zsd_webshop_cust.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:55"
        },
        {
          "file": "zsd_webshop_cust.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:56"
        }
      ]
    },
    {
      "id": "BM-092-B02",
      "text": "Für jede Registrierung wird zuerst ein nicht gelöschter Kunde mit gleichem Namen als Suchbegriff, gleicher Postleitzahl und gleichem Land gesucht.",
      "anchors": [
        {
          "file": "zsd_webshop_cust_f01.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust_f01.abap:16"
        }
      ]
    },
    {
      "id": "BM-092-B03",
      "text": "Ohne Treffer und mit angegebener E-Mail-Adresse wird ein nicht gelöschter Kunde mit derselben E-Mail-Adresse gesucht.",
      "anchors": [
        {
          "file": "zsd_webshop_cust_f01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust_f01.abap:25"
        },
        {
          "file": "zsd_webshop_cust_f01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust_f01.abap:26"
        }
      ]
    },
    {
      "id": "BM-092-B04",
      "text": "Wird ein vorhandener Kunde gefunden, wird die Registrierung als Dublette mit dessen Kundennummer markiert und nicht angelegt.",
      "anchors": [
        {
          "file": "zsd_webshop_cust.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:62"
        },
        {
          "file": "zsd_webshop_cust.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:63"
        },
        {
          "file": "zsd_webshop_cust.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:67"
        }
      ]
    },
    {
      "id": "BM-092-B05",
      "text": "Sonst wird eine Batch-Input-Mappe mit Kontengruppe, Buchungskreis, Vertriebsbereich, Adresse, E-Mail, Umsatzsteuer-Id, Abstimmkonto, Zahlungsbedingung Vorkasse, Währung EUR und Steuerklassifikation aufgebaut.",
      "anchors": [
        {
          "file": "zsd_webshop_cust.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:71"
        },
        {
          "file": "zsd_webshop_cust_f01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust_f01.abap:40"
        }
      ]
    },
    {
      "id": "BM-092-B06",
      "text": "Mit dieser Mappe wird der Debitor über die Transaktion XD01 angelegt.",
      "anchors": [
        {
          "file": "zsd_webshop_cust.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:73"
        }
      ]
    },
    {
      "id": "BM-092-B07",
      "text": "Bei Erfolg wird die neue Kundennummer aus der Anlagemeldung übernommen und die Registrierung als angelegt markiert.",
      "anchors": [
        {
          "file": "zsd_webshop_cust.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:77"
        },
        {
          "file": "zsd_webshop_cust.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:79"
        },
        {
          "file": "zsd_webshop_cust.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:82"
        }
      ]
    },
    {
      "id": "BM-092-B08",
      "text": "Bei Misserfolg wird die erste Fehlermeldung – ersatzweise die letzte Meldung – als Text ermittelt und die Registrierung mit diesem Text als fehlerhaft markiert.",
      "anchors": [
        {
          "file": "zsd_webshop_cust.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:87"
        },
        {
          "file": "zsd_webshop_cust_f01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust_f01.abap:88"
        },
        {
          "file": "zsd_webshop_cust_f01.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust_f01.abap:92"
        },
        {
          "file": "zsd_webshop_cust.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:88"
        }
      ]
    },
    {
      "id": "BM-092-B09",
      "text": "Der Status jeder Registrierung wird einzeln festgeschrieben.",
      "anchors": [
        {
          "file": "zsd_webshop_cust.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:93"
        }
      ]
    },
    {
      "id": "BM-092-B10",
      "text": "Zum Schluss werden die Anzahlen angelegter Kunden, Dubletten und Fehler ausgegeben.",
      "anchors": [
        {
          "file": "zsd_webshop_cust.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_webshop_cust.abap:96"
        }
      ]
    }
  ],
