  "businessStatements": [
    {
      "id": "BM-150-B01",
      "text": "Für den Antragsteller wird der Personalbereich und -teilbereich zum Antragsbeginn ermittelt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-150-B02",
      "text": "Fällt ein Erholungsurlaub in eine für den Teilbereich hinterlegte Urlaubssperre, wird der Antrag abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        },
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        },
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        }
      ]
    },
    {
      "id": "BM-150-B03",
      "text": "Überschneidet sich der Antrag mit einer bereits erfassten, nicht gesperrten Abwesenheit, wird er abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        },
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        },
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        }
      ]
    },
    {
      "id": "BM-150-B04",
      "text": "Die Antragsdauer wird in Kalendertagen einschließlich Beginn und Ende gezählt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:49"
        }
      ]
    },
    {
      "id": "BM-150-B05",
      "text": "Bei Erholungsurlaub wird der Restanspruch aus den noch nicht abgelaufenen Kontingenten 01 und 02 gebildet; übersteigt die Dauer den Rest, wird der Antrag abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        },
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        },
        {
          "file": "source.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:63"
        }
      ]
    },
    {
      "id": "BM-150-B06",
      "text": "Krankheitsarten dürfen nicht über ESS beantragt werden und werden abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:66"
        },
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        }
      ]
    },
    {
      "id": "BM-150-B07",
      "text": "Andere Abwesenheitsarten werden ohne Kontingentprüfung durchgelassen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        }
      ]
    },
    {
      "id": "BM-150-B08",
      "text": "Dauert der zulässige Antrag mehr als zehn Tage, erhält der Genehmiger einen Hinweis.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:75"
        }
      ]
    }
  ],
