  "businessStatements": [
    {
      "id": "BM-096-B01",
      "text": "Jedes IDoc des Pakets wird nur mit dem Nachrichtentyp ZMATMAS verarbeitet; ein anderer Typ bricht den Baustein ab.",
      "anchors": [
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:32"
        },
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:33"
        }
      ]
    },
    {
      "id": "BM-096-B02",
      "text": "Die Segmente des IDocs werden in die Daten für die Materialpflege übertragen; unbekannte Segmente werden ignoriert.",
      "anchors": [
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:37"
        },
        {
          "file": "lzmatmas_inf01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf01.abap:26"
        },
        {
          "file": "lzmatmas_inf01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf01.abap:27"
        }
      ]
    },
    {
      "id": "BM-096-B03",
      "text": "Aus dem Kopfsegment werden die ins interne Format gewandelte Materialnummer, Branche und Materialart sowie Warengruppe, Basismengeneinheit, alte Materialnummer, Nettogewicht mit Einheit und Produkthierarchie übernommen.",
      "anchors": [
        {
          "file": "lzmatmas_inf01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf01.abap:31"
        },
        {
          "file": "lzmatmas_inf01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf01.abap:39"
        },
        {
          "file": "lzmatmas_inf01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf01.abap:42"
        }
      ]
    },
    {
      "id": "BM-096-B04",
      "text": "Kurztexte werden je Sprache übernommen.",
      "anchors": [
        {
          "file": "lzmatmas_inf01.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf01.abap:52"
        }
      ]
    },
    {
      "id": "BM-096-B05",
      "text": "Je Werkssegment werden Dispomerkmal, Disponent, Einkäufergruppe, Beschaffungsart und Profit-Center übernommen.",
      "anchors": [
        {
          "file": "lzmatmas_inf01.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf01.abap:59"
        }
      ]
    },
    {
      "id": "BM-096-B06",
      "text": "Alternative Mengeneinheiten werden mit Zähler und Nenner der Umrechnung übernommen.",
      "anchors": [
        {
          "file": "lzmatmas_inf01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf01.abap:69"
        }
      ]
    },
    {
      "id": "BM-096-B07",
      "text": "Die Kundenfelder Designverantwortung und RoHS-Kennzeichen werden als Erweiterung übergeben.",
      "anchors": [
        {
          "file": "lzmatmas_inf01.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf01.abap:81"
        }
      ]
    },
    {
      "id": "BM-096-B08",
      "text": "Ist für das Material bereits ein jüngeres IDoc verbucht (später erstellt nach Datum und Uhrzeit), wird dieses IDoc mit Status 68 und Warnung übersprungen.",
      "anchors": [
        {
          "file": "lzmatmas_inf02.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:16"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:22"
        },
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:42"
        },
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:43"
        }
      ]
    },
    {
      "id": "BM-096-B09",
      "text": "Fehlt die Materialnummer, ist das IDoc fehlerhaft (Meldung 001).",
      "anchors": [
        {
          "file": "lzmatmas_inf02.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:37"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:38"
        }
      ]
    },
    {
      "id": "BM-096-B10",
      "text": "Ist die Materialart nicht definiert, ist das IDoc fehlerhaft (Meldung 002).",
      "anchors": [
        {
          "file": "lzmatmas_inf02.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:43"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:46"
        }
      ]
    },
    {
      "id": "BM-096-B11",
      "text": "Ist eines der gelieferten Werke nicht definiert, ist das IDoc fehlerhaft (Meldung 003 mit Werk und Material).",
      "anchors": [
        {
          "file": "lzmatmas_inf02.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:52"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:55"
        }
      ]
    },
    {
      "id": "BM-096-B12",
      "text": "Nur ein fehlerfrei geprüftes IDoc wird verbucht.",
      "anchors": [
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:49"
        },
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:50"
        }
      ]
    },
    {
      "id": "BM-096-B13",
      "text": "Vor der Verbuchung wird das Material gesperrt; ist es gesperrt, ist das IDoc fehlerhaft (Meldung 004 mit dem sperrenden Benutzer).",
      "anchors": [
        {
          "file": "lzmatmas_inf02.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:75"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:82"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:83"
        }
      ]
    },
    {
      "id": "BM-096-B14",
      "text": "Zuerst werden Mandantendaten, Kurztexte, Mengeneinheiten und Kundenfelder angelegt oder geändert; ein Fehler dabei macht das IDoc fehlerhaft (Meldung 005).",
      "anchors": [
        {
          "file": "lzmatmas_inf02.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:88"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:101"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:102"
        }
      ]
    },
    {
      "id": "BM-096-B15",
      "text": "Danach werden je Werk die Werksdaten mit Disposition- und Einkaufssicht gepflegt; beim ersten fehlerhaften Werk wird abgebrochen (Meldung 006).",
      "anchors": [
        {
          "file": "lzmatmas_inf02.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:105"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 116,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:116"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 123,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:123"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 124,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:124"
        }
      ]
    },
    {
      "id": "BM-096-B16",
      "text": "Sind alle Aufrufe fehlerfrei, wird die Materialpflege festgeschrieben, sonst vollständig verworfen; danach wird die Sperre freigegeben.",
      "anchors": [
        {
          "file": "lzmatmas_inf02.abap",
          "line": 131,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:131"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 132,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:132"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 136,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:136"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 139,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:139"
        }
      ]
    },
    {
      "id": "BM-096-B17",
      "text": "Nach erfolgreicher Verbuchung werden IDoc-Nummer und Erstellzeitpunkt als letzter Stand des Materials gespeichert und das IDoc erhält Status 53 mit der Materialnummer.",
      "anchors": [
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:54"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 154,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:154"
        },
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:55"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 170,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:170"
        }
      ]
    },
    {
      "id": "BM-096-B18",
      "text": "Ein fehlerhaftes IDoc erhält Status 51 mit der vermerkten Fehlermeldung, und das Workflow-Ergebnis meldet einen Fehler.",
      "anchors": [
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:59"
        },
        {
          "file": "lzmatmas_inf02.abap",
          "line": 178,
          "token": null,
          "expressionPath": null,
          "raw": "lzmatmas_inf02.abap:178"
        },
        {
          "file": "z_idoc_input_zmatmas.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zmatmas.abap:61"
        }
      ]
    }
