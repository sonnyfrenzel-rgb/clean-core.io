  "businessStatements": [
    {
      "id": "BM-033-B01",
      "text": "Der Baustein verarbeitet nur Wareneingangsmeldungen des Nachrichtentyps ZWEGR; wird er für einen anderen Typ gerufen, bricht er mit Ausnahme ab.",
      "anchors": [
        {
          "file": "z_idoc_input_zwegr.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zwegr.abap:33"
        },
        {
          "file": "z_idoc_input_zwegr.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zwegr.abap:34"
        }
      ]
    },
    {
      "id": "BM-033-B02",
      "text": "Jedes IDoc des Pakets wird einzeln verarbeitet.",
      "anchors": [
        {
          "file": "z_idoc_input_zwegr.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zwegr.abap:37"
        }
      ]
    },
    {
      "id": "BM-033-B03",
      "text": "Aus dem Kopfsegment werden Lieferschein, Bestellnummer und Buchungs- und Belegdatum übernommen, aus den Positionssegmenten Bestellposition, Menge, Charge und Lagerort; unbekannte Segmente werden ignoriert.",
      "anchors": [
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:14"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:16"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:18"
        }
      ]
    },
    {
      "id": "BM-033-B04",
      "text": "Fehlen Bestellnummer oder Positionen, ist das IDoc fehlerhaft.",
      "anchors": [
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:25"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:26"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:27"
        }
      ]
    },
    {
      "id": "BM-033-B05",
      "text": "Die Bestellung muss existieren und darf nicht gelöscht sein; ihr Lieferant wird für die weitere Verarbeitung übernommen.",
      "anchors": [
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:39"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:41"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:46"
        }
      ]
    },
    {
      "id": "BM-033-B06",
      "text": "Jede gemeldete Position muss als Bestellposition existieren, darf nicht gelöscht und nicht endgeliefert sein; die erste nicht offene Position macht das IDoc fehlerhaft.",
      "anchors": [
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:49"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:52"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:55"
        }
      ]
    },
    {
      "id": "BM-033-B07",
      "text": "Wurde der Lieferschein dieses Lieferanten bereits gebucht, wird das IDoc als Dublette mit dem früheren Materialbeleg abgelehnt.",
      "anchors": [
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:64"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:67"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:68"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:69"
        }
      ]
    },
    {
      "id": "BM-033-B08",
      "text": "Sonst wird ein Wareneingang zur Bestellung (Bewegungsart 101) mit Lieferschein als Referenz und je Position Menge, Charge und Lagerort gebucht.",
      "anchors": [
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:87"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:95"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:105"
        }
      ]
    },
    {
      "id": "BM-033-B09",
      "text": "Meldet die Buchung einen Fehler oder entsteht kein Materialbeleg, wird zurückgerollt und der Fehlertext übernommen.",
      "anchors": [
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:117"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 118,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:118"
        }
      ]
    },
    {
      "id": "BM-033-B10",
      "text": "Ein fehlerhaftes IDoc erhält Status 51 mit dem Fehlertext und wird dem Workflow als Fehler-IDoc gemeldet.",
      "anchors": [
        {
          "file": "z_idoc_input_zwegr.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zwegr.abap:58"
        },
        {
          "file": "z_idoc_input_zwegr.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zwegr.abap:59"
        },
        {
          "file": "z_idoc_input_zwegr.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zwegr.abap:61"
        }
      ]
    },
    {
      "id": "BM-033-B11",
      "text": "Ein erfolgreich gebuchtes IDoc registriert Lieferschein, Lieferant, Materialbeleg und IDoc-Nummer für die Dublettenprüfung und erhält Status 53 mit der Materialbelegnummer.",
      "anchors": [
        {
          "file": "z_idoc_input_zwegr.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zwegr.abap:66"
        },
        {
          "file": "z_idoc_input_zwegr.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zwegr.abap:73"
        },
        {
          "file": "lz_idoc_zwegr_f01.abap",
          "line": 131,
          "token": null,
          "expressionPath": null,
          "raw": "lz_idoc_zwegr_f01.abap:131"
        }
      ]
    }
  ],
