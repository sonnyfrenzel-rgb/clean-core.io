  "businessStatements": [
    {
      "id": "BM-029-B01",
      "text": "Der Verfallsstichtag ist das Tagesdatum plus der eingegebenen Vorlaufzeit in Tagen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        }
      ]
    },
    {
      "id": "BM-029-B02",
      "text": "Es werden Chargen in den gewählten Werken und Lagerorten mit frei verwendbarem Bestand gelesen, deren Mindesthaltbarkeits- bzw. Verfallsdatum gepflegt ist und spätestens am Stichtag liegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        }
      ]
    },
    {
      "id": "BM-029-B03",
      "text": "Gibt es keine, wird „Keine Chargen mit Verfall“ ausgegeben und der Lauf beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        }
      ]
    },
    {
      "id": "BM-029-B04",
      "text": "Nur wenn Buchen angekreuzt ist, wird je Charge der gesamte frei verwendbare Chargenbestand mit Bewegungsart 344 in den gesperrten Bestand umgebucht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        },
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        },
        {
          "file": "source.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:71"
        }
      ]
    },
    {
      "id": "BM-029-B05",
      "text": "Entsteht kein Materialbeleg, wird zurückgerollt und die erste Rückmeldung als Ergebnistext zur Charge vermerkt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:80"
        },
        {
          "file": "source.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:81"
        },
        {
          "file": "source.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:83"
        }
      ]
    },
    {
      "id": "BM-029-B06",
      "text": "Entsteht ein Materialbeleg, wird er je Charge sofort festgeschrieben und die Charge als in den Sperrbestand umgebucht markiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:86"
        },
        {
          "file": "source.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:85"
        }
      ]
    },
    {
      "id": "BM-029-B07",
      "text": "Am Ende wird die Liste der betroffenen Chargen mit Verfallsdatum, Bestand, Materialbeleg und Ergebnis als ALV angezeigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:93"
        }
      ]
    }
  ],
