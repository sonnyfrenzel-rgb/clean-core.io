        }
      ]
    },
    {
      "id": "BM-204-B04",
      "text": "Eine chargenpflichtige Position ohne Charge verhindert das Sichern.",
      "anchors": [
        {
          "file": "zcl_sd_deliv_gi_check.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_deliv_gi_check.abap:40"
        },
        {
