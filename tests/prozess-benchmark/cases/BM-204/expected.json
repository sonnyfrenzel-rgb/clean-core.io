          "raw": "zcl_sd_deliv_gi_check.abap:25"
        }
      ]
    },
    {
      "id": "BM-204-B03",
      "text": "Für jede nicht gelöschte Lieferposition wird der Kommissionierstatus gelesen; eine noch nicht kommissionierte Position verhindert das Sichern.",
