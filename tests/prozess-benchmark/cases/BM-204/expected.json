  "businessStatements": [
    {
      "id": "BM-204-B01",
      "text": "Die Prüfung greift nur beim Ändern einer Auslieferung; andere Belegtypen und das Anlegen werden durchgelassen.",
      "anchors": [
        {
          "file": "mv50afz1_save_prepare.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "mv50afz1_save_prepare.abap:10"
        },
        {
          "file": "mv50afz1_save_prepare.abap",
          "line": 11,
