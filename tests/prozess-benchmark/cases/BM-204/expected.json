        }
      ]
    },
    {
      "id": "BM-204-B05",
      "text": "Liegt der Warenempfänger außerhalb Deutschlands und ist keine Route gepflegt, wird das Sichern verhindert.",
      "anchors": [
        {
          "file": "zcl_sd_deliv_gi_check.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
