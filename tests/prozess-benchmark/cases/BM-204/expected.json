          "expressionPath": null,
          "raw": "mv50afz1_save_prepare.abap:11"
        }
      ]
    },
    {
      "id": "BM-204-B02",
      "text": "Ist der Warenausgang bereits gebucht, wird nicht mehr geprüft.",
      "anchors": [
        {
          "file": "zcl_sd_deliv_gi_check.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_deliv_gi_check.abap:24"
        },
