  "businessStatements": [
    {
      "id": "BM-283-B01",
      "text": "Beim Scannen des Von-Platzes wird der Lagerplatz in der Lagernummer nachgelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        }
      ]
    },
    {
      "id": "BM-283-B02",
      "text": "Ist der Platz unbekannt oder für Auslagerungen gesperrt, bricht eine Fehlermeldung die Eingabe ab und der Von-Platz muss neu gescannt werden.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        },
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        }
      ]
    },
    {
      "id": "BM-283-B03",
      "text": "Mit F3 oder Zurück kehrt der Staplerfahrer zum Einstiegsbild 0100 zurück.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        },
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        }
      ]
    },
    {
      "id": "BM-283-B04",
      "text": "Beim Bestätigen wird der Quantbestand des Materials auf dem Von-Platz aufsummiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        }
      ]
    },
    {
      "id": "BM-283-B05",
      "text": "Übersteigt die Umlagermenge diesen Bestand, erhält der Fahrer nur eine Warnung mit dem Bestand; bestätigt er sie, geht die Buchung weiter.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        }
      ]
    },
    {
      "id": "BM-283-B06",
      "text": "Anschließend wird ein Transportauftrag mit Bewegungsart 999 vom Von-Platz zum Nach-Platz angelegt, sofort quittiert und vom Baustein selbst festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:53"
        }
      ]
    },
    {
      "id": "BM-283-B07",
      "text": "Scheitert die Anlage, wird die Meldung des Bausteins als Fehlermeldung ausgegeben und der Fahrer bleibt auf dem Bild.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:75"
        },
        {
          "file": "source.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:76"
        }
      ]
    },
    {
      "id": "BM-283-B08",
      "text": "Bei Erfolg wird die Transportauftragsnummer als Statusmeldung angezeigt, die Eingaben werden geleert und das Umlagerbild für den nächsten Scan neu aufgerufen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:80"
        },
        {
          "file": "source.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:82"
        }
      ]
    }
  ],
