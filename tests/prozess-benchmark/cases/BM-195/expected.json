  "businessStatements": [
    {
      "id": "BM-195-B01",
      "text": "Beim Sichern eines Kundenauftrags wird geprüft, ob die Embargoprüfung über den Schalter ZFT_EMBARGO_AKTIV eingeschaltet ist.",
      "anchors": [
        {
          "file": "zei_ft_export_check.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:20"
        }
      ]
    },
    {
      "id": "BM-195-B02",
      "text": "Geprüft werden nur Terminaufträge und Kontrakte beim Anlegen oder Ändern.",
      "anchors": [
        {
          "file": "zei_ft_export_check.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:26"
        }
      ]
    },
    {
      "id": "BM-195-B03",
      "text": "Das Empfangsland ist das Land des Warenempfängers auf Kopfebene, ohne Warenempfänger das Land des Auftraggebers.",
      "anchors": [
        {
          "file": "zei_ft_export_check.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:30"
        },
        {
          "file": "zei_ft_export_check.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:33"
        }
      ]
    },
    {
      "id": "BM-195-B04",
      "text": "Lieferungen nach Deutschland und in EU-Mitgliedstaaten werden nicht geprüft.",
      "anchors": [
        {
          "file": "zei_ft_export_check.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:37"
        },
        {
          "file": "zei_ft_export_check.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:44"
        }
      ]
    },
    {
      "id": "BM-195-B05",
      "text": "Für alle anderen Länder wird die zum Empfangsland passende Embargoprüfung ermittelt und mit Auftragskopf und Positionen aufgerufen.",
      "anchors": [
        {
          "file": "zei_ft_export_check.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:47"
        },
        {
          "file": "zei_ft_export_check.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:51"
        }
      ]
    },
    {
      "id": "BM-195-B06",
      "text": "Gibt es für das Land keine aktive Prüfung, wird der Auftrag ungeprüft und ohne Sperre gesichert.",
      "anchors": [
        {
          "file": "zei_ft_export_check.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:61"
        },
        {
          "file": "zei_ft_export_check.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:64"
        }
      ]
    },
    {
      "id": "BM-195-B07",
      "text": "Meldet die Prüfung ein Totalembargo, wird das Sichern mit Abbruchmeldung beendet und der Auftrag nicht gesichert.",
      "anchors": [
        {
          "file": "zei_ft_export_check.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:68"
        },
        {
          "file": "zei_ft_export_check.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:70"
        },
        {
          "file": "zei_ft_export_check.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:71"
        }
      ]
    },
    {
      "id": "BM-195-B08",
      "text": "Verlangt die Prüfung eine Sperre, erhält der Auftrag die Liefersperre Z1 „Exportkontrolle“.",
      "anchors": [
        {
          "file": "zei_ft_export_check.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:74"
        },
        {
          "file": "zei_ft_export_check.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:76"
        }
      ]
    },
    {
      "id": "BM-195-B09",
      "text": "Die Sperre wird mit Auftrag, Land, Zeitpunkt, Benutzer und Anzahl der Prüfbefunde im Embargoprotokoll festgehalten, und der Benutzer erhält einen Hinweis.",
      "anchors": [
        {
          "file": "zei_ft_export_check.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:87"
        },
        {
          "file": "zei_ft_export_check.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "zei_ft_export_check.abap:89"
        }
      ]
    },
    {
      "id": "BM-195-B10",
      "text": "Für Russland und Belarus werden die am Tag gültigen sanktionierten Warennummern-Muster des Landes gelesen; ohne Einträge gibt es keine Sperre.",
      "anchors": [
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:36"
        },
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:41"
        },
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:42"
        }
      ]
    },
    {
      "id": "BM-195-B11",
      "text": "Zu den Positionen werden die Warennummern aus den Werksdaten der Materialien gelesen.",
      "anchors": [
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:45"
        }
      ]
    },
    {
      "id": "BM-195-B12",
      "text": "Geprüft werden alle nicht gelöschten Positionen ohne Absagegrund.",
      "anchors": [
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:52"
        },
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:54"
        }
      ]
    },
    {
      "id": "BM-195-B13",
      "text": "Hat das Material im Lieferwerk keine Warennummer, wird der Auftrag vorsorglich gesperrt und die Position als Warnung gemeldet.",
      "anchors": [
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:59"
        },
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:61"
        }
      ]
    },
    {
      "id": "BM-195-B14",
      "text": "Passt die Warennummer einer Position auf ein Sanktionsmuster, wird der Auftrag gesperrt; bei Sanktionsart Totalembargo wird die Position als Abbruch gemeldet, sonst als Warnung, und das erste passende Muster genügt.",
      "anchors": [
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:68"
        },
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:69"
        },
        {
          "file": "zcl_ft_embargo_ru.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_ru.abap:70"
        }
      ]
    },
    {
      "id": "BM-195-B15",
      "text": "Für die übrigen Länder wird die am Tag gültige Embargoart des Landes aus der Embargo-Länderliste gelesen; ein Land ohne Eintrag bleibt ungesperrt.",
      "anchors": [
        {
          "file": "zcl_ft_embargo_default.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_default.abap:25"
        },
        {
          "file": "zcl_ft_embargo_default.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_default.abap:29"
        },
        {
          "file": "zcl_ft_embargo_default.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_default.abap:30"
        }
      ]
    },
    {
      "id": "BM-195-B16",
      "text": "Bei Totalembargo wird der Auftrag gesperrt und mit einer Abbruchmeldung für das Land versehen.",
      "anchors": [
        {
          "file": "zcl_ft_embargo_default.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_default.abap:34"
        },
        {
          "file": "zcl_ft_embargo_default.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_default.abap:36"
        }
      ]
    },
    {
      "id": "BM-195-B17",
      "text": "Bei Waffenembargo wird der Auftrag nur gesperrt, wenn eine nicht gelöschte Position ein als Rüstungsgut gekennzeichnetes Material enthält, und jede solche Position wird als Warnung gemeldet.",
      "anchors": [
        {
          "file": "zcl_ft_embargo_default.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_default.abap:40"
        },
        {
          "file": "zcl_ft_embargo_default.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_default.abap:43"
        },
        {
          "file": "zcl_ft_embargo_default.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_default.abap:46"
        }
      ]
    },
    {
      "id": "BM-195-B18",
      "text": "Andere Embargoarten wie „Beobachtung“ haben keine Wirkung.",
      "anchors": [
        {
          "file": "zcl_ft_embargo_default.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ft_embargo_default.abap:53"
        }
      ]
    }
  ],
