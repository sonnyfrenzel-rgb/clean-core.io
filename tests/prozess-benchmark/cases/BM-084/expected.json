          "raw": "source.abap:15"
        }
      ]
    },
    {
      "id": "BM-084-B03",
      "text": "Sonst wird für den Kreditor das Workflow-Ereignis BANKCHANGED ausgelöst.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:19"
        }
      ]
    },
    {
      "id": "BM-084-B04",
      "text": "Kann das Ereignis nicht erzeugt werden, erscheint eine Warnung mit der Kreditornummer; das Sichern wird nicht verhindert.",
