          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:12"
        }
      ]
    },
    {
      "id": "BM-084-B02",
      "text": "Hat der Kreditor noch keine gespeicherte Bankverbindung, wird kein Workflow angestoßen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:14"
