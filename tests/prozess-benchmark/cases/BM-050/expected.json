  "businessStatements": [
    {
      "id": "BM-050-B01",
      "text": "Es werden die Innenaufträge (Auftragstyp 01) der gewählten Auftragsarten und Auftragsnummern im Buchungskreis gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        }
      ]
    },
    {
      "id": "BM-050-B02",
      "text": "Werden keine Aufträge gefunden, wird das gemeldet und der Report endet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        },
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        },
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        }
      ]
    },
    {
      "id": "BM-050-B03",
      "text": "Nur Aufträge mit dem Systemstatus „freigegeben“ werden abgerechnet; alle anderen werden als übersprungen gemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        },
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        }
      ]
    },
    {
      "id": "BM-050-B04",
      "text": "Jeder freigegebene Auftrag wird für Periode und Geschäftsjahr über die Einzelabrechnung KO88 abgerechnet; der Testlauf-Schalter wird an die Transaktion durchgereicht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:69"
        }
      ]
    },
    {
      "id": "BM-050-B05",
      "text": "Enthält die Rückmeldung der Transaktion eine Fehlermeldung, wird der Auftrag mit der Meldung als Fehler protokolliert, sonst als abgerechnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:74"
        },
        {
          "file": "source.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:75"
        },
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        },
        {
          "file": "source.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:80"
        }
      ]
    },
    {
      "id": "BM-050-B06",
      "text": "Zum Schluss werden die Anzahl abgerechneter und fehlerhafter Aufträge sowie das Testlauf-Kennzeichen ausgegeben.",
