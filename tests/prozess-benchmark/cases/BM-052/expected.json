  "businessStatements": [
    {
      "id": "BM-052-B01",
      "text": "Die Kontoauszugsdatei der Hausbank wird vom Applikationsserver gelesen; ist sie nicht lesbar, bricht der Report mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:13"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:14"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:15"
        }
      ]
    },
    {
      "id": "BM-052-B02",
      "text": "Die Kopfzeile der Datei wird übersprungen; jede weitere Zeile liefert Valutadatum, Betrag, Währung, Verwendungszweck und Auftraggeber.",
      "anchors": [
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:24"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:29"
        }
      ]
    },
    {
      "id": "BM-052-B03",
      "text": "Nur Gutschriften mit positivem Betrag werden übernommen; Lastschriften werden ignoriert.",
      "anchors": [
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:34"
        }
      ]
    },
    {
      "id": "BM-052-B04",
      "text": "Enthält die Datei keine Gutschriften, erhält der Anwender einen Hinweis und der Report endet.",
      "anchors": [
        {
          "file": "zfi_bankstmt.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt.abap:45"
        },
        {
          "file": "zfi_bankstmt.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt.abap:46"
        },
        {
          "file": "zfi_bankstmt.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt.abap:47"
        }
      ]
    },
    {
      "id": "BM-052-B05",
      "text": "Die zulässige Ausgleichsdifferenz wird aus der Variablentabelle gelesen; ohne Eintrag gilt 1,00.",
      "anchors": [
        {
          "file": "zfi_bankstmt.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt.abap:51"
        }
      ]
    },
    {
      "id": "BM-052-B06",
      "text": "Im Echtlauf wird vor der Verarbeitung die Buchungsschnittstelle im Hintergrundmodus mit synchroner Verbuchung geöffnet und danach wieder geschlossen.",
      "anchors": [
        {
          "file": "zfi_bankstmt.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt.abap:55"
        },
        {
          "file": "zfi_bankstmt.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt.abap:56"
        },
        {
          "file": "zfi_bankstmt.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt.abap:79"
        },
        {
          "file": "zfi_bankstmt.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt.abap:80"
        }
      ]
    },
    {
      "id": "BM-052-B07",
      "text": "Je Gutschrift wird im Verwendungszweck eine Rechnungsnummer der Form RE plus acht Ziffern gesucht; fehlt sie, bleibt der Umsatz mit Hinweis offen.",
      "anchors": [
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:49"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:51"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:54"
        }
      ]
    },
    {
      "id": "BM-052-B08",
      "text": "Zur gefundenen Rechnungsnummer werden die offenen Debitorenposten des Buchungskreises mit dieser Referenz gelesen; gibt es keine, bleibt der Umsatz offen.",
      "anchors": [
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:59"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:63"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:66"
        }
      ]
    },
    {
      "id": "BM-052-B09",
      "text": "Der Saldo der gefundenen Posten wird vorzeichengerecht gebildet (Soll positiv, Haben negativ).",
      "anchors": [
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:71"
        }
      ]
    },
    {
      "id": "BM-052-B10",
      "text": "Liegt die Differenz zwischen Saldo und Gutschrift innerhalb der Toleranz, gilt der Umsatz als zugeordnet; sonst bleibt er als Teilzahlung zur manuellen Klärung offen.",
      "anchors": [
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:76"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:77"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:79"
        }
      ]
    },
    {
      "id": "BM-052-B11",
      "text": "Zugeordnete Umsätze werden nur im Echtlauf gebucht: Zahlungseingang auf das Bankverrechnungskonto mit Ausgleich aller gefundenen Posten über die Ausgleichstransaktion.",
      "anchors": [
        {
          "file": "zfi_bankstmt.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt.abap:74"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:103"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:114"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:122"
        }
      ]
    },
    {
      "id": "BM-052-B12",
      "text": "War der Ausgleich erfolgreich, wird der Umsatz mit der Ausgleichsbelegnummer als gebucht markiert, sonst mit der Fehlermeldung als fehlerhaft.",
      "anchors": [
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 149,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:149"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 150,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:150"
        },
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 154,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:154"
        }
      ]
    },
    {
      "id": "BM-052-B13",
      "text": "Zum Schluss werden alle Umsätze mit Zuordnung, Status, Ausgleichsbeleg und Hinweis als ALV-Liste angezeigt.",
      "anchors": [
        {
          "file": "zfi_bankstmt_f01.abap",
          "line": 175,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_bankstmt_f01.abap:175"
        }
      ]
    }
  ],
