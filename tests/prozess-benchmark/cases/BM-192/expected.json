  "businessStatements": [
    {
      "id": "BM-192-B01",
      "text": "Angenommen werden nur Anlagen über die Entitätsmenge der Zählerablesungen; jede andere Menge wird als nicht unterstützt abgewiesen.",
      "anchors": [
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:41"
        },
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:42"
        }
      ]
    },
    {
      "id": "BM-192-B02",
      "text": "Kopf der Ablesung und die Stände der Zählwerke werden aus der Anfrage der App übernommen.",
      "anchors": [
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:49"
        }
      ]
    },
    {
      "id": "BM-192-B03",
      "text": "Enthält die Anfrage keine Zählwerksstände, wird sie mit der Meldung „Keine Zählwerke übermittelt“ abgelehnt.",
      "anchors": [
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:51"
        },
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:55"
        }
      ]
    },
    {
      "id": "BM-192-B04",
      "text": "Ohne Berechtigung zum Hochladen von Zählerständen wird die Anfrage abgelehnt.",
      "anchors": [
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:61"
        },
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:64"
        }
      ]
    },
    {
      "id": "BM-192-B05",
      "text": "Für den Lasttest-Benutzer MR_LOADTEST entfällt die Plausibilisierung vollständig.",
      "anchors": [
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:71"
        }
      ]
    },
    {
      "id": "BM-192-B06",
      "text": "Das Gerät wird über die Seriennummer ermittelt; ist es unbekannt oder nicht eindeutig, ist die Ablesung unplausibel.",
      "anchors": [
        {
          "file": "zcl_isu_mr_validator.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_isu_mr_validator.abap:63"
        },
        {
          "file": "zcl_isu_mr_validator.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_isu_mr_validator.abap:69"
        }
      ]
    },
    {
      "id": "BM-192-B07",
      "text": "Ein Ablesedatum in der Zukunft macht die Ablesung unplausibel.",
      "anchors": [
        {
          "file": "zcl_isu_mr_validator.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_isu_mr_validator.abap:83"
        }
      ]
    },
    {
      "id": "BM-192-B08",
      "text": "Je Zählwerk wird geprüft, ob es zum Ablesedatum am Gerät eingebaut ist; sonst ist die Ablesung unplausibel.",
      "anchors": [
        {
          "file": "zcl_isu_mr_validator.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_isu_mr_validator.abap:91"
        },
        {
          "file": "zcl_isu_mr_validator.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_isu_mr_validator.abap:97"
        }
      ]
    },
    {
      "id": "BM-192-B09",
      "text": "Liegt eine frühere gültige Ablesung vor, wird der neue Stand mit dem letzten verglichen; bei Erstablesung entfällt der Vergleich.",
      "anchors": [
        {
          "file": "zcl_isu_mr_validator.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_isu_mr_validator.abap:105"
        },
        {
          "file": "zcl_isu_mr_validator.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_isu_mr_validator.abap:112"
        }
      ]
    },
    {
      "id": "BM-192-B10",
      "text": "Ist der neue Stand kleiner als der letzte, wird ein Zählerüberlauf angenommen, wenn der daraus folgende Verbrauch höchstens ein Zehntel des Zählbereichs beträgt, was nur eine Warnung ergibt; sonst ist die Ablesung unplausibel.",
      "anchors": [
        {
          "file": "zcl_isu_mr_validator.abap",
          "line": 118,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_isu_mr_validator.abap:118"
        },
        {
          "file": "zcl_isu_mr_validator.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_isu_mr_validator.abap:121"
        },
        {
          "file": "zcl_isu_mr_validator.abap",
          "line": 124,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_isu_mr_validator.abap:124"
        }
      ]
    },
    {
      "id": "BM-192-B11",
      "text": "Ist die Ablesung unplausibel, wird sie mit den Prüfmeldungen an die App abgelehnt.",
      "anchors": [
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:82"
        },
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:86"
        }
      ]
    },
    {
      "id": "BM-192-B12",
      "text": "Die Zählwerksstände werden mit Seriennummer, Ablesedatum, -zeit, -grund und Ablesehinweis als Ableseergebnisse im Versorgersystem angelegt.",
      "anchors": [
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:94"
        },
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:103"
        }
      ]
    },
    {
      "id": "BM-192-B13",
      "text": "Meldet die Anlage einen Fehler, wird alles zurückgenommen und die Anfrage mit den Meldungen des Bausteins abgelehnt.",
      "anchors": [
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 108,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:108"
        },
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 109,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:109"
        },
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:112"
        }
      ]
    },
    {
      "id": "BM-192-B14",
      "text": "Sonst wird die Anlage synchron festgeschrieben.",
      "anchors": [
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:117"
        }
      ]
    },
    {
      "id": "BM-192-B15",
      "text": "Die Nummern der angelegten Ablesebelege werden je Zählwerk ermittelt und mit dem Status POSTED an die App zurückgegeben.",
      "anchors": [
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 123,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:123"
        },
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 130,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:130"
        },
        {
          "file": "zcl_zisu_meter_dpc_ext.abap",
          "line": 131,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zisu_meter_dpc_ext.abap:131"
        }
      ]
    }
  ],
