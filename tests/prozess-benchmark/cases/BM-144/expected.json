  "businessStatements": [
    {
      "id": "BM-144-B01",
      "text": "Eine Tagesgrenze außerhalb von 1 bis 365 wird auf dem Selektionsbild mit einer Fehlermeldung abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 7,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:7"
        },
        {
          "file": "source.abap",
          "line": 8,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:8"
        }
      ]
    },
    {
      "id": "BM-144-B02",
      "text": "Es werden Reisen gelesen, die genehmigt und zur Abrechnung vorgesehen sind und deren Reiseende mindestens die eingegebene Anzahl Tage zurückliegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:13"
        }
      ]
    },
    {
      "id": "BM-144-B03",
      "text": "Je Reise wird das Alter in Tagen seit Reiseende bestimmt und als „KRITISCH“ über 90, „WARNUNG“ über 60 und sonst „OFFEN“ eingestuft.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        },
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        }
      ]
    },
    {
      "id": "BM-144-B04",
      "text": "Jede Reise wird mit Personalnummer, Reisenummer, Reiseende, Alter und Einstufung ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        }
      ]
    }
