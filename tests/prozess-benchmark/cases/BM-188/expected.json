  "businessStatements": [
    {
      "id": "BM-188-B01",
      "text": "Als Buchungstag wird der Vortag vorgeschlagen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        }
      ]
    },
    {
      "id": "BM-188-B02",
      "text": "Es werden die Filialen (Werkstyp A) der Selektion gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:24"
        }
      ]
    },
    {
      "id": "BM-188-B03",
      "text": "Ohne Filialen wird ein Hinweis ausgegeben und die Verarbeitung beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        }
      ]
    },
    {
      "id": "BM-188-B04",
      "text": "Je Filiale wird geprüft, ob unverbuchte Kassendaten des Buchungstags vorliegen; Filialen ohne solche Daten werden übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        },
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        }
      ]
    },
    {
      "id": "BM-188-B05",
      "text": "Für die Filiale wird ein Hintergrundjob mit Filiale und Datum im Namen angelegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        }
      ]
    },
    {
      "id": "BM-188-B06",
      "text": "Kann der Job nicht angelegt werden, wird die Filiale im Protokoll gemeldet und übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:51"
        },
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        }
      ]
    },
    {
      "id": "BM-188-B07",
      "text": "In den Job wird die POS-Verbuchung für Filiale, Buchungstag und Testkennzeichen eingestellt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        }
      ]
    },
    {
      "id": "BM-188-B08",
      "text": "Der erste Job startet sofort, jeder weitere erst nach erfolgreichem Ende des vorher eingeplanten Jobs.",
      "anchors": [
        {
