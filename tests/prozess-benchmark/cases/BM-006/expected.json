  "businessStatements": [
    {
      "id": "BM-006-B01",
      "text": "Es werden die Kundenaufträge der eingegebenen Verkaufsorganisationen, Auftragsdaten und Kunden gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        }
      ]
    },
    {
      "id": "BM-006-B02",
      "text": "Ohne Treffer erscheint ein Hinweis und der Report endet ohne Liste.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        },
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        },
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        }
      ]
    },
    {
      "id": "BM-006-B03",
      "text": "Zu den Aufträgen werden nur aktive Zu- und Abschlagskonditionen gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        }
      ]
    },
    {
      "id": "BM-006-B04",
      "text": "Als Rabatt zählen nur kundeneigene Konditionsarten (Z…) und K007; ihre Werte werden je Auftrag summiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        }
      ]
    },
    {
      "id": "BM-006-B05",
      "text": "Die Rabattquote ist der Rabattbetrag im Verhältnis zu Nettowert plus Rabatt, in Prozent; bei Nettowert null bleibt sie null.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        }
      ]
    },
    {
      "id": "BM-006-B06",
      "text": "Aufträge mit einer Rabattquote über dem eingegebenen Grenzwert (Vorschlag 15 %) werden rot, alle anderen grün markiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:63"
        },
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        },
        {
          "file": "source.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:66"
        }
      ]
    },
    {
      "id": "BM-006-B07",
      "text": "Das Ergebnis wird als ALV-Liste mit allen Standardfunktionen angezeigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
