  "businessStatements": [
    {
      "id": "BM-189-B01",
      "text": "Beim Initialisierungsaufruf aus dem BW wird geprüft, ob die angeforderte DataSource ZPS_MEILENSTEIN ist; sonst wird der Aufruf mit Fehler abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        },
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        }
      ]
    },
    {
      "id": "BM-189-B02",
      "text": "Die Selektionen und die Paketgröße der Anforderung werden für die folgenden Datenaufrufe gemerkt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        }
      ]
    },
    {
      "id": "BM-189-B03",
      "text": "Beim ersten Datenaufruf werden die Projektselektion übernommen und, falls angegeben, nur Meilensteine ab dem angeforderten Änderungsdatum berücksichtigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        },
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        }
      ]
    },
    {
      "id": "BM-189-B04",
      "text": "Die Projektmeilensteine der Selektion werden zum paketweisen Lesen geöffnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        }
      ]
    },
    {
      "id": "BM-189-B05",
      "text": "Je Aufruf wird das nächste Paket Meilensteine in der angeforderten Paketgröße gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        }
      ]
    },
    {
      "id": "BM-189-B06",
      "text": "Sind keine Meilensteine mehr vorhanden, wird das Ende der Datenübertragung gemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        },
        {
          "file": "source.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:63"
        }
      ]
    },
    {
      "id": "BM-189-B07",
      "text": "Für jeden Meilenstein wird der Terminverzug in Tagen berechnet: bei offenem, überfälligem Meilenstein bis heute, bei verspätet erreichtem bis zum Ist-Termin, sonst null.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        },
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        }
      ]
    }
