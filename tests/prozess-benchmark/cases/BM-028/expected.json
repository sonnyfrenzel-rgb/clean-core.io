  "businessStatements": [
    {
      "id": "BM-028-B01",
      "text": "Die nächtliche Umlagerungsdatei des Logistikdienstleisters wird vom Applikationsserver gelesen; ist sie nicht lesbar, bricht der Lauf mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        },
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        },
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        }
      ]
    },
    {
      "id": "BM-028-B02",
      "text": "Jede Zeile liefert Material, abgebendes Werk und Lagerort, empfangendes Werk und Lagerort, Menge (Dezimalkomma wird umgesetzt) und Charge.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        },
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        }
      ]
    },
    {
      "id": "BM-028-B03",
      "text": "Vor jeder Buchung wird der frei verwendbare Bestand am abgebenden Lagerort gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        }
      ]
    },
    {
      "id": "BM-028-B04",
      "text": "Fehlt das Lagerortsegment oder reicht der Bestand nicht für die Menge, wird die Zeile mit dem vorhandenen Bestand protokolliert und nicht gebucht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        }
      ]
    },
    {
      "id": "BM-028-B05",
      "text": "Sonst wird je Zeile eine Umlagerung Werk an Werk mit Bewegungsart 301 zum Tagesdatum gebucht, im Testlauf nur simuliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:74"
        },
        {
          "file": "source.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:80"
        }
      ]
    },
    {
      "id": "BM-028-B06",
      "text": "Meldet die Buchung einen Fehler oder Abbruch, wird zurückgerollt und der Fehlertext protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:92"
        },
        {
          "file": "source.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:95"
        },
        {
          "file": "source.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:96"
        },
        {
          "file": "source.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:97"
        }
      ]
    },
    {
      "id": "BM-028-B07",
      "text": "Im Echtlauf wird die Buchung festgeschrieben und der Materialbeleg mit Jahr protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:99"
        },
        {
          "file": "source.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:102"
        }
      ]
    },
    {
      "id": "BM-028-B08",
      "text": "Im Testlauf wird die fehlerfreie Prüfung je Zeile protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:105"
        }
      ]
    }
  ],
