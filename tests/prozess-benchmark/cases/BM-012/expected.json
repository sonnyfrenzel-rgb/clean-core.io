  "businessStatements": [
    {
      "id": "BM-012-B01",
      "text": "Jedes IDoc des Eingangspakets wird für sich verarbeitet; ein Fehler in einem Schritt überspringt die folgenden Schritte dieses IDocs.",
      "anchors": [
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:26"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:30"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:33"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:36"
        }
      ]
    },
    {
      "id": "BM-012-B02",
      "text": "Aus dem Kopfsegment werden Bestellart und Währung übernommen.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:18"
        }
      ]
    },
    {
      "id": "BM-012-B03",
      "text": "Aus den Referenzsegmenten wird nur die Kundenbestellnummer mit Bestelldatum (Qualifier 001) übernommen.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:25"
        }
      ]
    },
    {
      "id": "BM-012-B04",
      "text": "Aus den Partnersegmenten wird nur der Auftraggeber (AG) übernommen.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:31"
        }
      ]
    },
    {
      "id": "BM-012-B05",
      "text": "Jedes Positionssegment ergibt eine Bestellposition mit Menge und Einheit; die Objektidentifikation liefert dazu Kundenmaterial (001) oder eigene Materialnummer (002).",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:18"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:45"
        }
      ]
    },
    {
      "id": "BM-012-B06",
      "text": "Fehlen Positionen oder die Kundenbestellnummer, wird das IDoc mit Fehler 110 abgelehnt.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:55"
        }
      ]
    },
    {
      "id": "BM-012-B07",
      "text": "Händler und Auftraggeber-GLN werden über eine Zuordnungstabelle auf Debitor, Vertriebsbereich und Auftragsart abgebildet; ohne Zuordnung wird mit Fehler 111 abgelehnt.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:68"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:71"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:74"
        }
      ]
    },
    {
      "id": "BM-012-B08",
      "text": "Hat der Debitor eine zentrale Auftragssperre, wird das IDoc mit Fehler 112 abgelehnt.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:82"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:83"
        }
      ]
    },
    {
      "id": "BM-012-B09",
      "text": "Kundenmaterialnummern werden über die Kunden-Material-Info in eigene Materialnummern umgeschlüsselt; ein unbekanntes Kundenmaterial lehnt das IDoc mit Fehler 113 ab und beendet die Umschlüsselung.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:96"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:97"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:102"
        }
      ]
    },
    {
      "id": "BM-012-B10",
      "text": "Ohne Kundenmaterial wird die gelieferte eigene Materialnummer ins interne Format gewandelt, ohne das Ergebnis zu prüfen.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 108,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:108"
        }
      ]
    },
    {
      "id": "BM-012-B11",
      "text": "Existiert beim selben Auftraggeber bereits ein Auftrag mit dieser Kundenbestellnummer, wird das IDoc als Dublette mit Fehler 114 abgelehnt.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 134,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:134"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 139,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:139"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 142,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:142"
        }
      ]
    },
    {
      "id": "BM-012-B12",
      "text": "Andernfalls wird ein Kundenauftrag der zugeordneten Auftragsart mit Auftraggeber, Bestelldaten und je Bestellposition einer Position (Nummern 10, 20, …) und Einteilung angelegt.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 162,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:162"
        }
      ]
    },
    {
      "id": "BM-012-B13",
      "text": "Meldet die Anlage einen Fehler oder Abbruch, wird das IDoc mit der ersten dieser Meldungen als fehlerhaft markiert.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 173,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:173"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 174,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:174"
        }
      ]
    },
    {
      "id": "BM-012-B14",
      "text": "Fehlerhafte IDocs erhalten Status 51 mit der Fehlermeldung, erfolgreiche Status 53 mit der neuen Auftragsnummer als Anwendungsobjekt.",
      "anchors": [
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 197,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:197"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 198,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:198"
        },
        {
          "file": "lzsd_edi_ordf01.abap",
          "line": 203,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_edi_ordf01.abap:203"
        }
      ]
    },
    {
      "id": "BM-012-B15",
      "text": "Ist mindestens ein IDoc des Pakets fehlerhaft, meldet der Baustein dem Workflow ein Fehlerergebnis.",
      "anchors": [
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:43"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:44"
        }
      ]
    }
  ],
