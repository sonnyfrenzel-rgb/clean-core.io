  "businessStatements": [
    {
      "id": "BM-213-B01",
      "text": "Je nach Auswahl wird ein normaler oder ein Intercompany-Fakturierungslauf aufgebaut.",
      "anchors": [
        {
          "file": "zsd_billing_run.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:24"
        },
        {
          "file": "zsd_billing_run.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:25"
        },
        {
          "file": "zsd_billing_run.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:27"
        }
      ]
    },
    {
      "id": "BM-213-B02",
      "text": "Der Lauf liest die gepflegte Fakturaart je Verkaufsorganisation für seine Laufart (normal oder Intercompany); ist keine gepflegt, bricht der Report mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:50"
        },
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:54"
        },
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:55"
        },
        {
          "file": "zsd_billing_run.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:32"
        }
      ]
    },
    {
      "id": "BM-213-B03",
      "text": "Für den Intercompany-Lauf muss außerdem ein RFC-Ziel des Partnersystems gepflegt sein, sonst Abbruch mit Fehlermeldung.",
      "anchors": [
        {
          "file": "zcl_sd_billing_run_ic.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run_ic.abap:28"
        },
        {
          "file": "zcl_sd_billing_run_ic.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run_ic.abap:30"
        },
        {
          "file": "zcl_sd_billing_run_ic.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run_ic.abap:31"
        }
      ]
    },
    {
      "id": "BM-213-B04",
      "text": "Fällig sind Lieferungen der gewählten Verkaufsorganisationen und Warenausgangsdaten mit vollständigem Warenausgang und offenem Fakturastatus.",
      "anchors": [
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:75"
        }
      ]
    },
    {
      "id": "BM-213-B05",
      "text": "Im Intercompany-Lauf werden davon nur Lieferungen mit offener Intercompany-Faktura berücksichtigt.",
      "anchors": [
        {
          "file": "zcl_sd_billing_run_ic.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run_ic.abap:41"
        },
        {
          "file": "zcl_sd_billing_run_ic.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run_ic.abap:43"
        },
        {
          "file": "zcl_sd_billing_run_ic.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run_ic.abap:48"
        }
      ]
    },
    {
      "id": "BM-213-B06",
      "text": "Ist nichts fällig, meldet der Lauf null angelegte Fakturen.",
      "anchors": [
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:64"
        },
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:65"
        },
        {
          "file": "zsd_billing_run.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:30"
        }
      ]
    },
    {
      "id": "BM-213-B07",
      "text": "Lieferungen einer Verkaufsorganisation ohne gepflegte Fakturaart werden übergangen.",
      "anchors": [
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:92"
        },
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:94"
        }
      ]
    },
    {
      "id": "BM-213-B08",
      "text": "Für die übrigen Lieferungen werden Fakturen der gepflegten Art mit Fakturadatum heute angelegt.",
      "anchors": [
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:104"
        }
      ]
    },
    {
      "id": "BM-213-B09",
      "text": "Entsteht dabei keine einzige Faktura und gibt es Fehler, wird verworfen und mit Fehlermeldung abgebrochen; sonst wird festgeschrieben.",
      "anchors": [
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:110"
        },
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:111"
        },
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:112"
        },
        {
          "file": "zcl_sd_billing_run.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run.abap:117"
        }
      ]
    },
    {
      "id": "BM-213-B10",
      "text": "Im Intercompany-Lauf wird jede angelegte Faktura per RFC an das Partnersystem übergeben; scheitert die Übergabe, erscheint eine Informationsmeldung und der Lauf geht weiter.",
      "anchors": [
        {
          "file": "zcl_sd_billing_run_ic.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run_ic.abap:55"
        },
        {
          "file": "zcl_sd_billing_run_ic.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run_ic.abap:56"
        },
        {
          "file": "zcl_sd_billing_run_ic.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run_ic.abap:64"
        },
        {
          "file": "zcl_sd_billing_run_ic.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_billing_run_ic.abap:65"
        }
      ]
    },
    {
      "id": "BM-213-B11",
      "text": "Am Ende wird die Anzahl der angelegten Fakturen ausgegeben.",
      "anchors": [
        {
          "file": "zsd_billing_run.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:30"
        }
      ]
    }
  ],
