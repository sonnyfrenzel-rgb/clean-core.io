  "businessStatements": [
    {
      "id": "BM-065-B01",
      "text": "Zum eingegebenen Vorgang des aktuellen Auftrags werden die geplante Vorgangsmenge und die bereits rückgemeldete Gutmenge gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:14"
        }
      ]
    },
    {
      "id": "BM-065-B02",
      "text": "Gibt es den Vorgang nicht, wird die Eingabe mit einer Fehlermeldung zurückgewiesen und das Dynpro bleibt zur Korrektur stehen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        },
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        }
      ]
    },
    {
      "id": "BM-065-B03",
      "text": "Die offene Menge ergibt sich aus Vorgangsmenge minus bereits rückgemeldeter Gutmenge.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:24"
        }
      ]
    },
    {
      "id": "BM-065-B04",
      "text": "Übersteigt die eingegebene Gutmenge die offene Menge, wird die Eingabe mit einer Fehlermeldung unter Angabe der offenen Menge zurückgewiesen; sonst wird sie akzeptiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        }
      ]
    }
  ],
