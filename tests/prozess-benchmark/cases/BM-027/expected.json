  "businessStatements": [
    {
      "id": "BM-027-B01",
      "text": "Zu Beginn wird geprüft, ob der Anwender für die angegebene Freigabegruppe mit dem angegebenen Freigabecode freigeben darf; sonst bricht der Report mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-027-B02",
      "text": "Es werden die nicht gelöschten, zur Freigabe gesperrten Bestellungen der Freigabegruppe in der Bestell- und Einkaufsorganisationsauswahl gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    },
    {
      "id": "BM-027-B03",
      "text": "Für jede Bestellung wird ihre Freigabestrategie gelesen; Bestellungen ohne gepflegte Strategie werden übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        },
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        }
      ]
    },
    {
      "id": "BM-027-B04",
      "text": "Es wird bestimmt, an welcher Stelle der Strategie der eigene Freigabecode steht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:46"
        },
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:49"
        }
      ]
    },
    {
      "id": "BM-027-B05",
      "text": "Kommt der eigene Code in der Strategie nicht vor oder ist er nach dem bisherigen Freigabestand nicht als nächster an der Reihe, wird die Bestellung übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        }
      ]
    },
    {
      "id": "BM-027-B06",
      "text": "Sonst wird die Bestellung mit dem eigenen Code über das Standard-BAPI freigegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-027-B07",
      "text": "Eine erfolgreiche Freigabe wird mit dem neuen Freigabestatus protokolliert, eine gescheiterte mit ihrem Grund.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:75"
        },
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        },
        {
          "file": "source.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:80"
        }
      ]
    },
    {
      "id": "BM-027-B08",
      "text": "Am Ende werden die Anzahl der freigegebenen und der gescheiterten Bestellungen ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:85"
        }
      ]
    }
  ],
