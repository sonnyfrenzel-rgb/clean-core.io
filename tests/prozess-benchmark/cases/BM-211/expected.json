  "businessStatements": [
    {
      "id": "BM-211-B01",
      "text": "Der Baustein verarbeitet jedes eingehende Wareneingangs-IDoc des Logistikdienstleisters einzeln.",
      "anchors": [
        {
          "file": "lzmm_grconfu01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "lzmm_grconfu01.abap:34"
        }
      ]
    },
    {
      "id": "BM-211-B02",
      "text": "Fehlt das Kopfsegment, erhält das IDoc Status 51 und wird übersprungen.",
      "anchors": [
        {
          "file": "lzmm_grconfu01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "lzmm_grconfu01.abap:35"
        },
        {
          "file": "lzmm_grconfu01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "lzmm_grconfu01.abap:38"
        },
        {
          "file": "lzmm_grconfu01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "lzmm_grconfu01.abap:39"
        }
      ]
    },
    {
      "id": "BM-211-B03",
      "text": "Existiert die Bestellung nicht oder ist sie gelöscht, wird der Wareneingang mit Fehlercode NOPO abgelehnt.",
      "anchors": [
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:43"
        },
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:46"
        },
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:47"
        }
      ]
    },
    {
      "id": "BM-211-B04",
      "text": "Ist die Bestellung noch nicht freigegeben, wird mit Fehlercode BLCK abgelehnt.",
      "anchors": [
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:50"
        },
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:51"
        }
      ]
    },
    {
      "id": "BM-211-B05",
      "text": "Je gemeldeter Position wird die offene Menge aus Bestellmenge zuzüglich Überlieferungstoleranz abzüglich bisheriger Wareneingänge ermittelt.",
      "anchors": [
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:55"
        },
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:60"
        },
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:66"
        }
      ]
    },
    {
      "id": "BM-211-B06",
      "text": "Übersteigt die gemeldete Menge die offene Menge, wird mit Fehlercode OVER abgelehnt.",
      "anchors": [
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:67"
        },
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:68"
        }
      ]
    },
    {
      "id": "BM-211-B07",
      "text": "Sonst wird ein Wareneingang zur Bestellung (Bewegungsart 101) mit Buchungsdatum und Lieferscheinnummer des Dienstleisters gebucht.",
      "anchors": [
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:85"
        }
      ]
    },
    {
      "id": "BM-211-B08",
      "text": "Entsteht kein Materialbeleg, wird mit Fehlercode BAPI abgelehnt.",
      "anchors": [
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:94"
        },
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:95"
        }
      ]
    },
    {
      "id": "BM-211-B09",
      "text": "Jede Ablehnung wird mit Fehlercode im WE-Journal vermerkt, und das IDoc erhält Status 51.",
      "anchors": [
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:103"
        },
        {
          "file": "zcl_mm_gr_notifier.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_notifier.abap:35"
        },
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 107,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:107"
        },
        {
          "file": "lzmm_grconfu01.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "lzmm_grconfu01.abap:60"
        }
      ]
    },
    {
      "id": "BM-211-B10",
      "text": "Bei Überlieferung wird zusätzlich der Einkäufer benachrichtigt.",
      "anchors": [
        {
          "file": "zcl_mm_gr_notifier.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_notifier.abap:38"
        },
        {
          "file": "zcl_mm_gr_notifier.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_notifier.abap:39"
        }
      ]
    },
    {
      "id": "BM-211-B11",
      "text": "Eine erfolgreiche Buchung wird mit Materialbeleg im WE-Journal vermerkt, und das IDoc erhält Status 53.",
      "anchors": [
        {
          "file": "zcl_mm_gr_poster.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_poster.abap:98"
        },
        {
          "file": "zcl_mm_gr_notifier.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_gr_notifier.abap:24"
        },
        {
          "file": "lzmm_grconfu01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "lzmm_grconfu01.abap:57"
        }
      ]
    }
  ],
