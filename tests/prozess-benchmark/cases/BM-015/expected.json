  "businessStatements": [
    {
      "id": "BM-015-B01",
      "text": "Ohne Berechtigung zum Anlegen der Retourenauftragsart ZRE wird mit Fehler 500 abgebrochen.",
      "anchors": [
        {
          "file": "z_sd_return_create.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "z_sd_return_create.abap:19"
        },
        {
          "file": "z_sd_return_create.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "z_sd_return_create.abap:22"
        },
        {
          "file": "z_sd_return_create.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "z_sd_return_create.abap:23"
        },
        {
          "file": "z_sd_return_create.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "z_sd_return_create.abap:24"
        }
      ]
    },
    {
      "id": "BM-015-B02",
      "text": "Existiert die angegebene Faktura nicht, wird mit Fehler 501 abgebrochen.",
      "anchors": [
        {
          "file": "lzsd_retf01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:19"
        },
        {
          "file": "lzsd_retf01.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:20"
        },
        {
          "file": "lzsd_retf01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:21"
        }
      ]
    },
    {
      "id": "BM-015-B03",
      "text": "Stornierte Fakturen und Stornobelege sind nicht retournierbar (Fehler 502).",
      "anchors": [
        {
          "file": "lzsd_retf01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:26"
        },
        {
          "file": "lzsd_retf01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:27"
        }
      ]
    },
    {
      "id": "BM-015-B04",
      "text": "Liegt das Fakturadatum mehr als 365 Tage zurück, wird mit Fehler 503 abgebrochen, außer bei Auftragsgrund Kulanz (Z05).",
      "anchors": [
        {
          "file": "lzsd_retf01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:31"
        },
        {
          "file": "lzsd_retf01.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:33"
        }
      ]
    },
    {
      "id": "BM-015-B05",
      "text": "Jede Rückgabeposition muss eine Position der Faktura sein, sonst Fehler 504.",
      "anchors": [
        {
          "file": "lzsd_retf01.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:49"
        },
        {
          "file": "lzsd_retf01.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:50"
        },
        {
          "file": "lzsd_retf01.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:51"
        }
      ]
    },
    {
      "id": "BM-015-B06",
      "text": "Die Rückgabemenge plus der bereits retournierten Menge darf die fakturierte Menge nicht übersteigen, sonst Fehler 505.",
      "anchors": [
        {
          "file": "lzsd_retf01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:56"
        },
        {
          "file": "lzsd_retf01.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:61"
        },
        {
          "file": "lzsd_retf01.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:62"
        }
      ]
    },
    {
      "id": "BM-015-B07",
      "text": "Alle Rückgabepositionen werden geprüft; bei mindestens einem Fehler wird keine Retoure angelegt.",
      "anchors": [
        {
          "file": "lzsd_retf01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:48"
        },
        {
          "file": "z_sd_return_create.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "z_sd_return_create.abap:33"
        }
      ]
    },
    {
      "id": "BM-015-B08",
      "text": "Andernfalls wird ein Retourenauftrag ZRE mit Bezug zur Faktura, dem Auftraggeber der Faktura und dem angegebenen Auftragsgrund angelegt.",
      "anchors": [
        {
          "file": "lzsd_retf01.abap",
          "line": 106,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:106"
        }
      ]
    },
    {
      "id": "BM-015-B09",
      "text": "Wurde keine Retoure angelegt oder ist Simulation gesetzt, wird verworfen und keine Retourennummer zurückgegeben.",
      "anchors": [
        {
          "file": "lzsd_retf01.abap",
          "line": 118,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:118"
        },
        {
          "file": "lzsd_retf01.abap",
          "line": 119,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:119"
        }
      ]
    },
    {
      "id": "BM-015-B10",
      "text": "Sonst wird die Retoure mit Faktura, Kunde, Auftragsgrund, Datum und Benutzer im Retourenprotokoll erfasst und alles festgeschrieben.",
      "anchors": [
        {
          "file": "lzsd_retf01.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:127"
        },
        {
          "file": "lzsd_retf01.abap",
          "line": 129,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_retf01.abap:129"
        }
      ]
    }
  ],
