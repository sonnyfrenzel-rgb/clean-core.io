  "businessStatements": [
    {
      "id": "BM-112-B01",
      "text": "Jedes eingehende IDoc beschreibt einen Equipmenttausch; seine Segmente liefern Technischen Platz mit Datum und Zeit, das ausgebaute Equipment mit Zählerstand und das eingebaute Equipment, unbekannte Segmente werden ignoriert.",
      "anchors": [
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:38"
        },
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:41"
        },
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:42"
        }
      ]
    },
    {
      "id": "BM-112-B02",
      "text": "Fehlen Platz, ausgebautes oder eingebautes Equipment, wird das IDoc abgelehnt.",
      "anchors": [
        {
          "file": "lzpm_swapf01.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:16"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:18"
        }
      ]
    },
    {
      "id": "BM-112-B03",
      "text": "Das ausgebaute Equipment muss aktuell an genau diesem Technischen Platz eingebaut sein, sonst wird das IDoc abgelehnt.",
      "anchors": [
        {
          "file": "lzpm_swapf01.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:24"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:29"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:30"
        }
      ]
    },
    {
      "id": "BM-112-B04",
      "text": "Das einzubauende Equipment darf aktuell an keinem Platz eingebaut sein, sonst wird das IDoc abgelehnt.",
      "anchors": [
        {
          "file": "lzpm_swapf01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:37"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:42"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:43"
        }
      ]
    },
    {
      "id": "BM-112-B05",
      "text": "Das alte Equipment wird zum gemeldeten Zeitpunkt vom Platz ausgebaut; meldet der Ausbau einen Fehler, wird das IDoc abgelehnt.",
      "anchors": [
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:56"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:58"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:66"
        }
      ]
    },
    {
      "id": "BM-112-B06",
      "text": "Ist ein Zählerstand gemeldet und hat das ausgebaute Equipment einen aktiven Zähler, wird der Stand bei Ausbau als Messbeleg erfasst; ohne Zähler entfällt der Messbeleg ohne Fehler.",
      "anchors": [
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:57"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:82"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:88"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:92"
        }
      ]
    },
    {
      "id": "BM-112-B07",
      "text": "Schlägt das Anlegen des Messbelegs fehl, wird das IDoc mit der Systemmeldung abgelehnt.",
      "anchors": [
        {
          "file": "lzpm_swapf01.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:102"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:105"
        }
      ]
    },
    {
      "id": "BM-112-B08",
      "text": "Das neue Equipment wird zum selben Zeitpunkt am Platz eingebaut; meldet der Einbau einen Fehler, wird das IDoc abgelehnt.",
      "anchors": [
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:60"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 120,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:120"
        },
        {
          "file": "lzpm_swapf01.abap",
          "line": 128,
          "token": null,
          "expressionPath": null,
          "raw": "lzpm_swapf01.abap:128"
        }
      ]
    },
    {
      "id": "BM-112-B09",
      "text": "Bei jeder Ablehnung werden Ausbau, Messbeleg und Einbau dieses IDocs gemeinsam zurückgenommen, das IDoc erhält Status 51 mit dem Fehlertext und der Workflow wird über den Fehler informiert.",
      "anchors": [
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:62"
        },
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:63"
        },
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:65"
        },
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:67"
        }
      ]
    },
    {
      "id": "BM-112-B10",
      "text": "Gelingt der ganze Tausch, wird er festgeschrieben und das IDoc erhält Status 53 „Equipmenttausch gebucht“.",
      "anchors": [
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:71"
        },
        {
          "file": "z_idoc_input_zequiswap.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zequiswap.abap:74"
        }
      ]
    }
  ],
