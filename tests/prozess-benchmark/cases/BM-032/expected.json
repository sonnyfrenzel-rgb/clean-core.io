  "businessStatements": [
    {
      "id": "BM-032-B01",
      "text": "Es werden die Wareneingänge zu Bestellungen der eingegebenen Einkaufsorganisation und Lieferanten im Buchungszeitraum gelesen; Stornobuchungen werden nicht bewertet.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 6,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:6"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:14"
        }
      ]
    },
    {
      "id": "BM-032-B02",
      "text": "Gibt es keine, wird ein Hinweis ausgegeben und die Bewertung übersprungen; die (leere) Ergebnisliste wird trotzdem angezeigt.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung.abap:47"
        },
        {
          "file": "zmm_lief_bewertung.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung.abap:48"
        },
        {
          "file": "zmm_lief_bewertung.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung.abap:49"
        },
        {
          "file": "zmm_lief_bewertung.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung.abap:60"
        }
      ]
    },
    {
      "id": "BM-032-B03",
      "text": "Für jeden Wareneingang wird der früheste Liefertermin der Bestellposition gelesen; Positionen ohne Termin gehen nicht in die Termintreue ein.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:25"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:28"
        }
      ]
    },
    {
      "id": "BM-032-B04",
      "text": "Die Verspätung in Tagen ergibt die Terminpunkte: pünktlich oder früh 100, bis 3 Tage 80, bis 7 Tage 50, darüber 0.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:31"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:35"
        }
      ]
    },
    {
      "id": "BM-032-B05",
      "text": "Für die Mengentreue werden die Wareneingangsmengen je Bestellposition summiert und nur endgelieferte Positionen mit Bestellmenge bewertet.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:65"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:69"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:73"
        }
      ]
    },
    {
      "id": "BM-032-B06",
      "text": "Die prozentuale Abweichung zwischen gelieferter und bestellter Menge ergibt die Mengenpunkte: 100 minus doppelte Abweichung, mindestens 0.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:76"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:80"
        }
      ]
    },
    {
      "id": "BM-032-B07",
      "text": "Für die Qualität werden die Wareneingangsprüflose der bewerteten Lieferanten im Zeitraum gelesen und nur Lose mit Verwendungsentscheid gezählt; angenommene Lose zählen als gut.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:95"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:102"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:104"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:110"
        }
      ]
    },
    {
      "id": "BM-032-B08",
      "text": "Je Lieferant werden die Durchschnittspunkte für Termin und Menge und die Annahmequote in Prozent gebildet; ohne Prüflose gilt die Qualität als 100.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:127"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 134,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:134"
        }
      ]
    },
    {
      "id": "BM-032-B09",
      "text": "Die Gesamtpunktzahl gewichtet Termintreue mit 40 %, Mengentreue und Qualität mit je 30 %.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 143,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:143"
        }
      ]
    },
    {
      "id": "BM-032-B10",
      "text": "Ab 90 Punkten erhält der Lieferant die Note A, ab 70 die Note B, sonst C.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 144,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:144"
        }
      ]
    },
    {
      "id": "BM-032-B11",
      "text": "Nur wenn Speichern gewählt ist, wird die bisherige Bewertung der Einkaufsorganisation und Periode gelöscht und durch die neue ersetzt.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung.abap:56"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 157,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:157"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 160,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:160"
        }
      ]
    },
    {
      "id": "BM-032-B12",
      "text": "Gelingt das Schreiben, wird festgeschrieben und die Anzahl gemeldet; sonst wird zurückgerollt und mit Fehler abgebrochen.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 161,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:161"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 162,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:162"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 163,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:163"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 165,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:165"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 166,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:166"
        }
      ]
    },
    {
      "id": "BM-032-B13",
      "text": "Zum Schluss wird die Bewertung je Lieferant mit Einzelpunkten, Gesamtpunkten und Note als ALV angezeigt.",
      "anchors": [
        {
          "file": "zmm_lief_bewertung.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung.abap:61"
        },
        {
          "file": "zmm_lief_bewertung_f01.abap",
          "line": 176,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_lief_bewertung_f01.abap:176"
        }
      ]
    }
  ],
