  "businessStatements": [
    {
      "id": "BM-166-B01",
      "text": "Das eingegebene Werk muss ein Verteilzentrum sein; andernfalls wird die Eingabe mit einer Fehlermeldung abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        }
      ]
    },
    {
      "id": "BM-166-B02",
      "text": "Es werden die Filialen des Verteilzentrums mit ihrer gepflegten Quote gelesen; nur Werke vom Typ Filiale zählen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        }
      ]
    },
    {
      "id": "BM-166-B03",
      "text": "Gibt es keine Filialquote, endet der Lauf mit einer als Fehler angezeigten Hinweismeldung ohne Aufteilung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        },
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        },
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        }
      ]
    },
    {
      "id": "BM-166-B04",
      "text": "Die Summe aller positiven Quoten bildet die Bezugsgröße der Aufteilung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        }
      ]
    },
    {
      "id": "BM-166-B05",
      "text": "Jede Filiale mit positiver Quote erhält den abgerundeten Anteil der Aktionsmenge nach ihrem Quotenanteil; Filialen ohne positive Quote gehen leer aus.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:51"
        },
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        }
      ]
    },
    {
      "id": "BM-166-B06",
      "text": "Der Rundungsrest wird der Filiale mit der größten Zuteilung zugeschlagen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        },
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        }
      ]
    },
    {
      "id": "BM-166-B07",
      "text": "Nur ohne Testkennzeichen wird die Aufteilung je Filiale mit Material, Verteilzentrum, Datum und Benutzer gespeichert und festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        },
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        },
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        }
      ]
    },
    {
      "id": "BM-166-B08",
      "text": "Die Zuteilung je Filiale wird als Liste angezeigt, im Testlauf ebenso wie im Echtlauf.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:79"
        }
      ]
    }
  ],
