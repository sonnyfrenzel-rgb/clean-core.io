  "businessStatements": [
    {
      "id": "BM-249-B01",
      "text": "Der Lauf selektiert alle Proben im Status gemessen zu den gewählten Werken und Probedaten.",
      "anchors": [
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:41"
        }
      ]
    },
    {
      "id": "BM-249-B02",
      "text": "Gibt es keine, wird ein Hinweis ausgegeben und der Lauf endet.",
      "anchors": [
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:48"
        },
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:49"
        },
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:50"
        }
      ]
    },
    {
      "id": "BM-249-B03",
      "text": "Für alle gefundenen Proben wird die Aktion Freigeben ausgeführt; welche Klassen das Framework dafür aufruft, legt die BO-Modellierung fest, die nicht im Fall liegt.",
      "anchors": [
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:53"
        }
      ]
    },
    {
      "id": "BM-249-B04",
      "text": "Alle Meldungen der Aktion werden ins Protokoll geschrieben.",
      "anchors": [
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:62"
        },
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:64"
        },
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:66"
        }
      ]
    },
    {
      "id": "BM-249-B05",
      "text": "Im Testlauf werden alle Änderungen verworfen und nur die Zahl geprüfter und nicht freigebbarer Proben ausgegeben.",
      "anchors": [
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:73"
        },
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:74"
        },
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:75"
        },
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:77"
        }
      ]
    },
    {
      "id": "BM-249-B06",
      "text": "Im Echtlauf wird die Transaktion gesichert; lehnt das Framework das Sichern ab, werden alle Änderungen verworfen und „keine Probe freigegeben“ gemeldet.",
      "anchors": [
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:80"
        },
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:85"
        },
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:86"
        },
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:87"
        }
      ]
    },
    {
      "id": "BM-249-B07",
      "text": "Nach erfolgreichem Sichern wird die Zahl bearbeiteter Proben (freigegeben oder zurückgewiesen) und abgelehnter Proben ausgegeben.",
      "anchors": [
        {
          "file": "zqm_probe_freigabe.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_probe_freigabe.abap:90"
        }
      ]
    },
    {
      "id": "BM-249-B08",
      "text": "Vor der Freigabe wird jede Probe ohne Prüfer oder ohne Probenahmezeitpunkt mit der Meldung ZQM_PROBE 020 von der Aktion ausgeschlossen.",
      "anchors": [
        {
          "file": "zcl_zqm_v_probe_vollst.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_v_probe_vollst.abap:27"
        },
        {
          "file": "zcl_zqm_v_probe_vollst.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_v_probe_vollst.abap:28"
        },
        {
          "file": "zcl_zqm_v_probe_vollst.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_v_probe_vollst.abap:32"
        }
      ]
    },
    {
      "id": "BM-249-B09",
      "text": "Ist der Prüfer derselbe Benutzer, der die Freigabe ausführt, wird die Probe nach dem Vier-Augen-Prinzip mit der Meldung ZQM_PROBE 021 ausgeschlossen.",
      "anchors": [
        {
          "file": "zcl_zqm_v_probe_vollst.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_v_probe_vollst.abap:27"
        },
        {
          "file": "zcl_zqm_v_probe_vollst.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_v_probe_vollst.abap:37"
        },
        {
          "file": "zcl_zqm_v_probe_vollst.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_v_probe_vollst.abap:41"
        }
      ]
    },
    {
      "id": "BM-249-B10",
      "text": "Die Aktion liest die Proben mit ihren Messwerten.",
      "anchors": [
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:35"
        },
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:40"
        }
      ]
    },
    {
      "id": "BM-249-B11",
      "text": "Eine Probe, die nicht im Status gemessen ist, wird mit der Meldung ZQM_PROBE 030 abgelehnt.",
      "anchors": [
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:50"
        },
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:51"
        },
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:54"
        }
      ]
    },
    {
      "id": "BM-249-B12",
      "text": "Je Probe werden noch nicht erfasste Messwerte und Messwerte außerhalb der Unter- oder Obergrenze gezählt.",
      "anchors": [
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:59"
        },
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:60"
        }
      ]
    },
    {
      "id": "BM-249-B13",
      "text": "Fehlt noch ein Messwert, wird die Probe mit der Meldung ZQM_PROBE 031 abgelehnt und bleibt unverändert.",
      "anchors": [
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:67"
        },
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:69"
        },
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:72"
        }
      ]
    },
    {
      "id": "BM-249-B14",
      "text": "Liegt mindestens ein Messwert außerhalb der Toleranz, wird die Probe zurückgewiesen und die Warnung ZQM_PROBE 032 ausgegeben; sonst wird sie freigegeben.",
      "anchors": [
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:76"
        },
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:77"
        },
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:78"
        },
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:82"
        }
      ]
    },
    {
      "id": "BM-249-B15",
      "text": "In beiden Fällen werden neuer Status, Freigeber und Datum in der Probe fortgeschrieben und ein Historieneintrag mit Status und Anzahl der Toleranzverletzungen angelegt.",
      "anchors": [
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:87"
        },
        {
          "file": "zcl_zqm_a_probe_freigeben.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zqm_a_probe_freigeben.abap:99"
        }
      ]
    }
  ],
