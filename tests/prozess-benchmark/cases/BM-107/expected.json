  "businessStatements": [
    {
      "id": "BM-107-B01",
      "text": "Die Prüfung greift nur für Aufträge des Planungswerks 2000; alle anderen Aufträge werden ohne Prüfung freigegeben.",
      "anchors": [
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:25"
        }
      ]
    },
    {
      "id": "BM-107-B02",
      "text": "Es werden die nicht gelöschten Genehmigungen zum Auftrag gelesen und die noch nicht erteilten gezählt.",
      "anchors": [
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:28"
        },
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:33"
        }
      ]
    },
    {
      "id": "BM-107-B03",
      "text": "Ist mindestens eine Genehmigung nicht erteilt, wird die Freigabe mit einer Fehlermeldung mit Anzahl und Auftragsnummer abgelehnt.",
      "anchors": [
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:37"
        },
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:38"
        }
      ]
    },
    {
      "id": "BM-107-B04",
      "text": "Es werden die Vorgänge des Auftrags mit Steuerschlüssel ZWCM gelesen und dazu die erfassten Freischaltungen.",
      "anchors": [
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:43"
        },
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:47"
        }
      ]
    },
    {
      "id": "BM-107-B05",
      "text": "Ein ZWCM-Vorgang gilt als nicht freigeschaltet, wenn eine seiner Freischaltungen nicht aktiv ist oder gar keine erfasst ist.",
      "anchors": [
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:54"
        },
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:59"
        }
      ]
    },
    {
      "id": "BM-107-B06",
      "text": "Die Prüfung der Vorgänge endet beim ersten nicht freigeschalteten Vorgang.",
      "anchors": [
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:63"
        }
      ]
    },
    {
      "id": "BM-107-B07",
      "text": "Ist ein Vorgang nicht freigeschaltet, wird die Freigabe mit einer Fehlermeldung zu diesem Vorgang abgelehnt; sonst wird der Auftrag freigegeben.",
      "anchors": [
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:68"
        },
        {
          "file": "zcl_im_pm_wcm_release.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_pm_wcm_release.abap:69"
        }
      ]
    }
