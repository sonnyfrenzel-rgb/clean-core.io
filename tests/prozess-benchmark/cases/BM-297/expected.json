  "businessStatements": [
    {
      "id": "BM-297-B01",
      "text": "Zu Prüflos und Vorgang werden die Merkmale mit Sollwert, Toleranzgrenzen, Maßeinheit und Auswahlmenge gelesen; gibt es keine, wird das in Fehleroptik gemeldet und die Erfassung beendet.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:24"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:30"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:31"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:32"
        }
      ]
    },
    {
      "id": "BM-297-B02",
      "text": "Merkmale, zu denen bereits eine Bewertung vorliegt, werden als abgeschlossen markiert.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:36"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:40"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:41"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:42"
        }
      ]
    },
    {
      "id": "BM-297-B03",
      "text": "Die Merkmale werden in einem editierbaren Grid angezeigt, dessen Eingaben bei Enter sofort geprüft werden.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:47"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:65"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:66"
        }
      ]
    },
    {
      "id": "BM-297-B04",
      "text": "Eine Eingabe zu einem abgeschlossenen Merkmal wird mit einem Fehlereintrag im Grid-Protokoll abgewiesen.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:30"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:34"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:35"
        }
      ]
    },
    {
      "id": "BM-297-B05",
      "text": "Für jede andere Eingabe wählt eine Fabrik den Bewerter: Merkmale mit Maßeinheit gelten als quantitativ, alle anderen als qualitativ.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:45"
        },
        {
          "file": "zqm_erg_erfassung_c01.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c01.abap:76"
        }
      ]
    },
    {
      "id": "BM-297-B06",
      "text": "Quantitativ wird der Messwert in eine Zahl umgesetzt; ist er keine Zahl, wird die Eingabe abgewiesen. Liegt er über der oberen oder unter der unteren Toleranzgrenze, ist die Bewertung zurückgewiesen, sonst angenommen.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c01.abap:27"
        },
        {
          "file": "zqm_erg_erfassung_c01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c01.abap:29"
        },
        {
          "file": "zqm_erg_erfassung_c01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c01.abap:34"
        },
        {
          "file": "zqm_erg_erfassung_c01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c01.abap:35"
        },
        {
          "file": "zqm_erg_erfassung_c01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c01.abap:37"
        }
      ]
    },
    {
      "id": "BM-297-B07",
      "text": "Qualitativ wird die Bewertung des eingegebenen Codes aus der Auswahlmenge des Merkmals gelesen; ist der Code dort nicht zulässig, wird die Eingabe abgewiesen.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c01.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c01.abap:51"
        },
        {
          "file": "zqm_erg_erfassung_c01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c01.abap:57"
        },
        {
          "file": "zqm_erg_erfassung_c01.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c01.abap:58"
        }
      ]
    },
    {
      "id": "BM-297-B08",
      "text": "Die ermittelte Bewertung wird ins Grid geschrieben; jede Abweisung erscheint als Fehlereintrag am Feld im Grid-Protokoll.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:49"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:53"
        }
      ]
    },
    {
      "id": "BM-297-B09",
      "text": "Beim Sichern werden zuerst die Grid-Eingaben übernommen; jedes noch offene Merkmal muss bewertet sein, sonst wird das erste unbewertete Merkmal gemeldet.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:96"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:101"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:84"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:69"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:70"
        }
      ]
    },
    {
      "id": "BM-297-B10",
      "text": "Die Ergebnisse der offenen Merkmale werden mit Mittelwert, Code und Bewertung zum Prüfvorgang gebucht; ein Fehler des BAPI wird als Ausnahme weitergegeben.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:95"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:104"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:105"
        }
      ]
    },
    {
      "id": "BM-297-B11",
      "text": "Bei Erfolg wird synchron festgeschrieben und die Buchung nur protokolliert.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:110"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 113,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:113"
        }
      ]
    },
    {
      "id": "BM-297-B12",
      "text": "Verlässt eine Ausnahme den Buchungsblock, wird vorher zurückgerollt und der Rollback protokolliert; dem Laboranten wird die Meldung als Information in Fehleroptik gezeigt.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 116,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:116"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:117"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:104"
        }
      ]
    },
    {
      "id": "BM-297-B13",
      "text": "Gibt es unter den gebuchten Merkmalen eine Zurückweisung, wird die Anlage einer Mängelmeldung für Prüflos und Vorgang asynchron angestoßen, ohne auf ihr Ergebnis zu warten.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:122"
        },
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 123,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:123"
        }
      ]
    },
    {
      "id": "BM-297-B14",
      "text": "Nach erfolgreicher Buchung werden die gebuchten Merkmale gesperrt, Prüflos und Vorgang gemeldet und das Grid aufgefrischt.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c02.abap",
          "line": 132,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c02.abap:132"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:102"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 106,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:106"
        }
      ]
    },
    {
      "id": "BM-297-B15",
      "text": "Beim Verlassen muss der Laborant bestätigen, dass nicht gebuchte Ergebnisse verworfen werden; sonst bleibt er im Grid.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:78"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:85"
        },
        {
          "file": "zqm_erg_erfassung.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung.abap:86"
        }
      ]
    },
    {
      "id": "BM-297-B16",
      "text": "Das Protokoll sammelt nur Texte mit Benutzer und Zeitpunkt und hat keine Wirkung auf den Ablauf.",
      "anchors": [
        {
          "file": "zqm_erg_erfassung_c03.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c03.abap:23"
        },
        {
          "file": "zqm_erg_erfassung_c03.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_erg_erfassung_c03.abap:24"
        }
      ]
    }
  ],
