  "businessStatements": [
    {
      "id": "BM-071-B01",
      "text": "Das MES übergibt je Aufruf eine Vorgangsrückmeldung mit eigener Nachrichten-ID, Auftrag, Vorgang, Gut- und Ausschussmenge, Endrückmeldekennzeichen und Buchungsdatum.",
      "anchors": [
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 1,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:1"
        }
      ]
    },
    {
      "id": "BM-071-B02",
      "text": "Fehlt dem aufrufenden Benutzer die Berechtigung für die MES-Schnittstelle, wird Status E mit „Keine Berechtigung fuer MES-Rueckmeldung“ zurückgegeben, ohne zu protokollieren.",
      "anchors": [
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:30"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:32"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:36"
        }
      ]
    },
    {
      "id": "BM-071-B03",
      "text": "Wurde dieselbe MES-ID bereits erfolgreich gebucht, wird Status D mit dem Hinweis „MES-ID bereits gebucht“ zurückgegeben und nichts erneut gebucht.",
      "anchors": [
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:40"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:43"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:46"
        }
      ]
    },
    {
      "id": "BM-071-B04",
      "text": "Der Fertigungsauftrag wird gesperrt; ist er bereits gesperrt, wird der Sperrkonflikt protokolliert und Status L zurückgegeben, damit das MES später wiederholt.",
      "anchors": [
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:56"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:63"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:68"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:69"
        }
      ]
    },
    {
      "id": "BM-071-B05",
      "text": "Es wird geprüft, ob der Auftrag existiert und ein Fertigungsauftrag ist; sonst lautet das Ergebnis „Kein Fertigungsauftrag“.",
      "anchors": [
        {
          "file": "lzmes_rmf01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:19"
        },
        {
          "file": "lzmes_rmf01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:21"
        }
      ]
    },
    {
      "id": "BM-071-B06",
      "text": "Der Auftrag muss freigegeben sein, sonst lautet das Ergebnis „Auftrag nicht freigegeben“.",
      "anchors": [
        {
          "file": "lzmes_rmf01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:28"
        },
        {
          "file": "lzmes_rmf01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:36"
        }
      ]
    },
    {
      "id": "BM-071-B07",
      "text": "Ein technisch abgeschlossener Auftrag wird mit „Auftrag technisch abgeschlossen“ abgelehnt.",
      "anchors": [
        {
          "file": "lzmes_rmf01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:43"
        },
        {
          "file": "lzmes_rmf01.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:51"
        }
      ]
    },
    {
      "id": "BM-071-B08",
      "text": "Der rückgemeldete Vorgang muss im Arbeitsplan des Auftrags vorhanden sein, sonst lautet das Ergebnis „Vorgang im Auftrag nicht vorhanden“.",
      "anchors": [
        {
          "file": "lzmes_rmf01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:57"
        },
        {
          "file": "lzmes_rmf01.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:59"
        },
        {
          "file": "lzmes_rmf01.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:62"
        }
      ]
    },
    {
      "id": "BM-071-B09",
      "text": "Scheitert die Prüfung, wird die Auftragssperre aufgehoben, der Prüffehler protokolliert und Status E mit dem Prüftext zurückgegeben.",
      "anchors": [
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:73"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:74"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:79"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:80"
        }
      ]
    },
    {
      "id": "BM-071-B10",
      "text": "Bei bestandener Prüfung wird die Vorgangsrückmeldung mit Buchungsdatum, Gutmenge, Ausschuss, Mengeneinheit und Endrückmeldekennzeichen gebucht; die MES-ID steht im Rückmeldetext.",
      "anchors": [
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:83"
        },
        {
          "file": "lzmes_rmf01.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:96"
        },
        {
          "file": "lzmes_rmf01.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:99"
        }
      ]
    },
    {
      "id": "BM-071-B11",
      "text": "Meldet die Buchung einen Fehler, wird zurückgerollt und Status E mit dem Fehlertext gesetzt.",
      "anchors": [
        {
          "file": "lzmes_rmf01.abap",
          "line": 107,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:107"
        },
        {
          "file": "lzmes_rmf01.abap",
          "line": 108,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:108"
        }
      ]
    },
    {
      "id": "BM-071-B12",
      "text": "Sonst wird mit Warten auf die Verbuchung festgeschrieben, Rückmeldenummer und -zähler werden übernommen und Status S gesetzt.",
      "anchors": [
        {
          "file": "lzmes_rmf01.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:114"
        },
        {
          "file": "lzmes_rmf01.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:117"
        }
      ]
    },
    {
      "id": "BM-071-B13",
      "text": "Danach wird die Auftragssperre aufgehoben und das Ergebnis protokolliert.",
      "anchors": [
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:87"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:93"
        }
      ]
    },
    {
      "id": "BM-071-B14",
      "text": "Jeder Protokolleintrag hält MES-ID, Auftrag, Vorgang, Status, Text sowie Datum, Uhrzeit und Benutzer fest und wird sofort festgeschrieben.",
      "anchors": [
        {
          "file": "lzmes_rmf01.abap",
          "line": 138,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:138"
        },
        {
          "file": "lzmes_rmf01.abap",
          "line": 139,
          "token": null,
          "expressionPath": null,
          "raw": "lzmes_rmf01.abap:139"
        }
      ]
    },
    {
      "id": "BM-071-B15",
      "text": "Das MES erhält Status, Rückmeldenummer, Rückmeldezähler und die Meldungstabelle zurück.",
      "anchors": [
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:91"
        },
        {
          "file": "z_mes_rueckmeldung.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "z_mes_rueckmeldung.abap:95"
        }
      ]
    }
  ],
