  "businessStatements": [
    {
      "id": "BM-246-B01",
      "text": "Die App übergibt Equipment, Kurztext und das Kennzeichen „Anlage steht“ für eine neue Störmeldung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        }
      ]
    },
    {
      "id": "BM-246-B02",
      "text": "Fehlen Equipment oder Kurztext, wird die Anlage mit der Meldung ZPM_APP 001 abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        },
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        },
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        }
      ]
    },
    {
      "id": "BM-246-B03",
      "text": "Existiert das Equipment nicht, wird die Anlage mit der Meldung ZPM_APP 002 und der Equipmentnummer abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        },
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        },
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        },
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        }
      ]
    },
    {
      "id": "BM-246-B04",
      "text": "Steht die Anlage, erhält die Meldung Priorität 1 und einen Wunschendtermin morgen, sonst Priorität 3 und einen Wunschendtermin in 14 Tagen; Melder ist der angemeldete Benutzer, Wunschbeginn heute.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        }
      ]
    },
    {
      "id": "BM-246-B05",
      "text": "Es wird eine Instandhaltungsmeldung der Art M2 zum Equipment angelegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        }
      ]
    },
    {
      "id": "BM-246-B06",
      "text": "Meldet die Anlage einen Fehler oder Abbruch, wird verworfen und die BAPI-Meldungen gehen mit der ersten als führender Meldung an die App, die Anfrage wird abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        },
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        },
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        }
      ]
    },
    {
      "id": "BM-246-B07",
      "text": "Sonst wird die Meldung gesichert, erhält ihre endgültige Nummer und wird synchron festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        },
        {
          "file": "source.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:76"
        }
      ]
    },
    {
      "id": "BM-246-B08",
      "text": "Die App erhält die Meldungsnummer als Erfolgsmeldung ZPM_APP 010 im Response-Header sowie Nummer und Priorität in der Antwort.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:81"
        },
        {
          "file": "source.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:90"
        }
      ]
    }
  ],
