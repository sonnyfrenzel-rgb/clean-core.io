  "businessStatements": [
    {
      "id": "BM-088-B01",
      "text": "Die Buchungsdatei des Zutrittskontrollsystems wird vom Applikationsserver gelesen; ist sie nicht lesbar, bricht der Job mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        },
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        },
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        }
      ]
    },
    {
      "id": "BM-088-B02",
      "text": "Für abgewiesene Zeilen wird eine Fehlerdatei angelegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:24"
        }
      ]
    },
    {
      "id": "BM-088-B03",
      "text": "Jede Zeile wird in Personalnummer, Datum, Uhrzeit und Satzart zerlegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        },
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:31"
        }
      ]
    },
    {
      "id": "BM-088-B04",
      "text": "Zeilen mit einer anderen Satzart als Kommen (P10) oder Gehen (P20) gehen in die Fehlerdatei.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        },
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        }
      ]
    },
    {
      "id": "BM-088-B05",
      "text": "Ist der Mitarbeiter am Buchungstag nicht aktiv beschäftigt (Status 3), geht die Zeile in die Fehlerdatei.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        },
        {
          "file": "source.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:49"
        },
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        }
      ]
    },
    {
      "id": "BM-088-B06",
      "text": "Gültige Buchungen werden mit Erfassungsdatum und -benutzer gespeichert; bereits vorhandene Buchungen gehen als Dublette in die Fehlerdatei.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        },
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-088-B07",
      "text": "Nach dem Dateiende werden die übernommenen Buchungen festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        }
      ]
    },
    {
      "id": "BM-088-B08",
      "text": "Nur wenn keine Zeile abgewiesen wurde, wird die Eingangsdatei gelöscht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:69"
        },
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        }
      ]
    },
    {
      "id": "BM-088-B09",
      "text": "Zum Schluss werden die Anzahl übernommener und abgewiesener Zeilen ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        },
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        }
      ]
    }
  ],
