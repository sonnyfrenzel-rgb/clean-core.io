  "businessStatements": [
    {
      "id": "BM-224-B01",
      "text": "Abwesenheiten der Art 0200 (Krankheit) werden ohne weitere Prüfung als zulässig zurückgegeben.",
      "anchors": [
        {
          "file": "lzhr_abwu01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:23"
        },
        {
          "file": "lzhr_abwu01.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:24"
        },
        {
          "file": "lzhr_abwu01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:25"
        }
      ]
    },
    {
      "id": "BM-224-B02",
      "text": "Es wird geprüft, ob sich der beantragte Zeitraum mit bestehenden, nicht gesperrten Abwesenheiten des Mitarbeiters überschneidet.",
      "anchors": [
        {
          "file": "lzhr_abwu01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:29"
        }
      ]
    },
    {
      "id": "BM-224-B03",
      "text": "Bei einer Überschneidung endet die Prüfung mit einer Fehlermeldung und der Ausnahme UEBERSCHNEIDUNG.",
      "anchors": [
        {
          "file": "lzhr_abwu01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:34"
        },
        {
          "file": "lzhr_abwu01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:35"
        }
      ]
    },
    {
      "id": "BM-224-B04",
      "text": "Der Antrag umfasst die Kalendertage von Beginn bis Ende einschließlich.",
      "anchors": [
        {
          "file": "lzhr_abwu01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:38"
        }
      ]
    },
    {
      "id": "BM-224-B05",
      "text": "Das Restkontingent ergibt sich aus den am Beginndatum abtragbaren Urlaubskontingenten der Arten 10 und 11 als Anspruch minus Verbrauch.",
      "anchors": [
        {
          "file": "lzhr_abwu01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:40"
        },
        {
          "file": "lzhr_abwf01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwf01.abap:12"
        },
        {
          "file": "lzhr_abwf01.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwf01.abap:20"
        }
      ]
    },
    {
      "id": "BM-224-B06",
      "text": "Ohne abtragbares Kontingent bleibt der Rest null.",
      "anchors": [
        {
          "file": "lzhr_abwf01.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwf01.abap:17"
        }
      ]
    },
    {
      "id": "BM-224-B07",
      "text": "Reicht der Rest nicht für die beantragten Tage, endet die Prüfung mit Fehlermeldung und der Ausnahme KONTINGENT_ERSCHOEPFT.",
      "anchors": [
        {
          "file": "lzhr_abwu01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:43"
        },
        {
          "file": "lzhr_abwu01.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:44"
        }
      ]
    },
    {
      "id": "BM-224-B08",
      "text": "Bleiben nach dem Antrag weniger als drei Tage übrig, wird ein Hinweis ausgegeben, der Antrag bleibt zulässig.",
      "anchors": [
        {
          "file": "lzhr_abwu01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:47"
        }
      ]
    },
    {
      "id": "BM-224-B09",
      "text": "In allen übrigen Fällen wird der Antrag als zulässig gekennzeichnet.",
      "anchors": [
        {
          "file": "lzhr_abwu01.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "lzhr_abwu01.abap:50"
        }
      ]
    }
  ],
