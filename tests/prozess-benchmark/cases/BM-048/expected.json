  "businessStatements": [
    {
      "id": "BM-048-B01",
      "text": "Es werden alle nicht deaktivierten Anlagen der gewählten Buchungskreise und Anlagenklassen mit ihren Jahreswerten für Geschäftsjahr und Bewertungsbereich (Vorschlag 01) gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        }
      ]
    },
    {
      "id": "BM-048-B02",
      "text": "Werden keine Anlagen gefunden, erhält der Anwender einen Hinweis und der Report endet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        },
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        },
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        }
      ]
    },
    {
      "id": "BM-048-B03",
      "text": "Je Anlage werden der Anschaffungswert (kumulierter Stand plus wertmäßige Bewegungen des Jahres), die kumulierte AfA (normal, Sonder- und außerplanmäßig) und daraus der Restbuchwert berechnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        },
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        }
      ]
    },
    {
      "id": "BM-048-B04",
      "text": "Anlagen mit Anschaffungswert, aber ohne Restbuchwert gelten als voll abgeschrieben; Anlagen ohne Aktivierungsdatum als nicht aktiviert; alle übrigen als in Nutzung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:74"
        },
        {
          "file": "source.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:75"
        },
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        },
        {
          "file": "source.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:79"
        }
      ]
    },
    {
      "id": "BM-048-B05",
      "text": "Ist die Option „nur Restbuchwert null“ gesetzt, werden Anlagen mit positivem Restbuchwert nicht in die Liste übernommen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:82"
        }
      ]
    },
    {
      "id": "BM-048-B06",
      "text": "Die Ergebnisliste wird als ALV mit allen Standardfunktionen angezeigt; kann das ALV nicht erzeugt werden, bricht der Report mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:88"
        },
