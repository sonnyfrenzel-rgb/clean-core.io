  "businessStatements": [
    {
      "id": "BM-193-B01",
      "text": "Beim Öffnen der Unfallmeldung wird die Meldungsnummer aus dem Aufruf übernommen und die Meldung geladen.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:13"
        },
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:17"
        }
      ]
    },
    {
      "id": "BM-193-B02",
      "text": "Ohne Meldungsnummer wird eine neue Meldung angelegt und mit dem erfassenden Benutzer, dem Tagesdatum und dem Status „in Erfassung“ vorbelegt.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:18"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:23"
        }
      ]
    },
    {
      "id": "BM-193-B03",
      "text": "Mit Meldungsnummer wird die vorhandene Unfallmeldung gelesen und als Vergleichsstand für den Änderungsbeleg gemerkt.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:28"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:37"
        }
      ]
    },
    {
      "id": "BM-193-B04",
      "text": "Gibt es die Meldung nicht, erhält der Benutzer die Fehlermeldung, dass sie nicht gefunden wurde, und die Maske bleibt leer.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:30"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:31"
        }
      ]
    },
    {
      "id": "BM-193-B05",
      "text": "Beim Sichern wird zuerst geprüft, ob Personalnummer, Werk, Unfalldatum, Unfallzeit, Unfallort, Hergang und Verletzung gefüllt sind.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:26"
        },
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:59"
        }
      ]
    },
    {
      "id": "BM-193-B06",
      "text": "Jedes leere Pflichtfeld wird am Feld als Fehler markiert; ein Feld, das es in der Maske nicht gibt, wird ohne Meldung übergangen.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:60"
        },
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:61"
        },
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:63"
        }
      ]
    },
    {
      "id": "BM-193-B07",
      "text": "Fehlt mindestens ein Pflichtfeld, wird nicht gesichert.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:27"
        },
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:28"
        }
      ]
    },
    {
      "id": "BM-193-B08",
      "text": "Eine neue Unfallmeldung erhält ihre Nummer aus dem Nummernkreis ZEHS_UNF.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:57"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:58"
        }
      ]
    },
    {
      "id": "BM-193-B09",
      "text": "Kann keine Nummer vergeben werden, wird der Benutzer auf den Nummernkreis hingewiesen und nicht gesichert.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:66"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:67"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:70"
        }
      ]
    },
    {
      "id": "BM-193-B10",
      "text": "Ein Unfall mit mehr als drei Ausfalltagen wird als meldepflichtig gekennzeichnet, sonst als nicht meldepflichtig.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:78"
        }
      ]
    },
    {
      "id": "BM-193-B11",
      "text": "Eine Meldung im Status 01 („in Erfassung“) wird beim Sichern auf Status 02 gesetzt, und der ändernde Benutzer mit Datum wird festgehalten.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:80"
        }
      ]
    },
    {
      "id": "BM-193-B12",
      "text": "Die Unfallmeldung wird in der Unfalltabelle angelegt oder überschrieben.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:84"
        }
      ]
    },
    {
      "id": "BM-193-B13",
      "text": "Schlägt das Schreiben fehl, wird alles zurückgenommen und der Benutzer erhält eine Fehlermeldung.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:85"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:86"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:87"
        }
      ]
    },
    {
      "id": "BM-193-B14",
      "text": "Für die Meldung wird ein Änderungsbeleg mit altem und neuem Stand fortgeschrieben, als Neuanlage oder als Änderung.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:97"
        }
      ]
    },
    {
      "id": "BM-193-B15",
      "text": "Meldung und Änderungsbeleg werden gemeinsam festgeschrieben, und die vergebene Nummer wird in der Maske angezeigt.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 108,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:108"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:111"
        }
      ]
    },
    {
      "id": "BM-193-B16",
      "text": "Nur wenn ein Unfall mit diesem Sichern erstmals meldepflichtig wird, wird die Sicherheitsfachkraft benachrichtigt.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:114"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:115"
        }
      ]
    },
    {
      "id": "BM-193-B17",
      "text": "Die Benachrichtigung wird nur verschickt, wenn der Mailversand über den Schalter ZEHS_UNFALL_MAIL eingeschaltet ist.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 135,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:135"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 139,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:139"
        }
      ]
    },
    {
      "id": "BM-193-B18",
      "text": "Empfänger ist die Sicherheitsfachkraft des Werks, ohne Eintrag das Sammelpostfach der Arbeitssicherheit.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 144,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:144"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 147,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:147"
        }
      ]
    },
    {
      "id": "BM-193-B19",
      "text": "Die Mail nennt Meldungsnummer, Werk, Unfalldatum und Ausfalltage und erinnert an die Unfallanzeige an die Berufsgenossenschaft binnen drei Tagen.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 150,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:150"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 165,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:165"
        }
      ]
    },
    {
      "id": "BM-193-B20",
      "text": "Scheitert der Mailversand, erhält der Benutzer nur eine Warnung; die gesicherte Meldung bleibt bestehen.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 167,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:167"
        },
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 168,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:168"
        }
      ]
    },
    {
      "id": "BM-193-B21",
      "text": "Nach erfolgreichem Sichern wird die Meldung bestätigt, die Maske schreibgeschützt und zur Bestätigungsseite gewechselt.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_compctrl.abap",
          "line": 118,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_compctrl.abap:118"
        },
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:37"
        },
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:38"
        }
      ]
    },
    {
      "id": "BM-193-B22",
      "text": "Ist das Sichern gescheitert, bleibt der Benutzer mit den Meldungen in der Erfassungsmaske.",
      "anchors": [
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:32"
        },
        {
          "file": "zwd_ehs_unfall_v_main.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_ehs_unfall_v_main.abap:34"
        }
      ]
    }
  ],
