  "businessStatements": [
    {
      "id": "BM-014-B01",
      "text": "Es werden Lieferungen der gewählten Verkaufsorganisationen und Versandstellen ermittelt, deren Warenausgang bis zum Fakturadatum gebucht ist, die noch nicht oder nur teilweise fakturiert sind und keine Fakturasperre haben.",
      "anchors": [
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:12"
        }
      ]
    },
    {
      "id": "BM-014-B02",
      "text": "Gibt es keine solchen Lieferungen, wird nur die Meldung 400 protokolliert und der Job endet.",
      "anchors": [
        {
          "file": "zsd_billing_run.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:35"
        },
        {
          "file": "zsd_billing_run.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:37"
        },
        {
          "file": "zsd_billing_run.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:38"
        }
      ]
    },
    {
      "id": "BM-014-B03",
      "text": "Für jede betroffene Verkaufsorganisation wird ein Sammellauf durchgeführt.",
      "anchors": [
        {
          "file": "zsd_billing_run.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:41"
        },
        {
          "file": "zsd_billing_run.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:42"
        }
      ]
    },
    {
      "id": "BM-014-B04",
      "text": "Läuft für die Verkaufsorganisation bereits ein Sammellauf, wird sie mit Fehler 401 übersprungen.",
      "anchors": [
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:34"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:41"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:44"
        }
      ]
    },
    {
      "id": "BM-014-B05",
      "text": "Im Echtlauf wird der Standard-Faktura-Sammellauf für genau die ermittelten Lieferungen dieser Verkaufsorganisation zum Fakturadatum gestartet und das mit Meldung 402 protokolliert.",
      "anchors": [
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:57"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:58"
        }
      ]
    },
    {
      "id": "BM-014-B06",
      "text": "Im Testlauf wird nur protokolliert, wie viele Selektionszeilen übergeben würden.",
      "anchors": [
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:57"
        }
      ]
    },
    {
      "id": "BM-014-B07",
      "text": "Danach wird die Sperre der Verkaufsorganisation gelöst.",
      "anchors": [
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:67"
        }
      ]
    },
    {
      "id": "BM-014-B08",
      "text": "Im Echtlauf wird anschließend für jede ermittelte Lieferung geprüft, ob eine Rechnung als Folgebeleg existiert.",
      "anchors": [
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:80"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:82"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:88"
        }
      ]
    },
    {
      "id": "BM-014-B09",
      "text": "Jede Lieferung ohne Rechnung wird gezählt und mit Warnung 404 samt Auftraggeber protokolliert.",
      "anchors": [
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:90"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:91"
        }
      ]
    },
    {
      "id": "BM-014-B10",
      "text": "Alle gesammelten Meldungen werden in einem Anwendungsprotokoll ZSD/BILLRUN mit 90 Tagen Aufbewahrung gesichert und festgeschrieben.",
      "anchors": [
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:111"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 120,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:120"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 129,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:129"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 134,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:134"
        }
      ]
    },
    {
      "id": "BM-014-B11",
      "text": "Gibt es Lieferungen ohne Rechnung und ist eine Mailadresse angegeben, erhält diese eine Mail mit der Anzahl und dem Verweis auf das Protokoll.",
      "anchors": [
        {
          "file": "zsd_billing_run.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run.abap:48"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 152,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:152"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 159,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:159"
        },
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 160,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:160"
        }
      ]
    },
    {
      "id": "BM-014-B12",
      "text": "Scheitert der Mailversand, wird nur eine Meldung ausgegeben.",
      "anchors": [
        {
          "file": "zsd_billing_run_f01.abap",
          "line": 162,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_billing_run_f01.abap:162"
        }
      ]
    }
  ],
