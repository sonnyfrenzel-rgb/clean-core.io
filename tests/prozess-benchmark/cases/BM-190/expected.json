  "businessStatements": [
    {
      "id": "BM-190-B01",
      "text": "Der Stellplatz wird bis zu fünfmal exklusiv zu sperren versucht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        },
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        }
      ]
    },
    {
      "id": "BM-190-B02",
      "text": "Ist der Platz von einem anderen Gate-Rechner gesperrt, wird zwei Sekunden gewartet und erneut versucht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        },
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        }
      ]
    },
    {
      "id": "BM-190-B03",
      "text": "Bei einem technischen Sperrfehler wird die Reservierung mit der Ausnahme SPERRFEHLER abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        },
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        }
      ]
    },
    {
      "id": "BM-190-B04",
      "text": "Nach fünf erfolglosen Versuchen läuft die Reservierung ohne Sperre weiter, weil die anschließende Prüfung das Ergebnis der Wartepause statt des Sperrversuchs auswertet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        },
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        }
      ]
    },
    {
      "id": "BM-190-B05",
      "text": "Der Stellplatz wird gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        }
      ]
    },
    {
      "id": "BM-190-B06",
      "text": "Existiert der Platz nicht oder ist er nicht frei, wird die Sperre aufgehoben und die Reservierung mit PLATZ_BELEGT abgelehnt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        },
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        }
      ]
    },
    {
      "id": "BM-190-B07",
      "text": "Das Reservierungsende wird aus dem aktuellen Zeitpunkt plus der angegebenen Stundenzahl (Standard 24) berechnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        }
      ]
    },
    {
      "id": "BM-190-B08",
      "text": "Der Platz wird mit Status R für den Container reserviert und gespeichert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        }
      ]
    },
    {
      "id": "BM-190-B09",
      "text": "Danach wird die Sperre des Stellplatzes aufgehoben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        }
      ]
    }
  ],
