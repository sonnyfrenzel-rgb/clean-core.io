  "businessStatements": [
    {
      "id": "BM-288-B01",
      "text": "Nach dem Start der Kasse für Verkaufsorganisation, Verkaufsbüro und Kassennummer wird das Kassenbild aufgerufen.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:17"
        },
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:20"
        }
      ]
    },
    {
      "id": "BM-288-B02",
      "text": "Beim ersten Aufbau wird das editierbare Positionsgrid angelegt, auf Zelländerungen registriert, der Preisbehandler angemeldet und die leere Positionsliste angezeigt.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:29"
        },
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:39"
        },
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:41"
        }
      ]
    },
    {
      "id": "BM-288-B03",
      "text": "Bei jeder Aktion werden offene Eingaben im Grid übernommen, was die Prüfung der geänderten Zellen auslöst.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:54"
        }
      ]
    },
    {
      "id": "BM-288-B04",
      "text": "Für jede geänderte Materialzelle wird der am Tag gültige Konditionssatz Grundpreis PR00 für Verkaufsorganisation, Vertriebsweg 10 und Material gesucht.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:27"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:33"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:34"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:37"
        }
      ]
    },
    {
      "id": "BM-288-B05",
      "text": "Gibt es keinen gültigen Preis, wird am Material ein Fehlereintrag im Grid-Protokoll erzeugt und mit der nächsten geänderten Zelle fortgefahren.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:45"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:46"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:53"
        }
      ]
    },
    {
      "id": "BM-288-B06",
      "text": "Sonst wird der Konditionsbetrag gelesen und als Preis in die Position übernommen.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:55"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:58"
        }
      ]
    },
    {
      "id": "BM-288-B07",
      "text": "Mit BUCHEN wird der Barverkauf gebucht; ohne Positionen geschieht nichts.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:57"
        },
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:58"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:81"
        }
      ]
    },
    {
      "id": "BM-288-B08",
      "text": "Der Bonbetrag wird als Summe aus Menge mal Preis aller Positionen ermittelt und der Kassierer bestätigt in einer Rückfrage, dass dieser Betrag kassiert ist; ohne Bestätigung wird nicht gebucht.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:83"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:93"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:100"
        }
      ]
    },
    {
      "id": "BM-288-B09",
      "text": "Es wird ein Sofortauftrag der Auftragsart ZBV an den CPD-Barverkaufskunden mit Verkaufsbüro und Kassenkennung als Bestellnummer angelegt.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:110"
        }
      ]
    },
    {
      "id": "BM-288-B10",
      "text": "Kommt keine Auftragsnummer zurück, wird zurückgerollt, die erste Fehlermeldung als Information in Fehleroptik angezeigt und die Buchung beendet.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:121"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:122"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 124,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:124"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 125,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:125"
        }
      ]
    },
    {
      "id": "BM-288-B11",
      "text": "Sonst wird der Auftrag synchron festgeschrieben und der Verkauf mit Kasse, Zeitpunkt, Auftrag, Betrag und Kassierer ins Kassenjournal für den Tagesabschluss geschrieben.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 128,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:128"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 140,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:140"
        }
      ]
    },
    {
      "id": "BM-288-B12",
      "text": "Auftragsnummer und Betrag werden als Erfolgsmeldung angezeigt und die Positionen für den nächsten Kunden geleert.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 142,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:142"
        },
        {
          "file": "zsd_kasse_barverkauf_c01.abap",
          "line": 143,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf_c01.abap:143"
        }
      ]
    },
    {
      "id": "BM-288-B13",
      "text": "Zurück oder Beenden mit offenen Positionen verlangt die Bestätigung, dass diese verworfen werden; ohne Bestätigung bleibt der Kassierer auf dem Bild, sonst wird das Kassenbild verlassen.",
      "anchors": [
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:60"
        },
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:61"
        },
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:62"
        },
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:69"
        },
        {
          "file": "zsd_kasse_barverkauf.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasse_barverkauf.abap:74"
        }
      ]
    }
  ],
