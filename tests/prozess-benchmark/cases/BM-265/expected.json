  "businessStatements": [
    {
      "id": "BM-265-B01",
      "text": "Zu Lagernummer und Spediteur wird die Schnittstellenkonfiguration für die Abfahrtsmeldung (RFC-Destination, Versuchszahl, Wartezeit) gelesen.",
      "anchors": [
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:24"
        }
      ]
    },
    {
      "id": "BM-265-B02",
      "text": "Fehlt die Konfiguration oder die Destination, endet der Baustein mit der Ausnahme NO_DESTINATION, ohne zu senden.",
      "anchors": [
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:28"
        },
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:29"
        }
      ]
    },
    {
      "id": "BM-265-B03",
      "text": "Ist keine Wartezeit gepflegt, wird mit fünf Sekunden begonnen.",
      "anchors": [
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:33"
        },
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:34"
        }
      ]
    },
    {
      "id": "BM-265-B04",
      "text": "Die Abfahrt der Transporteinheit wird synchron an das Speditionssystem gemeldet, höchstens so oft wie konfiguriert.",
      "anchors": [
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:37"
        },
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:39"
        }
      ]
    },
    {
      "id": "BM-265-B05",
      "text": "Nimmt die Gegenstelle die Meldung an, ist die Zustellung erfolgreich und es wird nicht weiter versucht.",
      "anchors": [
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:49"
        },
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:51"
        }
      ]
    },
    {
      "id": "BM-265-B06",
      "text": "Bei einem Kommunikationsfehler wird gewartet und erneut gesendet, wobei sich die Wartezeit mit jedem Versuch verdoppelt.",
      "anchors": [
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:55"
        }
      ]
    },
    {
      "id": "BM-265-B07",
      "text": "Bei einem Systemfehler oder Anwendungsfehler der Gegenstelle wird nicht wiederholt.",
      "anchors": [
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:49"
        }
      ]
    },
    {
      "id": "BM-265-B08",
      "text": "Konnte die Meldung nicht zugestellt werden, wird sie mit Versuchszahl und Fehlertext in die Retry-Queue für die spätere Nachverarbeitung eingetragen und der Baustein endet mit SEND_FAILED.",
      "anchors": [
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:63"
        },
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:70"
        },
        {
          "file": "z_ewm_tu_notify_carrier.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "z_ewm_tu_notify_carrier.abap:71"
        }
      ]
    }
  ],
