  "businessStatements": [
    {
      "id": "BM-191-B01",
      "text": "Es werden die aktiven Veranstaltungen der Planvariante gelesen, deren Ende im gewählten Zeitraum liegt.",
      "anchors": [
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:14"
        }
      ]
    },
    {
      "id": "BM-191-B02",
      "text": "Gibt es keine solche Veranstaltung, wird ein Hinweis ausgegeben und die Verarbeitung ohne Druck beendet.",
      "anchors": [
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:22"
        },
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:23"
        },
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:24"
        }
      ]
    },
    {
      "id": "BM-191-B03",
      "text": "Abgesagte Veranstaltungen werden aus der Druckmenge entfernt.",
      "anchors": [
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:29"
        },
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:36"
        }
      ]
    },
    {
      "id": "BM-191-B04",
      "text": "Zu den verbleibenden Veranstaltungen werden die aktiven Teilnahmebeziehungen zu den Teilnehmern gelesen.",
      "anchors": [
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:40"
        }
      ]
    },
    {
      "id": "BM-191-B05",
      "text": "Für alle Bestätigungen wird ein gemeinsamer Druckauftrag ohne Dialog geöffnet, bei Vorschau ohne sofortige Ausgabe; scheitert das, bricht der Lauf mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zpe_teilnbest.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:26"
        },
        {
          "file": "zpe_teilnbest.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:27"
        },
        {
          "file": "zpe_teilnbest.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:37"
        }
      ]
    },
    {
      "id": "BM-191-B06",
      "text": "Zum Formular ZPE_TEILNAHMEBEST wird der Formularbaustein ermittelt; ist das Formular nicht verwendbar, bricht der Lauf mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zpe_teilnbest.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:42"
        },
        {
          "file": "zpe_teilnbest.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:48"
        }
      ]
    },
    {
      "id": "BM-191-B07",
      "text": "Für interne Mitarbeiter wird der zum Veranstaltungsende gültige Name aus den Personaldaten gelesen, ersatzweise die Personalnummer verwendet.",
      "anchors": [
        {
          "file": "zpe_teilnbest.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:64"
        },
        {
          "file": "zpe_teilnbest.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:69"
        }
      ]
    },
    {
      "id": "BM-191-B08",
      "text": "Für externe Personen wird die Bezeichnung des Personenobjekts als Name verwendet.",
      "anchors": [
        {
          "file": "zpe_teilnbest.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:77"
        }
      ]
    },
    {
      "id": "BM-191-B09",
      "text": "Andere Teilnehmerarten wie Firmen oder Kunden erhalten keine Einzelbestätigung.",
      "anchors": [
        {
          "file": "zpe_teilnbest.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:61"
        },
        {
          "file": "zpe_teilnbest.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:86"
        }
      ]
    },
    {
      "id": "BM-191-B10",
      "text": "Eine bereits protokollierte Bestätigung wird nur bei gesetztem Wiederholungskennzeichen erneut gedruckt.",
      "anchors": [
        {
          "file": "zpe_teilnbest.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:90"
        },
        {
          "file": "zpe_teilnbest.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:95"
        }
      ]
    },
    {
      "id": "BM-191-B11",
      "text": "Die Teilnahmebestätigung wird mit Veranstaltungs- und Teilnehmerdaten über das Adobe-Formular ausgegeben.",
      "anchors": [
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:74"
        }
      ]
    },
    {
      "id": "BM-191-B12",
      "text": "Scheitert die Ausgabe, wird der Teilnehmer als Fehler in der Liste gezählt und nicht protokolliert.",
      "anchors": [
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:86"
        },
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:88"
        }
      ]
    },
    {
      "id": "BM-191-B13",
      "text": "Außerhalb der Vorschau wird der erfolgreiche Druck mit Datum und Benutzer im Druckprotokoll festgehalten.",
      "anchors": [
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:94"
        },
        {
          "file": "zpe_teilnbest_f01.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest_f01.abap:101"
        }
      ]
    },
    {
      "id": "BM-191-B14",
      "text": "Am Ende einer Veranstaltung wird eine Zeile mit der Zahl der für sie gedruckten Bestätigungen ausgegeben.",
      "anchors": [
        {
          "file": "zpe_teilnbest.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:99"
        },
        {
          "file": "zpe_teilnbest.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:100"
        }
      ]
    },
    {
      "id": "BM-191-B15",
      "text": "Der Druckauftrag wird geschlossen und die Gesamtzahl gedruckter und fehlerhafter Bestätigungen ausgegeben.",
      "anchors": [
        {
          "file": "zpe_teilnbest.abap",
          "line": 106,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:106"
        },
        {
          "file": "zpe_teilnbest.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:117"
        },
        {
          "file": "zpe_teilnbest.abap",
          "line": 118,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_teilnbest.abap:118"
        }
      ]
    }
  ],
