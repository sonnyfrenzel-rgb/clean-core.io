  "businessStatements": [
    {
      "id": "BM-223-B01",
      "text": "Es werden alle am Tagesdatum gültigen Kostenstellen des eingegebenen Kostenrechnungskreises im gewählten Bereich gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        }
      ]
    },
    {
      "id": "BM-223-B02",
      "text": "Findet der Report keine Kostenstelle, bricht er mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        },
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        }
      ]
    },
    {
      "id": "BM-223-B03",
      "text": "Kostenstellen, die bereits für Ist-Primärkosten gesperrt sind, werden übersprungen und gezählt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        }
      ]
    },
    {
      "id": "BM-223-B04",
      "text": "Für jede weitere Kostenstelle wird die Änderungsberechtigung geprüft; fehlt sie, wird „Keine Berechtigung“ protokolliert und die Kostenstelle ausgelassen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        },
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        },
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        }
      ]
    },
    {
      "id": "BM-223-B05",
      "text": "Im Testlauf wird je Kostenstelle nur protokolliert, dass sie gesperrt würde.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        },
        {
          "file": "source.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:53"
        }
      ]
    },
    {
      "id": "BM-223-B06",
      "text": "Im Echtlauf wird das Sperrkennzeichen für Ist-Primärkosten direkt im Kostenstellenstamm gesetzt und gezählt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        }
      ]
    },
    {
      "id": "BM-223-B07",
      "text": "Nach der Schleife werden die Änderungen festgeschrieben und die Anzahl gesperrter und übersprungener Kostenstellen gemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        },
        {
          "file": "source.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:65"
        }
      ]
    }
  ],
