  "businessStatements": [
    {
      "id": "BM-064-B01",
      "text": "Die Prüfung greift nur bei der Freigabe von Aufträgen der Werke 1000 und 1100; für andere Werke wird die Freigabe ohne Prüfung zugelassen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 8,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:8"
        }
      ]
    },
    {
      "id": "BM-064-B02",
      "text": "Für Material und Werk des Auftrags wird eine nicht gelöschte Zuordnung zu einem Prüfplan (Plantyp Q) gesucht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:11"
        }
      ]
    },
    {
      "id": "BM-064-B03",
      "text": "Fehlt ein Prüfplan, wird der Hinweis „Kein Pruefplan fuer Material … – Freigabe nicht moeglich“ ausgegeben und die Freigabe über die Ausnahme ERROR abgelehnt.",
