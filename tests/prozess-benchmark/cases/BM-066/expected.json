  "businessStatements": [
    {
      "id": "BM-066-B01",
      "text": "Die vom MES bereitgestellte Rückmeldedatei wird auf dem Applikationsserver geöffnet; gelingt das nicht, wird „Datei kann nicht geoeffnet werden“ gemeldet und abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        },
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        },
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        },
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        }
      ]
    },
    {
      "id": "BM-066-B02",
      "text": "Die Datei wird bis zum Ende zeilenweise gelesen; jede Zeile liefert Auftrag, Vorgang, Gutmenge, Ausschuss, Mengeneinheit und Endrückmeldekennzeichen, die Auftragsnummer wird mit führenden Nullen aufgefüllt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        },
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        },
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        },
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        }
      ]
    },
    {
      "id": "BM-066-B03",
      "text": "Nach dem Einlesen wird die Datei geschlossen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        }
      ]
    },
    {
      "id": "BM-066-B04",
      "text": "Je Zeile wird eine Vorgangsrückmeldung mit Gutmenge und Ausschuss gebildet; ist das Kennzeichen gesetzt, als Endrückmeldung, sonst als Teilrückmeldung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-066-B05",
      "text": "Die Rückmeldung wird einzeln an die Rückmelde-BAPI übergeben, im Testlauf nur simuliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:66"
        }
      ]
    },
    {
      "id": "BM-066-B06",
      "text": "Meldet die BAPI einen Fehler, wird die Zeile zurückgerollt und mit „FEHLER“ und Meldungstext protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:76"
        },
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        },
        {
          "file": "source.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:79"
        }
      ]
    },
    {
      "id": "BM-066-B07",
      "text": "Fehlerfreie Zeilen werden im Echtlauf mit Warten auf die Verbuchung festgeschrieben und mit „OK“ protokolliert; im Testlauf wird nur „OK“ protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:81"
        },
        {
          "file": "source.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:82"
        },
        {
          "file": "source.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:87"
        }
      ]
    },
    {
      "id": "BM-066-B08",
      "text": "Am Ende werden die Anzahl erfolgreicher und fehlerhafter Zeilen ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:92"
        }
      ]
    }
  ],
