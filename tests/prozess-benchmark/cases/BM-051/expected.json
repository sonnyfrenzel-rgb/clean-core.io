  "businessStatements": [
    {
      "id": "BM-051-B01",
      "text": "Vor der Dateierzeugung wird geprüft, ob der Anwender für den zahlenden Buchungskreis Zahlungsträger erstellen darf; sonst bricht der Report mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zfi_payfile_f01.abap",
          "line": 9,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:9"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:12"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:13"
        }
      ]
    },
    {
      "id": "BM-051-B02",
      "text": "Der Zahllauf zu Laufdatum und Identifikation muss existieren und echt ausgeführt sein, sonst bricht der Report ab.",
      "anchors": [
        {
          "file": "zfi_payfile_f01.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:16"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:19"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:20"
        }
      ]
    },
    {
      "id": "BM-051-B03",
      "text": "Gelesen werden die Zahlungen des Echtlaufs für den zahlenden Buchungskreis und die gewählte Zahlungsmethode (Vorschlag U = Überweisung).",
      "anchors": [
        {
          "file": "zfi_payfile.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile.abap:36"
        }
      ]
    },
    {
      "id": "BM-051-B04",
      "text": "Gibt es keine Zahlungen, erhält der Anwender einen Hinweis und der Report endet.",
      "anchors": [
        {
          "file": "zfi_payfile.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile.abap:42"
        },
        {
          "file": "zfi_payfile.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile.abap:43"
        },
        {
          "file": "zfi_payfile.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile.abap:44"
        }
      ]
    },
    {
      "id": "BM-051-B05",
      "text": "Zahlungen ohne IBAN oder BIC des Empfängers werden nicht in die Datei übernommen, sondern mit Grund in einer Fehlerliste gesammelt.",
      "anchors": [
        {
          "file": "zfi_payfile_f01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:43"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:48"
        }
      ]
    },
    {
      "id": "BM-051-B06",
      "text": "Der Verwendungszweck wird aus den Referenznummern der mit der Zahlung beglichenen Rechnungen gebildet und auf 140 Zeichen gekürzt.",
      "anchors": [
        {
          "file": "zfi_payfile_f01.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:53"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:62"
        }
      ]
    },
    {
      "id": "BM-051-B07",
      "text": "Je Zahlung entsteht ein Einzelsatz mit Zahlungsbelegnummer, Empfängername, IBAN, BIC, Betrag (als positiver Wert), Währung und Verwendungszweck.",
      "anchors": [
        {
          "file": "zfi_payfile_f01.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:68"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:70"
        }
      ]
    },
    {
      "id": "BM-051-B08",
      "text": "Anzahl und Kontrollsumme der Zahlungen werden fortgeschrieben; die Summe addiert Beträge unabhängig von ihrer Währung.",
      "anchors": [
        {
          "file": "zfi_payfile_f01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:74"
        }
      ]
    },
    {
      "id": "BM-051-B09",
      "text": "Nur im Echtlauf wird die Datei auf dem Applikationsserver geschrieben; lässt sie sich nicht öffnen, bricht der Report mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zfi_payfile.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile.abap:49"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:84"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:85"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:86"
        }
      ]
    },
    {
      "id": "BM-051-B10",
      "text": "Die Datei besteht aus einem Kopfsatz mit Buchungskreis, Lauf und Erstelldatum, den Einzelsätzen und einem Summensatz mit Anzahl und Kontrollsumme.",
      "anchors": [
        {
          "file": "zfi_payfile_f01.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:91"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:94"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:98"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:99"
        }
      ]
    },
    {
      "id": "BM-051-B11",
      "text": "Im Echtlauf wird die Dateierzeugung mit Datei, Anzahl, Summe, Benutzer und Zeitpunkt in einer kundeneigenen Protokolltabelle festgehalten.",
      "anchors": [
        {
          "file": "zfi_payfile_f01.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:117"
        }
      ]
    },
    {
      "id": "BM-051-B12",
      "text": "Existiert für den Lauf bereits ein Protokollsatz, wird nur ein Hinweis ausgegeben; die Datei ist dann trotzdem neu geschrieben.",
      "anchors": [
        {
          "file": "zfi_payfile_f01.abap",
          "line": 118,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:118"
        },
        {
          "file": "zfi_payfile_f01.abap",
          "line": 120,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile_f01.abap:120"
        }
      ]
    },
    {
      "id": "BM-051-B13",
      "text": "Zum Schluss werden Anzahl, Summe, Testlauf-Kennzeichen und alle abgewiesenen Zahlungen mit Grund ausgegeben.",
      "anchors": [
        {
          "file": "zfi_payfile.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile.abap:55"
        },
        {
          "file": "zfi_payfile.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_payfile.abap:57"
        }
      ]
    }
  ],
