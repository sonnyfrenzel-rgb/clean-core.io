  "businessStatements": [
    {
      "id": "BM-262-B01",
      "text": "Für den Mahnlauf-Nachlauf wird ein Hintergrundjob ZFI_DUNNING_FOLLOWUP angelegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:10"
        }
      ]
    },
    {
      "id": "BM-262-B02",
      "text": "Scheitert das Anlegen, bricht der Report mit der Fehlermeldung „Job konnte nicht angelegt werden“ ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:17"
        },
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        }
      ]
    },
    {
      "id": "BM-262-B03",
      "text": "Der Nachlaufreport wird mit Laufdatum und Identifikation des Mahnlaufs als Schritt in diesen Job eingeplant, nicht sofort im Dialog ausgeführt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-262-B04",
      "text": "Der Job wird geschlossen und zum sofortigen Start freigegeben; bei Erfolg werden Jobname und Jobnummer gemeldet, sonst erscheint der Hinweis, dass der Job angelegt, aber nicht freigegeben ist.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
