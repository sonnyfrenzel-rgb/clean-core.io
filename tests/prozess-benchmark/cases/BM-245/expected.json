  "businessStatements": [
    {
      "id": "BM-245-B01",
      "text": "Für jeden einzeln eingegebenen Buchungskreis wird die Anzeigeberechtigung für Buchhaltungsbelege geprüft; fehlt sie, bleibt das Selektionsbild mit einer Fehlermeldung stehen.",
      "anchors": [
        {
          "file": "zfi_op_alterung.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:22"
        },
        {
          "file": "zfi_op_alterung.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:23"
        },
        {
          "file": "zfi_op_alterung.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:27"
        }
      ]
    },
    {
      "id": "BM-245-B02",
      "text": "Die offenen Debitorenposten der gewählten Buchungskreise werden auf der Datenbank gelesen, nur Posten mit Buchungsdatum bis zum Stichtag.",
      "anchors": [
        {
          "file": "zfi_op_alterung.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:33"
        },
        {
          "file": "zcl_fi_aging_amdp.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_aging_amdp.abap:42"
        },
        {
          "file": "zcl_fi_aging_amdp.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_aging_amdp.abap:44"
        }
      ]
    },
    {
      "id": "BM-245-B03",
      "text": "Je Buchungskreis und Kunde werden die Hauswährungsbeträge (Haben negativ) nach Tagen zwischen Basisdatum und Stichtag in die Klassen bis 30, 31–60, 61–90 und über 90 Tage summiert und mit dem Kundennamen versehen.",
      "anchors": [
        {
          "file": "zcl_fi_aging_amdp.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_aging_amdp.abap:44"
        }
      ]
    },
    {
      "id": "BM-245-B04",
      "text": "Schlägt die Datenbankprozedur fehl, wird ihr Fehlertext angezeigt und die Auswertung abgebrochen.",
      "anchors": [
        {
          "file": "zfi_op_alterung.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:42"
        },
        {
          "file": "zfi_op_alterung.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:43"
        }
      ]
    },
    {
      "id": "BM-245-B05",
      "text": "Kunden, deren Gesamtsaldo unter dem eingegebenen Mindestbetrag liegt, werden ausgeblendet.",
      "anchors": [
        {
          "file": "zfi_op_alterung.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:47"
        }
      ]
    },
    {
      "id": "BM-245-B06",
      "text": "Bleibt kein Kunde übrig, erscheint ein Hinweis und keine Liste.",
      "anchors": [
        {
          "file": "zfi_op_alterung.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:49"
        },
        {
          "file": "zfi_op_alterung.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:50"
        },
        {
          "file": "zfi_op_alterung.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:51"
        }
      ]
    },
    {
      "id": "BM-245-B07",
      "text": "Sonst wird die Altersstruktur als ALV-Liste mit allen Standardfunktionen angezeigt.",
      "anchors": [
        {
          "file": "zfi_op_alterung.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_op_alterung.abap:55"
        },
        {
