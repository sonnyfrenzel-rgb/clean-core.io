  "businessStatements": [
    {
      "id": "BM-103-B01",
      "text": "Die Regel greift nur für Servicemeldungen der Arten S1 und S3; alle anderen Meldungen werden unverändert gesichert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 7,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:7"
        }
      ]
    },
    {
      "id": "BM-103-B02",
      "text": "Meldungen, die der Benutzer TWEBER sichert, bleiben ohne Prioritätsableitung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 9,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:9"
        },
        {
          "file": "source.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:10"
        }
      ]
    },
    {
      "id": "BM-103-B03",
      "text": "Zum Kunden der Meldung wird die Kundenklassifizierung gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:13"
        }
      ]
    },
    {
      "id": "BM-103-B04",
      "text": "Kunden der Klasse 01 erhalten Priorität 1, Kunden der Klasse 02 Priorität 2; bei allen anderen bleibt die erfasste Priorität stehen.",
