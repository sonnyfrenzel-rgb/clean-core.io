  "businessStatements": [
    {
      "id": "BM-169-B01",
      "text": "Es werden offene Bonusabsprachen der gewählten Verkaufsorganisationen und Absprachearten gelesen, deren Gültigkeit innerhalb der vorgegebenen Tage ausläuft.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        }
      ]
    },
    {
      "id": "BM-169-B02",
      "text": "Gibt es keine, wird ein Hinweis gezeigt und die Listverarbeitung verlassen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        },
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        },
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        }
      ]
    },
    {
      "id": "BM-169-B03",
      "text": "Für jede Absprache wird der Umsatzreport ZSD_BONUS_UMSATZ gestartet und seine Liste im Speicher abgelegt statt angezeigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        }
      ]
    },
    {
      "id": "BM-169-B04",
      "text": "Aus der zurückgegebenen Liste wird der Betrag der vierten Listzeile ab Spalte 60 als bisheriger Bonusumsatz übernommen; ist er nicht als Zahl lesbar, bleibt der Umsatz null.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        },
        {
          "file": "source.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:49"
        },
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        }
      ]
    },
    {
      "id": "BM-169-B05",
      "text": "Jede Absprache wird mit Absprachenummer, Art, Bonusempfänger, Gültigkeitsende und Umsatz als anklickbare Zeile ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        }
      ]
    },
    {
      "id": "BM-169-B06",
      "text": "Ein Klick auf eine Zeile öffnet die Absprache direkt in der Anzeige der Bonusabsprache.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        },
