  "businessStatements": [
    {
      "id": "BM-035-B01",
      "text": "Beim Verlassen des Selektionsbilds wird geprüft, ob der Anwender im Werk Inventurbelege anlegen darf; sonst wird die Eingabe mit Fehlermeldung zurückgewiesen.",
      "anchors": [
        {
          "file": "zmm_zyklusinventur.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_zyklusinventur.abap:23"
        },
        {
          "file": "zmm_zyklusinventur.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_zyklusinventur.abap:26"
        },
        {
          "file": "zmm_zyklusinventur.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_zyklusinventur.abap:27"
        }
      ]
    },
    {
      "id": "BM-035-B02",
      "text": "Im Modus Anlegen werden die Materialien des Werks mit Zykluskennzeichen gelesen, die am Lagerort frei verwendbaren Bestand haben und nicht zur Inventur gesperrt sind.",
      "anchors": [
        {
          "file": "zmm_zyklusinventur.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_zyklusinventur.abap:33"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:41"
        }
      ]
    },
    {
      "id": "BM-035-B03",
      "text": "Fällig ist ein Material, wenn es noch nie inventarisiert wurde oder seit der letzten Inventur mindestens 365 geteilt durch die Zahl der Inventuren pro Jahr seines Zykluskennzeichens Tage vergangen sind.",
      "anchors": [
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:52"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:54"
        }
      ]
    },
    {
      "id": "BM-035-B04",
      "text": "Ist nichts fällig, wird das gemeldet und die Verarbeitung beendet.",
      "anchors": [
        {
          "file": "zmm_zyklusinventur.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_zyklusinventur.abap:36"
        },
        {
          "file": "zmm_zyklusinventur.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_zyklusinventur.abap:37"
        },
        {
          "file": "zmm_zyklusinventur.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_zyklusinventur.abap:38"
        }
      ]
    },
    {
      "id": "BM-035-B05",
      "text": "Für die fälligen Materialien werden Inventurbelege mit Referenz ZYKLUS zum Tagesdatum angelegt, aufgeteilt nach der eingegebenen Höchstzahl an Positionen je Beleg.",
      "anchors": [
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:70"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:73"
        }
      ]
    },
    {
      "id": "BM-035-B06",
      "text": "Meldet die Anlage einen Fehler, wird zurückgerollt und der Fehler protokolliert; sonst werden die Belege festgeschrieben und ihre Nummern protokolliert.",
      "anchors": [
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:82"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:83"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:87"
        }
      ]
    },
    {
      "id": "BM-035-B07",
      "text": "Im Modus Buchen werden die gezählten, noch nicht gebuchten und nicht gelöschten Inventurpositionen des Lagerorts je Inventurbeleg verarbeitet.",
      "anchors": [
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:101"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:111"
        }
      ]
    },
    {
      "id": "BM-035-B08",
      "text": "Je Position wird der Bewertungspreis nach Preissteuerung (Standardpreis oder gleitender Durchschnittspreis) je Preiseinheit gelesen; ohne Bewertung wird die Position mit Warnung übersprungen.",
      "anchors": [
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:115"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:121"
        }
      ]
    },
    {
      "id": "BM-035-B09",
      "text": "Der Differenzwert ist der Betrag der Mengendifferenz mal Stückpreis.",
      "anchors": [
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 125,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:125"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 126,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:126"
        }
      ]
    },
    {
      "id": "BM-035-B10",
      "text": "Liegt er über der Wertgrenze, wird die Position nicht gebucht, sondern zur Nachzählung bzw. Freigabe durch das Controlling vorgemerkt und protokolliert.",
      "anchors": [
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:127"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 129,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:129"
        }
      ]
    },
    {
      "id": "BM-035-B11",
      "text": "Die übrigen Positionen eines Belegs werden gemeinsam als Inventurdifferenz zum Tagesdatum gebucht; Belege ohne buchbare Position werden übersprungen.",
      "anchors": [
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 140,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:140"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 143,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:143"
        }
      ]
    },
    {
      "id": "BM-035-B12",
      "text": "Scheitert die Buchung, wird zurückgerollt und der Beleg als fehlgeschlagen protokolliert; sonst wird festgeschrieben und die Zahl gebuchter Differenzen protokolliert.",
      "anchors": [
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 151,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:151"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 152,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:152"
        },
        {
          "file": "zcl_mm_cycle_count.abap",
          "line": 155,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_cycle_count.abap:155"
        }
      ]
    },
    {
      "id": "BM-035-B13",
      "text": "Am Ende wird das Protokoll mit Meldungstyp und Text als Liste ausgegeben.",
      "anchors": [
        {
          "file": "zmm_zyklusinventur.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_zyklusinventur.abap:45"
        },
        {
          "file": "zmm_zyklusinventur.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_zyklusinventur.abap:46"
        }
      ]
    }
  ],
