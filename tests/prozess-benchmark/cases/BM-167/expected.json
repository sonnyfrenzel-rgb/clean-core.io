  "businessStatements": [
    {
      "id": "BM-167-B01",
      "text": "Der Baustein verarbeitet nur Nachrichten vom Typ ZDELJIT und bricht sonst mit der Ausnahme „falscher Baustein“ ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:31"
        },
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    },
    {
      "id": "BM-167-B02",
      "text": "Je IDoc werden Kopfsegment (Kunde, Abrufnummer) und Positionssegmente des Sequenzabrufs ausgewertet; andere Segmente werden ignoriert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        },
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        }
      ]
    },
    {
      "id": "BM-167-B03",
      "text": "Zu jeder Abrufposition wird über die Kunden-Material-Info das eigene Material zur Kundenmaterialnummer ermittelt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        }
      ]
    },
    {
      "id": "BM-167-B04",
      "text": "Ist das Kundenmaterial unbekannt oder die Menge nicht numerisch, wird die Segmentauswertung des IDocs abgebrochen und ein Fehlergrund gemerkt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        },
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        },
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        }
      ]
    },
    {
      "id": "BM-167-B05",
      "text": "Fehlerfreie Abrufe werden mit Sequenznummer, Liefertermin und Lieferzeit in die Abruftabelle eingefügt; bereits vorhandene Abrufpositionen werden stillschweigend übergangen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:75"
        },
        {
          "file": "source.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:76"
        }
      ]
    },
    {
      "id": "BM-167-B06",
      "text": "Das IDoc erhält Status 53 mit der Abrufnummer, im Fehlerfall Status 51 mit dem Fehlergrund, und das Workflow-Ergebnis wird auf Fehler gesetzt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        },
        {
          "file": "source.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:82"
        }
      ]
    },
    {
      "id": "BM-167-B07",
      "text": "Nur wenn kein IDoc des Pakets fehlerhaft war, werden alle IDocs als verarbeitet zurückgemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:91"
        },
        {
          "file": "source.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:94"
        }
      ]
    }
  ],
