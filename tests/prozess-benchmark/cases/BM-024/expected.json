  "businessStatements": [
    {
      "id": "BM-024-B01",
      "text": "Es werden die Lieferanten der eingegebenen Einkaufsorganisation gelesen, die dort für den Einkauf gesperrt oder zentral gebucht gesperrt sind.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:16"
        }
      ]
    },
    {
      "id": "BM-024-B02",
      "text": "Gibt es keine, wird „Keine gesperrten Lieferanten“ ausgegeben und der Report endet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        },
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        },
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        }
      ]
    },
    {
      "id": "BM-024-B03",
      "text": "Sonst werden Lieferantennummer, Name, Land und beide Sperrkennzeichen als ALV-Liste angezeigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-024-B04",
      "text": "Lässt sich die Liste nicht erzeugen, bricht der Report mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:31"
        }
      ]
    }
