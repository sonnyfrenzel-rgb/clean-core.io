  "businessStatements": [
    {
      "id": "BM-183-B01",
      "text": "Für die Frachtpreisberechnung wird der im Hauptspeicher gehaltene Speditionstarif geöffnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 9,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:9"
        }
      ]
    },
    {
      "id": "BM-183-B02",
      "text": "Liegt keine gültige Tarifversion im Speicher, wird der Tarifspeicher neu aufgebaut und danach geöffnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:10"
        },
        {
          "file": "source.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:11"
        },
        {
          "file": "source.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:12"
        }
      ]
    },
    {
      "id": "BM-183-B03",
      "text": "Zur angefragten Relation wird der Tarifsatz ermittelt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:15"
        }
      ]
    },
    {
      "id": "BM-183-B04",
      "text": "Gibt es für die Relation keinen Tarif, wird die Kalkulation mit dem Fehler KEIN_TARIF abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        },
        {
          "file": "source.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:19"
        }
      ]
    },
    {
      "id": "BM-183-B05",
      "text": "Bis 1.000 kg gilt der Grundpreis, darüber wird das Mehrgewicht anteilig mit dem Satz je 100 kg aufgeschlagen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        }
      ]
    }
