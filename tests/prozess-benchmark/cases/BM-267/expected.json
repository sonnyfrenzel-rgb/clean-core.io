  "businessStatements": [
    {
      "id": "BM-267-B01",
      "text": "Eingehende Kundenaufträge (Nachrichtentyp ZORDERS) werden IDoc für IDoc verarbeitet, jedes Segment über einen zum Segmenttyp passenden Mapper.",
      "anchors": [
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:32"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:36"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:37"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:41"
        }
      ]
    },
    {
      "id": "BM-267-B02",
      "text": "Kopfsegment und Partnersegment gehen an den Kopf-Mapper, Positions- und Materialsegment an den Positions-Mapper; für alle anderen Segmente gibt es keinen Mapper, sie werden übergangen.",
      "anchors": [
        {
          "file": "zcl_sd_seg_map_factory.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_seg_map_factory.abap:18"
        },
        {
          "file": "zcl_sd_seg_map_factory.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_seg_map_factory.abap:20"
        },
        {
          "file": "zcl_sd_seg_map_factory.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_seg_map_factory.abap:22"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:38"
        }
      ]
    },
    {
      "id": "BM-267-B03",
      "text": "Aus der Bestellart des Kunden werden über eine Zuordnungstabelle Auftragsart, Verkaufsorganisation, Vertriebsweg und Sparte bestimmt; Währung und Kundenbestellnummer werden übernommen.",
      "anchors": [
        {
          "file": "zcl_sd_map_header.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_header.abap:23"
        }
      ]
    },
    {
      "id": "BM-267-B04",
      "text": "Ist der Bestellart keine Auftragsart zugeordnet, ist das IDoc fehlerhaft.",
      "anchors": [
        {
          "file": "zcl_sd_map_header.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_header.abap:27"
        },
        {
          "file": "zcl_sd_map_header.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_header.abap:28"
        }
      ]
    },
    {
      "id": "BM-267-B05",
      "text": "Von den Partnern werden nur Auftraggeber und Warenempfänger übernommen, und nur wenn sie als nicht gelöschte Kunden existieren; sonst ist das IDoc fehlerhaft.",
      "anchors": [
        {
          "file": "zcl_sd_map_header.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_header.abap:38"
        },
        {
          "file": "zcl_sd_map_header.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_header.abap:41"
        },
        {
          "file": "zcl_sd_map_header.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_header.abap:44"
        },
        {
          "file": "zcl_sd_map_header.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_header.abap:45"
        }
      ]
    },
    {
      "id": "BM-267-B06",
      "text": "Jede Position wird mit Positionsnummer, Menge, Mengeneinheit und einer Einteilung über dieselbe Menge aufgenommen; eine Position ohne Menge macht das IDoc fehlerhaft.",
      "anchors": [
        {
          "file": "zcl_sd_map_item.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_item.abap:24"
        },
        {
          "file": "zcl_sd_map_item.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_item.abap:25"
        },
        {
          "file": "zcl_sd_map_item.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_item.abap:31"
        }
      ]
    },
    {
      "id": "BM-267-B07",
      "text": "Das Material einer Position wird aus der Kunden-Material-Info zur Kundenmaterialnummer des Auftraggebers ermittelt; andere Identifikationsarten werden übergangen.",
      "anchors": [
        {
          "file": "zcl_sd_map_item.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_item.abap:40"
        },
        {
          "file": "zcl_sd_map_item.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_item.abap:42"
        }
      ]
    },
    {
      "id": "BM-267-B08",
      "text": "Fehlt die Kunden-Material-Info, wird die Kundenmaterialnummer als eigene Materialnummer versucht; existiert auch diese nicht, ist das IDoc fehlerhaft.",
      "anchors": [
        {
          "file": "zcl_sd_map_item.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_item.abap:47"
        },
        {
          "file": "zcl_sd_map_item.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_item.abap:50"
        },
        {
          "file": "zcl_sd_map_item.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_item.abap:52"
        },
        {
          "file": "zcl_sd_map_item.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_item.abap:53"
        }
      ]
    },
    {
      "id": "BM-267-B09",
      "text": "Das ermittelte Material wird in die zuletzt aufgenommene Position eingetragen.",
      "anchors": [
        {
          "file": "zcl_sd_map_item.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_map_item.abap:59"
        }
      ]
    },
    {
      "id": "BM-267-B10",
      "text": "Ein Mappingfehler bricht das Abbilden des IDocs ab und setzt es mit dem Fehlertext auf Status 51; der Auftrag wird dann nicht angelegt.",
      "anchors": [
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:48"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:55"
        }
      ]
    },
    {
      "id": "BM-267-B11",
      "text": "Aus den abgebildeten Kopf-, Positions-, Partner- und Einteilungsdaten wird ein Kundenauftrag angelegt.",
      "anchors": [
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:59"
        }
      ]
    },
    {
      "id": "BM-267-B12",
      "text": "Meldet die Anlage einen Fehler oder liefert sie keine Auftragsnummer, wird zurückgerollt und das IDoc mit der Meldung auf Status 51 gesetzt.",
      "anchors": [
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:70"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:71"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:72"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:75"
        }
      ]
    },
    {
      "id": "BM-267-B13",
      "text": "Sonst wird der Auftrag festgeschrieben, das IDoc mit der Auftragsnummer auf Status 53 gesetzt und der Auftrag als Anwendungsobjekt mit dem IDoc verknüpft.",
      "anchors": [
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:83"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:88"
        }
      ]
    },
    {
      "id": "BM-267-B14",
      "text": "Ist mindestens ein IDoc des Pakets fehlerhaft, meldet der Baustein dem Workflow ein Fehlerergebnis.",
      "anchors": [
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:104"
        },
        {
          "file": "z_idoc_input_zorders.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zorders.abap:105"
        }
      ]
    }
  ],
