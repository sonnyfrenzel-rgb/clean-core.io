  "businessStatements": [
    {
      "id": "BM-207-B01",
      "text": "Die Formel rechnet nur für Positionen, deren Kunde eine Kundengruppe hat; sonst bleibt der Konditionswert unberührt.",
      "anchors": [
        {
          "file": "rv64a901.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "rv64a901.abap:12"
        },
        {
          "file": "rv64a901.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "rv64a901.abap:13"
        }
      ]
    },
    {
      "id": "BM-207-B02",
      "text": "Die Preisstrategie wird über eine Pflegetabelle der Kundengruppe zugeordnet; ohne Zuordnung gilt die Einzelhandelsstrategie.",
      "anchors": [
        {
          "file": "zcl_sd_price_factory.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_factory.abap:21"
        },
        {
          "file": "zcl_sd_price_factory.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_factory.abap:23"
        },
        {
          "file": "zcl_sd_price_factory.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_factory.abap:24"
        }
      ]
    },
    {
      "id": "BM-207-B03",
      "text": "Ist eine unbekannte Strategieklasse gepflegt, wird die Kondition inaktiv gesetzt.",
      "anchors": [
        {
          "file": "zcl_sd_price_factory.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_factory.abap:27"
        },
        {
          "file": "zcl_sd_price_factory.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_factory.abap:34"
        },
        {
          "file": "rv64a901.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "rv64a901.abap:22"
        }
      ]
    },
    {
      "id": "BM-207-B04",
      "text": "Der Basispreis ist der kundenindividuelle Preis ZPR0, ersatzweise der Materialpreis ZPR0 zum Preisdatum.",
      "anchors": [
        {
          "file": "zcl_sd_price_base.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_base.abap:50"
        },
        {
          "file": "zcl_sd_price_base.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_base.abap:61"
        },
        {
          "file": "zcl_sd_price_base.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_base.abap:63"
        }
      ]
    },
    {
      "id": "BM-207-B05",
      "text": "Gibt es keinen Basispreis, wird die Kondition inaktiv gesetzt und der Grund als Statusmeldung ausgegeben.",
      "anchors": [
        {
          "file": "zcl_sd_price_base.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_base.abap:73"
        },
        {
          "file": "zcl_sd_price_base.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_base.abap:74"
        },
        {
          "file": "rv64a901.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "rv64a901.abap:22"
        },
        {
          "file": "rv64a901.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "rv64a901.abap:23"
        }
      ]
    },
    {
      "id": "BM-207-B06",
      "text": "Großhandelskunden erhalten den Rabatt der höchsten erreichten Mengenstaffel ihrer Kundengruppe.",
      "anchors": [
        {
          "file": "zcl_sd_price_wholesale.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_wholesale.abap:21"
        },
        {
          "file": "zcl_sd_price_wholesale.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_wholesale.abap:25"
        },
        {
          "file": "zcl_sd_price_wholesale.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_wholesale.abap:26"
        }
      ]
    },
    {
      "id": "BM-207-B07",
      "text": "Einzelhandelskunden erhalten einen zum Preisdatum gültigen Aktionsrabatt auf das Material, sofern einer existiert.",
      "anchors": [
        {
          "file": "zcl_sd_price_retail.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_retail.abap:23"
        },
        {
          "file": "zcl_sd_price_retail.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_retail.abap:28"
        },
        {
          "file": "zcl_sd_price_retail.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_retail.abap:29"
        }
      ]
    },
    {
      "id": "BM-207-B08",
      "text": "Der Nettopreis muss mindestens 5 % über dem Standardpreis liegen; darunter wird die Kondition inaktiv gesetzt.",
      "anchors": [
        {
          "file": "zcl_sd_price_base.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_base.abap:85"
        },
        {
          "file": "zcl_sd_price_base.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_base.abap:90"
        },
        {
          "file": "zcl_sd_price_base.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_base.abap:92"
        }
      ]
    },
    {
      "id": "BM-207-B09",
      "text": "Bei Aktionsware im Einzelhandel entfällt die Mindestmargenprüfung.",
      "anchors": [
        {
          "file": "zcl_sd_price_retail.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_retail.abap:37"
        },
        {
          "file": "zcl_sd_price_retail.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_price_retail.abap:38"
        }
      ]
    },
    {
      "id": "BM-207-B10",
      "text": "Der Konditionswert ergibt sich aus Nettopreis mal Positionsmenge.",
      "anchors": [
        {
          "file": "rv64a901.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "rv64a901.abap:19"
        }
      ]
    }
  ],
