  "businessStatements": [
    {
      "id": "BM-251-B01",
      "text": "Wer den Mahnvorschlag erstellt, braucht die Berechtigung zum Ändern von Mahndaten im Buchungskreis; ohne sie bricht der Lauf mit der Meldung ZFI_MAHN 001 ab.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:48"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:51"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:52"
        },
        {
          "file": "zfi_mahn_report.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahn_report.abap:27"
        }
      ]
    },
    {
      "id": "BM-251-B02",
      "text": "Aus der Sicht offener Posten werden zum Stichtag die überfälligen, nicht von der Mahnung ausgenommenen Posten des Buchungskreises mit Betrag, Verzugstagen und letzter Mahnstufe gelesen.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:64"
        }
      ]
    },
    {
      "id": "BM-251-B03",
      "text": "Gibt es keine solchen Posten, endet der Lauf mit der Meldung ZFI_MAHN 002.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:72"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:73"
        }
      ]
    },
    {
      "id": "BM-251-B04",
      "text": "Posten von Kunden mit Mahnsperre im Buchungskreis werden nicht vorgeschlagen.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:80"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:91"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:93"
        }
      ]
    },
    {
      "id": "BM-251-B05",
      "text": "Die Mahnstufe richtet sich nach den Verzugstagen: bis 13 Tage keine Mahnung, ab 14 Tagen Stufe 1, ab 30 Tagen Stufe 2, ab 45 Tagen Stufe 3.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:97"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:122"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 126,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:126"
        }
      ]
    },
    {
      "id": "BM-251-B06",
      "text": "Ein Posten wird nur vorgeschlagen, wenn seine neue Stufe höher ist als die letzte Mahnstufe.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:100"
        }
      ]
    },
    {
      "id": "BM-251-B07",
      "text": "Vorgeschlagene Posten erhalten eine Mahngebühr von 25 in Stufe 3, 10 in Stufe 2 und keine in Stufe 1.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:104"
        }
      ]
    },
    {
      "id": "BM-251-B08",
      "text": "Im Testlauf wird der Vorschlag nur angezeigt, nicht gespeichert.",
      "anchors": [
        {
          "file": "zfi_mahn_report.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahn_report.abap:20"
        }
      ]
    },
    {
      "id": "BM-251-B09",
      "text": "Im Echtlauf wird ein nicht leerer Vorschlag unter Sperre des Buchungskreises gespeichert; ist die Sperre belegt, bricht der Lauf mit der Meldung ZFI_MAHN 003 ab.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 140,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:140"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 144,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:144"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 150,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:150"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 151,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:151"
        }
      ]
    },
    {
      "id": "BM-251-B10",
      "text": "Ein bereits vorhandener Vorschlag desselben Buchungskreises zum selben Stichtag wird gelöscht und durch den neuen ersetzt und festgeschrieben.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 161,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:161"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 162,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:162"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 172,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:172"
        }
      ]
    },
    {
      "id": "BM-251-B11",
      "text": "Scheitert das Schreiben, wird zurückgerollt und der Lauf mit der Meldung ZFI_MAHN 004 abgebrochen.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 164,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:164"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 165,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:165"
        }
      ]
    },
    {
      "id": "BM-251-B12",
      "text": "Nach dem Speichern wird die Sperre aufgehoben; anschließend wird der Vorschlag als Liste angezeigt.",
      "anchors": [
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 174,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:174"
        },
        {
          "file": "zcl_fi_mahnvorschlag.abap",
          "line": 185,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_fi_mahnvorschlag.abap:185"
        }
      ]
    }
  ],
