  "businessStatements": [
    {
      "id": "BM-290-B01",
      "text": "Zum eingegebenen Kunden wird das bestehende Kassenlimit gelesen; gibt es noch keines, wird ein neuer Satz in Euro vorbereitet.",
      "anchors": [
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:19"
        },
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:60"
        },
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:62"
        }
      ]
    },
    {
      "id": "BM-290-B02",
      "text": "Der Kundensatz wird für die Pflege gesperrt; ist er bereits gesperrt, wird der sperrende Benutzer als Statusmeldung in Fehleroptik gemeldet und die Pflege beendet.",
      "anchors": [
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:21"
        },
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:71"
        },
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:79"
        },
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:23"
        },
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:24"
        }
      ]
    },
    {
      "id": "BM-290-B03",
      "text": "Sonst wird das Pflegebild mit den Limitdaten aufgerufen.",
      "anchors": [
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:28"
        }
      ]
    },
    {
      "id": "BM-290-B04",
      "text": "Beim Sichern übernimmt die Pflege die Bildfelder und prüft: liegt das neue Limit über der Freigabegrenze von 50.000, braucht der Bearbeiter die Zusatzberechtigung für die Verkaufsorganisation, sonst wird das Sichern mit einer Fehlermeldung abgebrochen.",
      "anchors": [
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:44"
        },
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:48"
        },
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:86"
        },
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:87"
        },
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:51"
        }
      ]
    },
    {
      "id": "BM-290-B05",
      "text": "Nach bestandener Prüfung wird der Satz mit Änderer und Datum neu angelegt oder geändert, je nachdem ob er vorher existierte.",
      "anchors": [
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:103"
        },
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:104"
        },
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 107,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:107"
        }
      ]
    },
    {
      "id": "BM-290-B06",
      "text": "Dazu wird ein Änderungsbeleg mit altem und neuem Stand zur Verbuchung vorgemerkt.",
      "anchors": [
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 113,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:113"
        }
      ]
    },
    {
      "id": "BM-290-B07",
      "text": "Mit dem Festschreiben werden Satz und Änderungsbeleg gebucht und eine Erfolgsmeldung zum Kunden ausgegeben.",
      "anchors": [
        {
          "file": "zsd_kasslim_pflege_c01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege_c01.abap:32"
        },
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:49"
        }
      ]
    },
    {
      "id": "BM-290-B08",
      "text": "Zurück, Beenden oder Abbrechen hebt die Sperre auf und verlässt das Pflegebild, ohne ungesicherte Eingaben nachzufragen.",
      "anchors": [
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:55"
        },
        {
          "file": "zsd_kasslim_pflege.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_kasslim_pflege.abap:58"
        }
      ]
    }
  ],
