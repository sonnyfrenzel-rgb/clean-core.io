  "businessStatements": [
    {
      "id": "BM-173-B01",
      "text": "Ist kein Versorgungsbereich gesetzt, wird er aus dem Benutzerparameter vorbelegt.",
      "anchors": [
        {
          "file": "mzkanbani01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbani01.abap:12"
        },
        {
          "file": "mzkanbani01.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbani01.abap:13"
        }
      ]
    },
    {
      "id": "BM-173-B02",
      "text": "Mit Zurück oder Beenden verlässt der Werker den Scanner.",
      "anchors": [
        {
          "file": "mzkanbani01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbani01.abap:25"
        },
        {
          "file": "mzkanbani01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbani01.abap:26"
        }
      ]
    },
    {
      "id": "BM-173-B03",
      "text": "Der gescannte Behälter wird gelesen; ist er unbekannt, bleibt die Scanmaske mit Fehlermeldung stehen.",
      "anchors": [
        {
          "file": "mzkanbanf01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:12"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:14"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:15"
        }
      ]
    },
    {
      "id": "BM-173-B04",
      "text": "Zum Behälter wird der Regelkreis gelesen; gehört er zu einem anderen als dem gesetzten Versorgungsbereich, wird der Scan abgewiesen.",
      "anchors": [
        {
          "file": "mzkanbanf01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:18"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:21"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:22"
        }
      ]
    },
    {
      "id": "BM-173-B05",
      "text": "Ohne Berechtigung für das Werk des Regelkreises wird der Scan abgewiesen.",
      "anchors": [
        {
          "file": "mzkanbanf01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:25"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:28"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:29"
        }
      ]
    },
    {
      "id": "BM-173-B06",
      "text": "Ein voller oder in Benutzung befindlicher Behälter wird per BAPI auf „leer“ gesetzt und sofort festgeschrieben; lehnt das BAPI ab, wird zurückgerollt und der Scan mit Fehlermeldung abgewiesen.",
      "anchors": [
        {
          "file": "mzkanbanf01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:40"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:41"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:47"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:48"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:51"
        }
      ]
    },
    {
      "id": "BM-173-B07",
      "text": "Ist der Behälter bereits leer, wird der Werker gefragt, ob ein Eil-Nachschub ausgelöst werden soll.",
      "anchors": [
        {
          "file": "mzkanbanf01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:56"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:58"
        }
      ]
    },
    {
      "id": "BM-173-B08",
      "text": "Bei Zustimmung wird ein Eil-Nachschub mit Regelkreis, Material, Werk, Versorgungsbereich und Anforderer gespeichert – höchstens einer je Regelkreis und Tag; ein zweiter wird mit Fehlermeldung abgewiesen.",
      "anchors": [
        {
          "file": "mzkanbanf01.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:65"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:93"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:94"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:97"
        }
      ]
    },
    {
      "id": "BM-173-B09",
      "text": "Behälter in jedem anderen Status können nicht leer gemeldet werden.",
      "anchors": [
        {
          "file": "mzkanbanf01.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:72"
        },
        {
          "file": "mzkanbanf01.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbanf01.abap:73"
        }
      ]
    },
    {
      "id": "BM-173-B10",
      "text": "Nach erfolgreicher Verarbeitung erscheint die Rückmeldemaske; von dort geht es zum nächsten Scan oder aus dem Programm.",
      "anchors": [
        {
          "file": "mzkanbani01.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbani01.abap:30"
        },
        {
          "file": "mzkanbani01.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbani01.abap:54"
        },
        {
          "file": "mzkanbani01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "mzkanbani01.abap:56"
        }
      ]
    }
  ],
