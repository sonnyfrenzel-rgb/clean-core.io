  "businessStatements": [
    {
      "id": "BM-025-B01",
      "text": "Es werden die Inventurbelegpositionen des Werks und Geschäftsjahres gelesen, die bereits gezählt, deren Differenzen aber noch nicht gebucht sind.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:12"
        }
      ]
    },
    {
      "id": "BM-025-B02",
      "text": "Ist ein Lagerort angegeben, bleiben nur dessen Positionen übrig.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:17"
        },
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        }
      ]
    },
    {
      "id": "BM-025-B03",
      "text": "Je Position wird die Differenz aus Zählmenge und Buchbestand berechnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        }
      ]
    },
    {
      "id": "BM-025-B04",
      "text": "Inventurbeleg, Position, Material, Lagerort, Buchbestand, Zählmenge und Differenz werden ausgegeben, Minderbestände rot und Mehrbestände grün.",
