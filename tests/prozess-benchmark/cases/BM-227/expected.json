  "businessStatements": [
    {
      "id": "BM-227-B01",
      "text": "Ohne Änderungsberechtigung für den Buchungskreis bricht der Lauf mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zfi_mahnsperre.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:20"
        },
        {
          "file": "zfi_mahnsperre.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:23"
        },
        {
          "file": "zfi_mahnsperre.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:24"
        }
      ]
    },
    {
      "id": "BM-227-B02",
      "text": "Es werden die Debitoren des Buchungskreises mit Mahndaten ohne Mahnbereich gelesen, eingeschränkt auf die gewählten Debitoren.",
      "anchors": [
        {
          "file": "zfi_mahnsperre.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:27"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:10"
        }
      ]
    },
    {
      "id": "BM-227-B03",
      "text": "Gibt es keinen solchen Debitor, erscheint eine Meldung in Fehleroptik; die Verarbeitung endet, das Protokoll wird trotzdem ausgegeben.",
      "anchors": [
        {
          "file": "zfi_mahnsperre.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:28"
        },
        {
          "file": "zfi_mahnsperre.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:29"
        },
        {
          "file": "zfi_mahnsperre.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:30"
        },
        {
          "file": "zfi_mahnsperre.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:41"
        }
      ]
    },
    {
      "id": "BM-227-B04",
      "text": "Je Debitor werden seine offenen Posten ohne Mahnsperre gelesen; ohne solche Posten ist der Debitor erledigt.",
      "anchors": [
        {
          "file": "zfi_mahnsperre.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:34"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:28"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:34"
        }
      ]
    },
    {
      "id": "BM-227-B05",
      "text": "Die Fälligkeit eines Postens ergibt sich aus Basisdatum plus Tagen der ersten Skontofrist; Posten, die zum Stichtag noch nicht fällig sind, bleiben unberührt.",
      "anchors": [
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:38"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:39"
        }
      ]
    },
    {
      "id": "BM-227-B06",
      "text": "Für fällige Posten wird der Streitfall zum Beleg in der Kundentabelle gesucht; ohne Streitfall oder bei geschlossenem Streitfall bleibt der Posten unberührt.",
      "anchors": [
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:45"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:49"
        }
      ]
    },
    {
      "id": "BM-227-B07",
      "text": "Im Testlauf wird für einen Posten mit offenem Streitfall nur protokolliert, dass die Mahnsperre gesetzt würde.",
      "anchors": [
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:53"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:54"
        }
      ]
    },
    {
      "id": "BM-227-B08",
      "text": "Im Echtlauf wird die eingegebene Mahnsperre in der Belegzeile gesetzt.",
      "anchors": [
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:58"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:81"
        }
      ]
    },
    {
      "id": "BM-227-B09",
      "text": "Gelingt die Änderung, wird sie gezählt und als Erfolg protokolliert; sonst wird ein Fehler protokolliert.",
      "anchors": [
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:59"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:61"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:63"
        }
      ]
    },
    {
      "id": "BM-227-B10",
      "text": "Nach allen Debitoren werden die Belegänderungen nur im Echtlauf und nur bei mindestens einer erfolgreichen Änderung festgeschrieben.",
      "anchors": [
        {
          "file": "zfi_mahnsperre.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:37"
        },
        {
          "file": "zfi_mahnsperre.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:38"
        }
      ]
    },
    {
      "id": "BM-227-B11",
      "text": "Zum Abschluss wird jede gesammelte Protokollzeile mit Typ, Debitor, Beleg, Jahr, Position und Text ausgegeben.",
      "anchors": [
        {
          "file": "zfi_mahnsperre.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre.abap:42"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:121"
        },
        {
          "file": "zfi_mahnsperre_f01.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_mahnsperre_f01.abap:122"
        }
      ]
    }
  ],
