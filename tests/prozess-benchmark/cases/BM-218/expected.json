  "businessStatements": [
    {
      "id": "BM-218-B01",
      "text": "Der Job selektiert freigegebene, noch nicht bestellte, nicht gelöschte und nicht als fehlerhaft markierte Bestellanforderungen der gewählten Werke, Einkäufergruppen, Warengruppen und Liefertermine.",
      "anchors": [
        {
          "file": "zmm_auto_po_f01.abap",
          "line": 7,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_f01.abap:7"
        }
      ]
    },
    {
      "id": "BM-218-B02",
      "text": "Gibt es keine, wird das ausgegeben und die Verarbeitung beendet.",
      "anchors": [
        {
          "file": "zmm_auto_po.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po.abap:21"
        },
        {
          "file": "zmm_auto_po.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po.abap:22"
        },
        {
          "file": "zmm_auto_po.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po.abap:23"
        }
      ]
    },
    {
      "id": "BM-218-B03",
      "text": "Für jede Banf-Position wird die Bezugsquelle in fester Reihenfolge gesucht: Kontrakt, Quotierung, Orderbuch oder Infosatz; der erste gefundene Lieferant gilt.",
      "anchors": [
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 162,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:162"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 163,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:163"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 164,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:164"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 165,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:165"
        }
      ]
    },
    {
      "id": "BM-218-B04",
      "text": "Ein gültiger Kontrakt zu Material und Werk wird als Quelle mit Kontraktposition und Preis übernommen.",
      "anchors": [
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:33"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:44"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:45"
        }
      ]
    },
    {
      "id": "BM-218-B05",
      "text": "Bei einer zum Liefertermin gültigen Quotierung wird der Lieferant mit der niedrigsten Quotenzahl aus zugeordneter Menge und Basismenge je Quote gewählt.",
      "anchors": [
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:71"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:76"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:80"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:85"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:86"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:88"
        }
      ]
    },
    {
      "id": "BM-218-B06",
      "text": "Ist im Orderbuch ein fester Lieferant gepflegt, wird dessen Infosatz genommen, sonst der erste gültige Infosatz zum Material im Werk.",
      "anchors": [
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 106,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:106"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 113,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:113"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:114"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 124,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:124"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 132,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:132"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 133,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:133"
        }
      ]
    },
    {
      "id": "BM-218-B07",
      "text": "Findet keine Strategie einen Lieferanten, wird die Banf als fehlerhaft markiert.",
      "anchors": [
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 168,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:168"
        },
        {
          "file": "zmm_auto_po.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po.abap:36"
        }
      ]
    },
    {
      "id": "BM-218-B08",
      "text": "Ist der gefundene Lieferant für die Einkaufsorganisation gesperrt, wird die Banf ebenfalls als fehlerhaft markiert.",
      "anchors": [
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 201,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:201"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 204,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:204"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 205,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:205"
        }
      ]
    },
    {
      "id": "BM-218-B09",
      "text": "Fehlerhafte Banf erhalten ein Fehlerkennzeichen mit Text in Kundenfeldern der Banf und werden in Folgeläufen nicht mehr selektiert.",
      "anchors": [
        {
          "file": "zmm_auto_po_f01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_f01.abap:25"
        }
      ]
    },
    {
      "id": "BM-218-B10",
      "text": "Je Lieferant, Einkaufsorganisation und Einkäufergruppe wird eine Normalbestellung mit Bezug auf Banf, Kontrakt und Infosatz angelegt, im Testlauf nur simuliert.",
      "anchors": [
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 221,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:221"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 241,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:241"
        }
      ]
    },
    {
      "id": "BM-218-B11",
      "text": "Meldet die Anlage einen Fehler, wird verworfen und jede Banf der Gruppe als fehlerhaft markiert.",
      "anchors": [
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 253,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:253"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 254,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:254"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 255,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:255"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 256,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:256"
        }
      ]
    },
    {
      "id": "BM-218-B12",
      "text": "Im Echtlauf wird jede Bestellung festgeschrieben und mit Lieferant und Positionszahl im Laufprotokoll vermerkt.",
      "anchors": [
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 261,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:261"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 262,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:262"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 266,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:266"
        },
        {
          "file": "zmm_auto_po_c01.abap",
          "line": 293,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_c01.abap:293"
        }
      ]
    },
    {
      "id": "BM-218-B13",
      "text": "Am Ende werden die im Lauf erzeugten Bestellungen ausgegeben, im Testlauf mit einem Hinweis.",
      "anchors": [
        {
          "file": "zmm_auto_po_f01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_auto_po_f01.abap:32"
