        }
      ]
    },
    {
      "id": "BM-218-B14",
      "text": "Positionen mit gültiger Bezugsquelle werden je Lieferant und Einkaufsorganisation für die Bestellung gesammelt.",
      "anchors": [
        {
          "file": "zmm_auto_po_c01.abap",
