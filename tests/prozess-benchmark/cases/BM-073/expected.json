  "businessStatements": [
    {
      "id": "BM-073-B01",
      "text": "Es werden Instandhaltungsaufträge des Planungswerks mit Wartungsplanbezug, der gewählten Auftragsart (Vorschlag PM02) und einem Eckstarttermin bis heute plus Horizonttage (Vorschlag 14) gelesen.",
      "anchors": [
        {
          "file": "zpm_wp_freigabe.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe.abap:24"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:49"
        }
      ]
    },
    {
      "id": "BM-073-B02",
      "text": "Nur Aufträge, deren Systemstatus EROF (eröffnet) aktiv ist, kommen in die Kandidatenliste.",
      "anchors": [
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:62"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:66"
        }
      ]
    },
    {
      "id": "BM-073-B03",
      "text": "Ist das Equipment des Auftrags inaktiv (Status INAK), wird der Auftrag mit „Equipment inaktiv - nicht freigeben“ gekennzeichnet, sonst als „freigebbar“.",
      "anchors": [
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:70"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:91"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:71"
        }
      ]
    },
    {
      "id": "BM-073-B04",
      "text": "Aufträge ohne Equipment gelten als freigebbar.",
      "anchors": [
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:87"
        }
      ]
    },
    {
      "id": "BM-073-B05",
      "text": "Ohne Kandidaten wird „Keine freizugebenden Wartungsauftraege“ gemeldet und der Lauf beendet.",
      "anchors": [
        {
          "file": "zpm_wp_freigabe.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe.abap:28"
        },
        {
          "file": "zpm_wp_freigabe.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe.abap:29"
        },
        {
          "file": "zpm_wp_freigabe.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe.abap:30"
        }
      ]
    },
    {
      "id": "BM-073-B06",
      "text": "Im Hintergrundlauf werden alle freigebbaren Kandidaten freigegeben, bevor die Liste ausgegeben wird.",
      "anchors": [
        {
          "file": "zpm_wp_freigabe.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe.abap:34"
        },
        {
          "file": "zpm_wp_freigabe.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe.abap:35"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 107,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:107"
        }
      ]
    },
    {
      "id": "BM-073-B07",
      "text": "Jeder freigebbare Auftrag wird einzeln freigegeben und gesichert; nicht freigebbare Zeilen werden übergangen.",
      "anchors": [
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:115"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:122"
        }
      ]
    },
    {
      "id": "BM-073-B08",
      "text": "Meldet die Freigabe einen Fehler oder Abbruch, wird zurückgerollt und „Freigabe fehlgeschlagen“ vermerkt; sonst wird festgeschrieben, „freigegeben“ vermerkt und die Zeile als nicht mehr freigebbar markiert.",
      "anchors": [
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:127"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 128,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:128"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 131,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:131"
        }
      ]
    },
    {
      "id": "BM-073-B09",
      "text": "Die Kandidatenliste wird als ALV mit der Zusatzfunktion „Freigeben“ angezeigt, im Hintergrund als Spoolliste.",
      "anchors": [
        {
          "file": "zpm_wp_freigabe.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe.abap:38"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 142,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:142"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 148,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:148"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 149,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:149"
        }
      ]
    },
    {
      "id": "BM-073-B10",
      "text": "Im Dialog gibt die Funktion „Freigeben“ die markierten Zeilen frei und frischt die Liste auf; ohne Markierung erscheint „Bitte Zeilen markieren“.",
      "anchors": [
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 154,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:154"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 157,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:157"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 158,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:158"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 161,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:161"
        },
        {
          "file": "zpm_wp_freigabe_cl.abap",
          "line": 162,
          "token": null,
          "expressionPath": null,
          "raw": "zpm_wp_freigabe_cl.abap:162"
        }
      ]
    }
  ],
