  "businessStatements": [
    {
      "id": "BM-273-B01",
      "text": "Für die Lauf-ID wird geprüft, ob ein abgebrochener Lauf einen Wiederaufsetzpunkt hinterlassen hat.",
      "anchors": [
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:12"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:14"
        }
      ]
    },
    {
      "id": "BM-273-B02",
      "text": "Existiert der Lauf und ist kein Restart-Kennzeichen gesetzt, bricht der Export mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:15"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:16"
        }
      ]
    },
    {
      "id": "BM-273-B03",
      "text": "Mit Restart-Kennzeichen wird nach der letzten exportierten Faktura fortgesetzt und an die vorhandene Datei angehängt, was gemeldet wird; ohne vorhandenen Lauf beginnt eine neue Datei.",
      "anchors": [
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:19"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:20"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:23"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:31"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:32"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:34"
        }
      ]
    },
    {
      "id": "BM-273-B04",
      "text": "Lässt sich die Datei nicht öffnen, bricht der Export mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:36"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:37"
        }
      ]
    },
    {
      "id": "BM-273-B05",
      "text": "Eine neue Datei erhält eine Kopfzeile mit den Spaltennamen.",
      "anchors": [
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:39"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:40"
        }
      ]
    },
    {
      "id": "BM-273-B06",
      "text": "Es werden nicht stornierte, an die Buchhaltung übergebene Fakturen des Fakturadatums und der Verkaufsorganisationen nach der letzten exportierten Nummer in Nummernfolge selektiert.",
      "anchors": [
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:48"
        }
      ]
    },
    {
      "id": "BM-273-B07",
      "text": "Je Faktura wird der Steuerbetrag aus den Steuerkonditionen summiert und für jede Position eine Zeile mit Faktura, Datum, Regulierer, Position, Material, Menge, Nettowert, Steuer und Währung in die Datei geschrieben.",
      "anchors": [
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:66"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:70"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:74"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:77"
        }
      ]
    },
    {
      "id": "BM-273-B08",
      "text": "Jede exportierte Faktura wird mit Lauf-ID und Datum im Exportprotokoll vermerkt.",
      "anchors": [
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:83"
        }
      ]
    },
    {
      "id": "BM-273-B09",
      "text": "Nach jeder im Commit-Intervall liegenden Faktura wird deren Nummer als Wiederaufsetzpunkt gespeichert und alles bis dahin festgeschrieben.",
      "anchors": [
        {
          "file": "zsd_inv_export.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export.abap:16"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:96"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:97"
        }
      ]
    },
    {
      "id": "BM-273-B10",
      "text": "Nach der letzten Faktura wird die Datei geschlossen, der Wiederaufsetzpunkt gelöscht, festgeschrieben und die Zahl exportierter Fakturen mit dem Dateinamen ausgegeben.",
      "anchors": [
        {
          "file": "zsd_inv_export.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export.abap:21"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:104"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:105"
        },
        {
          "file": "zsd_inv_export_f01.abap",
          "line": 106,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_inv_export_f01.abap:106"
        }
      ]
    }
  ],
