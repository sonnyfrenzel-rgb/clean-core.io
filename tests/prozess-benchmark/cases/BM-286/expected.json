  "businessStatements": [
    {
      "id": "BM-286-B01",
      "text": "Für jede geänderte Messwertzeile wird die Bewertung aus den Toleranzen abgeleitet: liegt der Istwert über der oberen oder unter der unteren Toleranz, gilt der Wert als zurückgewiesen, sonst als angenommen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        },
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        },
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        }
      ]
    },
    {
      "id": "BM-286-B02",
      "text": "Mit Zurück oder Abbrechen verlässt der Prüfer die Messwerterfassung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        },
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        }
      ]
    },
    {
      "id": "BM-286-B03",
      "text": "Markierte Messwerte werden nur aus der Erfassung entfernt und ihre Anzahl als Statusmeldung angezeigt; in der Datenbank ändert sich dabei nichts.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        },
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        }
      ]
    },
    {
      "id": "BM-286-B04",
      "text": "Beim Sichern werden die bisherigen Messwerte zu Prüflos und Vorgang gelöscht und die erfassten Werte vollständig neu geschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-286-B05",
      "text": "Schlägt das Einfügen fehl, wird die Änderung zurückgerollt und das Sichern mit einer Fehlermeldung zum Prüflos abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        },
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        },
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        }
      ]
    },
    {
      "id": "BM-286-B06",
      "text": "Sonst werden die Messwerte festgeschrieben und Prüflos und Anzahl der gesicherten Werte gemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        },
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        }
      ]
    }
  ],
