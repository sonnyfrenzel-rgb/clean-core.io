  "businessStatements": [
    {
      "id": "BM-086-B01",
      "text": "Jedes IDoc des Pakets wird nur verarbeitet, wenn es den Nachrichtentyp ZCREDLIM trägt; sonst bricht der Baustein mit WRONG_FUNCTION_CALLED ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        },
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        }
      ]
    },
    {
      "id": "BM-086-B02",
      "text": "Die Segmente des IDocs werden der Reihe nach ausgewertet; das Kopfsegment liefert die Kundennummer.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        },
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        },
        {
          "file": "source.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:46"
        }
      ]
    },
    {
      "id": "BM-086-B03",
      "text": "Je Kreditsegment wird der vorhandene Kreditstammsatz des Kunden im genannten Kreditkontrollbereich gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:49"
        }
      ]
    },
    {
      "id": "BM-086-B04",
      "text": "Fehlt der Kreditstammsatz oder ist das gelieferte Limit negativ, wird das IDoc als fehlerhaft markiert und die weiteren Segmente werden übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        }
      ]
    },
    {
      "id": "BM-086-B05",
      "text": "Sonst wird das neue Kreditlimit mit heutigem Prüfdatum, Änderer und Änderungsdatum direkt in den Kreditstammsatz geschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        },
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        }
      ]
    },
    {
      "id": "BM-086-B06",
      "text": "Ein fehlerfreies IDoc erhält Status 53 (Anwendungsbeleg gebucht).",
      "anchors": [
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        },
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        }
      ]
    },
    {
      "id": "BM-086-B07",
      "text": "Ein fehlerhaftes IDoc erhält Status 51 mit der Kundennummer in der Meldung, und das Workflow-Ergebnis meldet einen Fehler.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 78,
