  "businessStatements": [
    {
      "id": "BM-113-B01",
      "text": "Zu Beginn wird ein Anwendungslog für die Fakturierung eröffnet; gelingt das nicht, bricht das Programm ab.",
      "anchors": [
        {
          "file": "zcs_sm_faktura.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:49"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:78"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:85"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:86"
        }
      ]
    },
    {
      "id": "BM-113-B02",
      "text": "Es werden Serviceaufträge der Selektion ermittelt, die bis zum Stichtag technisch abgeschlossen sind, deren Auftragsart ein DIP-Profil zugeordnet ist und für die noch keine Fakturaanforderung protokolliert ist.",
      "anchors": [
        {
          "file": "zcs_sm_faktura.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:51"
        }
      ]
    },
    {
      "id": "BM-113-B03",
      "text": "Ohne solche Aufträge endet die Verarbeitung, das (leere) Protokoll wird dennoch gesichert und angezeigt.",
      "anchors": [
        {
          "file": "zcs_sm_faktura.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:65"
        },
        {
          "file": "zcs_sm_faktura.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:66"
        },
        {
          "file": "zcs_sm_faktura.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:90"
        }
      ]
    },
    {
      "id": "BM-113-B04",
      "text": "Garantieaufträge werden nicht fakturiert, sondern mit einer Warnung protokolliert.",
      "anchors": [
        {
          "file": "zcs_sm_faktura.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:70"
        },
        {
          "file": "zcs_sm_faktura.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:71"
        }
      ]
    },
    {
      "id": "BM-113-B05",
      "text": "Für jeden übrigen Auftrag werden die Istkosten summiert; sind sie nicht positiv, wird der Auftrag als ohne Istkosten markiert.",
      "anchors": [
        {
          "file": "zcs_sm_faktura.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:75"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:14"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:17"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:18"
        }
      ]
    },
    {
      "id": "BM-113-B06",
      "text": "Markierte Aufträge werden mit der Warnung „Keine Istkosten“ protokolliert und nicht fakturiert.",
      "anchors": [
        {
          "file": "zcs_sm_faktura.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:76"
        },
        {
          "file": "zcs_sm_faktura.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:77"
        }
      ]
    },
    {
      "id": "BM-113-B07",
      "text": "Im Dialogmodus wird die aufwandsbezogene Fakturierung mit vorbelegtem Auftrag ohne Einstiegsbild aufgerufen, der Sachbearbeiter schließt sie selbst ab.",
      "anchors": [
        {
          "file": "zcs_sm_faktura.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:81"
        },
        {
          "file": "zcs_sm_faktura.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:82"
        },
        {
          "file": "zcs_sm_faktura.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:83"
        }
      ]
    },
    {
      "id": "BM-113-B08",
      "text": "Im Hintergrund wird die Fakturaanforderung mit Auftrag, DIP-Profil und Stichtag per Batch-Input erzeugt und gesichert.",
      "anchors": [
        {
          "file": "zcs_sm_faktura.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:85"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:41"
        }
      ]
    },
    {
      "id": "BM-113-B09",
      "text": "Meldet die Transaktion die gesicherte Anforderung, wird die Belegnummer zum Auftrag im Fakturaprotokoll gespeichert, festgeschrieben und im Anwendungslog als Erfolg vermerkt.",
      "anchors": [
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:47"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:49"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:51"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:55"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:57"
        }
      ]
    },
    {
      "id": "BM-113-B10",
      "text": "Sonst werden alle Fehler- und Abbruchmeldungen der Transaktion zum Auftrag ins Anwendungslog übernommen.",
      "anchors": [
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:60"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:64"
        }
      ]
    },
    {
      "id": "BM-113-B11",
      "text": "Jeder Protokolleintrag wird mit Auftragsnummer und Text dem Anwendungslog hinzugefügt.",
      "anchors": [
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:103"
        }
      ]
    },
    {
      "id": "BM-113-B12",
      "text": "Am Ende wird das Anwendungslog gesichert und angezeigt.",
      "anchors": [
        {
          "file": "zcs_sm_faktura.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura.abap:91"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:115"
        },
        {
          "file": "zcs_sm_faktura_f01.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zcs_sm_faktura_f01.abap:121"
        }
      ]
    }
  ],
