  "businessStatements": [
    {
      "id": "BM-020-B01",
      "text": "Als Geschäftsjahr ist das Vorjahr vorgeschlagen.",
      "anchors": [
        {
          "file": "zsd_bonus_run.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run.abap:20"
        }
      ]
    },
    {
      "id": "BM-020-B02",
      "text": "Für Verkaufsorganisation, Vertriebsweg und Geschäftsjahr wird der Nettoumsatz je Regulierer und Belegwährung aus nicht stornierten Rechnungen der Arten F2 und ZF2 ermittelt, ohne Bonuspositionen.",
      "anchors": [
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:23"
        },
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:41"
        }
      ]
    },
    {
      "id": "BM-020-B03",
      "text": "Nur Regulierer aus der Selektion werden abgerechnet.",
      "anchors": [
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:47"
        }
      ]
    },
    {
      "id": "BM-020-B04",
      "text": "Gibt es keine Umsätze, endet der Lauf mit einem Hinweis.",
      "anchors": [
        {
          "file": "zsd_bonus_run.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run.abap:24"
        },
        {
          "file": "zsd_bonus_run.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run.abap:25"
        },
        {
          "file": "zsd_bonus_run.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run.abap:26"
        }
      ]
    },
    {
      "id": "BM-020-B05",
      "text": "Ist für Verkaufsorganisation und Jahr keine Bonusstaffel gepflegt, bricht der Lauf mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:50"
        },
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:53"
        },
        {
          "file": "zsd_bonus_run.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run.abap:35"
        }
      ]
    },
    {
      "id": "BM-020-B06",
      "text": "Die Staffel wird absteigend nach Umsatzschwelle geordnet, sodass die höchste erreichte Stufe gilt.",
      "anchors": [
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:61"
        },
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 119,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:119"
        }
      ]
    },
    {
      "id": "BM-020-B07",
      "text": "Kunden, die im Vertriebsbereich nicht bonusrelevant sind, erhalten keinen Bonus.",
      "anchors": [
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:72"
        },
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:77"
        }
      ]
    },
    {
      "id": "BM-020-B08",
      "text": "Wurde für Kunde, Verkaufsorganisation und Jahr bereits ein Bonusbeleg erzeugt, gibt es keinen weiteren Bonus.",
      "anchors": [
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:83"
        },
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:87"
        }
      ]
    },
    {
      "id": "BM-020-B09",
      "text": "Umsätze in Fremdwährung werden zum 31.12. des Jahres in EUR umgerechnet; fehlt der Kurs, gibt es keinen Bonus.",
      "anchors": [
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:93"
        },
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:94"
        },
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:104"
        }
      ]
    },
    {
      "id": "BM-020-B10",
      "text": "Unter einem Umsatz von 10.000 EUR gibt es keinen Bonus.",
      "anchors": [
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 113,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:113"
        }
      ]
    },
    {
      "id": "BM-020-B11",
      "text": "Der Bonusprozentsatz ist der der höchsten Staffelstufe, deren Schwelle der EUR-Umsatz erreicht; ohne erreichte Stufe ist er null.",
      "anchors": [
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 119,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:119"
        },
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 120,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:120"
        }
      ]
    },
    {
      "id": "BM-020-B12",
      "text": "Der Bonus ist der Umsatz in Belegwährung mal Prozentsatz, auf zwei Nachkommastellen gerundet.",
      "anchors": [
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 125,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:125"
        }
      ]
    },
    {
      "id": "BM-020-B13",
      "text": "Übersteigt der Bonus den Höchstbetrag der Stufe, wird er auf diesen gekappt.",
      "anchors": [
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 129,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:129"
        },
        {
          "file": "zcl_sd_bonus_calc.abap",
          "line": 130,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_bonus_calc.abap:130"
        }
      ]
    },
    {
      "id": "BM-020-B14",
      "text": "Kunden ohne Bonus werden nur mit Begründung ausgewiesen.",
      "anchors": [
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:74"
        }
      ]
    },
    {
      "id": "BM-020-B15",
      "text": "Im Testlauf werden Kunden mit Bonus nur als „würde angelegt“ ausgewiesen.",
      "anchors": [
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:80"
        }
      ]
    },
    {
      "id": "BM-020-B16",
      "text": "Im Echtlauf wird je Kunde eine Gutschriftsanforderung ZG2 mit Auftragsgrund Z30, dem Bonusmaterial und dem Bonus als Kondition ZBON in Belegwährung angelegt.",
      "anchors": [
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 139,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:139"
        }
      ]
    },
    {
      "id": "BM-020-B17",
      "text": "Zusammen mit der Gutschriftsanforderung wird ein Bonusbeleg mit Umsatz, Prozentsatz und Bonus verbucht; scheitert die Anlage, wird beides verworfen und der Kunde mit der Fehlermeldung ausgewiesen.",
      "anchors": [
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 135,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:135"
        },
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 150,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:150"
        },
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 151,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:151"
        },
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 156,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:156"
        }
      ]
    },
    {
      "id": "BM-020-B18",
      "text": "Existiert der Bonusbeleg bei der Verbuchung bereits, bricht die Verbuchung ab.",
      "anchors": [
        {
          "file": "z_sd_bonus_post_upd.abap",
          "line": 9,
          "token": null,
          "expressionPath": null,
          "raw": "z_sd_bonus_post_upd.abap:9"
        },
        {
          "file": "z_sd_bonus_post_upd.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "z_sd_bonus_post_upd.abap:10"
        },
        {
          "file": "z_sd_bonus_post_upd.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "z_sd_bonus_post_upd.abap:11"
        }
      ]
    },
    {
      "id": "BM-020-B19",
      "text": "Am Ende wird je Kunde Umsatz, Bonusprozentsatz, Bonus, Gutschriftsanforderung, Status und Meldung mit Summen je Währung angezeigt.",
      "anchors": [
        {
          "file": "zsd_bonus_run_f01.abap",
          "line": 187,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_bonus_run_f01.abap:187"
        }
      ]
    }
  ],
