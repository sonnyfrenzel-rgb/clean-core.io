  "businessStatements": [
    {
      "id": "BM-220-B01",
      "text": "Ohne gepflegte RFC-Destination für das EWM der Lagernummer bricht der Lauf ab.",
      "anchors": [
        {
          "file": "zmm_sto_replenish.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:20"
        },
        {
          "file": "zmm_sto_replenish.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:22"
        },
        {
          "file": "zmm_sto_replenish.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:23"
        }
      ]
    },
    {
      "id": "BM-220-B02",
      "text": "Nachschubrelevant sind nicht zum Löschen vorgemerkte Filialmaterialien mit Dispositionsmerkmal Z1 und Sicherheitsbestand.",
      "anchors": [
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:36"
        }
      ]
    },
    {
      "id": "BM-220-B03",
      "text": "Der Bedarf ist der doppelte Sicherheitsbestand abzüglich des frei verwendbaren Filialbestands und der offenen Umlagerungsmengen aus dem Zentrallager.",
      "anchors": [
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:47"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:52"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:62"
        }
      ]
    },
    {
      "id": "BM-220-B04",
      "text": "Nur positive Bedarfe werden übernommen und, falls gepflegt, auf den Rundungswert aufgerundet.",
      "anchors": [
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:63"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:65"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:66"
        }
      ]
    },
    {
      "id": "BM-220-B05",
      "text": "Gibt es keinen Bedarf, endet der Lauf mit einer Meldung.",
      "anchors": [
        {
          "file": "zmm_sto_replenish.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:28"
        },
        {
          "file": "zmm_sto_replenish.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:29"
        },
        {
          "file": "zmm_sto_replenish.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:30"
        }
      ]
    },
    {
      "id": "BM-220-B06",
      "text": "Je Filialwerk wird eine Umlagerungsbestellung (UB) mit Lieferwerk Zentrallager in einem parallelen Task angelegt.",
      "anchors": [
        {
          "file": "zmm_sto_replenish.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:38"
        },
        {
          "file": "zmm_sto_replenish.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:40"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:96"
        },
        {
          "file": "z_mm_sto_create_rfc.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_sto_create_rfc.abap:29"
        }
      ]
    },
    {
      "id": "BM-220-B07",
      "text": "Lässt sich kein paralleler Task starten, wird die UB synchron im eigenen Prozess angelegt.",
      "anchors": [
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 108,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:108"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:110"
        }
      ]
    },
    {
      "id": "BM-220-B08",
      "text": "Der RFC-Baustein schreibt eine angelegte UB fest und verwirft sonst.",
      "anchors": [
        {
          "file": "z_mm_sto_create_rfc.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_sto_create_rfc.abap:40"
        },
        {
          "file": "z_mm_sto_create_rfc.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_sto_create_rfc.abap:41"
        },
        {
          "file": "z_mm_sto_create_rfc.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_sto_create_rfc.abap:43"
        }
      ]
    },
    {
      "id": "BM-220-B09",
      "text": "Der Lauf wartet höchstens 600 Sekunden auf alle Rückmeldungen und weist auf eine Zeitüberschreitung hin.",
      "anchors": [
        {
          "file": "zmm_sto_replenish.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:45"
        },
        {
          "file": "zmm_sto_replenish.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:47"
        },
        {
          "file": "zmm_sto_replenish.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:48"
        }
      ]
    },
    {
      "id": "BM-220-B10",
      "text": "Jede Rückmeldung wird abgeholt; ist keine UB entstanden, wird das Werk mit Fehler ausgegeben.",
      "anchors": [
        {
          "file": "zmm_sto_replenish_f01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_f01.abap:12"
        },
        {
          "file": "zmm_sto_replenish_f01.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_f01.abap:22"
        },
        {
          "file": "zmm_sto_replenish_f01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_f01.abap:23"
        }
      ]
    },
    {
      "id": "BM-220-B11",
      "text": "Zu jeder angelegten UB wird eine Auslieferung angelegt und festgeschrieben; entsteht keine, wird verworfen und ein Fehler zur UB ausgegeben.",
      "anchors": [
        {
          "file": "zmm_sto_replenish.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:51"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 157,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:157"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 165,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:165"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 166,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:166"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 167,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:167"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 170,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:170"
        },
        {
          "file": "zmm_sto_replenish.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish.abap:55"
        }
      ]
    },
    {
      "id": "BM-220-B12",
      "text": "Jede Auslieferung wird dem EWM des Zentrallagers synchron angekündigt; ist es nicht erreichbar, wird ein Wiederholungseintrag geschrieben.",
      "anchors": [
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 175,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:175"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 184,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:184"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 186,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:186"
        }
      ]
    },
    {
      "id": "BM-220-B13",
      "text": "Jede angelegte Lieferung wird mit UB und EWM-Status protokolliert.",
      "anchors": [
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 193,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:193"
        },
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 217,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:217"
        }
      ]
    },
    {
      "id": "BM-220-B14",
      "text": "Am Ende werden die Anzahl der UB, der Lieferungen und der offenen EWM-Meldungen ausgegeben.",
      "anchors": [
        {
          "file": "zmm_sto_replenish_f01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_f01.abap:35"
        }
      ]
    },
    {
      "id": "BM-220-B15",
      "text": "Jeder erfolgreich gestartete Task wird gezählt, damit auf alle Rückmeldungen gewartet werden kann.",
      "anchors": [
        {
          "file": "zmm_sto_replenish_c01.abap",
          "line": 123,
          "token": null,
          "expressionPath": null,
          "raw": "zmm_sto_replenish_c01.abap:123"
        }
      ]
    }
  ],
