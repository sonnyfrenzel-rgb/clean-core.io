  "businessStatements": [
    {
      "id": "BM-205-B01",
      "text": "Vor der Reservierung wird Material, Werk und Lagerort über eine eigene Sperre gegen parallele Reservierungen gesperrt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        }
      ]
    },
    {
      "id": "BM-205-B02",
      "text": "Ist die Kombination bereits gesperrt, erhält der Anwender die Information, dass sie gerade bearbeitet wird, und es wird nichts reserviert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        },
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        },
        {
          "file": "source.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:91"
        }
      ]
    },
    {
      "id": "BM-205-B03",
      "text": "Der frei verwendbare Lagerortbestand und die Summe der offenen weichen Reservierungen werden gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        },
        {
          "file": "source.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:63"
        }
      ]
    },
    {
      "id": "BM-205-B04",
      "text": "Reicht der Restbestand nicht für die gewünschte Menge, wird nicht reserviert und der Anwender informiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:66"
        },
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        },
        {
          "file": "source.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:93"
        }
      ]
    },
    {
      "id": "BM-205-B05",
      "text": "Sonst wird eine weiche Reservierung mit Auftrag, Menge, Anleger und Datum angelegt und festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        },
        {
          "file": "source.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:88"
        }
      ]
    },
    {
      "id": "BM-205-B06",
      "text": "Nach erfolgreicher Reservierung erscheint eine Erfolgsmeldung mit der Auftragsnummer.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:89"
        }
      ]
    },
    {
      "id": "BM-205-B07",
      "text": "In jedem Fall wird die Sperre am Ende wieder freigegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:96"
        },
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        }
      ]
    }
  ],
