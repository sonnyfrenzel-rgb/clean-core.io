  "businessStatements": [
    {
      "id": "BM-123-B01",
      "text": "Es wird geprüft, ob die Finanzposition im angegebenen Finanzkreis und Geschäftsjahr angelegt ist.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        }
      ]
    },
    {
      "id": "BM-123-B02",
      "text": "Fehlt sie, endet die Prüfung mit der Ausnahme NOT_FOUND und einer Fehlermeldung zu Position und Finanzkreis.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        },
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        }
      ]
    },
    {
      "id": "BM-123-B03",
      "text": "Ist die Position keine Ausgabeposition (Positionstyp 3), endet die Prüfung mit der Ausnahme NO_EXPENDITURE.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        },
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        }
      ]
    },
    {
      "id": "BM-123-B04",
      "text": "Sonst wird der Finanzvorgang der Position an den Aufrufer zurückgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:31"
        }
      ]
    }
