  "businessStatements": [
    {
      "id": "BM-055-B01",
      "text": "Der Monatsjob verrechnet für Kostenrechnungskreis, Geschäftsjahr und Periode zum gewählten Buchungsdatum; standardmäßig läuft er als Testlauf.",
      "anchors": [
        {
          "file": "zco_act_alloc.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zco_act_alloc.abap:18"
        }
      ]
    },
    {
      "id": "BM-055-B02",
      "text": "Gelesen werden nur die vom Vorgesetzten freigegebenen Zeitsätze (Status F) der Periode; gibt es keine, endet der Lauf mit einem Info-Eintrag.",
      "anchors": [
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 164,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:164"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:53"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:55"
        }
      ]
    },
    {
      "id": "BM-055-B03",
      "text": "Jeder Zeitsatz wird zum Periodenbeginn geprüft: Die Sender-Kostenstelle muss gültig und für sekundäre Istkosten nicht gesperrt sein, die Leistungsart muss existieren; sonst wird der Satz mit Fehlertext protokolliert und nicht verrechnet.",
      "anchors": [
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 183,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:183"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 189,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:189"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 195,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:195"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 200,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:200"
        }
      ]
    },
    {
      "id": "BM-055-B04",
      "text": "Gültige Zeitsätze werden je Sender-Kostenstelle, Leistungsart, Empfänger-Kostenstelle bzw. Innenauftrag und Einheit zu einer Menge verdichtet.",
      "anchors": [
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 214,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:214"
        }
      ]
    },
    {
      "id": "BM-055-B05",
      "text": "Vor dem Buchen wird die Periode gegen parallele Verrechnung gesperrt; ist sie schon gesperrt, endet der Lauf mit einem Fehlereintrag.",
      "anchors": [
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:61"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:70"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:72"
        }
      ]
    },
    {
      "id": "BM-055-B06",
      "text": "Je verdichteter Position wird eine Leistungsverrechnung von der Sender-Kostenstelle auf die Empfänger-Kostenstelle bzw. den Innenauftrag aufgebaut; im Testlauf wird sie nur geprüft, im Echtlauf zur Buchung übergeben.",
      "anchors": [
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:83"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:90"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:91"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:98"
        }
      ]
    },
    {
      "id": "BM-055-B07",
      "text": "Enthält die Rückmeldung eine Fehlermeldung, wird zurückgerollt; im Echtlauf werden die betroffenen Zeitsätze auf Status E gesetzt und festgeschrieben.",
      "anchors": [
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:115"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 116,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:116"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:117"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 120,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:120"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:121"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 130,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:130"
        }
      ]
    },
    {
      "id": "BM-055-B08",
      "text": "Im Testlauf ohne Fehler wird die Position nur als geprüft protokolliert.",
      "anchors": [
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 133,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:133"
        }
      ]
    },
    {
      "id": "BM-055-B09",
      "text": "Im Echtlauf ohne Fehler werden die Zeitsätze mit der CO-Belegnummer auf Status V gesetzt und gemeinsam mit der Verrechnung festgeschrieben.",
      "anchors": [
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 136,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:136"
        },
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 146,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:146"
        }
      ]
    },
    {
      "id": "BM-055-B10",
      "text": "Nach allen Positionen wird die Periodensperre freigegeben und das Protokoll mit Sender, Leistungsart, Empfänger, Menge, Status und Text ausgegeben.",
      "anchors": [
        {
          "file": "zcl_co_act_alloc.abap",
          "line": 155,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_co_act_alloc.abap:155"
        },
        {
          "file": "zco_act_alloc.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zco_act_alloc.abap:25"
        }
      ]
    }
  ],
