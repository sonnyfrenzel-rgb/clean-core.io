  "businessStatements": [
    {
      "id": "BM-289-B01",
      "text": "Der Transportauftrag wird gegen parallele Quittierung gesperrt; ist er bereits gesperrt, endet der Baustein mit der Ausnahme TA_GESPERRT.",
      "anchors": [
        {
          "file": "lzwm_quitu01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitu01.abap:19"
        },
        {
          "file": "lzwm_quitu01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitu01.abap:28"
        },
        {
          "file": "lzwm_quitu01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitu01.abap:29"
        }
      ]
    },
    {
      "id": "BM-289-B02",
      "text": "Es werden die noch nicht quittierten Positionen des Transportauftrags mit Materialkurztext gelesen.",
      "anchors": [
        {
          "file": "lzwm_quitu01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitu01.abap:32"
        }
      ]
    },
    {
      "id": "BM-289-B03",
      "text": "Gibt es keine offene Position, wird die Sperre wieder aufgehoben und der Baustein endet mit der Ausnahme NICHTS_OFFEN.",
      "anchors": [
        {
          "file": "lzwm_quitu01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitu01.abap:40"
        },
        {
          "file": "lzwm_quitu01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitu01.abap:41"
        },
        {
          "file": "lzwm_quitu01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitu01.abap:45"
        }
      ]
    },
    {
      "id": "BM-289-B04",
      "text": "Sonst werden die Positionen in einem modalen Quittierdialog angezeigt; nach dessen Ende wird die Sperre aufgehoben und zurückgegeben, ob quittiert wurde.",
      "anchors": [
        {
          "file": "lzwm_quitu01.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitu01.abap:50"
        },
        {
          "file": "lzwm_quitu01.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitu01.abap:52"
        },
        {
          "file": "lzwm_quitu01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitu01.abap:57"
        }
      ]
    },
    {
      "id": "BM-289-B05",
      "text": "Mit Abbrechen nach Eingaben muss der Packer das Verwerfen bestätigen; ohne Bestätigung bleibt der Dialog offen, sonst wird er geschlossen.",
      "anchors": [
        {
          "file": "lzwm_quiti01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quiti01.abap:29"
        },
        {
          "file": "lzwm_quiti01.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quiti01.abap:30"
        },
        {
          "file": "lzwm_quiti01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quiti01.abap:31"
        },
        {
          "file": "lzwm_quiti01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quiti01.abap:37"
        },
        {
          "file": "lzwm_quiti01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quiti01.abap:39"
        }
      ]
    },
    {
      "id": "BM-289-B06",
      "text": "Beim Quittieren muss für jede markierte Position Istmenge plus Differenzmenge die Sollmenge ergeben, sonst bricht eine Fehlermeldung mit der Positionsnummer ab.",
      "anchors": [
        {
          "file": "lzwm_quitf01.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:16"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:18"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:19"
        }
      ]
    },
    {
      "id": "BM-289-B07",
      "text": "Ist keine Position markiert, erhält der Packer einen Hinweis und es wird nichts quittiert.",
      "anchors": [
        {
          "file": "lzwm_quitf01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:29"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:30"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:31"
        }
      ]
    },
    {
      "id": "BM-289-B08",
      "text": "Die markierten Positionen werden mit Ist- und Differenzmenge im Transportauftrag quittiert.",
      "anchors": [
        {
          "file": "lzwm_quitf01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:34"
        }
      ]
    },
    {
      "id": "BM-289-B09",
      "text": "Scheitert die Quittierung, wird zurückgerollt und die Meldung des Bausteins als Fehler ausgegeben.",
      "anchors": [
        {
          "file": "lzwm_quitf01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:47"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:48"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:49"
        }
      ]
    },
    {
      "id": "BM-289-B10",
      "text": "Sonst wird synchron festgeschrieben, Transportauftrag und Anzahl der quittierten Positionen werden gemeldet, die Quittierung wird als erfolgt vermerkt und der Dialog geschlossen.",
      "anchors": [
        {
          "file": "lzwm_quitf01.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:53"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:55"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:56"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:57"
        }
      ]
    },
    {
      "id": "BM-289-B11",
      "text": "Mit Differenz wird für die Position unter dem Cursor nach Rückfrage die Fehlmenge Soll minus Ist als Differenzmenge eingetragen und die Position markiert; gebucht wird dabei noch nichts.",
      "anchors": [
        {
          "file": "lzwm_quitf01.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:72"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:73"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:75"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:81"
        },
        {
          "file": "lzwm_quitf01.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "lzwm_quitf01.abap:82"
        }
      ]
    }
