  "businessStatements": [
    {
      "id": "BM-291-B01",
      "text": "Das gescannte Prüflos wird nur gelesen, wenn zu ihm noch kein Verwendungsentscheid existiert.",
      "anchors": [
        {
          "file": "zqm_ud_schnell.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:19"
        }
      ]
    },
    {
      "id": "BM-291-B02",
      "text": "Ist das Los unbekannt oder schon entschieden, wird das als Statusmeldung in Fehleroptik angezeigt und nichts weiter getan; sonst wird das Entscheidungsbild aufgerufen.",
      "anchors": [
        {
          "file": "zqm_ud_schnell.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:25"
        },
        {
          "file": "zqm_ud_schnell.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:26"
        },
        {
          "file": "zqm_ud_schnell.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:29"
        }
      ]
    },
    {
      "id": "BM-291-B03",
      "text": "Zurück oder Abbrechen verlässt das Entscheidungsbild ohne Entscheid.",
      "anchors": [
        {
          "file": "zqm_ud_schnell.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:37"
        },
        {
          "file": "zqm_ud_schnell.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:39"
        }
      ]
    },
    {
      "id": "BM-291-B04",
      "text": "Auf Anforderung wird ein Entscheidungsvorschlag ermittelt: vorbelegt ist Annahme mit der Codegruppe WE01.",
      "anchors": [
        {
          "file": "zqm_ud_schnell.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:42"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:86"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:88"
        }
      ]
    },
    {
      "id": "BM-291-B05",
      "text": "Die anzuwendenden Regeln hängen von der Prüfart ab: die Lieferanten-Sperrlistenregel gilt immer, die Merkmalsregel nur bei Wareneingangsprüfung (Prüfart 01).",
      "anchors": [
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:89"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:78"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:81"
        }
      ]
    },
    {
      "id": "BM-291-B06",
      "text": "Die Regeln werden der Reihe nach angewandt; die erste, die Zurückweisung ergibt, setzt den Vorschlag auf Zurückweisung und beendet die Bewertung.",
      "anchors": [
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:90"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:91"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:92"
        }
      ]
    },
    {
      "id": "BM-291-B07",
      "text": "Die Lieferantenregel weist zurück, wenn der Lieferant des Loses mit noch gültigem Datum auf der QM-Sperrliste steht.",
      "anchors": [
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:32"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:36"
        }
      ]
    },
    {
      "id": "BM-291-B08",
      "text": "Die Merkmalsregel weist zurück, wenn im Los mindestens ein Merkmal mit Bewertung zurückgewiesen erfasst ist.",
      "anchors": [
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:51"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:55"
        }
      ]
    },
    {
      "id": "BM-291-B09",
      "text": "Beim Entscheiden muss der Prüfer bestätigen, dass der nicht rücknehmbare Entscheid gebucht werden soll; ohne Bestätigung bleibt er auf dem Bild und es wird nichts gebucht.",
      "anchors": [
        {
          "file": "zqm_ud_schnell.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:46"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:105"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 113,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:113"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:114"
        }
      ]
    },
    {
      "id": "BM-291-B10",
      "text": "Der Verwendungsentscheid wird mit Werk, Codegruppe, Code, Erfasser und Datum zum Prüflos per BAPI gesetzt, mit erzwungenem Abschluss.",
      "anchors": [
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 125,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:125"
        }
      ]
    },
    {
      "id": "BM-291-B11",
      "text": "Meldet der BAPI einen Fehler oder Abbruch, wird dessen Meldung als Fehlermeldung ausgegeben und der Prüfer bleibt auf dem Bild.",
      "anchors": [
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 131,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:131"
        },
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 132,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:132"
        },
        {
          "file": "zqm_ud_schnell.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:51"
        }
      ]
    },
    {
      "id": "BM-291-B12",
      "text": "Sonst wird synchron festgeschrieben, Los und Entscheidungscode werden als Erfolgsmeldung angezeigt und das Bild wird verlassen.",
      "anchors": [
        {
          "file": "zqm_ud_schnell_c01.abap",
          "line": 138,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell_c01.abap:138"
        },
        {
          "file": "zqm_ud_schnell.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:47"
        },
        {
          "file": "zqm_ud_schnell.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zqm_ud_schnell.abap:48"
        }
      ]
    }
  ],
