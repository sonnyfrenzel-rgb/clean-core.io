  "businessStatements": [
    {
      "id": "BM-287-B01",
      "text": "Beim Aufbau des Meldungsdetails wird für Mängelmeldungen (M2) der Subscreen mit dem Objektteil, sonst der Subscreen mit dem Schadensbild eingeblendet.",
      "anchors": [
        {
          "file": "mzpm_stoer_o01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_o01.abap:15"
        }
      ]
    },
    {
      "id": "BM-287-B02",
      "text": "Auf dem Einstiegsbild beendet Zurück oder Beenden die Transaktion.",
      "anchors": [
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:13"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:15"
        }
      ]
    },
    {
      "id": "BM-287-B03",
      "text": "Wählt der Instandhalter Störmeldung (M1) oder Mängelmeldung (M2), werden zum gescannten Equipment der aktuell gültige Zeitabschnitt mit Planungswerk und die Bezeichnung in Anmeldesprache gelesen.",
      "anchors": [
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:17"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:20"
        }
      ]
    },
    {
      "id": "BM-287-B04",
      "text": "Gibt es das Equipment nicht, bricht eine Fehlermeldung ab und er bleibt auf dem Einstiegsbild.",
      "anchors": [
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:28"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:29"
        }
      ]
    },
    {
      "id": "BM-287-B05",
      "text": "Fehlt ihm die Berechtigung für das Planungswerk zur Meldungsanlage, wird die Transaktion mit einer Abbruchmeldung beendet.",
      "anchors": [
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:32"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:35"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:37"
        }
      ]
    },
    {
      "id": "BM-287-B06",
      "text": "Anschließend wird gesucht, ob zum Equipment bereits eine noch nicht abgeschlossene Meldung derselben Meldungsart existiert.",
      "anchors": [
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:41"
        }
      ]
    },
    {
      "id": "BM-287-B07",
      "text": "Gibt es eine, wird er gefragt, ob er trotzdem eine neue Meldung anlegen will; verneint er, wird das Einstiegsbild neu aufgerufen.",
      "anchors": [
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:45"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:46"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:53"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:54"
        }
      ]
    },
    {
      "id": "BM-287-B08",
      "text": "Ohne offene Meldung oder nach Bestätigung wechselt der Dialog ins Meldungsdetail.",
      "anchors": [
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:59"
        }
      ]
    },
    {
      "id": "BM-287-B09",
      "text": "Zurück oder Abbrechen im Meldungsdetail verwirft die Erfassung und kehrt zum Einstiegsbild zurück.",
      "anchors": [
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:69"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:70"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:71"
        }
      ]
    },
    {
      "id": "BM-287-B10",
      "text": "Beim Sichern wird bei gemeldetem Anlagenstillstand mit einer schlechteren Priorität als 2 eine Warnung ausgegeben und die Priorität auf 2 hochgesetzt.",
      "anchors": [
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:83"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:85"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:87"
        },
        {
          "file": "mzpm_stoer_i01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_i01.abap:88"
        }
      ]
    },
    {
      "id": "BM-287-B11",
      "text": "Die Meldung wird mit Equipment, Kurztext, Priorität, Melder, Meldezeitpunkt, Ausfallkennzeichen und Störungsbeginn sowie einer Position mit Schadens- und Objektteilcode per BAPI angelegt.",
      "anchors": [
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:36"
        }
      ]
    },
    {
      "id": "BM-287-B12",
      "text": "Meldet der BAPI einen Fehler oder Abbruch, wird die erste solche Meldung ins Anwendungsprotokoll geschrieben, als Statusmeldung in Fehleroptik angezeigt und die Anlage ohne Sichern beendet.",
      "anchors": [
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:46"
        },
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:47"
        },
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:48"
        },
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:49"
        }
      ]
    },
    {
      "id": "BM-287-B13",
      "text": "Sonst wird die Meldung gesichert und synchron festgeschrieben; die vergebene Meldungsnummer wird als Erfolgsmeldung angezeigt und das Einstiegsbild für die nächste Meldung aufgerufen.",
      "anchors": [
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:52"
        },
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:60"
        },
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:65"
        },
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:67"
        }
      ]
    },
    {
      "id": "BM-287-B14",
      "text": "Die Protokollroutine schreibt nur, wenn ein Anwendungsprotokoll geöffnet ist, und hat sonst keine Wirkung auf den Ablauf.",
      "anchors": [
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:74"
        },
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:80"
        },
        {
          "file": "mzpm_stoer_f01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "mzpm_stoer_f01.abap:88"
        }
      ]
    }
  ],
