  "businessStatements": [
    {
      "id": "BM-124-B01",
      "text": "Für den Geschäftspartner werden im angegebenen Kreditsegment Kreditlimit, Sperrkennzeichen und Limitgültigkeit gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:16"
        }
      ]
    },
    {
      "id": "BM-124-B02",
      "text": "Hat der Partner im Segment keine Kreditdaten, wird die Prüfung mit einer Ausnahme „kein Segment“ abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        },
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        }
      ]
    },
    {
      "id": "BM-124-B03",
      "text": "Ist der Partner im Kreditmanagement gesperrt, wird der Auftrag ohne weitere Prüfung abgelehnt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        }
      ]
    },
    {
      "id": "BM-124-B04",
      "text": "Sonst wird der Auftrag freigegeben, wenn das Limit unbefristet oder noch gültig ist und das übergebene Obligo zusammen mit dem Auftragswert das Kreditlimit nicht übersteigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        }
      ]
    }
  ],
