  "businessStatements": [
    {
      "id": "BM-203-B01",
      "text": "Zum Kunden wird die Kundengruppe im gewählten Vertriebsbereich gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:87"
        }
      ]
    },
    {
      "id": "BM-203-B02",
      "text": "Ist der Kunde im Vertriebsbereich nicht angelegt, bricht der Report mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:92"
        },
        {
          "file": "source.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:93"
        }
      ]
    },
    {
      "id": "BM-203-B03",
      "text": "Der Listenpreis (Konditionsart PR00) des Materials wird zum Tagesdatum aus den Konditionssätzen gelesen; ohne Satz rechnet der Report mit 0 weiter.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:97"
        }
      ]
    },
    {
      "id": "BM-203-B04",
      "text": "Die Preisstrategie richtet sich nach der Kundengruppe: 01 Key Account, 02 Wiederverkäufer, alle anderen Listenpreis.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:71"
        }
      ]
    },
    {
      "id": "BM-203-B05",
      "text": "Für Key Accounts wird der kundenindividuelle Rabattsatz aus der Pflegetabelle vom Listenpreis abgezogen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        },
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    },
    {
      "id": "BM-203-B06",
      "text": "Wiederverkäufer erhalten ab 100 Stück einen Staffelrabatt von 5 %, darunter den Listenpreis.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        },
        {
          "file": "source.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:46"
        }
      ]
    },
    {
      "id": "BM-203-B07",
      "text": "Alle übrigen Kundengruppen erhalten den Listenpreis als Nettopreis.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        }
      ]
    },
    {
      "id": "BM-203-B08",
      "text": "Kundengruppe, Listenpreis und Nettopreis werden als Liste ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 113,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:113"
        }
      ]
    }
  ],
