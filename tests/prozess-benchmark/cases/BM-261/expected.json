          "expressionPath": null,
          "raw": "source.abap:13"
        }
      ]
    },
    {
      "id": "BM-261-B02",
      "text": "Ohne Treffer erscheint eine Erfolgsmeldung „Keine fehlerhaften IDocs gefunden“ und der Report endet.",
