  "businessStatements": [
    {
      "id": "BM-146-B01",
      "text": "Für jeden selektierten Mitarbeiter wird das Abrechnungsverzeichnis gelesen; hat er keines, wird er übergangen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        },
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        },
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        }
      ]
    },
    {
      "id": "BM-146-B02",
      "text": "Die Abrechnungsergebnisse werden von der neuesten Periode rückwärts durchlaufen, wobei nur aktuelle Ergebnisse berücksichtigt werden.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        },
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        }
      ]
    },
    {
      "id": "BM-146-B03",
      "text": "Jedes berücksichtigte Ergebnis wird aus dem deutschen Abrechnungscluster gelesen; ein nicht lesbares Ergebnis wird übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        },
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        }
      ]
    },
    {
      "id": "BM-146-B04",
      "text": "Für die gewählte Abrechnungsperiode wird der Auszahlungsbetrag als Summe der Lohnart /559 ermittelt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        }
      ]
    },
    {
      "id": "BM-146-B05",
      "text": "Für die erste ältere Periode wird ebenso der Auszahlungsbetrag ermittelt und die Suche beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        },
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        },
        {
          "file": "source.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:66"
        }
      ]
    },
    {
      "id": "BM-146-B06",
      "text": "Ohne Auszahlung in der Vorperiode wird der Mitarbeiter nicht weiter geprüft.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        }
      ]
    },
    {
      "id": "BM-146-B07",
      "text": "Die prozentuale Abweichung des Auszahlungsbetrags zur Vorperiode wird berechnet; fehlt ein Ergebnis der gewählten Periode, zählt es als null und ergibt 100 Prozent.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:71"
        }
      ]
    },
    {
      "id": "BM-146-B08",
      "text": "Liegt die Abweichung über der eingegebenen Schwelle, wird der Mitarbeiter mit beiden Beträgen und der Abweichung gelistet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        },
        {
          "file": "source.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:74"
        }
      ]
    },
    {
      "id": "BM-146-B09",
      "text": "Gab es keinen auffälligen Mitarbeiter, wird am Ende gemeldet, dass keine Abweichung über der Schwelle vorliegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:78"
        },
        {
          "file": "source.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:79"
        }
      ]
    }
  ],
