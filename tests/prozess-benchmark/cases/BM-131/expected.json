  "businessStatements": [
    {
      "id": "BM-131-B01",
      "text": "Auf dem Selektionsbild wird das eingegebene Toleranzprofil gelesen; ist es unbekannt, wird eine Fehlermeldung ausgegeben und die Eingabe erneut angefordert.",
      "anchors": [
        {
          "file": "zps_budget_avc.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc.abap:33"
        },
        {
          "file": "zps_budget_avc.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc.abap:35"
        },
        {
          "file": "zps_budget_avc.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc.abap:36"
        }
      ]
    },
    {
      "id": "BM-131-B02",
      "text": "Jede Listenseite erhält eine Überschrift mit Geschäftsjahr und Toleranzprofil.",
      "anchors": [
        {
          "file": "zps_budget_avc.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc.abap:40"
        }
      ]
    },
    {
      "id": "BM-131-B03",
      "text": "Es werden die nicht gelöschten PSP-Elemente der ausgewählten Projekte gelesen; ohne Treffer werden keine Werte ermittelt.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:15"
        },
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:20"
        }
      ]
    },
    {
      "id": "BM-131-B04",
      "text": "Die Istkosten des Geschäftsjahres in Version 0 werden für alle PSP-Elemente gelesen.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:23"
        }
      ]
    },
    {
      "id": "BM-131-B05",
      "text": "Je PSP-Element wird das Jahresbudget aus Ursprungsbudget, Nachträgen und Rückgaben summiert.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:32"
        }
      ]
    },
    {
      "id": "BM-131-B06",
      "text": "Die Istkosten des Elements werden über die Perioden 1 bis 16 aufsummiert.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:39"
        },
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:40"
        },
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:42"
        }
      ]
    },
    {
      "id": "BM-131-B07",
      "text": "Das Obligo des Elements wird über alle Jahre summiert.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:48"
        }
      ]
    },
    {
      "id": "BM-131-B08",
      "text": "Werden keine PSP-Elemente gefunden, erscheint ein Warnhinweis und die Bewertung entfällt; die Listenausgabe läuft trotzdem.",
      "anchors": [
        {
          "file": "zps_budget_avc.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc.abap:46"
        },
        {
          "file": "zps_budget_avc.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc.abap:47"
        },
        {
          "file": "zps_budget_avc.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc.abap:48"
        }
      ]
    },
    {
      "id": "BM-131-B09",
      "text": "PSP-Elemente ohne Budget werden als „ohne Budget“ gekennzeichnet und nicht weiter bewertet.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:60"
        },
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:61"
        }
      ]
    },
    {
      "id": "BM-131-B10",
      "text": "Die Ausschöpfung ist die Summe aus Ist und Obligo in Prozent des Jahresbudgets.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:64"
        }
      ]
    },
    {
      "id": "BM-131-B11",
      "text": "Ab der Fehlergrenze des Profils ist die Ampel rot, ab der Warngrenze gelb, sonst grün.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:65"
        }
      ]
    },
    {
      "id": "BM-131-B12",
      "text": "Die Anzahl der roten PSP-Elemente wird gezählt.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:69"
        }
      ]
    },
    {
      "id": "BM-131-B13",
      "text": "Die Liste zeigt je PSP-Element Budget, Ist, Obligo, Ausschöpfung und Ampel, nach Projekt sortiert, mit einer Summenzeile je Projekt.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:82"
        },
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:84"
        },
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:86"
        }
      ]
    },
    {
      "id": "BM-131-B14",
      "text": "Am Listenende steht die Anzahl der PSP-Elemente über der Fehlergrenze.",
      "anchors": [
        {
          "file": "zps_budget_avc_f01.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc_f01.abap:91"
        }
      ]
    },
    {
      "id": "BM-131-B15",
      "text": "Ist der Mailversand gewählt und gibt es rote Elemente, wird die Projektleitung über eine Routine eines anderen Programms informiert, sofern diese existiert.",
      "anchors": [
        {
          "file": "zps_budget_avc.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc.abap:54"
        },
        {
          "file": "zps_budget_avc.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zps_budget_avc.abap:55"
        }
      ]
    }
  ],
