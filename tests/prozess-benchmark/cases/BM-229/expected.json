  "businessStatements": [
    {
      "id": "BM-229-B01",
      "text": "Liegt der gewählte Auswertungsmonat vor dem aktuellen Monat, wird auf dem Selektionsbild gewarnt; die Auswertung bleibt möglich.",
      "anchors": [
        {
          "file": "zhr_jubilaeum.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum.abap:17"
        },
        {
          "file": "zhr_jubilaeum.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum.abap:18"
        }
      ]
    },
    {
      "id": "BM-229-B02",
      "text": "Es werden die aktiven Mitarbeiter mit ihrer aktuellen organisatorischen Zuordnung in den gewählten Personalbereichen gelesen.",
      "anchors": [
        {
          "file": "zhr_jubilaeum.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum.abap:22"
        },
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:10"
        }
      ]
    },
    {
      "id": "BM-229-B03",
      "text": "Für jeden Mitarbeiter wird das Konzerneintrittsdatum aus den heute gültigen Datumsangaben (Datumsart 01) ermittelt.",
      "anchors": [
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:34"
        },
        {
          "file": "zhr_jubilaeum_cls.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_cls.abap:33"
        },
        {
          "file": "zhr_jubilaeum_cls.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_cls.abap:41"
        },
        {
          "file": "zhr_jubilaeum_cls.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_cls.abap:43"
        },
        {
          "file": "zhr_jubilaeum_cls.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_cls.abap:45"
        }
      ]
    },
    {
      "id": "BM-229-B04",
      "text": "Fehlen die Datumsangaben oder die Datumsart 01, wird der Mitarbeiter mit „kein Eintrittsdatum gepflegt“ ausgegeben und übersprungen.",
      "anchors": [
        {
          "file": "zhr_jubilaeum_cls.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_cls.abap:37"
        },
        {
          "file": "zhr_jubilaeum_cls.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_cls.abap:38"
        },
        {
          "file": "zhr_jubilaeum_cls.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_cls.abap:49"
        },
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:36"
        },
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:37"
        }
      ]
    },
    {
      "id": "BM-229-B05",
      "text": "Nur Mitarbeiter, deren Eintrittsmonat dem Auswertungsmonat entspricht, werden weiter betrachtet.",
      "anchors": [
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:41"
        }
      ]
    },
    {
      "id": "BM-229-B06",
      "text": "Die Dienstjahre ergeben sich aus der Differenz von Auswertungsjahr und Eintrittsjahr.",
      "anchors": [
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:43"
        }
      ]
    },
    {
      "id": "BM-229-B07",
      "text": "Ein Jubiläum liegt nur bei genau 10, 25 oder 40 Dienstjahren vor; sonst wird der Mitarbeiter nicht aufgenommen.",
      "anchors": [
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:44"
        },
        {
          "file": "zhr_jubilaeum_cls.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_cls.abap:53"
        },
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:45"
        }
      ]
    },
    {
      "id": "BM-229-B08",
      "text": "Für Jubilare wird die Prämie je Stufe und Personalbereich aus der Kundentabelle gelesen und der Jubilar mit Eintritt, Jahren, Stufe und Prämie in die Liste aufgenommen.",
      "anchors": [
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:53"
        },
        {
          "file": "zhr_jubilaeum_cls.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_cls.abap:67"
        },
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:55"
        }
      ]
    },
    {
      "id": "BM-229-B09",
      "text": "Gibt es keinen Jubilar, erscheint ein Hinweis mit dem Monat und die Verarbeitung endet.",
      "anchors": [
        {
          "file": "zhr_jubilaeum.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum.abap:28"
        },
        {
          "file": "zhr_jubilaeum.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum.abap:29"
        },
        {
          "file": "zhr_jubilaeum.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum.abap:30"
        }
      ]
    },
    {
      "id": "BM-229-B10",
      "text": "Die Jubilare werden absteigend nach Dienstjahren sortiert und als ALV-Liste angezeigt; scheitert die Anzeige, erscheint eine Fehlermeldung.",
      "anchors": [
        {
          "file": "zhr_jubilaeum.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum.abap:33"
        },
        {
          "file": "zhr_jubilaeum.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum.abap:34"
        },
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:79"
        },
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:88"
        },
        {
          "file": "zhr_jubilaeum_f01.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_jubilaeum_f01.abap:89"
        }
      ]
    }
  ],
