  "businessStatements": [
    {
      "id": "BM-041-B01",
      "text": "Es werden alle offenen Debitorenposten des eingegebenen Kunden im eingegebenen Buchungskreis gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:15"
        }
      ]
    },
    {
      "id": "BM-041-B02",
      "text": "Für jeden Posten wird die Nettofälligkeit als Basisdatum plus Tage des ersten Zahlungsziels bestimmt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        }
      ]
    },
    {
      "id": "BM-041-B03",
      "text": "Nur Posten, deren Nettofälligkeit vor dem Stichtag liegt, gelten als überfällig; Habenposten gehen mit negativem Vorzeichen in die Summe ein.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        },
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        },
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        }
      ]
    },
    {
      "id": "BM-041-B04",
      "text": "Jeder überfällige Posten wird mit Belegnummer, Geschäftsjahr, Fälligkeit und Betrag gelistet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        }
      ]
    },
    {
      "id": "BM-041-B05",
      "text": "Am Ende wird die Summe der überfälligen Beträge in Hauswährung ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:31"
        }
      ]
    }
  ],
