  "businessStatements": [
    {
      "id": "BM-089-B01",
      "text": "Aus dem PLM-System werden per RFC alle seit dem Stichtag freigegebenen Teile abgeholt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-089-B02",
      "text": "Bei einem Kommunikations- oder Systemfehler wird die Fehlermeldung ausgegeben und der Lauf beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        },
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:31"
        },
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    },
    {
      "id": "BM-089-B03",
      "text": "Je Teil wird geprüft, ob die Teilenummer bereits als Material existiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        }
      ]
    },
    {
      "id": "BM-089-B04",
      "text": "Neue Teile werden als Halbfabrikat der Branche Maschinenbau angelegt, bestehende nur in den Grunddaten geändert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        },
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        },
        {
          "file": "source.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:46"
        }
      ]
    },
    {
      "id": "BM-089-B05",
      "text": "Übernommen werden Basismengeneinheit, Nettogewicht in Kilogramm, die PLM-Nummer als alte Materialnummer und der deutsche Kurztext.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        }
      ]
    },
    {
      "id": "BM-089-B06",
      "text": "Meldet die Materialpflege einen Fehler oder Abbruch, wird verworfen und die Meldung mit Teilenummer ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:69"
        },
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        },
        {
          "file": "source.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:71"
        }
      ]
    },
    {
      "id": "BM-089-B07",
      "text": "Im Testmodus wird auch eine erfolgreiche Pflege wieder verworfen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:76"
        },
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        }
      ]
    },
    {
      "id": "BM-089-B08",
      "text": "Im Echtlauf wird die Pflege festgeschrieben und die Übernahme mit Materialnummer an das PLM zurückgemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:79"
        },
        {
          "file": "source.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:82"
        }
      ]
    },
    {
      "id": "BM-089-B09",
      "text": "Zum Schluss werden die Anzahl verarbeiteter und fehlerhafter Teile ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:94"
        }
      ]
    }
  ],
