  "businessStatements": [
    {
      "id": "BM-231-B01",
      "text": "Die Abweichungsschwelle in Prozent wird je Kostenrechnungskreis aus einer Kundentabelle gelesen; fehlt sie, gilt 10 % und es erscheint ein Hinweis.",
      "anchors": [
        {
          "file": "zco_abweichung_mail.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:41"
        },
        {
          "file": "zco_abweichung_mail.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:43"
        },
        {
          "file": "zco_abweichung_mail.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:45"
        }
      ]
    },
    {
      "id": "BM-231-B02",
      "text": "Es werden die heute gültigen Kostenstellen des Kostenrechnungskreises mit ihrem verantwortlichen Benutzer gelesen.",
      "anchors": [
        {
          "file": "zco_abweichung_mail.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:48"
        }
      ]
    },
    {
      "id": "BM-231-B03",
      "text": "Je Kostenstelle werden Plan- und Ist-Primärkosten der Planversion für die Perioden 1 bis zur Bis-Periode kumuliert.",
      "anchors": [
        {
          "file": "zco_abweichung_mail.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:57"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:22"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:32"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:34"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:36"
        }
      ]
    },
    {
      "id": "BM-231-B04",
      "text": "Gibt es keine Primärkostensätze, bleibt die Abweichung null.",
      "anchors": [
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:27"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:28"
        }
      ]
    },
    {
      "id": "BM-231-B05",
      "text": "Die Abweichung ist die prozentuale Differenz von Ist zu Plan; ohne Plan gilt sie als 999 %.",
      "anchors": [
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:41"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:42"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:45"
        }
      ]
    },
    {
      "id": "BM-231-B06",
      "text": "Nur Kostenstellen, deren Abweichung betragsmäßig über der Schwelle liegt, kommen auf die Abweichungsliste.",
      "anchors": [
        {
          "file": "zco_abweichung_mail.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:58"
        }
      ]
    },
    {
      "id": "BM-231-B07",
      "text": "Hat eine solche Kostenstelle keinen verantwortlichen Benutzer, wird ein Hinweis ausgegeben und keine Mail versandt.",
      "anchors": [
        {
          "file": "zco_abweichung_mail.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:61"
        },
        {
          "file": "zco_abweichung_mail.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:62"
        }
      ]
    },
    {
      "id": "BM-231-B08",
      "text": "Im Echtlauf erhält der Verantwortliche eine Mail mit kumuliertem Plan, Ist und Abweichung.",
      "anchors": [
        {
          "file": "zco_abweichung_mail.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:66"
        },
        {
          "file": "zco_abweichung_mail.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:67"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:78"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:82"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:84"
        }
      ]
    },
    {
      "id": "BM-231-B09",
      "text": "Wird der Versand angenommen, wird der Sendeauftrag festgeschrieben und protokolliert; ein Fehler der Sendeschnittstelle wird protokolliert.",
      "anchors": [
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:85"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:86"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:87"
        },
        {
          "file": "zco_abweichung_mail_f01.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail_f01.abap:90"
        }
      ]
    },
    {
      "id": "BM-231-B10",
      "text": "Am Ende wird jede Kostenstelle der Abweichungsliste mit Plan, Ist und Prozent ausgegeben.",
      "anchors": [
        {
          "file": "zco_abweichung_mail.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zco_abweichung_mail.abap:71"
        },
        {
