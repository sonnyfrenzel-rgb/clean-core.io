  "businessStatements": [
    {
      "id": "BM-062-B01",
      "text": "Das übergebene Prüflos wird gelesen; existiert es nicht, endet der Baustein mit der Ausnahme LOS_NICHT_GEFUNDEN.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        },
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        },
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        }
      ]
    },
    {
      "id": "BM-062-B02",
      "text": "Zum Prüflos wird der Verwendungsentscheid auf Losebene gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        }
      ]
    },
    {
      "id": "BM-062-B03",
      "text": "Nur wenn ein Verwendungsentscheid existiert und seine Bewertung „angenommen“ (A) lautet, wird die Freigabe gesetzt und der Entscheidungscode zurückgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        }
      ]
    },
    {
      "id": "BM-062-B04",
      "text": "Fehlt der Verwendungsentscheid oder ist er nicht angenommen, kehrt der Baustein ohne Freigabe und ohne Ausnahme zurück.",
      "anchors": [
        {
          "file": "source.abap",
