  "businessStatements": [
    {
      "id": "BM-133-B01",
      "text": "Es werden die gültigen Förderungen des Buchungskreises mit kostenbasierter Abrechnungsregel gelesen; gibt es keine, bricht der Job mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:54"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:60"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:61"
        },
        {
          "file": "z_gm_billing_job.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "z_gm_billing_job.abap:21"
        }
      ]
    },
    {
      "id": "BM-133-B02",
      "text": "Für jede Förderung werden die nicht förderfähigen Sponsored Classes ihres Fördertyps gelesen.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:76"
        }
      ]
    },
    {
      "id": "BM-133-B03",
      "text": "Die Ist-Ausgaben der Förderung bis zum Stichtag werden je Sponsored Class summiert, und nur die förderfähigen Klassen werden addiert.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:80"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:88"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:91"
        }
      ]
    },
    {
      "id": "BM-133-B04",
      "text": "Der abzurechnende Betrag ist die Summe der förderfähigen Ausgaben abzüglich aller bereits abgerechneten Beträge.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:94"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:98"
        }
      ]
    },
    {
      "id": "BM-133-B05",
      "text": "Ist nichts abzurechnen, wird das für die Förderung vermerkt und keine Anforderung angelegt.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:99"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:101"
        }
      ]
    },
    {
      "id": "BM-133-B06",
      "text": "Im Testlauf wird der Betrag nur ausgewiesen.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:103"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:105"
        }
      ]
    },
    {
      "id": "BM-133-B07",
      "text": "Im Echtlauf wird der Debitor des Sponsors ermittelt.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 108,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:108"
        }
      ]
    },
    {
      "id": "BM-133-B08",
      "text": "Für den Sponsor wird eine Lastschriftanforderung der Art ZGMA mit dem Betrag als Kondition ZGM0 und der Fördernummer als Bestellnummer angelegt.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:114"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 154,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:154"
        }
      ]
    },
    {
      "id": "BM-133-B09",
      "text": "Meldet die Anlage, dass Sponsor oder Beleg gerade bearbeitet werden, wird nach zwei Sekunden Wartezeit bis zu dreimal insgesamt versucht; danach wird die Förderung auf den nächsten Lauf verschoben.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 166,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:166"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 167,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:167"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 126,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:126"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:127"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 128,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:128"
        }
      ]
    },
    {
      "id": "BM-133-B10",
      "text": "Liefert die Anlage keine Belegnummer, wird zurückgerollt und der Fehlertext übernommen.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 169,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:169"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 132,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:132"
        }
      ]
    },
    {
      "id": "BM-133-B11",
      "text": "Nach erfolgreicher Anlage wird die Abrechnung mit Stichtag, Anforderungsnummer und Betrag vermerkt und alles festgeschrieben.",
      "anchors": [
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:117"
        },
        {
          "file": "zcl_gm_sponsor_billing.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_gm_sponsor_billing.abap:121"
        }
      ]
    },
    {
      "id": "BM-133-B12",
      "text": "Je Förderung werden Betrag, Anforderungsnummer und Ergebnistext gelistet.",
      "anchors": [
        {
          "file": "z_gm_billing_job.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "z_gm_billing_job.abap:25"
        }
      ]
    }
  ],
