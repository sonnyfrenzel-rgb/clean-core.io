  "businessStatements": [
    {
      "id": "BM-031-B01",
      "text": "Beim Sichern einer Eingangsrechnung in der Logistik-Rechnungsprüfung werden nur Rechnungen geprüft; Gutschriften und nachträgliche Belastungen bleiben ungeprüft.",
      "anchors": [
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:16"
        },
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:27"
        },
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:28"
        }
      ]
    },
    {
      "id": "BM-031-B02",
      "text": "Die Toleranz wird zuerst kreditorspezifisch für den Buchungskreis gesucht, dann als Buchungskreis-Default, und fehlt beides, gilt eine feste Preistoleranz von 5 %.",
      "anchors": [
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:28"
        },
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:32"
        },
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:38"
        }
      ]
    },
    {
      "id": "BM-031-B03",
      "text": "Ist die Prüfung für den Kreditor abgeschaltet, wird die Rechnung ohne Prüfung gesichert.",
      "anchors": [
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:34"
        },
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:35"
        }
      ]
    },
    {
      "id": "BM-031-B04",
      "text": "Geprüft werden nur Rechnungspositionen mit Bestellbezug.",
      "anchors": [
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:38"
        }
      ]
    },
    {
      "id": "BM-031-B05",
      "text": "Je Position wird die Bestellposition gelesen; fehlt sie oder sind Preiseinheit bzw. Rechnungsmenge null, wird die Position übersprungen.",
      "anchors": [
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:50"
        },
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:53"
        },
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:40"
        }
      ]
    },
    {
      "id": "BM-031-B06",
      "text": "Rechnungs- und Bestellpreis werden je Einheit verglichen; daraus ergeben sich die prozentuale Preisabweichung und der Differenzbetrag über die Rechnungsmenge.",
      "anchors": [
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:59"
        },
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:62"
        }
      ]
    },
    {
      "id": "BM-031-B07",
      "text": "Bei WE-bezogener Rechnungsprüfung wird die Rechnungsmenge gegen die gelieferte, noch nicht berechnete Menge aus der Bestellentwicklung gestellt; nur ein Überhang zählt als Mengenüberschreitung.",
      "anchors": [
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:67"
        },
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:72"
        },
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:78"
        },
        {
          "file": "zcl_mm_iv_check.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_iv_check.abap:79"
        }
      ]
    },
    {
      "id": "BM-031-B08",
      "text": "Eine Position ist auffällig, wenn die Preisabweichung die Toleranz übersteigt oder, falls der Kreditor keine Mengenüberschreitung erlaubt, mehr berechnet als offen geliefert wurde.",
      "anchors": [
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:45"
        },
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:46"
        },
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:48"
        }
      ]
    },
    {
      "id": "BM-031-B09",
      "text": "Für jede auffällige Position wird der Differenzbetrag summiert und eine Protokollzeile mit Rechnung, Bestellung, Kreditor, Differenz, Benutzer und Datum gebildet.",
      "anchors": [
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:53"
        },
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:54"
        }
      ]
    },
    {
      "id": "BM-031-B10",
      "text": "Ohne auffällige Position wird die Rechnung normal gesichert.",
      "anchors": [
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:67"
        },
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:68"
        }
      ]
    },
    {
      "id": "BM-031-B11",
      "text": "Übersteigt die Summe der Differenzen eine gepflegte harte Betragsgrenze, wird das Sichern mit einer Fehlermeldung verhindert.",
      "anchors": [
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:72"
        },
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:73"
        }
      ]
    },
    {
      "id": "BM-031-B12",
      "text": "Sonst wird die Rechnung gesichert und die Abweichungen werden mit der Verbuchung als offene Nacharbeitsfälle für die Kreditorenbuchhaltung protokolliert.",
      "anchors": [
        {
          "file": "zcl_im_invoice_update.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_im_invoice_update.abap:78"
        },
        {
          "file": "z_mm_iv_log_write.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_iv_log_write.abap:11"
        },
        {
          "file": "z_mm_iv_log_write.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_iv_log_write.abap:12"
        }
      ]
    },
    {
      "id": "BM-031-B13",
      "text": "Scheitert das Schreiben des Protokolls, bricht die Verbuchung mit Abbruchmeldung ab.",
      "anchors": [
        {
          "file": "z_mm_iv_log_write.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_iv_log_write.abap:13"
        },
        {
          "file": "z_mm_iv_log_write.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "z_mm_iv_log_write.abap:14"
        }
      ]
    }
  ],
