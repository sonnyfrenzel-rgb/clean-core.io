  "businessStatements": [
    {
      "id": "BM-061-B01",
      "text": "Es werden Fertigungsaufträge des eingegebenen Werks und der gewählten Disponenten selektiert, deren Eckendtermin vor dem heutigen Datum liegt, die kein Endlieferkennzeichen tragen und deren gelieferte Menge unter der Auftragsmenge liegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-061-B02",
      "text": "Ohne Treffer wird die Meldung „Kein Rueckstand im Werk“ ausgegeben und die Verarbeitung beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        }
      ]
    },
    {
      "id": "BM-061-B03",
      "text": "Die Rückstandsaufträge werden nach Eckendtermin sortiert und je Auftrag mit Material, Ecktermin und offener Restmenge (Auftragsmenge minus gelieferte Menge) als Liste ausgegeben.",
