        }
      ]
    },
    {
      "id": "BM-122-B02",
      "text": "Es werden die Mietverträge des Buchungskreises gelesen, deren erstes Vertragsende zwischen heute und dem Ende des eingegebenen Tagesfensters liegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:16"
        }
      ]
    },
    {
      "id": "BM-122-B03",
      "text": "Je Vertrag wird eine Ampel bestimmt: Rot bis 30 Tage Restlaufzeit, Gelb bis 60 Tage, sonst Grün.",
