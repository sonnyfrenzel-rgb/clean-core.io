  "businessStatements": [
    {
      "id": "BM-230-B01",
      "text": "Liegt das Stornodatum nicht nach dem Buchungsdatum, weist das Selektionsbild die Eingabe mit einer Fehlermeldung zurück.",
      "anchors": [
        {
          "file": "zfi_abgrenzung_sel.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_sel.abap:19"
        },
        {
          "file": "zfi_abgrenzung_sel.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_sel.abap:20"
        }
      ]
    },
    {
      "id": "BM-230-B02",
      "text": "Es werden die offenen Periodenabgrenzungen des Buchungskreises bis zum Buchungsdatum gelesen.",
      "anchors": [
        {
          "file": "zfi_abgrenzung.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung.abap:19"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 9,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:9"
        }
      ]
    },
    {
      "id": "BM-230-B03",
      "text": "Gibt es keine, erscheint eine Meldung und die Verarbeitung endet.",
      "anchors": [
        {
          "file": "zfi_abgrenzung.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung.abap:20"
        },
        {
          "file": "zfi_abgrenzung.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung.abap:21"
        },
        {
          "file": "zfi_abgrenzung.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung.abap:22"
        }
      ]
    },
    {
      "id": "BM-230-B04",
      "text": "Je Abgrenzung werden Batch-Input-Daten für einen Abgrenzungsbeleg der Belegart SA mit Stornodatum und Stornogrund aufgebaut: Aufwandskonto mit Kostenstelle im Soll, Abgrenzungskonto im Haben.",
      "anchors": [
        {
          "file": "zfi_abgrenzung.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung.abap:26"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:36"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:38"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:44"
        }
      ]
    },
    {
      "id": "BM-230-B05",
      "text": "Der Beleg wird über die Transaktion FBS1 im gewählten Anzeigemodus mit synchroner Verbuchung gebucht.",
      "anchors": [
        {
          "file": "zfi_abgrenzung.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung.abap:27"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:64"
        }
      ]
    },
    {
      "id": "BM-230-B06",
      "text": "Nur wenn die Transaktion fehlerfrei endet und die Buchungsbestätigung vorliegt, wird die Abgrenzung mit Status B und Belegnummer gekennzeichnet und als gebucht gezählt.",
      "anchors": [
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:71"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:74"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:75"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:80"
        }
      ]
    },
    {
      "id": "BM-230-B07",
      "text": "Sonst wird die Abgrenzung als Fehler gezählt und jede Fehler- und Abbruchmeldung der Transaktion mit Text ausgegeben.",
      "anchors": [
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:84"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 116,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:116"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:117"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:127"
        }
      ]
    },
    {
      "id": "BM-230-B08",
      "text": "Ist die Fehlermappe gewünscht, wird beim ersten Fehler eine Batch-Input-Mappe geöffnet; scheitert das, bricht das Programm ab.",
      "anchors": [
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:86"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:87"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:88"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:96"
        },
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:97"
        }
      ]
    },
    {
      "id": "BM-230-B09",
      "text": "Die fehlgeschlagene Transaktion wird mit ihren Eingaben in die Mappe zur manuellen Nacharbeit eingestellt.",
      "anchors": [
        {
          "file": "zfi_abgrenzung_f01.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung_f01.abap:102"
        }
      ]
    },
    {
      "id": "BM-230-B10",
      "text": "Nach allen Abgrenzungen wird eine geöffnete Mappe geschlossen und ihr Name gemeldet.",
      "anchors": [
        {
          "file": "zfi_abgrenzung.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung.abap:30"
        },
        {
          "file": "zfi_abgrenzung.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung.abap:31"
        },
        {
          "file": "zfi_abgrenzung.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung.abap:32"
        }
      ]
    },
    {
      "id": "BM-230-B11",
      "text": "Zum Schluss werden die Anzahl gebuchter und fehlerhafter Abgrenzungen ausgegeben.",
      "anchors": [
        {
          "file": "zfi_abgrenzung.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_abgrenzung.abap:36"
        }
      ]
    }
  ],
