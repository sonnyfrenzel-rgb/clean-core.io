  "businessStatements": [
    {
      "id": "BM-244-B01",
      "text": "Ist keine Bestellanforderung markiert, erhält der Genehmiger die Warnung ZMM_WD 001 und die Aktion endet ohne Wirkung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        },
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:24"
        },
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        }
      ]
    },
    {
      "id": "BM-244-B02",
      "text": "Der Freigabecode des Genehmigers wird aus der kundeneigenen Zuordnung Benutzer → Freigabecode gelesen, nur aktive Einträge.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-244-B03",
      "text": "Hat der Benutzer keinen aktiven Freigabecode, wird der Fehler ZMM_WD 002 gemeldet und nichts freigegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        },
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        },
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        }
      ]
    },
    {
      "id": "BM-244-B04",
      "text": "Jede markierte Bestellanforderung wird einzeln mit diesem Freigabecode über das Freigabe-BAPI freigegeben, ohne dass das BAPI selbst festschreibt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        },
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        }
      ]
    },
    {
      "id": "BM-244-B05",
      "text": "Meldet das BAPI eine Ausnahme (z. B. Berechtigung, Sperre, bereits freigegeben), wird die Banf als Fehler gezählt, mit Nummer und Ausnahmenummer gemeldet und die nächste bearbeitet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        }
      ]
    },
    {
      "id": "BM-244-B06",
      "text": "Enthält die BAPI-Rückgabe eine Fehlermeldung, wird die Freigabe dieser Banf zurückgerollt und der Fehlertext angezeigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        },
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        },
        {
          "file": "source.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:71"
        }
      ]
    },
    {
      "id": "BM-244-B07",
      "text": "Sonst wird die Freigabe je Banf synchron festgeschrieben und der neue Freigabestatus in der Liste angezeigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        },
        {
          "file": "source.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:78"
        }
      ]
    },
    {
      "id": "BM-244-B08",
      "text": "Am Ende meldet die Anwendung die Anzahl erfolgreich freigegebener und fehlerhafter Bestellanforderungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:82"
        }
      ]
    }
  ],
