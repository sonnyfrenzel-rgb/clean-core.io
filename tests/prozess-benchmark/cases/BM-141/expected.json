  "businessStatements": [
    {
      "id": "BM-141-B01",
      "text": "Für jeden selektierten Mitarbeiter wird die im Auswahlzeitraum zuletzt gültige Hauptbankverbindung ermittelt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:10"
        },
        {
          "file": "source.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:11"
        }
      ]
    },
    {
      "id": "BM-141-B02",
      "text": "Mitarbeiter, deren Hauptbankverbindung den Zahlweg Barzahlung trägt, werden übergangen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:12"
        }
      ]
    },
    {
      "id": "BM-141-B03",
      "text": "Fehlt die Hauptbankverbindung im Zeitraum oder hat sie keine IBAN, wird der Mitarbeiter gezählt und mit Personalnummer ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:13"
        },
        {
          "file": "source.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:15"
        }
      ]
    },
    {
      "id": "BM-141-B04",
      "text": "Am Ende wird die Anzahl der Mitarbeiter ohne verwendbare Bankverbindung ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    }
  ],
