  "businessStatements": [
    {
      "id": "BM-292-B01",
      "text": "Die Retourenannahme startet mit dem Erfassungsbild für Fakturanummer und Rückgabegrund.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter.abap:16"
        },
        {
          "file": "zsd_retoure_schalter.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter.abap:17"
        }
      ]
    },
    {
      "id": "BM-292-B02",
      "text": "Zurück oder Beenden verlässt die Transaktion.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter.abap:24"
        },
        {
          "file": "zsd_retoure_schalter.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter.abap:26"
        }
      ]
    },
    {
      "id": "BM-292-B03",
      "text": "Mit Weiter wird die Faktura gelesen; existiert sie nicht, bricht eine Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter.abap:29"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:12"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:14"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:15"
        }
      ]
    },
    {
      "id": "BM-292-B04",
      "text": "Eine stornierte Faktura wird mit Fehlermeldung abgewiesen.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:18"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:19"
        }
      ]
    },
    {
      "id": "BM-292-B05",
      "text": "Ist die Faktura noch nicht vollständig an die Buchhaltung übergeben, wird die Retoure mit Fehlermeldung abgewiesen.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:23"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:25"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:26"
        }
      ]
    },
    {
      "id": "BM-292-B06",
      "text": "Liegt das Fakturadatum mehr als 30 Tage zurück, erscheint nur eine Warnung mit der Anzahl der Tage; nach Bestätigung geht es weiter.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:30"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:32"
        }
      ]
    },
    {
      "id": "BM-292-B07",
      "text": "Die Fakturapositionen werden gelesen und dem Mitarbeiter in einem Auswahlpopup mit Ankreuzfeld angeboten.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:35"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:40"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:58"
        }
      ]
    },
    {
      "id": "BM-292-B08",
      "text": "Bricht er das Popup ab oder schlägt es fehl, bleibt die Auswahl leer; sonst werden die angekreuzten Positionen übernommen.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:73"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:77"
        }
      ]
    },
    {
      "id": "BM-292-B09",
      "text": "Ohne gewählte Position wird dies gemeldet und keine Retoure angelegt.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:41"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:42"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:43"
        }
      ]
    },
    {
      "id": "BM-292-B10",
      "text": "Sonst wird per Batch-Input im Hintergrund ein Retourenauftrag der Auftragsart ZRE mit Bezug auf die Faktura, die gewählten Positionen und den Rückgabegrund über die Auftragserfassung angelegt, synchron verbucht.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:46"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 107,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:107"
        }
      ]
    },
    {
      "id": "BM-292-B11",
      "text": "Findet sich in den Meldungen der Auftragserfassung die Erfolgsmeldung V1 311, wird die Retourennummer entnommen, mit Faktura, Grund, Erfasser und Datum im Retourenprotokoll festgeschrieben und als Erfolgsmeldung angezeigt.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:112"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:114"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:121"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:122"
        },
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 123,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:123"
        }
      ]
    },
    {
      "id": "BM-292-B12",
      "text": "Sonst wird die erste Fehlermeldung der Auftragserfassung als Information in Fehleroptik angezeigt.",
      "anchors": [
        {
          "file": "zsd_retoure_schalter_f01.abap",
          "line": 126,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_retoure_schalter_f01.abap:126"
        }
      ]
    }
  ],
