  "businessStatements": [
    {
      "id": "BM-279-B01",
      "text": "Das Staplerleitsystem meldet quittierte Lageraufgaben asynchron per Inbound-Proxy; jede gemeldete Quittierung wird einzeln ausgeführt, und Fehler werden nicht an den Sender zurückgemeldet, sondern in eine Fehlerqueue gestellt.",
      "anchors": [
        {
          "file": "zcl_ewm_ii_wt_confirm.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_ii_wt_confirm.abap:28"
        },
        {
          "file": "zcl_ewm_ii_wt_confirm.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_ii_wt_confirm.abap:37"
        }
      ]
    },
    {
      "id": "BM-279-B02",
      "text": "Ist die Lageraufgabe nicht mehr offen, aber bereits quittiert, geschieht nichts, sodass Wiederholungen unschädlich sind; ist sie unbekannt, ist das ein fachlicher Fehler.",
      "anchors": [
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:47"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:51"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:53"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:57"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:58"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:60"
        }
      ]
    },
    {
      "id": "BM-279-B03",
      "text": "Eine Quittierung über der Sollmenge ist ein fachlicher Fehler; eine Mindermenge wird mit dem Ausnahmecode DIFF als Differenz quittiert.",
      "anchors": [
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:65"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:66"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:77"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:80"
        }
      ]
    },
    {
      "id": "BM-279-B04",
      "text": "Die Lageraufgabe wird mit Istmenge, Einheit und Nachplatz quittiert und bei Erfolg synchron festgeschrieben.",
      "anchors": [
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:86"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:103"
        }
      ]
    },
    {
      "id": "BM-279-B05",
      "text": "Scheitert die Quittierung, wird zurückgerollt; ist eine der Fehlermeldungen als vorübergehend (Sperre) gepflegt, gilt der Fehler als vorübergehend, sonst als fachlich.",
      "anchors": [
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:97"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:98"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:110"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:115"
        },
        {
          "file": "zcl_ewm_wt_processor.abap",
          "line": 120,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_processor.abap:120"
        }
      ]
    },
    {
      "id": "BM-279-B06",
      "text": "Ein vorübergehender Fehler stellt die Quittierung mit Status E und Wiederholung in fünf Minuten in die Queue, ein fachlicher mit Status F zur manuellen Klärung; die Quittierung wird dazu als XML gesichert.",
      "anchors": [
        {
          "file": "zcl_ewm_ii_wt_confirm.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_ii_wt_confirm.abap:39"
        },
        {
          "file": "zcl_ewm_ii_wt_confirm.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_ii_wt_confirm.abap:43"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:46"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:50"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:56"
        }
      ]
    },
    {
      "id": "BM-279-B07",
      "text": "Der Wiederholungsjob löscht zuerst erledigte Einträge, die älter als die Aufbewahrungsfrist sind; endgültig fehlerhafte bleiben stehen.",
      "anchors": [
        {
          "file": "zewm_wt_retry.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:24"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:110"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:115"
        },
        {
          "file": "zewm_wt_retry.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:25"
        }
      ]
    },
    {
      "id": "BM-279-B08",
      "text": "Dann holt er die Einträge mit Status E, deren Wiederholungszeitpunkt erreicht ist; gibt es keine, endet er mit Hinweis.",
      "anchors": [
        {
          "file": "zewm_wt_retry.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:27"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:64"
        },
        {
          "file": "zewm_wt_retry.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:28"
        },
        {
          "file": "zewm_wt_retry.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:29"
        }
      ]
    },
    {
      "id": "BM-279-B09",
      "text": "Je Lauf werden höchstens p_max Einträge bearbeitet; jeder wird gesperrt, und ist er anderweitig in Bearbeitung, wird er übersprungen.",
      "anchors": [
        {
          "file": "zewm_wt_retry.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:33"
        },
        {
          "file": "zewm_wt_retry.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:34"
        },
        {
          "file": "zewm_wt_retry.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:41"
        }
      ]
    },
    {
      "id": "BM-279-B10",
      "text": "Die gesicherte Quittierung wird erneut ausgeführt; gelingt sie, wird der Eintrag als erledigt gekennzeichnet.",
      "anchors": [
        {
          "file": "zewm_wt_retry.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:47"
        },
        {
          "file": "zewm_wt_retry.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:50"
        },
        {
          "file": "zewm_wt_retry.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:51"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:72"
        }
      ]
    },
    {
      "id": "BM-279-B11",
      "text": "Bei erneutem vorübergehendem Fehler wird der nächste Versuch mit verdoppelter Wartezeit eingeplant; ab dem sechsten Versuch wird der Eintrag endgültig fehlerhaft.",
      "anchors": [
        {
          "file": "zewm_wt_retry.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:54"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:83"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:84"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 90,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:90"
        }
      ]
    },
    {
      "id": "BM-279-B12",
      "text": "Bei fachlichem Fehler wird der Eintrag mit Fehlertext endgültig fehlerhaft gekennzeichnet.",
      "anchors": [
        {
          "file": "zewm_wt_retry.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:58"
        },
        {
          "file": "zcl_ewm_wt_queue.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_ewm_wt_queue.abap:98"
        }
      ]
    },
    {
      "id": "BM-279-B13",
      "text": "Jede Queue-Änderung wird sofort festgeschrieben und die Sperre gelöst; am Ende werden die Zahlen quittierter, erneut eingeplanter, endgültig fehlerhafter und gesperrter Einträge ausgegeben.",
      "anchors": [
        {
          "file": "zewm_wt_retry.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:62"
        },
        {
          "file": "zewm_wt_retry.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:64"
        },
        {
          "file": "zewm_wt_retry.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zewm_wt_retry.abap:69"
        }
      ]
    }
  ],
