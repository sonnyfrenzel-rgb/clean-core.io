        },
        {
          "file": "source.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:97"
        }
      ]
    },
    {
      "id": "BM-087-B09",
      "text": "Zum Schluss wird die Anzahl gesendeter Kreditoren ausgegeben.",
      "anchors": [
