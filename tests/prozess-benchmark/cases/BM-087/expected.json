  "businessStatements": [
    {
      "id": "BM-087-B01",
      "text": "Es werden die noch nicht verarbeiteten Änderungszeiger des Nachrichtentyps gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        }
      ]
    },
    {
      "id": "BM-087-B02",
      "text": "Gibt es keine, wird das gemeldet und der Lauf beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        },
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        },
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        }
      ]
    },
    {
      "id": "BM-087-B03",
      "text": "Mehrere Änderungszeiger desselben Kreditors werden zu einem Versand verdichtet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        },
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        }
      ]
    },
    {
      "id": "BM-087-B04",
      "text": "Je Kreditor wird der Stammsatz gelesen; fehlende oder zum Löschen vorgemerkte Kreditoren werden nicht gesendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:46"
        },
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        }
      ]
    },
    {
      "id": "BM-087-B05",
      "text": "Im Testmodus wird der Kreditor nur aufgelistet und nichts gesendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        },
        {
          "file": "source.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:63"
        }
      ]
    },
    {
      "id": "BM-087-B06",
      "text": "Im Echtlauf werden Name, Anschrift und USt-Id des Kreditors als IDoc ZVENDOR01 an das Alt-System adressiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        }
      ]
    },
    {
      "id": "BM-087-B07",
      "text": "Schlägt das Erzeugen fehl, wird ein Sendefehler mit Kreditornummer ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:84"
        },
        {
          "file": "source.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:87"
        }
      ]
    },
    {
      "id": "BM-087-B08",
      "text": "Im Echtlauf werden danach alle gelesenen Änderungszeiger als verarbeitet markiert und festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:91"
        },
