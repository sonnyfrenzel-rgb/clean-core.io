  "businessStatements": [
    {
      "id": "BM-068-B01",
      "text": "Aus Material und Charge wird der Objektschlüssel der Chargenklassifizierung gebildet und das Klassifizierungsobjekt der Klassenart 023 gesucht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        },
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        }
      ]
    },
    {
      "id": "BM-068-B02",
      "text": "Ist die Charge nicht klassifiziert, endet der Baustein mit der Ausnahme KEINE_KLASSIFIZIERUNG.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        },
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        }
      ]
    },
    {
      "id": "BM-068-B03",
      "text": "Die Merkmale Reinheit (Z_REINHEIT) und Verfallsdatum werden auf ihre internen Merkmalsnummern aufgelöst und die Merkmalwerte der Charge gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        },
        {
          "file": "source.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:46"
        },
        {
          "file": "source.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:49"
        }
      ]
    },
    {
      "id": "BM-068-B04",
      "text": "Fehlt ein Reinheitswert, wird der Status P (manuell prüfen) zurückgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        },
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        },
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        }
      ]
    },
    {
      "id": "BM-068-B05",
      "text": "Der Reinheitswert wird zurückgegeben; ein vorhandenes Verfallsdatum wird aus dem Merkmalwert übernommen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        },
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        },
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        }
      ]
    },
    {
      "id": "BM-068-B06",
      "text": "Eine verfallene Charge erhält den Status S (sperren), unabhängig von der Reinheit.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        },
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        }
      ]
    },
    {
      "id": "BM-068-B07",
      "text": "Sonst wird die Charge mit Status F freigegeben, wenn die Reinheit mindestens den übergebenen Grenzwert (Vorschlag 99,5) erreicht, andernfalls mit Status S gesperrt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:69"
        },
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        },
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        }
      ]
    }
  ],
