  "businessStatements": [
    {
      "id": "BM-127-B01",
      "text": "Es werden die Umsatzmeldungen aller Monate des Geschäftsjahres für die Mietverträge des Buchungskreises gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:15"
        }
      ]
    },
    {
      "id": "BM-127-B02",
      "text": "Liegen keine Meldungen vor, wird ein Hinweis ausgegeben und der Lauf beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        },
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        },
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:24"
        }
      ]
    },
    {
      "id": "BM-127-B03",
      "text": "Je Mietvertrag und Währung wird der gemeldete Jahresumsatz summiert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        },
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    },
    {
      "id": "BM-127-B04",
      "text": "Die monatliche Mindestmiete wird aus der Vertragskondition Z100 gelesen; Verträge ohne diese Kondition werden nicht abgerechnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        },
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        }
      ]
    },
    {
      "id": "BM-127-B05",
      "text": "Der höchste Staffelsatz, dessen Umsatzschwelle erreicht ist, wird ermittelt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        }
      ]
    },
    {
      "id": "BM-127-B06",
      "text": "Die Jahresmiete ist der größere Betrag aus Umsatz mal Staffelsatz und zwölf Mindestmieten; die Nachforderung ist ihr Überschuss über die Mindestmieten.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:52"
        },
        {
          "file": "source.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:60"
        }
      ]
    },
    {
      "id": "BM-127-B07",
      "text": "Die Mietbelastungsquote ist die Jahresmiete in Prozent des Umsatzes; bei einem Umsatz von null und einer Miete über null wird sie auf 999 gesetzt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        },
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        }
      ]
    },
    {
      "id": "BM-127-B08",
      "text": "Auf Wunsch wird das Abrechnungsergebnis je Vertrag gespeichert und festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        },
        {
          "file": "source.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:71"
        },
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        }
      ]
    },
    {
      "id": "BM-127-B09",
      "text": "Die Abrechnungsliste wird am Bildschirm angezeigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        }
      ]
    }
  ],
