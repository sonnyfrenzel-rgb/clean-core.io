  "businessStatements": [
    {
      "id": "BM-043-B01",
      "text": "Jede Kontierungszeile gilt zunächst als gültig; ohne Kostenstelle bleibt es dabei.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:10"
        },
        {
          "file": "source.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:11"
        }
      ]
    },
    {
      "id": "BM-043-B02",
      "text": "Zur kontierten Kostenstelle wird der Stammsatz gelesen, der am Buchungsdatum im Kostenrechnungskreis gültig ist.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:13"
        }
      ]
    },
    {
      "id": "BM-043-B03",
      "text": "Gibt es zum Buchungsdatum keine gültige Kostenstelle, schlägt die Validierung fehl.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        },
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-043-B04",
      "text": "Ist die Kostenstelle für Ist-Primärkosten gesperrt, schlägt die Validierung ebenfalls fehl.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        },
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        }
      ]
    }
  ],
