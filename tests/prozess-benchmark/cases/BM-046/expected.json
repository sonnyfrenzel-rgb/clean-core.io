  "businessStatements": [
    {
      "id": "BM-046-B01",
      "text": "Es werden die offenen Debitorenposten der gewählten Buchungskreise und Kunden gelesen, die noch keine Mahnsperre tragen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:37"
        }
      ]
    },
    {
      "id": "BM-046-B02",
      "text": "Gibt es keine solchen Posten, erhält der Anwender einen Hinweis und der Lauf endet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        },
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        },
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        }
      ]
    },
    {
      "id": "BM-046-B03",
      "text": "Zu diesen Belegen werden die offenen Klärungsfälle (Status O) aus der kundeneigenen Klärungsfalltabelle gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        }
      ]
    },
    {
      "id": "BM-046-B04",
      "text": "Posten ohne offenen Klärungsfall werden übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        },
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        }
      ]
    },
    {
      "id": "BM-046-B05",
      "text": "Im Testlauf werden die betroffenen Posten nur als „würde gesperrt“ gelistet; es wird nichts geändert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        },
        {
          "file": "source.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:69"
        }
      ]
    },
    {
      "id": "BM-046-B06",
      "text": "Im Echtlauf wird am Posten die gewählte Mahnsperre (Vorschlag R) über die Standard-Massenänderung für Belegpositionen gesetzt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:81"
        }
      ]
    },
    {
      "id": "BM-046-B07",
      "text": "Gelingt die Sperre, wird der Klärungsfall auf Status S gesetzt und der Erfolg gemeldet; sonst wird ein Fehler gemeldet und der Fehlerzähler erhöht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:92"
        },
        {
          "file": "source.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:94"
        },
        {
          "file": "source.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:98"
        },
        {
          "file": "source.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:101"
        }
      ]
    },
    {
      "id": "BM-046-B08",
      "text": "Nach allen Posten wird im Echtlauf COMMIT WORK ausgelöst, und die Zähler für gesperrte und fehlerhafte Posten werden ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 105,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:105"
        },
        {
          "file": "source.abap",
          "line": 106,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:106"
        },
        {
          "file": "source.abap",
          "line": 109,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:109"
        }
      ]
    }
  ],
