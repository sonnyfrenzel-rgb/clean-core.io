  "businessStatements": [
    {
      "id": "BM-129-B01",
      "text": "Es werden die offenen Zahlungszusagen des Buchungskreises mit der zugehörigen Fallnummer gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-129-B02",
      "text": "Zusagen, deren Datum zuzüglich der Karenztage noch nicht überschritten ist, werden übergangen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-129-B03",
      "text": "Für jede überfällige Zusage wird geprüft, ob der zugesagte Posten beim Kunden noch offen ist; ist er ausgeglichen, gilt die Zusage als eingehalten.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:31"
        },
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        }
      ]
    },
    {
      "id": "BM-129-B04",
      "text": "Jede gebrochene Zusage wird mit Fallnummer, Kunde, Beleg, Zusagedatum und zugesagtem Betrag gelistet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:43"
        }
      ]
    },
    {
      "id": "BM-129-B05",
      "text": "Am Ende der Liste wird die Anzahl der gebrochenen Zusagen ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        }
      ]
    },
    {
      "id": "BM-129-B06",
      "text": "Wählt der Spezialist eine Zeile mit Beleg, wird der Buchhaltungsbeleg direkt in der Belegansicht geöffnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:53"
        },
