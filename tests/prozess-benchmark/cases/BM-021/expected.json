  "businessStatements": [
    {
      "id": "BM-021-B01",
      "text": "Es werden die Materialbelegpositionen des eingegebenen Werks mit der gewählten Bewegungsart (Vorschlag 101, Wareneingang zur Bestellung) im Buchungszeitraum selektiert.",
