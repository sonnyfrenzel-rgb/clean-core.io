          "expressionPath": null,
          "raw": "source.abap:23"
        }
      ]
    },
    {
      "id": "BM-222-B04",
      "text": "Sonst wird die Zahl der Kalendertage vom Stichtag bis zum Befristungsende zurückgegeben.",
