        }
      ]
    },
    {
      "id": "BM-222-B02",
      "text": "Zum Stichtag werden die Vertragsbestandteile (Infotyp 0016) des Mitarbeiters gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        }
      ]
    },
    {
      "id": "BM-222-B03",
      "text": "Gibt es keinen gültigen Satz oder kein Befristungsende, endet der Baustein mit der Ausnahme KEIN_VERTRAG.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        },
        {
