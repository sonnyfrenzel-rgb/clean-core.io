  "businessStatements": [
    {
      "id": "BM-148-B01",
      "text": "Ab der eingegebenen Wurzeleinheit wird die Linienhierarchie Einheit für Einheit abgelaufen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        }
      ]
    },
    {
      "id": "BM-148-B02",
      "text": "Liegt eine Einheit tiefer als die zulässige Ebenenzahl, wird sie samt Teilbaum nicht ausgewertet und die Abschneidung vermerkt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        }
      ]
    },
    {
      "id": "BM-148-B03",
      "text": "Für jede Einheit werden am Stichtag über Planstellen die direkt zugeordneten Personen ermittelt und gezählt; Personen in untergeordneten Einheiten zählen dort.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:53"
        },
        {
          "file": "source.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:66"
        },
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        }
      ]
    },
    {
      "id": "BM-148-B04",
      "text": "Die Einheit wird mit ihrer Hierarchieebene und der Personenzahl vorgemerkt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        }
      ]
    },
    {
      "id": "BM-148-B05",
      "text": "Die am Stichtag direkt untergeordneten Organisationseinheiten werden gelesen und jeweils auf der nächsten Ebene genauso ausgewertet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:75"
        },
        {
          "file": "source.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:84"
        },
        {
          "file": "source.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:87"
        }
      ]
    },
    {
      "id": "BM-148-B06",
      "text": "Wurden Teilbäume wegen der Tiefe abgeschnitten, erhält der Anwender einen Hinweis.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        }
      ]
    },
    {
      "id": "BM-148-B07",
      "text": "Alle ausgewerteten Einheiten werden mit Ebene und Personenzahl als Liste angezeigt; scheitert die Listanzeige, bricht der Report mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:31"
        },
        {
          "file": "source.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:33"
        },
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        }
      ]
    }
  ],
