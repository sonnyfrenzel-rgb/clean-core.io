  "businessStatements": [
    {
      "id": "BM-209-B01",
      "text": "Zu Beginn wird ein Anwendungsprotokoll ZSD/DELIVERY eröffnet.",
      "anchors": [
        {
          "file": "zcl_sd_app_log.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_app_log.abap:33"
        }
      ]
    },
    {
      "id": "BM-209-B02",
      "text": "Selektiert werden Aufträge der gewählten Verkaufsorganisationen ohne Liefersperre, deren Positionen noch nicht voll beliefert sind und eine bis zum Lieferdatum fällige, bestätigte Einteilung haben.",
      "anchors": [
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:30"
        }
      ]
    },
    {
      "id": "BM-209-B03",
      "text": "Gibt es keine lieferfälligen Aufträge, meldet der Lauf das und endet ohne Protokoll zu sichern.",
      "anchors": [
        {
          "file": "zsd_delivery_run.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_delivery_run.abap:36"
        },
        {
          "file": "zsd_delivery_run.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_delivery_run.abap:37"
        },
        {
          "file": "zsd_delivery_run.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_delivery_run.abap:38"
        }
      ]
    },
    {
      "id": "BM-209-B04",
      "text": "Ein Auftrag mit Kreditsperre wird nicht beliefert, sondern als Fehler protokolliert.",
      "anchors": [
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:52"
        },
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:54"
        },
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:55"
        },
        {
          "file": "zsd_delivery_run.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_delivery_run.abap:49"
        }
      ]
    },
    {
      "id": "BM-209-B05",
      "text": "Für alle nicht abgesagten Positionen eines Auftrags wird eine Auslieferung mit Fälligkeit heute angelegt; die Meldungen der Anlage werden protokolliert.",
      "anchors": [
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:62"
        },
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:68"
        },
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:77"
        },
        {
          "file": "zcl_sd_app_log.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_app_log.abap:53"
        }
      ]
    },
    {
      "id": "BM-209-B06",
      "text": "Entsteht keine Lieferung, wird die Anlage verworfen und der Auftrag als Fehler protokolliert.",
      "anchors": [
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:79"
        },
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:80"
        },
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:81"
        }
      ]
    },
    {
      "id": "BM-209-B07",
      "text": "Im Testmodus wird die angelegte Lieferung wieder verworfen.",
      "anchors": [
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:88"
        },
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:89"
        }
      ]
    },
    {
      "id": "BM-209-B08",
      "text": "Außerhalb des Testmodus wird die Lieferung festgeschrieben.",
      "anchors": [
        {
          "file": "zcl_sd_delivery_builder.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_delivery_builder.abap:93"
        }
      ]
    },
    {
      "id": "BM-209-B09",
      "text": "Nach allen Aufträgen wird das Protokoll gesichert und festgeschrieben.",
      "anchors": [
        {
          "file": "zsd_delivery_run.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_delivery_run.abap:53"
        },
        {
          "file": "zcl_sd_app_log.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_app_log.abap:79"
        },
        {
          "file": "zcl_sd_app_log.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_app_log.abap:85"
        }
      ]
    },
    {
      "id": "BM-209-B10",
      "text": "Im Dialog wird das Protokoll anschließend angezeigt, im Hintergrund nicht.",
      "anchors": [
        {
          "file": "zsd_delivery_run.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zsd_delivery_run.abap:54"
        },
        {
          "file": "zcl_sd_app_log.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_app_log.abap:93"
        }
      ]
    }
  ],
