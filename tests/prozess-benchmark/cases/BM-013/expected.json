  "businessStatements": [
    {
      "id": "BM-013-B01",
      "text": "Die Kreditprüfung läuft nur für Kundenaufträge beim Anlegen oder Ändern, beim Ändern nur, wenn sich der Nettowert geändert hat.",
      "anchors": [
        {
          "file": "mv45afzz_credit.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:11"
        },
        {
          "file": "mv45afzz_credit.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:12"
        },
        {
          "file": "mv45afzz_credit.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:14"
        }
      ]
    },
    {
      "id": "BM-013-B02",
      "text": "Für Auftraggeber und Kreditkontrollbereich des Auftrags werden Kreditlimit, Risikoklasse und Kreditsperre gelesen.",
      "anchors": [
        {
          "file": "mv45afzz_credit.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:16"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:44"
        }
      ]
    },
    {
      "id": "BM-013-B03",
      "text": "Hat der Kunde keinen Kreditstammsatz, gilt der Auftrag ohne Prüfung als in Ordnung.",
      "anchors": [
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:59"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:60"
        }
      ]
    },
    {
      "id": "BM-013-B04",
      "text": "Ist der Kunde im Kreditmanagement gesperrt, lautet das Ergebnis Ablehnen.",
      "anchors": [
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:64"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:65"
        }
      ]
    },
    {
      "id": "BM-013-B05",
      "text": "Das Obligo setzt sich aus dem Kreditwert offener Aufträge, offener Lieferungen und offener Fakturen aus den Infostrukturen sowie dem Saldo der offenen Posten aller Buchungskreise des Kreditkontrollbereichs zusammen.",
      "anchors": [
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 104,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:104"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 109,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:109"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:114"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 124,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:124"
        }
      ]
    },
    {
      "id": "BM-013-B06",
      "text": "Habenposten mindern, Sollposten erhöhen den Saldo der offenen Posten.",
      "anchors": [
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:117"
        }
      ]
    },
    {
      "id": "BM-013-B07",
      "text": "Zum Obligo wird die Differenz aus neuem und altem Nettowert des Auftrags addiert.",
      "anchors": [
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:70"
        }
      ]
    },
    {
      "id": "BM-013-B08",
      "text": "Die Toleranz über dem Limit beträgt 10 % für Risikoklasse 001, 5 % für 002 und sonst null.",
      "anchors": [
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:73"
        }
      ]
    },
    {
      "id": "BM-013-B09",
      "text": "Übersteigt das Obligo das Limit samt Toleranz, lautet das Ergebnis Sperren, sonst in Ordnung.",
      "anchors": [
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:82"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:83"
        }
      ]
    },
    {
      "id": "BM-013-B10",
      "text": "Nur wenn ein Kreditstammsatz existiert und der Kunde nicht im Kreditmanagement gesperrt ist, wird das Prüfergebnis (Sperren oder in Ordnung) mit Obligo, Limit und Benutzer zur Protokollierung mit dem Auftrag verbucht; Aufträge ohne Kreditstammsatz und Ablehnungen werden nicht protokolliert.",
      "anchors": [
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:60"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:66"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:86"
        }
      ]
    },
    {
      "id": "BM-013-B11",
      "text": "Bei Ergebnis Sperren erhält der Auftrag die Liefersperre Z1, der Erfasser eine Warnung mit Obligo und Limit, und der Kreditmanager wird per Workflow-Ereignis benachrichtigt.",
      "anchors": [
        {
          "file": "mv45afzz_credit.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:24"
        },
        {
          "file": "mv45afzz_credit.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:26"
        },
        {
          "file": "mv45afzz_credit.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:27"
        },
        {
          "file": "mv45afzz_credit.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:28"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 132,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:132"
        }
      ]
    },
    {
      "id": "BM-013-B12",
      "text": "Scheitert das Auslösen des Ereignisses, erhält der Erfasser nur einen Hinweis.",
      "anchors": [
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 140,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:140"
        },
        {
          "file": "zcl_sd_credit_check.abap",
          "line": 141,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_credit_check.abap:141"
        }
      ]
    },
    {
      "id": "BM-013-B13",
      "text": "Bei Ergebnis Ablehnen wird das Sichern mit einer Fehlermeldung abgebrochen.",
      "anchors": [
        {
          "file": "mv45afzz_credit.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:30"
        }
      ]
    },
    {
      "id": "BM-013-B14",
      "text": "Bei Ergebnis in Ordnung wird eine früher gesetzte Kreditliefersperre Z1 wieder aufgehoben.",
      "anchors": [
        {
          "file": "mv45afzz_credit.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:33"
        },
        {
          "file": "mv45afzz_credit.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "mv45afzz_credit.abap:34"
        }
      ]
    }
  ],
