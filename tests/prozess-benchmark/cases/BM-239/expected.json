  "businessStatements": [
    {
      "id": "BM-239-B01",
      "text": "Es werden die aktiven Partnergesellschaften des Buchungskreises mit RFC-Destination gelesen; gibt es keine, bricht der Lauf mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung.abap:31"
        },
        {
          "file": "zfi_ic_abstimmung_f01.abap",
          "line": 10,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f01.abap:10"
        },
        {
          "file": "zfi_ic_abstimmung.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung.abap:32"
        },
        {
          "file": "zfi_ic_abstimmung.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung.abap:33"
        }
      ]
    },
    {
      "id": "BM-239-B02",
      "text": "Je Partner werden der eigene Forderungs- und Verbindlichkeitssaldo aus offenen Posten mit dessen Partner-Gesellschaftsnummer bis zum Stichtag ermittelt.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung.abap:36"
        },
        {
          "file": "zfi_ic_abstimmung_f01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f01.abap:27"
        },
        {
          "file": "zfi_ic_abstimmung_f01.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f01.abap:31"
        },
        {
          "file": "zfi_ic_abstimmung_f01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f01.abap:38"
        }
      ]
    },
    {
      "id": "BM-239-B03",
      "text": "Je Partner wird die Saldenabfrage im Partnersystem asynchron gestartet.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung.abap:37"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:22"
        }
      ]
    },
    {
      "id": "BM-239-B04",
      "text": "Sind keine freien Prozesse verfügbar, wird der Partner synchron abgefragt; das Ergebnis oder der Fehler wird sofort vermerkt.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:35"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:40"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:54"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:55"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:57"
        }
      ]
    },
    {
      "id": "BM-239-B05",
      "text": "Scheitert der Start aus anderem Grund, wird der Fehler beim Partner vermerkt.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:60"
        }
      ]
    },
    {
      "id": "BM-239-B06",
      "text": "Im Partnersystem werden die offenen Forderungen und Verbindlichkeiten gegenüber der anfragenden Gesellschaft bis zum Stichtag gezählt und saldiert; ohne offene Posten meldet die Abfrage KEINE_DATEN.",
      "anchors": [
        {
          "file": "lzfi_ic_rfcu01.abap",
          "line": 1,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ic_rfcu01.abap:1"
        },
        {
          "file": "lzfi_ic_rfcu01.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ic_rfcu01.abap:20"
        },
        {
          "file": "lzfi_ic_rfcu01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ic_rfcu01.abap:27"
        },
        {
          "file": "lzfi_ic_rfcu01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ic_rfcu01.abap:34"
        },
        {
          "file": "lzfi_ic_rfcu01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "lzfi_ic_rfcu01.abap:35"
        }
      ]
    },
    {
      "id": "BM-239-B07",
      "text": "Bei Rückmeldung eines Partners wird sein Ergebnis übernommen; KEINE_DATEN gilt als Saldo null, ein Kommunikations- oder Systemfehler wird vermerkt; jede Rückmeldung wird gezählt.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:76"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:82"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:93"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:94"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:97"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:99"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:102"
        }
      ]
    },
    {
      "id": "BM-239-B08",
      "text": "Ergebnisse und Fehler werden nur bei Partnern eingetragen, die in der Saldenliste stehen.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 113,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:113"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:115"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:127"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 129,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:129"
        }
      ]
    },
    {
      "id": "BM-239-B09",
      "text": "Jede Abfrage läuft unter dem Partner-Buchungskreis als Taskname, über den die Rückmeldung dem Partner zugeordnet wird.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:20"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:92"
        }
      ]
    },
    {
      "id": "BM-239-B10",
      "text": "Nach dem Start aller Abfragen wird höchstens fünf Minuten auf alle Rückmeldungen gewartet; fehlen danach welche, erscheint ein Hinweis.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:65"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:66"
        },
        {
          "file": "zfi_ic_abstimmung_f02.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f02.abap:67"
        }
      ]
    },
    {
      "id": "BM-239-B11",
      "text": "Partner mit Abfragefehler werden nicht verglichen.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung.abap:38"
        },
        {
          "file": "zfi_ic_abstimmung_f03.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f03.abap:21"
        }
      ]
    },
    {
      "id": "BM-239-B12",
      "text": "Verglichen werden unsere Forderung mit der Verbindlichkeit des Partners und unsere Verbindlichkeit mit der Forderung des Partners.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung_f03.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f03.abap:25"
        }
      ]
    },
    {
      "id": "BM-239-B13",
      "text": "Liegen beide Differenzen innerhalb der Toleranz, gilt der Partner als abgestimmt; sonst als Differenz.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung_f03.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f03.abap:28"
        }
      ]
    },
    {
      "id": "BM-239-B14",
      "text": "Im Echtlauf wird für jede Differenz ein offener Klärungssatz mit beiden Differenzbeträgen geschrieben und am Ende festgeschrieben.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung_f03.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f03.abap:34"
        },
        {
          "file": "zfi_ic_abstimmung_f03.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung_f03.abap:44"
        },
        {
          "file": "zfi_ic_abstimmung.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung.abap:40"
        },
        {
          "file": "zfi_ic_abstimmung.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung.abap:41"
        }
      ]
    },
    {
      "id": "BM-239-B15",
      "text": "Das Abstimmungsergebnis je Partner wird als ALV-Liste angezeigt; ein Anzeigefehler wird gemeldet.",
      "anchors": [
        {
          "file": "zfi_ic_abstimmung.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zfi_ic_abstimmung.abap:44"
