          "raw": "zcl_zret_promo_dpc_ext.abap:15"
        }
      ]
    },
    {
      "id": "BM-186-B02",
      "text": "Mit dem Filter Aktiv werden nur Aktionen berücksichtigt, die heute laufen.",
      "anchors": [
        {
          "file": "zcl_zret_promo_dpc_ext.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zret_promo_dpc_ext.abap:19"
        }
      ]
    },
    {
      "id": "BM-186-B03",
      "text": "Jeder andere Filter wird mit dem Fehler „Filter nicht unterstützt“ abgewiesen.",
      "anchors": [
        {
          "file": "zcl_zret_promo_dpc_ext.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zret_promo_dpc_ext.abap:21"
        }
      ]
    },
    {
      "id": "BM-186-B04",
      "text": "Ohne Filialfilter wird die Anfrage mit „Filter WERKS ist Pflicht“ abgewiesen.",
