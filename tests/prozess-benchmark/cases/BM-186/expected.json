  "businessStatements": [
    {
      "id": "BM-186-B01",
      "text": "Die App fragt Werbeaktionen mit Filtern ab; ausgewertet werden die Filter Filiale und Aktiv.",
      "anchors": [
        {
          "file": "zcl_zret_promo_dpc_ext.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_zret_promo_dpc_ext.abap:12"
        },
        {
          "file": "zcl_zret_promo_dpc_ext.abap",
          "line": 15,
          "token": null,
