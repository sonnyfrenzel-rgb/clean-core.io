          "raw": "zcl_zret_promo_dpc_ext.abap:63"
        }
      ]
    },
    {
      "id": "BM-186-B09",
      "text": "Auf Anforderung wird die Anzahl der zurückgegebenen Aktionen als Trefferzahl gemeldet.",
