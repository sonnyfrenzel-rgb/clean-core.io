  "businessStatements": [
    {
      "id": "BM-049-B01",
      "text": "Beim Buchen werden nur Kreditorenrechnungen der Belegarten KR und RE geprüft.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        }
      ]
    },
    {
      "id": "BM-049-B02",
      "text": "Belege ohne Kreditorenzeile im Buchungskreis werden nicht weiter geprüft.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    },
    {
      "id": "BM-049-B03",
      "text": "Zum Lieferanten werden Land und Umsatzsteuer-Identifikationsnummer gelesen, dazu, ob sein Land EU-Mitglied ist, und das Land des Buchungskreises.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        },
        {
          "file": "source.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:38"
        },
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        }
      ]
    },
    {
      "id": "BM-049-B04",
      "text": "Nur wenn der Lieferant aus einem anderen EU-Land als der Buchungskreis stammt, greift die innergemeinschaftliche Prüfung.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:44"
        }
      ]
    },
    {
      "id": "BM-049-B05",
      "text": "Fehlt dem EU-Lieferanten die USt-IdNr., wird die Buchung mit einer Fehlermeldung abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        },
        {
          "file": "source.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:46"
        }
      ]
    },
    {
      "id": "BM-049-B06",
      "text": "Jedes Steuerkennzeichen auf Sachkontenzeilen muss in der kundeneigenen Liste der EU-Steuerkennzeichen des Buchungskreises stehen, sonst wird die Buchung mit Angabe von Kennzeichen und Zeile abgebrochen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:49"
        },
        {
          "file": "source.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:53"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        },
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        }
      ]
    }
  ],
