  "businessStatements": [
    {
      "id": "BM-155-B01",
      "text": "Zur gewählten Veranstaltung wird geprüft, ob sie künftig stattfindet und nicht nur geplant ist; sonst bricht der Lauf mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zpe_book_participants.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_book_participants.abap:41"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:47"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:50"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:52"
        },
        {
          "file": "zpe_book_participants.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_book_participants.abap:44"
        }
      ]
    },
    {
      "id": "BM-155-B02",
      "text": "Für die Veranstaltung werden die Maximalkapazität und die Zahl fester Buchungen ermittelt; ohne Kapazitätsangabe gilt keine Grenze.",
      "anchors": [
        {
          "file": "zcl_pe_booking.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:56"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:59"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:101"
        }
      ]
    },
    {
      "id": "BM-155-B03",
      "text": "Über den Veranstaltungstyp wird die als Voraussetzung hinterlegte Qualifikation bestimmt.",
      "anchors": [
        {
          "file": "zcl_pe_booking.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:65"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:68"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:69"
        }
      ]
    },
    {
      "id": "BM-155-B04",
      "text": "Teilnehmer sind alle Mitarbeiter, die heute einer der gewählten Organisationseinheiten zugeordnet sind.",
      "anchors": [
        {
          "file": "zpe_book_participants.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_book_participants.abap:50"
        }
      ]
    },
    {
      "id": "BM-155-B05",
      "text": "Wer bereits gebucht ist oder auf der Warteliste steht, wird abgelehnt.",
      "anchors": [
        {
          "file": "zcl_pe_booking.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:77"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:82"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:83"
        }
      ]
    },
    {
      "id": "BM-155-B06",
      "text": "Verlangt der Veranstaltungstyp eine Qualifikation und besitzt der Mitarbeiter sie nicht gültig, wird er abgelehnt.",
      "anchors": [
        {
          "file": "zcl_pe_booking.abap",
          "line": 88,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:88"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:89"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:95"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:96"
        }
      ]
    },
    {
      "id": "BM-155-B07",
      "text": "Ist die Kapazität ausgeschöpft, wird der Mitarbeiter mit Wartelistenpriorität eingetragen und als Warteliste protokolliert.",
      "anchors": [
        {
          "file": "zcl_pe_booking.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:102"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 103,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:103"
        },
        {
          "file": "zpe_book_participants.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_book_participants.abap:31"
        }
      ]
    },
    {
      "id": "BM-155-B08",
      "text": "Sonst wird die feste Teilnahme ab heute unbefristet angelegt, die Buchungszahl erhöht und die Buchung protokolliert.",
      "anchors": [
        {
          "file": "zcl_pe_booking.abap",
          "line": 107,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:107"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 108,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:108"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 109,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:109"
        },
        {
          "file": "zpe_book_participants.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_book_participants.abap:27"
        }
      ]
    },
    {
      "id": "BM-155-B09",
      "text": "Die Teilnahmebeziehung wird im Testlauf nur im Puffer, im Echtlauf über die Verbuchung angelegt; scheitert die Anlage, wird der Mitarbeiter abgelehnt.",
      "anchors": [
        {
          "file": "zcl_pe_booking.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:114"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 134,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:134"
        },
        {
          "file": "zcl_pe_booking.abap",
          "line": 135,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pe_booking.abap:135"
        }
      ]
    },
    {
      "id": "BM-155-B10",
      "text": "Jede Ablehnung wird mit Personalnummer und Grund ausgegeben.",
      "anchors": [
        {
          "file": "zpe_book_participants.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_book_participants.abap:60"
        },
        {
          "file": "zpe_book_participants.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_book_participants.abap:61"
        }
      ]
    },
    {
      "id": "BM-155-B11",
      "text": "Im Echtlauf werden alle Buchungen am Ende festgeschrieben, im Testlauf verworfen; danach werden die Zahlen gebuchter und wartender Teilnehmer ausgegeben.",
      "anchors": [
        {
          "file": "zpe_book_participants.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_book_participants.abap:65"
        },
        {
          "file": "zpe_book_participants.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_book_participants.abap:66"
        },
        {
          "file": "zpe_book_participants.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zpe_book_participants.abap:68"
        },
