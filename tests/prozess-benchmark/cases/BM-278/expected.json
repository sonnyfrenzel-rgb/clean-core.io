  "businessStatements": [
    {
      "id": "BM-278-B01",
      "text": "Der Baustein liest die noch nicht verarbeiteten Änderungszeiger des Nachrichtentyps; ist das nicht möglich, bricht er ab, gibt es keine, endet er mit Hinweis.",
      "anchors": [
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:29"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:39"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:40"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:42"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:43"
        }
      ]
    },
    {
      "id": "BM-278-B02",
      "text": "Aus den Zeigern werden die geänderten Personalnummern bestimmt; für den Lauf wird ein Anwendungsprotokoll angelegt.",
      "anchors": [
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:54"
        }
      ]
    },
    {
      "id": "BM-278-B03",
      "text": "Welche Infotypen ins IDoc gehen, bestimmt ein Customizing mit Mapper-Klassen in fester Reihenfolge; ein falsch gepflegter Mapper wird gemeldet und fehlt dann in allen IDocs des Laufs.",
      "anchors": [
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:62"
        },
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:30"
        },
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:38"
        },
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:42"
        }
      ]
    },
    {
      "id": "BM-278-B04",
      "text": "Für ausgetretene Mitarbeiter wird nur ein Kopfsegment mit Löschkennzeichen gesendet, damit der Zutritt entzogen wird.",
      "anchors": [
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:55"
        },
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:59"
        },
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:60"
        },
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:62"
        }
      ]
    },
    {
      "id": "BM-278-B05",
      "text": "Für alle anderen wird ein Kopfsegment mit Änderungskennzeichen und je Mapper die Segmente seines Infotyps aufgebaut.",
      "anchors": [
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:65"
        },
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:68"
        },
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:69"
        }
      ]
    },
    {
      "id": "BM-278-B06",
      "text": "Die organisatorische Zuordnung (Buchungskreis, Werk, Teilbereich, Kostenstelle, Organisationseinheit) ist Pflicht; fehlt sie zum Stichtag, wird die Personalnummer übersprungen.",
      "anchors": [
        {
          "file": "zcl_hr_it_mapper_0001.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0001.abap:18"
        },
        {
          "file": "zcl_hr_it_mapper_0001.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0001.abap:28"
        },
        {
          "file": "zcl_hr_it_mapper_0001.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0001.abap:29"
        }
      ]
    },
    {
      "id": "BM-278-B07",
      "text": "Name und Vorname sind Pflicht; das volle Geburtsdatum wird nur mit gültiger Einwilligung für den Zweck Kantine übermittelt, sonst nur das Geburtsjahr.",
      "anchors": [
        {
          "file": "zcl_hr_it_mapper_0002.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0002.abap:20"
        },
        {
          "file": "zcl_hr_it_mapper_0002.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0002.abap:30"
        },
        {
          "file": "zcl_hr_it_mapper_0002.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0002.abap:40"
        },
        {
          "file": "zcl_hr_it_mapper_0002.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0002.abap:44"
        },
        {
          "file": "zcl_hr_it_mapper_0002.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0002.abap:45"
        },
        {
          "file": "zcl_hr_it_mapper_0002.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0002.abap:48"
        }
      ]
    },
    {
      "id": "BM-278-B08",
      "text": "Eine vorhandene Ausweisnummer (Kommunikationsart 9001) wird mit Gültigkeitsende übermittelt; ohne Ausweis entfällt das Segment ohne Fehler.",
      "anchors": [
        {
          "file": "zcl_hr_it_mapper_0105.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0105.abap:20"
        },
        {
          "file": "zcl_hr_it_mapper_0105.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0105.abap:31"
        },
        {
          "file": "zcl_hr_it_mapper_0105.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_0105.abap:33"
        }
      ]
    },
    {
      "id": "BM-278-B09",
      "text": "Liegt zum Stichtag eine Elternzeit oder Krankheit ohne Lohnfortzahlung von mehr als 42 Tagen vor, wird eine Zutrittssperre für diesen Zeitraum übermittelt.",
      "anchors": [
        {
          "file": "zcl_hr_it_mapper_2001.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_2001.abap:22"
        },
        {
          "file": "zcl_hr_it_mapper_2001.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_2001.abap:38"
        },
        {
          "file": "zcl_hr_it_mapper_2001.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_2001.abap:40"
        },
        {
          "file": "zcl_hr_it_mapper_2001.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_it_mapper_2001.abap:41"
        }
      ]
    },
    {
      "id": "BM-278-B10",
      "text": "Bleibt außer dem Kopf kein Segment, wird die Personalnummer als „nichts zu senden“ übersprungen.",
      "anchors": [
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:73"
        },
        {
          "file": "zcl_hr_idoc_builder.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_hr_idoc_builder.abap:75"
        }
      ]
    },
    {
      "id": "BM-278-B11",
      "text": "Übersprungene Personalnummern werden mit Grund als Warnung protokolliert; ihre Änderungszeiger bleiben offen und werden im nächsten Lauf erneut versucht.",
      "anchors": [
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:69"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:73"
        }
      ]
    },
    {
      "id": "BM-278-B12",
      "text": "Für jede aufgebaute Personalnummer wird ein IDoc erzeugt; scheitert das, wird ein Fehler protokolliert und die Zeiger bleiben offen.",
      "anchors": [
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:85"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:93"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:95"
        }
      ]
    },
    {
      "id": "BM-278-B13",
      "text": "Nach erfolgreicher Erzeugung werden alle Änderungszeiger dieser Personalnummer als erledigt vorgemerkt.",
      "anchors": [
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 107,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:107"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 108,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:108"
        }
      ]
    },
    {
      "id": "BM-278-B14",
      "text": "Am Ende werden die vorgemerkten Zeiger als verarbeitet gekennzeichnet, alles festgeschrieben, das Protokoll gesichert und die Zahl gesendeter und übersprungener Personalnummern gemeldet.",
      "anchors": [
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 114,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:114"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 119,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:119"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:122"
        },
        {
          "file": "z_hr_masteridoc_create_zhrmd.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "z_hr_masteridoc_create_zhrmd.abap:127"
        }
      ]
    }
  ],
