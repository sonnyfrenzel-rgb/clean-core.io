  "businessStatements": [
    {
      "id": "BM-128-B01",
      "text": "Es werden die freigegebenen Beschaffungsanträge des Finanzkreises und Geschäftsjahres gelesen, eingeschränkt auf eine Finanzstelle, wenn sie angegeben ist.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-128-B02",
      "text": "Gibt es keine freigegebenen Anträge, bricht der Lauf mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        },
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:31"
        }
      ]
    },
    {
      "id": "BM-128-B03",
      "text": "Zu den Anträgen werden alle Positionen gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        }
      ]
    },
    {
      "id": "BM-128-B04",
      "text": "Für jede Position eines Antrags werden die verfügbaren Mittel der Finanzstelle und Finanzposition nachgelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:42"
        }
      ]
    },
    {
      "id": "BM-128-B05",
      "text": "Reichen die Mittel für eine Position nicht, wird die Prüfung des Antrags abgebrochen und der Antrag als zurückgestellt gemeldet; er bleibt freigegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:47"
        },
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        },
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        }
      ]
    },
    {
      "id": "BM-128-B06",
      "text": "Für gedeckte Anträge wird eine Mittelvorbindung der Belegart ZV mit allen Positionen angelegt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        }
      ]
    },
    {
      "id": "BM-128-B07",
      "text": "Schlägt die Anlage fehl, wird zurückgerollt und der Fehler mit Meldungsnummer gemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        },
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        },
        {
          "file": "source.abap",
          "line": 74,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:74"
        }
      ]
    },
    {
      "id": "BM-128-B08",
      "text": "Nach erfolgreicher Anlage wird der Antrag mit der Belegnummer als angelegt gekennzeichnet und alles festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        },
        {
          "file": "source.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:79"
        }
      ]
    },
    {
      "id": "BM-128-B09",
      "text": "Die Nummer der angelegten Mittelvorbindung wird je Antrag gemeldet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 82,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:82"
        }
      ]
    }
  ],
