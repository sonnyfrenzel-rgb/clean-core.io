  "businessStatements": [
    {
      "id": "BM-072-B01",
      "text": "Beim Ausführen wird geprüft, ob der Benutzer für Werk und Auftragsart berechtigt ist; ohne Berechtigung bleibt er mit einer Fehlermeldung im Selektionsbild.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen.abap:14"
        },
        {
          "file": "zpp_plaf_umsetzen.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen.abap:17"
        },
        {
          "file": "zpp_plaf_umsetzen.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen.abap:18"
        }
      ]
    },
    {
      "id": "BM-072-B02",
      "text": "Es werden Planaufträge des Werks zu den gewählten Disponenten und Materialien selektiert, deren Eckstarttermin bis zum Horizont reicht und die Lageraufträge (LA) für Eigenfertigung (E) sind.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 9,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:9"
        }
      ]
    },
    {
      "id": "BM-072-B03",
      "text": "Ist der Schalter „nur fixierte“ gesetzt (Vorschlag), werden nicht fixierte Planaufträge verworfen; die übrigen werden nach Eckstarttermin sortiert.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:19"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:20"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:22"
        }
      ]
    },
    {
      "id": "BM-072-B04",
      "text": "Bleibt kein Planauftrag übrig, wird ein Hinweis ausgegeben und der Lauf beendet.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen.abap:23"
        },
        {
          "file": "zpp_plaf_umsetzen.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen.abap:24"
        },
        {
          "file": "zpp_plaf_umsetzen.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen.abap:25"
        }
      ]
    },
    {
      "id": "BM-072-B05",
      "text": "Ist das Material im Werk für die Fertigung gesperrt (Status Z1), wird der Planauftrag rot protokolliert und nicht umgesetzt.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:33"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:37"
        },
        {
          "file": "zpp_plaf_umsetzen.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen.abap:30"
        }
      ]
    },
    {
      "id": "BM-072-B06",
      "text": "Für jeden nicht gelöschten Sekundärbedarf des Planauftrags wird der frei verwendbare Bestand der Komponente über alle Lagerorte des Werks summiert.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:63"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:68"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:70"
        }
      ]
    },
    {
      "id": "BM-072-B07",
      "text": "Reicht der Bestand einer Komponente nicht für den Bedarf, wird der Planauftrag gelb mit „Fehlteil“ und der Komponente protokolliert, die Prüfung abgebrochen und nicht umgesetzt.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:73"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:77"
        },
        {
          "file": "zpp_plaf_umsetzen.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen.abap:35"
        }
      ]
    },
    {
      "id": "BM-072-B08",
      "text": "Sonst wird aus dem Planauftrag ein Fertigungsauftrag der gewählten Auftragsart erzeugt.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen.abap:39"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:92"
        }
      ]
    },
    {
      "id": "BM-072-B09",
      "text": "Scheitert die Umsetzung, wird zurückgerollt und der Planauftrag rot mit dem Fehlertext protokolliert.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:100"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 101,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:101"
        }
      ]
    },
    {
      "id": "BM-072-B10",
      "text": "Gelingt sie, wird festgeschrieben und der Planauftrag mit der neuen Auftragsnummer grün als „umgesetzt“ protokolliert.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 107,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:107"
        }
      ]
    },
    {
      "id": "BM-072-B11",
      "text": "Ist Sofortfreigabe gewählt, wird der neue Fertigungsauftrag freigegeben; scheitert die Freigabe, wird sie zurückgerollt und „umgesetzt, Freigabe fehlgeschlagen“ gelb protokolliert, sonst festgeschrieben.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 113,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:113"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 115,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:115"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:121"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 122,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:122"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 126,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:126"
        }
      ]
    },
    {
      "id": "BM-072-B12",
      "text": "Am Ende wird das Protokoll mit Ampel, Planauftrag, Material, Auftrag und Ergebnistext als ALV-Liste ausgegeben.",
      "anchors": [
        {
          "file": "zpp_plaf_umsetzen.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen.abap:43"
        },
        {
          "file": "zpp_plaf_umsetzen_f01.abap",
          "line": 147,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_plaf_umsetzen_f01.abap:147"
        }
      ]
    }
  ],
