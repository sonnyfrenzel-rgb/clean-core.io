          "expressionPath": null,
          "raw": "source.abap:19"
        }
      ]
    },
    {
      "id": "BM-162-B02",
      "text": "Der Ausdehnungskoeffizient des Materials wird aus der Kundentabelle gelesen; fehlt er, endet die Umrechnung mit der Ausnahme „kein Koeffizient“.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:22"
        },
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
