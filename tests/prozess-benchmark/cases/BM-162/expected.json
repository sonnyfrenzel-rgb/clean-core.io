      "id": "BM-162-B01",
      "text": "Liegt die gemessene Temperatur unter -30 °C oder über 60 °C, bricht die Umrechnung mit der Ausnahme „Temperatur unplausibel“ ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
