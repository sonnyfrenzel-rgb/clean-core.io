  "businessStatements": [
    {
      "id": "BM-070-B01",
      "text": "Die Stückliste des Materials wird zum Stichtag im Werk mehrstufig mit der Anwendung PP01 für die Menge 1 aufgelöst.",
      "anchors": [
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:39"
        }
      ]
    },
    {
      "id": "BM-070-B02",
      "text": "Lässt sie sich nicht auflösen (Material oder Stückliste fehlt), wird die Prüfung mit einer Ausnahme abgebrochen.",
      "anchors": [
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:53"
        },
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:54"
        }
      ]
    },
    {
      "id": "BM-070-B03",
      "text": "Geprüft werden nur Lagerpositionen, jeweils mit ihrer Stücklistenstufe.",
      "anchors": [
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:58"
        }
      ]
    },
    {
      "id": "BM-070-B04",
      "text": "Ist eine Komponente im Werk nicht angelegt, wird „Komponente im Werk nicht angelegt“ vermerkt und die Komponente nicht weiter geprüft.",
      "anchors": [
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:63"
        },
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:66"
        },
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:67"
        }
      ]
    },
    {
      "id": "BM-070-B05",
      "text": "Eine zum Löschen vorgemerkte Komponente wird vermerkt; andernfalls wird eine Komponente mit Dispomerkmal ND als nicht disponiert vermerkt.",
      "anchors": [
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:72"
        },
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:75"
        }
      ]
    },
    {
      "id": "BM-070-B06",
      "text": "Hat die Komponente den werksübergreifenden Materialstatus 01 oder Z9, wird sie zusätzlich als werksübergreifend gesperrt vermerkt.",
      "anchors": [
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 80,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:80"
        },
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 92,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:92"
        },
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:95"
        },
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:81"
        }
      ]
    },
    {
      "id": "BM-070-B07",
      "text": "Die Methode gibt die Liste aller Befunde zurück.",
      "anchors": [
        {
          "file": "zcl_pp_bom_check.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_bom_check.abap:86"
