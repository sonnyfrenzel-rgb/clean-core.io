  "businessStatements": [
    {
      "id": "BM-210-B01",
      "text": "Der aufrufende Portalbenutzer muss Retourenaufträge (Auftragsart RE) anlegen dürfen; sonst wird ein Fehler zurückgegeben und nichts angelegt.",
      "anchors": [
        {
          "file": "lzsd_rmau01.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:23"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:26"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:27"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:29"
        }
      ]
    },
    {
      "id": "BM-210-B02",
      "text": "Die Referenzrechnung wird gelesen; existiert sie nicht, wird ein Fehler zurückgegeben.",
      "anchors": [
        {
          "file": "lzsd_rmau01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:32"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:34"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:35"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:37"
        }
      ]
    },
    {
      "id": "BM-210-B03",
      "text": "Welche Prüfungen in welcher Reihenfolge laufen, bestimmt eine Konfigurationstabelle je Verkaufsorganisation; unbekannte Einträge werden übergangen.",
      "anchors": [
        {
          "file": "lzsd_rmac01.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:91"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:95"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 97,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:97"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:99"
        }
      ]
    },
    {
      "id": "BM-210-B04",
      "text": "Jede Retourenposition durchläuft alle aktiven Prüfungen der Kette.",
      "anchors": [
        {
          "file": "lzsd_rmau01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:42"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:44"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:111"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:112"
        }
      ]
    },
    {
      "id": "BM-210-B05",
      "text": "Die Rückgabefrist ist je Verkaufsorganisation gepflegt, ersatzweise 30 Tage; wird sie seit dem Fakturadatum überschritten, wird die Position abgelehnt.",
      "anchors": [
        {
          "file": "lzsd_rmac01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:32"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:34"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:35"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:37"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:38"
        }
      ]
    },
    {
      "id": "BM-210-B06",
      "text": "Die Rückgabemenge darf die fakturierte Menge des Materials abzüglich bereits angelegter, nicht abgesagter Retouren zur Rechnung nicht übersteigen.",
      "anchors": [
        {
          "file": "lzsd_rmac01.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:53"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:57"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:64"
        },
        {
          "file": "lzsd_rmac01.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmac01.abap:65"
        }
      ]
    },
    {
      "id": "BM-210-B07",
      "text": "Jede Ablehnung wird mit ihrem Grund als Fehlermeldung gesammelt; die übrigen Positionen werden trotzdem geprüft.",
      "anchors": [
        {
          "file": "lzsd_rmau01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:47"
        }
      ]
    },
    {
      "id": "BM-210-B08",
      "text": "Ist mindestens eine Position abgelehnt, wird kein Retourenauftrag angelegt.",
      "anchors": [
        {
          "file": "lzsd_rmau01.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:52"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:54"
        }
      ]
    },
    {
      "id": "BM-210-B09",
      "text": "Im Simulationsmodus wird nur die Zulässigkeit gemeldet.",
      "anchors": [
        {
          "file": "lzsd_rmau01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:57"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:58"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:60"
        }
      ]
    },
    {
      "id": "BM-210-B10",
      "text": "Für die Anlage wird je Position die passende Rechnungsposition als Referenz gesucht und gesetzt.",
      "anchors": [
        {
          "file": "lzsd_rmaf01.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmaf01.abap:17"
        },
        {
          "file": "lzsd_rmaf01.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmaf01.abap:25"
        },
        {
          "file": "lzsd_rmaf01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmaf01.abap:28"
        },
        {
          "file": "lzsd_rmaf01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmaf01.abap:29"
        }
      ]
    },
    {
      "id": "BM-210-B11",
      "text": "Der Retourenauftrag wird mit Rechnungsbezug und dem Auftraggeber der Rechnung angelegt; die Meldungen des BAPI gehen an den Aufrufer zurück.",
      "anchors": [
        {
          "file": "lzsd_rmau01.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:73"
        }
      ]
    },
    {
      "id": "BM-210-B12",
      "text": "Entsteht kein Auftrag, wird zurückgerollt, sonst festgeschrieben.",
      "anchors": [
        {
          "file": "lzsd_rmau01.abap",
          "line": 84,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:84"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:85"
        },
        {
          "file": "lzsd_rmau01.abap",
          "line": 87,
          "token": null,
          "expressionPath": null,
          "raw": "lzsd_rmau01.abap:87"
        }
      ]
    }
  ],
