  "businessStatements": [
    {
      "id": "BM-284-B01",
      "text": "Es werden die am Stichtag angelegten Kundenaufträge der Verkaufsorganisation und des Verkaufsbüros (Schalter) selektiert, deren Gesamtstatus nicht erledigt ist.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:49"
        }
      ]
    },
    {
      "id": "BM-284-B02",
      "text": "Gibt es keinen offenen Auftrag, wird dies als Statusmeldung in Fehleroptik angezeigt und die Verarbeitung beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:57"
        },
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-284-B03",
      "text": "Sonst wird das Schalterbild 0100 aufgerufen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        }
      ]
    },
    {
      "id": "BM-284-B04",
      "text": "Beim ersten Aufbau des Bildes wird das ALV-Grid im Container angelegt, der Doppelklick-Behandler registriert und die Auftragsliste angezeigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:71"
        },
        {
          "file": "source.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:78"
        },
        {
          "file": "source.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:79"
        }
      ]
    },
    {
      "id": "BM-284-B05",
      "text": "Mit Zurück, Beenden oder Abbrechen verlässt der Mitarbeiter das Schalterbild.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 91,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:91"
        },
        {
          "file": "source.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:93"
        }
      ]
    },
    {
      "id": "BM-284-B06",
      "text": "Ein Doppelklick auf eine Zeile übergibt die Auftragsnummer als Parameter AUN und öffnet die Auftragsanzeige VA03 unter Überspringen des Einstiegsbildes.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        },
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
