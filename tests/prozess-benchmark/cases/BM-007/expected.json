  "businessStatements": [
    {
      "id": "BM-007-B01",
      "text": "Zum Auftrag werden alle nicht abgesagten Positionen mit Material, Werk, Auftragsmenge und Lieferstatus gelesen.",
      "anchors": [
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:34"
        }
      ]
    },
    {
      "id": "BM-007-B02",
      "text": "Hat der Auftrag keine solchen Positionen, bricht die Prüfung mit dem Fehler „keine Positionen“ ab.",
      "anchors": [
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:40"
        },
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:41"
        }
      ]
    },
    {
      "id": "BM-007-B03",
      "text": "Voll belieferte Positionen werden nicht geprüft.",
      "anchors": [
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:45"
        }
      ]
    },
    {
      "id": "BM-007-B04",
      "text": "Für jede übrige Position wird die Verfügbarkeit des Materials im Werk mit der Prüfregel A ermittelt.",
      "anchors": [
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:49"
        }
      ]
    },
    {
      "id": "BM-007-B05",
      "text": "Meldet die Verfügbarkeitsprüfung einen Fehler, bricht die gesamte Prüfung mit Angabe des Materials ab.",
      "anchors": [
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:60"
        },
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:61"
        }
      ]
    },
    {
      "id": "BM-007-B06",
      "text": "Als verfügbar zählen nur Mengen, die bis heute bestätigt sind.",
      "anchors": [
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:66"
        },
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:67"
        }
      ]
    },
    {
      "id": "BM-007-B07",
      "text": "Liegt die verfügbare Menge unter der Auftragsmenge, wird die Position mit Bedarf, verfügbarer Menge und Fehlmenge zurückgegeben.",
      "anchors": [
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:69"
        },
        {
          "file": "zcl_sd_atp_check.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_sd_atp_check.abap:70"
        }
      ]
    }
  ],
