  "businessStatements": [
    {
      "id": "BM-132-B01",
      "text": "Die Abrechnungseinheit wird mit Umlageschlüssel, Buchungskreis, Erlöskonto und Währung gelesen; ist sie unbekannt, bricht der Lauf mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zre_nk_abr.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr.abap:17"
        },
        {
          "file": "zre_nk_abr.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr.abap:19"
        },
        {
          "file": "zre_nk_abr.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr.abap:20"
        }
      ]
    },
    {
      "id": "BM-132-B02",
      "text": "Die umlagefähigen Kosten der Einheit im Abrechnungsjahr werden summiert.",
      "anchors": [
        {
          "file": "zre_nk_abr.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr.abap:24"
        }
      ]
    },
    {
      "id": "BM-132-B03",
      "text": "Es werden die Mieter der Einheit gelesen, deren Nutzungszeitraum das Abrechnungsjahr berührt; Nutzungen ohne Ende-Datum fallen dabei aus der Selektion.",
      "anchors": [
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:12"
        }
      ]
    },
    {
      "id": "BM-132-B04",
      "text": "Der Nutzungszeitraum jedes Mieters wird auf das Abrechnungsjahr begrenzt.",
      "anchors": [
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:24"
        }
      ]
    },
    {
      "id": "BM-132-B05",
      "text": "Je Mieter wird die monatliche Nebenkostenvorauszahlung aus der Vertragskondition Z200 gelesen und mit der Zahl der Nutzungsmonate (Tage durch 30) multipliziert.",
      "anchors": [
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:28"
        },
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:32"
        }
      ]
    },
    {
      "id": "BM-132-B06",
      "text": "Die Verteilungsbasis je Mieter ist die Personenzahl oder die Fläche, je nach Umlageschlüssel der Einheit, mal die Nutzungstage.",
      "anchors": [
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:56"
        }
      ]
    },
    {
      "id": "BM-132-B07",
      "text": "Aus Gesamtkosten und Summe aller Basen wird ein Kostensatz je Basiseinheit berechnet.",
      "anchors": [
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:63"
        }
      ]
    },
    {
      "id": "BM-132-B08",
      "text": "Jeder Mieter trägt Kostensatz mal Basis; sein Saldo ist dieser Anteil abzüglich der Vorauszahlungen.",
      "anchors": [
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:65"
        }
      ]
    },
    {
      "id": "BM-132-B09",
      "text": "Ist bei vorhandenen Kosten keine Verteilungsbasis vorhanden, werden die Gesamtkosten zurückgesetzt und der Lauf bricht mit einer Fehlermeldung ab.",
      "anchors": [
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:69"
        },
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:43"
        }
      ]
    },
    {
      "id": "BM-132-B10",
      "text": "Im Echtlauf wird für jeden Mieter mit Saldo ein FI-Beleg der Belegart NK gebucht: Nachzahlung oder Guthaben auf dem Debitor gegen das Erlöskonto der Einheit.",
      "anchors": [
        {
          "file": "zre_nk_abr.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr.abap:30"
        },
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:86"
        },
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:100"
        }
      ]
    },
    {
      "id": "BM-132-B11",
      "text": "Meldet die Buchung einen Fehler, wird zurückgerollt und die Fehlermeldung beim Mieter vermerkt.",
      "anchors": [
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 111,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:111"
        },
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 112,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:112"
        }
      ]
    },
    {
      "id": "BM-132-B12",
      "text": "Eine erfolgreiche Buchung wird festgeschrieben und mit Belegnummer im Ergebnisprotokoll vermerkt; am Ende wird das Protokoll festgeschrieben.",
      "anchors": [
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 117,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:117"
        },
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:121"
        },
        {
          "file": "zre_nk_abr_f01.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr_f01.abap:127"
        }
      ]
    },
    {
      "id": "BM-132-B13",
      "text": "Für alle Mieter werden Kostenanteil, Vorauszahlung, Saldo, Belegnummer und Meldung gelistet, im Testlauf ohne Belegnummer.",
      "anchors": [
        {
          "file": "zre_nk_abr.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zre_nk_abr.abap:35"
        }
      ]
    }
  ],
