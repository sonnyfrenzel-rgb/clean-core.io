  "businessStatements": [
    {
      "id": "BM-172-B01",
      "text": "Je IDoc werden Kopfsegment (Filiale, Tag) und Verkaufspositionen je EAN gelesen; der Umsatz einer Position ist Umsatz abzüglich Rabatt.",
      "anchors": [
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:26"
        },
        {
          "file": "lzposf01.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "lzposf01.abap:13"
        },
        {
          "file": "lzposf01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "lzposf01.abap:21"
        }
      ]
    },
    {
      "id": "BM-172-B02",
      "text": "Positionen mit Menge null (Storno-Nullzeilen der Kasse) werden übergangen.",
      "anchors": [
        {
          "file": "lzposf01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "lzposf01.abap:18"
        }
      ]
    },
    {
      "id": "BM-172-B03",
      "text": "Fehlt die Filiale im Kopf, erhält das IDoc Status 51 und wird nicht weiter verarbeitet.",
      "anchors": [
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:27"
        },
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:28"
        }
      ]
    },
    {
      "id": "BM-172-B04",
      "text": "Filiale und Tag werden gesperrt; ist die Sperre nicht zu bekommen, erhält das IDoc Status 51.",
      "anchors": [
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:33"
        },
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:41"
        },
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:42"
        }
      ]
    },
    {
      "id": "BM-172-B05",
      "text": "Zu jeder EAN wird der Artikel ermittelt; unbekannte EANs werden mit Filiale, Tag und Menge für das Clearing gesammelt und aus der Umsatzrechnung genommen.",
      "anchors": [
        {
          "file": "lzposf01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "lzposf01.abap:37"
        },
        {
          "file": "lzposf01.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "lzposf01.abap:44"
        },
        {
          "file": "lzposf01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "lzposf01.abap:46"
        },
        {
          "file": "lzposf01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "lzposf01.abap:56"
        }
      ]
    },
    {
      "id": "BM-172-B06",
      "text": "Menge und Umsatz werden je Artikel aufsummiert.",
      "anchors": [
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:47"
        },
        {
          "file": "lzposf01.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "lzposf01.abap:73"
        },
        {
          "file": "lzposf01.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "lzposf01.abap:75"
        }
      ]
    },
    {
      "id": "BM-172-B07",
      "text": "Die unbekannten EANs werden sofort in die Clearingtabelle geschrieben, bereits vorhandene Einträge bleiben unverändert.",
      "anchors": [
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:49"
        },
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:50"
        }
      ]
    },
    {
      "id": "BM-172-B08",
      "text": "Bleibt kein Artikelumsatz übrig, erhält das IDoc Status 51.",
      "anchors": [
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:53"
        },
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:54"
        }
      ]
    },
    {
      "id": "BM-172-B09",
      "text": "Sonst werden die Artikelumsätze der Filiale zur Fortschreibung in der Verbuchung vorgemerkt, und das IDoc erhält Status 53 – mit Warnung, wenn es unbekannte EANs gab.",
      "anchors": [
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:56"
        },
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:61"
        },
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:62"
        },
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:65"
        }
      ]
    },
    {
      "id": "BM-172-B10",
      "text": "Die Sperre für Filiale und Tag wird am Ende jedes IDocs wieder freigegeben.",
      "anchors": [
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:69"
        }
      ]
    },
    {
      "id": "BM-172-B11",
      "text": "Der aufrufenden IDoc-Verarbeitung wird gemeldet, dass die Fortschreibung in der Verbuchung läuft.",
      "anchors": [
        {
          "file": "z_idoc_input_zposums.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zposums.abap:75"
        }
      ]
    }
  ],
