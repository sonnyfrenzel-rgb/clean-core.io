  "businessStatements": [
    {
      "id": "BM-264-B01",
      "text": "Für die Zeitdatei wird geprüft, ob ein Wiederaufsetzpunkt aus einem abgebrochenen Lauf existiert; dann wird ab der Zeile danach fortgesetzt und darauf hingewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:23"
        },
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        },
        {
          "file": "source.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:27"
        },
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        }
      ]
    },
    {
      "id": "BM-264-B02",
      "text": "Lässt sich die Datei auf dem Applikationsserver nicht öffnen, bricht der Report mit Fehlermeldung ab.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        },
        {
          "file": "source.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:35"
        },
        {
          "file": "source.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:36"
        }
      ]
    },
    {
      "id": "BM-264-B03",
      "text": "Die Datei wird Zeile für Zeile bis zum Dateiende gelesen; Zeilen bis zum Wiederaufsetzpunkt werden übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        },
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        },
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        },
        {
          "file": "source.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:45"
        }
      ]
    },
    {
      "id": "BM-264-B04",
      "text": "Für jede Zeile wird geprüft, ob die Personalnummer zum Buchungsdatum eine gültige Organisationszuordnung hat; sonst wird die Zeile als Fehler ausgegeben und übergangen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        },
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        },
        {
          "file": "source.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:56"
        }
      ]
    },
    {
      "id": "BM-264-B05",
      "text": "Gültige Zeitsätze werden mit Personalnummer, Datum, Stunden und Status N (neu) in die Staging-Tabelle geschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:65"
        }
      ]
    },
    {
      "id": "BM-264-B06",
      "text": "Nach jedem vollen Paket wird die erreichte Zeilennummer als Wiederaufsetzpunkt gespeichert und zusammen mit den Zeitsätzen festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        },
        {
          "file": "source.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:70"
        },
        {
          "file": "source.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:71"
        }
      ]
    },
    {
      "id": "BM-264-B07",
      "text": "Ist die Datei vollständig gelesen, wird der Wiederaufsetzpunkt gelöscht, festgeschrieben und die Zahl übernommener und fehlerhafter Sätze ausgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:77"
        },
