  "businessStatements": [
    {
      "id": "BM-252-B01",
      "text": "Ohne Bestellnummer erhält der Lagerarbeiter den Feldfehler „Bitte Bestellnummer eingeben“ und es wird nichts geladen.",
      "anchors": [
        {
          "file": "zwd_mm_we_view.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_view.abap:12"
        },
        {
          "file": "zwd_mm_we_view.abap",
          "line": 13,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_view.abap:13"
        },
        {
          "file": "zwd_mm_we_view.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_view.abap:17"
        }
      ]
    },
    {
      "id": "BM-252-B02",
      "text": "Eine unbekannte, gelöschte oder noch nicht freigegebene Bestellung wird mit einer entsprechenden Fehlermeldung abgewiesen.",
      "anchors": [
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:17"
        },
        {
          "file": "zcl_mm_we_assist.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_we_assist.abap:21"
        },
        {
          "file": "zcl_mm_we_assist.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_we_assist.abap:25"
        },
        {
          "file": "zcl_mm_we_assist.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_we_assist.abap:30"
        },
        {
          "file": "zcl_mm_we_assist.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_we_assist.abap:36"
        },
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:19"
        }
      ]
    },
    {
      "id": "BM-252-B03",
      "text": "Für eine gültige Bestellung werden Kopf und Positionen gelesen.",
      "anchors": [
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:23"
        }
      ]
    },
    {
      "id": "BM-252-B04",
      "text": "Angeboten werden nur nicht gelöschte Positionen mit Wareneingangskennzeichen.",
      "anchors": [
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:32"
        },
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:34"
        }
      ]
    },
    {
      "id": "BM-252-B05",
      "text": "Die offene Menge einer Position ist die Bestellmenge abzüglich der bisherigen Wareneingänge (101) nach Abzug der Stornos (102).",
      "anchors": [
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:38"
        },
        {
          "file": "zcl_mm_we_assist.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_we_assist.abap:52"
        },
        {
          "file": "zcl_mm_we_assist.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_we_assist.abap:58"
        },
        {
          "file": "zcl_mm_we_assist.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_mm_we_assist.abap:64"
        }
      ]
    },
    {
      "id": "BM-252-B06",
      "text": "Positionen mit offener Menge werden mit dieser Menge als Erfassungsvorschlag angezeigt, zusammen mit dem Lieferanten.",
      "anchors": [
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:40"
        },
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:56"
        }
      ]
    },
    {
      "id": "BM-252-B07",
      "text": "Ist keine Position mehr offen, erscheint die Information ZMM_WE 010.",
      "anchors": [
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 52,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:52"
        },
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:53"
        }
      ]
    },
    {
      "id": "BM-252-B08",
      "text": "Beim Buchen werden nur Positionen mit erfasster Menge berücksichtigt; ist keine übrig, gibt es eine Warnung und keine Buchung.",
      "anchors": [
        {
          "file": "zwd_mm_we_view.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_view.abap:35"
        },
        {
          "file": "zwd_mm_we_view.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_view.abap:36"
        },
        {
          "file": "zwd_mm_we_view.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_view.abap:37"
        },
        {
          "file": "zwd_mm_we_view.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_view.abap:38"
        }
      ]
    },
    {
      "id": "BM-252-B09",
      "text": "Der Wareneingang wird als Bewegungsart 101 zur Bestellung mit Tagesdatum als Buchungs- und Belegdatum gebucht.",
      "anchors": [
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 89,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:89"
        }
      ]
    },
    {
      "id": "BM-252-B10",
      "text": "Entsteht kein Materialbeleg, wird verworfen und jede Fehlermeldung des BAPIs angezeigt.",
      "anchors": [
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 99,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:99"
        },
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:100"
        },
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 102,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:102"
        }
      ]
    },
    {
      "id": "BM-252-B11",
      "text": "Sonst wird synchron festgeschrieben, der Lagerarbeiter erhält die Materialbelegnummer als Erfolgsmeldung und gelangt auf die Bestätigungsseite.",
      "anchors": [
        {
          "file": "zwd_mm_we_compctrl.abap",
          "line": 109,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_compctrl.abap:109"
        },
        {
          "file": "zwd_mm_we_view.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_view.abap:44"
        },
        {
          "file": "zwd_mm_we_view.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zwd_mm_we_view.abap:45"
        }
      ]
    }
  ],
