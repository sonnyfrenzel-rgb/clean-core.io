  "businessStatements": [
    {
      "id": "BM-069-B01",
      "text": "Es werden Prüflose des gewählten Werks mit der gewählten Herkunft (Vorschlag 04, Wareneingang aus Produktion) und Entstehungsdatum gelesen, für die noch kein Verwendungsentscheid getroffen ist.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        }
      ]
    },
    {
      "id": "BM-069-B02",
      "text": "Ohne offene Prüflose wird „Keine offenen Prueflose“ gemeldet und der Lauf beendet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:39"
        },
        {
          "file": "source.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:40"
        },
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        }
      ]
    },
    {
      "id": "BM-069-B03",
      "text": "Hat ein Prüflos inzwischen einen Verwendungsentscheid auf Losebene, wird es ohne Protokolleintrag übersprungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 51,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:51"
        },
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        },
        {
          "file": "source.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:55"
        }
      ]
    },
    {
      "id": "BM-069-B04",
      "text": "Ist mindestens ein Merkmal zurückgewiesen, bleibt das Los für einen manuellen Verwendungsentscheid liegen und wird so protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 58,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:58"
        },
        {
          "file": "source.abap",
          "line": 61,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:61"
        },
        {
          "file": "source.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:62"
        }
      ]
    },
    {
      "id": "BM-069-B05",
      "text": "Sind weniger Merkmale bewertet als geplant, wird kein Entscheid gesetzt und „Offene Merkmale - kein VE“ protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:67"
        },
        {
          "file": "source.abap",
          "line": 69,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:69"
        },
        {
          "file": "source.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:72"
        },
        {
          "file": "source.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:73"
        }
      ]
    },
    {
      "id": "BM-069-B06",
      "text": "Für vollständig bewertete Lose ohne Zurückweisung wird der Verwendungsentscheid mit dem Code aus dem Parameter (Vorschlag A1) aus der Auswahlmenge ZFREI gesetzt und der Abschluss erzwungen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:79"
        },
        {
          "file": "source.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:86"
        }
      ]
    },
    {
      "id": "BM-069-B07",
      "text": "Scheitert der Entscheid, wird zurückgerollt und der Fehlertext protokolliert; sonst wird festgeschrieben und „VE gesetzt“ protokolliert.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:94"
        },
        {
          "file": "source.abap",
          "line": 95,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:95"
        },
        {
          "file": "source.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:98"
        }
      ]
    },
    {
      "id": "BM-069-B08",
      "text": "Das Protokoll aller nicht übersprungenen Lose wird als ALV-Liste angezeigt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 106,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:106"
        },
