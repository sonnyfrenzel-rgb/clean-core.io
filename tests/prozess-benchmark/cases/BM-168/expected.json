  "businessStatements": [
    {
      "id": "BM-168-B01",
      "text": "Zur Auftragsposition wird die Konfigurationsinstanz gelesen; ist die Position nicht konfiguriert, endet die Ermittlung mit einer Ausnahme.",
      "anchors": [
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:29"
        },
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:32"
        },
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 33,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:33"
        }
      ]
    },
    {
      "id": "BM-168-B02",
      "text": "Die Merkmalbewertung der Konfiguration wird gelesen; scheitert das, endet die Ermittlung mit einer Ausnahme.",
      "anchors": [
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:38"
        },
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:47"
        }
      ]
    },
    {
      "id": "BM-168-B03",
      "text": "Die Spannung ist Pflichtmerkmal: fehlt ihre Bewertung, endet die Ermittlung mit der Ausnahme „Merkmal fehlt“; Gehäuse und ATEX-Kennzeichen sind optional.",
      "anchors": [
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:54"
        },
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:56"
        },
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:59"
        },
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 60,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:60"
        }
      ]
    },
    {
      "id": "BM-168-B04",
      "text": "Aus der Spannung ergibt sich die Grundvariante: 230 V → N1, 400 V → N3, 690 V → H3, jede andere Spannung → Sonderausführung SO.",
      "anchors": [
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:62"
        }
      ]
    },
    {
      "id": "BM-168-B05",
      "text": "Bei ATEX-Ausführung wird die zweite Stelle der Variante durch X ersetzt und ein Hinweis auf den zwingenden Prüfplan EX01 gesetzt.",
      "anchors": [
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:67"
        },
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:68"
        }
      ]
    },
    {
      "id": "BM-168-B06",
      "text": "Bei Edelstahlgehäuse wird an die Variante ein E angehängt, außer sie lautet genau SO; eine ATEX-Sonderausführung (SX) erhält das E also doch.",
      "anchors": [
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:71"
        },
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:72"
        }
      ]
    },
    {
      "id": "BM-168-B07",
      "text": "Zur Variante wird die Plangruppe aus der Zuordnungstabelle gelesen; fehlt sie, wird ein Hinweis auf manuelle Zuordnung gesetzt.",
      "anchors": [
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 75,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:75"
        },
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:77"
        },
        {
          "file": "zcl_vc_fertvar.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_vc_fertvar.abap:78"
        }
      ]
    }
  ],
