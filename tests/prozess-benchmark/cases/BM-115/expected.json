  "businessStatements": [
    {
      "id": "BM-115-B01",
      "text": "Die Garantieprüfung greift nur beim Anlegen von Stör- (M2) oder Servicemeldungen (S2) mit Equipment.",
      "anchors": [
        {
          "file": "zxqqmu20.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:20"
        }
      ]
    },
    {
      "id": "BM-115-B02",
      "text": "Hat der Massenupload das Überspringen angefordert, wird die Meldung ohne Garantieprüfung gesichert.",
      "anchors": [
        {
          "file": "zxqqmu20.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:25"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:26"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:27"
        }
      ]
    },
    {
      "id": "BM-115-B03",
      "text": "Für das Equipment wird die am Meldungsdatum gültige Garantie ermittelt; gibt es keine, wird ohne weitere Prüfung gesichert.",
      "anchors": [
        {
          "file": "zxqqmu20.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:30"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 39,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:39"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 40,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:40"
        }
      ]
    },
    {
      "id": "BM-115-B04",
      "text": "Eine Garantie wird zuerst am Equipment selbst gesucht.",
      "anchors": [
        {
          "file": "z_pm_warranty_check.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "z_pm_warranty_check.abap:30"
        },
        {
          "file": "z_pm_warranty_check.abap",
          "line": 35,
          "token": null,
          "expressionPath": null,
          "raw": "z_pm_warranty_check.abap:35"
        }
      ]
    },
    {
      "id": "BM-115-B05",
      "text": "Hat das Equipment keine gültige Garantie, wird sie über bis zu fünf Stufen vom jeweils übergeordneten Equipment geerbt; ohne übergeordnetes Equipment endet die Suche.",
      "anchors": [
        {
          "file": "z_pm_warranty_check.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "z_pm_warranty_check.abap:26"
        },
        {
          "file": "z_pm_warranty_check.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "z_pm_warranty_check.abap:41"
        },
        {
          "file": "z_pm_warranty_check.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "z_pm_warranty_check.abap:44"
        }
      ]
    },
    {
      "id": "BM-115-B06",
      "text": "Wird keine Garantie gefunden, meldet der Prüfbaustein „keine Garantie“.",
      "anchors": [
        {
          "file": "z_pm_warranty_check.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "z_pm_warranty_check.abap:49"
        },
        {
          "file": "z_pm_warranty_check.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "z_pm_warranty_check.abap:50"
        }
      ]
    },
    {
      "id": "BM-115-B07",
      "text": "Als Garantielieferant wird der Lieferant aus dem Stamm des gemeldeten Equipments übernommen.",
      "anchors": [
        {
          "file": "z_pm_warranty_check.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "z_pm_warranty_check.abap:54"
        }
      ]
    },
    {
      "id": "BM-115-B08",
      "text": "Bei Kundengarantie erhält der Erfasser im Dialog einen Hinweis mit Garantieende.",
      "anchors": [
        {
          "file": "zxqqmu20.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:43"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:46"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:47"
        }
      ]
    },
    {
      "id": "BM-115-B09",
      "text": "Bei Lieferantengarantie wird der Baustein für die Regressnummer des Buchungskreises aus der Variablenpflege gelesen und damit eine Regressnummer gezogen.",
      "anchors": [
        {
          "file": "zxqqmu20.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:53"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:57"
        }
      ]
    },
    {
      "id": "BM-115-B10",
      "text": "Der Regress wird mit Meldung, Garantie-Equipment, Lieferant, Garantie und Status NEU vorgemerkt; scheitert das, wird das Sichern der Meldung mit Fehler verhindert.",
      "anchors": [
        {
          "file": "zxqqmu20.abap",
          "line": 70,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:70"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 71,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:71"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:72"
        }
      ]
    },
    {
      "id": "BM-115-B11",
      "text": "Die Regressnummer wird für das Regressschreiben bereitgelegt und der Erfasser im Dialog informiert.",
      "anchors": [
        {
          "file": "zxqqmu20.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:76"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 77,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:77"
        },
        {
          "file": "zxqqmu20.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:78"
        }
      ]
    },
    {
      "id": "BM-115-B12",
      "text": "Andere Garantiearten werden nicht behandelt.",
      "anchors": [
        {
          "file": "zxqqmu20.abap",
          "line": 81,
          "token": null,
          "expressionPath": null,
          "raw": "zxqqmu20.abap:81"
        }
      ]
    }
  ],
