  "businessStatements": [
    {
      "id": "BM-232-B01",
      "text": "Ein Vergleichsobjekt wird mit der eingegebenen Prozentschwelle angelegt und ein Protokoll für gemeldete Abweichungen registriert.",
      "anchors": [
        {
          "file": "zhr_abrechnung_vergleich.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich.abap:15"
        },
        {
          "file": "zhr_abrechnung_vergleich.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich.abap:19"
        }
      ]
    },
    {
      "id": "BM-232-B02",
      "text": "Es werden die Personalnummern der gewählten Abrechnungskreise gelesen, deren organisatorische Zuordnung heute oder später endet.",
      "anchors": [
        {
          "file": "zhr_abrechnung_vergleich.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich.abap:21"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 9,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:9"
        }
      ]
    },
    {
      "id": "BM-232-B03",
      "text": "Für jeden Mitarbeiter wird das Abrechnungsverzeichnis gelesen; ohne Verzeichnis wird er übersprungen.",
      "anchors": [
        {
          "file": "zhr_abrechnung_vergleich.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich.abap:24"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:27"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:37"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:38"
        }
      ]
    },
    {
      "id": "BM-232-B04",
      "text": "Im Verzeichnis wird je Für-Periode das aktuelle Ergebnis gesucht, einmal für die Abrechnungsperiode und einmal für die Vergleichsperiode.",
      "anchors": [
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:41"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 42,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:42"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 66,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:66"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:68"
        }
      ]
    },
    {
      "id": "BM-232-B05",
      "text": "Fehlt eines der beiden Ergebnisse, wird der Mitarbeiter nicht verglichen.",
      "anchors": [
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:43"
        }
      ]
    },
    {
      "id": "BM-232-B06",
      "text": "Beide Abrechnungsergebnisse werden aus dem deutschen Abrechnungscluster gelesen; scheitert das Lesen eines davon, wird der Mitarbeiter nicht verglichen.",
      "anchors": [
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 45,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:45"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:47"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 79,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:79"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 46,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:46"
        },
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:48"
        }
      ]
    },
    {
      "id": "BM-232-B07",
      "text": "Für jede gewählte Lohnart der Ergebnistabelle der Abrechnungsperiode wird die prozentuale Veränderung gegenüber dem Betrag der Vorperiode berechnet; fehlt die Lohnart in der Vorperiode, gilt die Veränderung als 100 %.",
      "anchors": [
        {
          "file": "zhr_abrechnung_vergleich_f01.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_f01.abap:50"
        },
        {
          "file": "zhr_abrechnung_vergleich_cls.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_cls.abap:44"
        },
        {
          "file": "zhr_abrechnung_vergleich_cls.abap",
          "line": 47,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_cls.abap:47"
        }
      ]
    },
    {
      "id": "BM-232-B08",
      "text": "Liegt die Veränderung betragsmäßig über der Schwelle, wird eine Abweichung mit Personalnummer, Lohnart, altem und neuem Betrag gemeldet und im Protokoll gesammelt.",
      "anchors": [
        {
          "file": "zhr_abrechnung_vergleich_cls.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_cls.abap:49"
        },
        {
          "file": "zhr_abrechnung_vergleich_cls.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_cls.abap:50"
        },
        {
          "file": "zhr_abrechnung_vergleich_cls.abap",
          "line": 65,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_cls.abap:65"
        }
      ]
    },
    {
      "id": "BM-232-B09",
      "text": "Zum Schluss werden alle gesammelten Abweichungen als Liste ausgegeben.",
      "anchors": [
        {
          "file": "zhr_abrechnung_vergleich.abap",
          "line": 27,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich.abap:27"
        },
        {
          "file": "zhr_abrechnung_vergleich_cls.abap",
          "line": 72,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_cls.abap:72"
        },
        {
          "file": "zhr_abrechnung_vergleich_cls.abap",
          "line": 73,
          "token": null,
          "expressionPath": null,
          "raw": "zhr_abrechnung_vergleich_cls.abap:73"
        }
      ]
    }
  ],
