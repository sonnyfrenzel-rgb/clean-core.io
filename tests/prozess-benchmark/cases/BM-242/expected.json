  "businessStatements": [
    {
      "id": "BM-242-B01",
      "text": "Für den angefragten Kunden (mit führenden Nullen aufbereitet) und Kreditkontrollbereich werden Kreditlimit, Forderungen, Sonderobligo und Risikoklasse gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 12,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:12"
        }
      ]
    },
    {
      "id": "BM-242-B02",
      "text": "Existiert kein Kreditlimit, wird die Anfrage mit dem Geschäftsfehler „Kein Kreditlimit für Kunde … in …“ abgewiesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:17"
        },
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        }
      ]
    },
    {
      "id": "BM-242-B03",
      "text": "Bei einem Limit größer null wird die Ausschöpfung als Anteil von Forderungen plus Sonderobligo am Limit in Prozent berechnet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        },
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        }
      ]
    },
    {
      "id": "BM-242-B04",
      "text": "Bei einem Limit von null bleibt die Ausschöpfung leer; das Limit wird trotzdem zurückgegeben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 25,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:25"
        }
      ]
    }
  ],
