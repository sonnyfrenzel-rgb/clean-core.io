  "businessStatements": [
    {
      "id": "BM-102-B01",
      "text": "Zum Messpunkt wird, sofern er ein Zähler ist, der Zählerüberlaufwert gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 15,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:15"
        }
      ]
    },
    {
      "id": "BM-102-B02",
      "text": "Es wird der jüngste nicht stornierte Messbeleg bis zum Ablesedatum ermittelt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        }
      ]
    },
    {
      "id": "BM-102-B03",
      "text": "Der Zuwachs ergibt sich aus neuem Zählerstand minus letztem Zählerstand; ohne Vorbeleg zählt der volle neue Stand.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:28"
        }
      ]
    },
    {
      "id": "BM-102-B04",
      "text": "Ist der neue Zählerstand kleiner als der letzte und für den Zähler kein Überlauf gepflegt, wird die Erfassung mit der Ausnahme READING_TOO_LOW abgelehnt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        },
        {
          "file": "source.abap",
          "line": 30,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:30"
        }
      ]
    },
    {
      "id": "BM-102-B05",
      "text": "Ist ein Überlauf gepflegt, wird ein negativer Zuwachs als Zählerüberlauf gewertet und um den Überlaufwert erhöht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:32"
        }
      ]
    }
