  "businessStatements": [
    {
      "id": "BM-253-B01",
      "text": "Der Job öffnet die Rückmeldedatei des MES; ist sie nicht lesbar, wird das protokolliert, als ein Fehler gezählt und nichts verbucht.",
      "anchors": [
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 55,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:55"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:56"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:57"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:59"
        }
      ]
    },
    {
      "id": "BM-253-B02",
      "text": "Die Datei wird zeilenweise gelesen; die erste Zeile gilt als Kopfzeile und wird übergangen.",
      "anchors": [
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:63"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 67,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:67"
        }
      ]
    },
    {
      "id": "BM-253-B03",
      "text": "Zeilen ohne Auftragsnummer oder mit nicht numerischer Gutmenge werden als fehlerhaft gezählt und im Joblog protokolliert.",
      "anchors": [
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 76,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:76"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 78,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:78"
        }
      ]
    },
    {
      "id": "BM-253-B04",
      "text": "Gültige Zeilen werden zu Paketen von 50 Rückmeldungen gesammelt und jedes volle Paket sowie das Restpaket verbucht.",
      "anchors": [
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 85,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:85"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 86,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:86"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 93,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:93"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 94,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:94"
        }
      ]
    },
    {
      "id": "BM-253-B05",
      "text": "Je Paket werden Rückmeldungen zu Auftrag und Vorgang mit Gutmenge, Ausschuss (leer = 0), Mengeneinheit und Endrückmeldekennzeichen im Rückmelde-BO angelegt.",
      "anchors": [
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 100,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:100"
        }
      ]
    },
    {
      "id": "BM-253-B06",
      "text": "Lehnt das BO auch nur eine Rückmeldung ab, wird das ganze Paket verworfen, alle Sätze des Pakets zählen als fehlerhaft und die Meldungen des BOs gehen ins Joblog.",
      "anchors": [
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 116,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:116"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 118,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:118"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 121,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:121"
        }
      ]
    },
    {
      "id": "BM-253-B07",
      "text": "Im Testlauf wird ein fehlerfreies Paket nach der Prüfung verworfen, aber als rückgemeldet gezählt.",
      "anchors": [
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 126,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:126"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 127,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:127"
        }
      ]
    },
    {
      "id": "BM-253-B08",
      "text": "Im Echtlauf wird das Paket gesichert; scheitert das Sichern, zählen alle Sätze als fehlerhaft und die Meldungen gehen ins Joblog, sonst als rückgemeldet.",
      "anchors": [
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 132,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:132"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 136,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:136"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 139,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:139"
        }
      ]
    },
    {
      "id": "BM-253-B09",
      "text": "Nur wenn im Echtlauf kein einziger Fehler auftrat, wird die Datei in eine Archivdatei mit Datum und Uhrzeit kopiert und danach gelöscht.",
      "anchors": [
        {
          "file": "zpp_rm_import.abap",
          "line": 19,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_rm_import.abap:19"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 153,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:153"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 164,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:164"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 168,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:168"
        }
      ]
    },
    {
      "id": "BM-253-B10",
      "text": "Lässt sich die Archivdatei nicht anlegen, bleibt die Eingangsdatei liegen und ein Hinweis geht ins Joblog.",
      "anchors": [
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 154,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:154"
        },
        {
          "file": "zcl_pp_rm_import.abap",
          "line": 155,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_pp_rm_import.abap:155"
        }
      ]
    },
    {
      "id": "BM-253-B11",
      "text": "Am Ende gibt der Job die Zahl gelesener, rückgemeldeter und fehlerhafter Sätze aus.",
      "anchors": [
        {
          "file": "zpp_rm_import.abap",
          "line": 23,
          "token": null,
          "expressionPath": null,
          "raw": "zpp_rm_import.abap:23"
        }
      ]
    }
  ],
