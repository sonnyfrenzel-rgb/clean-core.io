  "businessStatements": [
    {
      "id": "BM-187-B01",
      "text": "Beim Ausgeben werden die betroffenen Leihgeräte-Vorgänge gelesen und einzeln geprüft.",
      "anchors": [
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 11,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:11"
        },
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:18"
        }
      ]
    },
    {
      "id": "BM-187-B02",
      "text": "Liegt die geplante Rückgabe vor dem Ausgabedatum, wird der Vorgang mit Meldung 001 abgelehnt und nicht weiter geprüft.",
      "anchors": [
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:21"
        },
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 22,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:22"
        }
      ]
    },
    {
      "id": "BM-187-B03",
      "text": "Zum Kunden werden die zentrale Auftrags- und Liefersperre gelesen.",
      "anchors": [
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 28,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:28"
        }
      ]
    },
    {
      "id": "BM-187-B04",
      "text": "Existiert der Kunde nicht oder ist er für Aufträge oder Lieferungen gesperrt, wird der Vorgang mit Meldung 002 abgelehnt.",
      "anchors": [
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:31"
        },
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 32,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:32"
        }
      ]
    },
    {
      "id": "BM-187-B05",
      "text": "Es wird gezählt, wie viele andere Leihgeräte der Kunde derzeit ausgeliehen hat.",
      "anchors": [
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:38"
        }
      ]
    },
    {
      "id": "BM-187-B06",
      "text": "Hat der Kunde bereits drei oder mehr Leihgeräte, wird der Vorgang mit Meldung 003 abgelehnt.",
      "anchors": [
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 43,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:43"
        },
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 44,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:44"
        }
      ]
    },
    {
      "id": "BM-187-B07",
      "text": "Ein abgelehnter Vorgang wird als fehlgeschlagen markiert und erhält eine Fehlermeldung am Vorgang.",
      "anchors": [
        {
          "file": "zcl_leih_v_ausgabe.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "zcl_leih_v_ausgabe.abap:54"
        },
        {
