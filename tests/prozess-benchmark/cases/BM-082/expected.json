      "id": "BM-082-B01",
      "text": "Vor dem Löschen wird geprüft, ob der Benutzer Überstundengrenzen des angegebenen Personalbereichs löschen darf; sonst endet der Baustein mit NO_AUTHORITY.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 14,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:14"
        },
