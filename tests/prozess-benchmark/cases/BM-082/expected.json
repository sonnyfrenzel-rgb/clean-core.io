        },
        {
          "file": "source.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:18"
        }
      ]
    },
    {
      "id": "BM-082-B02",
      "text": "Alle Überstundengrenzen des Personalbereichs mit Beginn ab dem Stichtag werden gelöscht.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        }
      ]
    },
    {
      "id": "BM-082-B03",
      "text": "Gab es keine solchen Einträge, endet der Baustein mit NOT_FOUND.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
