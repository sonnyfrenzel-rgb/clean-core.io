  "businessStatements": [
    {
      "id": "BM-134-B01",
      "text": "Die Zuordnung der Kürzungsgründe des Kunden zu Klärungsgründen wird einmal je Paket gelesen.",
      "anchors": [
        {
          "file": "z_idoc_input_zdispute.abap",
          "line": 31,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zdispute.abap:31"
        }
      ]
    },
    {
      "id": "BM-134-B02",
      "text": "Je IDoc werden Kopfsegment (Buchungskreis, Kunde, Avisnummer, Währung) und Kürzungssegmente (Rechnungsreferenz, Betrag, Kundengrund) übernommen.",
      "anchors": [
        {
          "file": "z_idoc_input_zdispute.abap",
          "line": 37,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zdispute.abap:37"
        },
        {
          "file": "z_idoc_input_zdispute.abap",
          "line": 38,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zdispute.abap:38"
        }
      ]
    },
    {
      "id": "BM-134-B03",
      "text": "Ist der Kunde des Avis unbekannt, gilt das Avis als fehlerhaft.",
      "anchors": [
        {
          "file": "lzdsp_f01.abap",
          "line": 16,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:16"
        },
        {
          "file": "lzdsp_f01.abap",
          "line": 18,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:18"
        },
        {
          "file": "lzdsp_f01.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:21"
        }
      ]
    },
    {
      "id": "BM-134-B04",
      "text": "Jeder Kürzungsbetrag wird aus dem Text umgewandelt; ist er ungültig, wird die Verarbeitung des Avis mit Fehler abgebrochen.",
      "anchors": [
        {
          "file": "lzdsp_f01.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:26"
        },
        {
          "file": "lzdsp_f01.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:29"
        }
      ]
    },
    {
      "id": "BM-134-B05",
      "text": "Kürzungen von null oder weniger werden übergangen.",
      "anchors": [
        {
          "file": "lzdsp_f01.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:34"
        }
      ]
    },
    {
      "id": "BM-134-B06",
      "text": "Zur Rechnungsreferenz werden die offenen Posten des Kunden im Buchungskreis gelesen; ist die Rechnung nicht offen, wird die Verarbeitung des Avis mit Fehler abgebrochen.",
      "anchors": [
        {
          "file": "lzdsp_f01.abap",
          "line": 36,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:36"
        },
        {
          "file": "lzdsp_f01.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:41"
        }
      ]
    },
    {
      "id": "BM-134-B07",
      "text": "Hat ein offener Posten schon einen Klärungsfall, wird der nächste Posten der Rechnung betrachtet.",
      "anchors": [
        {
          "file": "lzdsp_f01.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:48"
        },
        {
          "file": "lzdsp_f01.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:53"
        }
      ]
    },
    {
      "id": "BM-134-B08",
      "text": "Der Klärungsgrund wird aus dem Kundengrund abgeleitet; ist keiner zugeordnet, gilt Grund 99.",
      "anchors": [
        {
          "file": "lzdsp_f01.abap",
          "line": 56,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:56"
        }
      ]
    },
    {
      "id": "BM-134-B09",
      "text": "Für den ersten Posten ohne Klärungsfall wird ein Klärungsfall mit dem gekürzten Betrag, der Avis-Währung und dem Grund angelegt und die Zuordnung Posten–Fall mit Avisnummer gespeichert.",
      "anchors": [
        {
          "file": "lzdsp_f01.abap",
          "line": 57,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:57"
        },
        {
          "file": "lzdsp_f01.abap",
          "line": 83,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:83"
        },
        {
          "file": "lzdsp_f01.abap",
          "line": 62,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:62"
        }
      ]
    },
    {
      "id": "BM-134-B10",
      "text": "Scheitert die Anlage, wird die Fehlermeldung vermerkt und mit der nächsten Kürzung des Avis weitergemacht.",
      "anchors": [
        {
          "file": "lzdsp_f01.abap",
          "line": 96,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:96"
        },
        {
          "file": "lzdsp_f01.abap",
          "line": 98,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:98"
        },
        {
          "file": "lzdsp_f01.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:59"
        }
      ]
    },
    {
      "id": "BM-134-B11",
      "text": "Ist das Avis fehlerfrei, erhält das IDoc den Status 53; sonst werden alle noch nicht festgeschriebenen Änderungen zurückgerollt und das IDoc erhält den Status 51 mit dem Fehlertext.",
      "anchors": [
        {
          "file": "z_idoc_input_zdispute.abap",
          "line": 49,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zdispute.abap:49"
        },
        {
          "file": "z_idoc_input_zdispute.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zdispute.abap:53"
        },
        {
          "file": "z_idoc_input_zdispute.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zdispute.abap:50"
        },
        {
          "file": "z_idoc_input_zdispute.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zdispute.abap:54"
        },
        {
          "file": "lzdsp_f01.abap",
          "line": 110,
          "token": null,
          "expressionPath": null,
          "raw": "lzdsp_f01.abap:110"
        }
      ]
    },
    {
      "id": "BM-134-B12",
      "text": "Hat mindestens ein IDoc des Pakets Status 51, meldet der Baustein dem Workflow einen Fehler.",
      "anchors": [
        {
          "file": "z_idoc_input_zdispute.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "z_idoc_input_zdispute.abap:59"
        }
      ]
    }
  ],
