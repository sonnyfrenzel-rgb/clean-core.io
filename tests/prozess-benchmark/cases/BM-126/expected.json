  "businessStatements": [
    {
      "id": "BM-126-B01",
      "text": "Der Sperrgrund, mit dem offene Meilensteintermine gesperrt sind, wird aus der Variablentabelle gelesen; ist er nicht gepflegt, gilt Z1.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 26,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:26"
        },
        {
          "file": "source.abap",
          "line": 29,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:29"
        }
      ]
    },
    {
      "id": "BM-126-B02",
      "text": "Es werden die Meilensteine der selektierten PSP-Elemente gelesen, die bereits ein Ist-Datum haben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 34,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:34"
        }
      ]
    },
    {
      "id": "BM-126-B03",
      "text": "Zu diesen Meilensteinen werden die Termine der Fakturierungspläne gelesen, die noch mit dem Sperrgrund gesperrt sind.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 41,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:41"
        }
      ]
    },
    {
      "id": "BM-126-B04",
      "text": "Planpositionen, deren Meilenstein nicht unter den erreichten ist, werden übergangen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 48,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:48"
        },
        {
          "file": "source.abap",
          "line": 50,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:50"
        }
      ]
    },
    {
      "id": "BM-126-B05",
      "text": "Im Echtlauf wird die Fakturasperre des Planungstermins direkt entfernt, sodass er fakturiert werden kann.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 53,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:53"
        },
        {
          "file": "source.abap",
          "line": 54,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:54"
        }
      ]
    },
    {
      "id": "BM-126-B06",
      "text": "Jede betroffene Planposition wird mit Plannummer, Termin, Fakturadatum, Betrag und Währung gelistet.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 59,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:59"
        }
      ]
    },
    {
      "id": "BM-126-B07",
      "text": "Im Echtlauf werden die Freigaben am Ende gemeinsam festgeschrieben.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 63,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:63"
        },
        {
          "file": "source.abap",
          "line": 64,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:64"
        }
      ]
    },
    {
      "id": "BM-126-B08",
      "text": "Zum Schluss wird die Anzahl der Positionen gemeldet, im Testlauf als „würden freigegeben“.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 68,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:68"
        }
      ]
    }
  ],
