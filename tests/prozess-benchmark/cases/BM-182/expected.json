  "businessStatements": [
    {
      "id": "BM-182-B01",
      "text": "Zum Gerät wird das Ende der Kundengarantie (Garantieart 1) gelesen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 17,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:17"
        }
      ]
    },
    {
      "id": "BM-182-B02",
      "text": "Hat das Gerät keine Kundengarantie oder ist sie abgelaufen, wird der Antrag mit der Ausnahme GARANTIE_ABGELAUFEN abgelehnt.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 20,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:20"
        },
        {
          "file": "source.abap",
          "line": 21,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:21"
        }
      ]
    },
    {
      "id": "BM-182-B03",
      "text": "Die Antragsnummer wird aus dem Nummernkreis ZWTY_ANTR, Intervall 01, gezogen.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 24,
          "token": null,
          "expressionPath": null,
          "raw": "source.abap:24"
        }
      ]
    },
    {
      "id": "BM-182-B04",
      "text": "Anträge über 5.000 erhalten den Status P (zu prüfen), alle anderen den Status F.",
      "anchors": [
        {
          "file": "source.abap",
          "line": 31,
          "token": null,
