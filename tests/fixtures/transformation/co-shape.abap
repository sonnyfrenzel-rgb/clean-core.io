*&---------------------------------------------------------------------*
*& Hand-written fixture for tests/transformation-*.spec.ts, modelled on
*& the shape of a CO allocation simulation: obligatory selection, checks
*& at the selection screen, policy guards, packed quotas in a structure,
*& a semicolon CSV, demo data behind a checkbox. Not a customer program.
*&---------------------------------------------------------------------*
REPORT zfx_co_alloc.

CONSTANTS gc_sep TYPE c LENGTH 1 VALUE ';'.
CONSTANTS gc_x TYPE c LENGTH 1 VALUE 'X'.

TYPES: BEGIN OF ty_rcv,
         kostl TYPE kostl,
         quota TYPE p LENGTH 4 DECIMALS 2,
         amount TYPE p LENGTH 8 DECIMALS 2,
       END OF ty_rcv.
TYPES ty_rcv_tab TYPE STANDARD TABLE OF ty_rcv WITH EMPTY KEY.

DATA gt_rcv TYPE ty_rcv_tab.
DATA gv_total TYPE p LENGTH 8 DECIMALS 2.
DATA gv_csv TYPE string.

PARAMETERS p_kokrs TYPE kokrs OBLIGATORY DEFAULT 'A100'.
PARAMETERS p_gjahr TYPE gjahr OBLIGATORY.
PARAMETERS p_sender TYPE kostl OBLIGATORY.
PARAMETERS p_demo AS CHECKBOX DEFAULT 'X'.

AT SELECTION-SCREEN.
  IF p_gjahr < '1900' OR p_gjahr > '2199'.
    MESSAGE e001(zco).
  ENDIF.

START-OF-SELECTION.
  IF p_demo = gc_x.
    PERFORM load_demo_receivers.
  ELSE.
    PERFORM read_receivers.
  ENDIF.
  PERFORM validate_policy.
  PERFORM allocate.
  PERFORM export_csv.

FORM read_receivers.
  SELECT kostl, quota, amount FROM zco_receivers
    WHERE kokrs = @p_kokrs AND gjahr = @p_gjahr
    INTO CORRESPONDING FIELDS OF TABLE @gt_rcv.
  IF sy-subrc <> 0.
    MESSAGE e005(zco).
  ENDIF.
ENDFORM.

FORM validate_policy.
  DATA lv_sum TYPE p LENGTH 6 DECIMALS 2.
  IF gt_rcv IS INITIAL.
    MESSAGE e002(zco).
  ENDIF.
  LOOP AT gt_rcv INTO DATA(ls_rcv).
    IF ls_rcv-kostl = p_sender.
      MESSAGE e003(zco).
    ENDIF.
    IF ls_rcv-quota > 100.
      MESSAGE e004(zco).
    ENDIF.
    lv_sum = lv_sum + ls_rcv-quota.
  ENDLOOP.
  IF lv_sum > 100.
    MESSAGE e006(zco).
  ENDIF.
ENDFORM.

FORM allocate.
  DATA lv_share TYPE p LENGTH 8 DECIMALS 2.
  LOOP AT gt_rcv ASSIGNING FIELD-SYMBOL(<ls_rcv>).
    CHECK <ls_rcv>-quota > 0.
    lv_share = <ls_rcv>-amount * <ls_rcv>-quota / 100.
    PERFORM round_cents CHANGING lv_share.
    gv_total = gv_total + lv_share.
  ENDLOOP.
ENDFORM.

FORM round_cents CHANGING cv_value TYPE p.
  cv_value = round( val = cv_value dec = 2 ).
ENDFORM.

FORM export_csv.
  DATA lv_cell TYPE string.
  PERFORM csv_cell USING 'Cost center' CHANGING lv_cell.
  gv_csv = lv_cell && gc_sep.
  LOOP AT gt_rcv INTO DATA(ls_rcv).
    PERFORM csv_cell USING ls_rcv-kostl CHANGING lv_cell.
    gv_csv = gv_csv && lv_cell && gc_sep.
  ENDLOOP.
  PERFORM write_total.
ENDFORM.

FORM csv_cell USING iv_text TYPE clike CHANGING cv_cell TYPE string.
  cv_cell = iv_text.
  REPLACE ALL OCCURRENCES OF '"' IN cv_cell WITH '""'.
ENDFORM.

FORM write_total.
  DATA lv_cell TYPE string.
  PERFORM csv_cell USING 'Total' CHANGING lv_cell.
  WRITE: / lv_cell, gv_total.
  WRITE: / 'End of list'.
  WRITE: / 'Generated by the allocation simulation'.
  WRITE: / 'Values in the controlling area currency'.
  WRITE: / 'Rounded to two places'.
  WRITE: / 'Quota above 100 is refused'.
  WRITE: / 'Sender is never a receiver'.
ENDFORM.

FORM load_demo_receivers.
  CLEAR gt_rcv.
  PERFORM add_demo_line USING 'C100' '40.00' '1000.00'.
  PERFORM add_demo_line USING 'C200' '60.00' '1000.00'.
  PERFORM set_demo_year.
ENDFORM.

FORM add_demo_line USING iv_kostl TYPE clike iv_quota TYPE clike iv_amount TYPE clike.
  APPEND VALUE #( kostl = iv_kostl quota = iv_quota amount = iv_amount ) TO gt_rcv.
ENDFORM.

FORM set_demo_year.
  DATA lv_year TYPE gjahr.
  lv_year = '2026'.
  IF lv_year <> p_gjahr.
    MESSAGE e007(zco).
  ENDIF.
  CLEAR lv_year.
  lv_year = p_gjahr.
  CLEAR lv_year.
  lv_year = p_gjahr.
  CLEAR lv_year.
  lv_year = p_gjahr.
ENDFORM.

FORM obsolete_report.
  WRITE: / 'not used any more'.
ENDFORM.
