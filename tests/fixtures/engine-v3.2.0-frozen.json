 "probes": {
  "gui-download-and-authority": "REPORT zco_list.\nDATA lt_out TYPE STANDARD TABLE OF string.\nDATA lv_bukrs TYPE bukrs.\nAUTHORITY-CHECK OBJECT 'F_BKPF_BUK' ID 'BUKRS' FIELD lv_bukrs ID 'ACTVT' FIELD '03'.\nSELECT * FROM coep INTO TABLE @DATA(lt_coep) WHERE kokrs = '1000'.\nCALL FUNCTION 'GUI_DOWNLOAD'\n  EXPORTING filename = 'C:\\temp\\co.txt'\n  TABLES data_tab = lt_out.\n",
  "ws-download-and-upload": "REPORT zws.\nDATA lt_out TYPE STANDARD TABLE OF string.\nCALL FUNCTION 'WS_DOWNLOAD' EXPORTING filename = 'C:\\temp\\a.txt' TABLES data_tab = lt_out.\nCALL FUNCTION 'WS_UPLOAD' EXPORTING filename = 'C:\\temp\\b.txt' TABLES data_tab = lt_out.\nCALL FUNCTION 'GUI_UPLOAD' EXPORTING filename = 'C:\\temp\\c.txt' TABLES data_tab = lt_out.\n",
  "frontend-services-class": "REPORT zfs.\nDATA lt_files TYPE filetable.\nDATA lv_rc TYPE i.\ncl_gui_frontend_services=>file_open_dialog( CHANGING file_table = lt_files rc = lv_rc ).\n",
  "aufk-beside-afko-and-resb": "REPORT zpp_sim.\nDATA: lt_aufk TYPE STANDARD TABLE OF aufk,\n      lt_afko TYPE STANDARD TABLE OF afko,\n      lt_resb TYPE STANDARD TABLE OF resb.\nSELECT * FROM aufk INTO TABLE lt_aufk WHERE autyp = 10.\nSELECT * FROM afko INTO TABLE lt_afko FOR ALL ENTRIES IN lt_aufk WHERE aufnr = lt_aufk-aufnr.\nSELECT * FROM resb INTO TABLE lt_resb FOR ALL ENTRIES IN lt_aufk WHERE aufnr = lt_aufk-aufnr.\n",
  "local-and-remote-rfc": "REPORT zrfc.\nDATA lv_dest TYPE rfcdest.\nCALL FUNCTION 'Z_WORK' DESTINATION 'NONE' STARTING NEW TASK 'TASK' EXPORTING iv = 1.\nCALL FUNCTION 'Z_REMOTE' DESTINATION lv_dest EXPORTING iv = 1.\nCALL FUNCTION 'RFC_CONNECTION_CLOSE' EXPORTING destination = lv_dest.\n",
  "rfc-none-variants": "REPORT zrfc.\nCALL FUNCTION 'Z_A' DESTINATION 'NONE'.\nCALL FUNCTION 'Z_B' DESTINATION 'NONE_PROD'.\nCALL FUNCTION 'Z_C' DESTINATION `NONE`.\nCALL FUNCTION 'Z_D' DESTINATION 'NONE''X'.\nCALL FUNCTION 'Z_E' STARTING NEW TASK 't1' DESTINATION `NONE`.\n",
  "remote-rfc-and-standard-write": "REPORT zsd_upd.\nDATA ls_vbak TYPE vbak.\nUPDATE vbak SET netwr = 0 WHERE vbeln = '1'.\nCALL FUNCTION 'Z_REMOTE' DESTINATION 'PRD_100'.\n",
  "file-validation-result-ignored": "REPORT zfile.\nPARAMETERS p_path TYPE string.\nCALL FUNCTION 'FILE_VALIDATE_NAME' EXPORTING logical_filename = 'Z_IN' CHANGING physical_filename = p_path EXCEPTIONS OTHERS = 1.\nOPEN DATASET p_path FOR INPUT IN TEXT MODE ENCODING DEFAULT.\n"
 },
