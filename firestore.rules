rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin check uses ONLY the custom claim token. The Firestore doc
    // fallback was removed because (a) admin status is set via the
    // set-admin-claim API which writes the custom claim, and (b) the
    // Firestore get() caused evaluation errors in the emulator when the
    // user document didn't exist yet (e.g., during first-time create).
    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }

    // NOTE: getUserData() and getUserOrgId() were removed because they used
    // get() calls that caused evaluation errors in the Firebase Emulator.
    // Quota enforcement is handled server-side by reserveTransformationQuota().
    // OrgId isolation is handled server-side in API routes.

    // Roadmap 5.4 — Einsicht by invitation.
    //
    // `readers` is the list of uids whose invitation to a project was accepted
    // and not revoked. It sits on the project document itself, so this check
    // reads no second document: `resource.data` is the document the request is
    // already fetching. The alternative — get()ing into
    // projects/{id}/invitations — would cost one document read per rule
    // evaluation and is exactly the construct this file removed twice before
    // (getUserData above, the admin fallback below) after it produced
    // evaluation errors in the emulator.
    //
    // Three defaults do the safety work, and each has a test:
    //   · a project with no `readers` field at all falls back to the empty
    //     list, so absence grants nothing — a rule that gets generous when a
    //     field is missing is the classic way to open a door by accident;
    //   · `readers: []` grants nothing;
    //   · anything that is not a list grants nothing, rather than erroring its
    //     way into an undefined outcome.
    //
    // `readers` is deliberately absent from both client allowlists on
    // /projects/{projectId} — the one on create and the one on update — so no
    // browser can put itself, or anyone else, on that list by any write path,
    // including as one key inside a larger write that would otherwise be
    // allowed. Only the Admin SDK writes it, on accepting and on revoking an
    // invitation.
    //
    // (Neither allowlist is quoted here on purpose: `lib/firestore-rules-contract.ts`
    // finds the update allowlist by searching this file for the first
    // occurrence of that call, and a comment that spelled it out would be the
    // one it found.)
    function invitedReader(data) {
      return isAuthenticated() &&
             data.get('readers', []) is list &&
             request.auth.uid in data.get('readers', []);
    }

    function userClientCreateKeys() {
      return [
        'firstName', 'lastName', 'email',
        'tier', 'status',
        'transformationsUsed', 'transformationsLimit',
        'maxTeamMembers', 'orgId',
        'identityProvider', 'createdAt', 'authMethod', 'isAdmin',
        's4TenantAccessAllowed', 's4TenantAccessRequested', 'mfaEnabled'
        // V14: 'termsVersionAccepted' and 'termsAcceptedAt' were here. A browser
        // could therefore assert its own Terms acceptance, timestamp included,
        // with no consent_events row behind it — a claim, not a record. Consent
        // is now written exclusively by the Admin SDK (lib/consent.ts, reached
        // through POST /api/account/register or POST /api/consent), so a create
        // carrying either field is rejected outright.
      ];
    }

    function userClientUpdateKeys() {
      return [
        'firstName', 'lastName', 'theme', 'landingPageDefault',
        'backupEnabled', 'desktopChatbotEnabled', 'updatedAt'
      ];
    }

    // NOTE: projectAllowedKeys() and isValidProject() were removed.
    // Field validation is handled server-side in API routes.

    // Validate User entity
    function isValidUser(data) {
      return data.firstName is string && data.firstName.size() > 0 && data.firstName.size() < 100 &&
             data.lastName is string && data.lastName.size() > 0 && data.lastName.size() < 100 &&
             data.email is string && data.email.size() < 255 &&
             data.tier in ['basic', 'starter', 'premium', 'unlimited', 'enterprise', 'pilot', 'pilot_byok'] &&
             data.transformationsUsed is number &&
             data.transformationsLimit is number &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (userId == request.auth.uid || isAdmin()) &&
                    (
                      isAdmin() || 
                      (
                        request.resource.data.keys().hasOnly(userClientCreateKeys()) &&
                        request.resource.data.get('orgId', null) == null &&
                        request.resource.data.get('email', '') == request.auth.token.email &&
                        request.resource.data.get('tier', 'pilot') == 'pilot' &&
                        request.resource.data.get('status', 'pending') == 'pending' &&
                        request.resource.data.get('isAdmin', false) == false &&
                        request.resource.data.get('transformationsUsed', 0) == 0 &&
                        request.resource.data.get('transformationsLimit', 5) == 5 &&
                        request.resource.data.get('maxTeamMembers', 1) == 1 &&
                        request.resource.data.get('s4TenantAccessAllowed', false) == false &&
                        request.resource.data.get('s4TenantAccessRequested', false) == false &&
                        request.resource.data.get('mfaEnabled', false) == false
                      )
                    );
      allow update: if isAuthenticated() && (
                      isAdmin() ||
                      (
                        userId == request.auth.uid &&
                        request.resource.data.diff(resource.data).changedKeys().hasOnly(userClientUpdateKeys()) &&
                        request.resource.data.diff(resource.data).addedKeys().hasOnly(userClientUpdateKeys()) &&
                        request.resource.data.diff(resource.data).removedKeys().hasOnly([])
                      )
                    );
      allow delete: if isAdmin();
    }

    match /user_secrets/{userId}/{allPaths=**} {
      allow read, write: if false; // Block all client-side read/write access.
    }

    // Validate Project entity
    function isValidProject(data, isUpdate) {
      return (isUpdate || (data.name is string && data.name.size() > 0 && data.name.size() < 255)) &&
             (isUpdate || (data.status in ['uploaded', 'analyzed', 'designed', 'transformed', 'testing', 'documented', 'completed'])) &&
             (isUpdate || (data.userId is string && data.userId == request.auth.uid)) &&
             (isUpdate || (data.createdAt is timestamp)) &&
             (!('legacyCode' in data) || (data.legacyCode is string && data.legacyCode.size() < 1000000)) &&
             (!('analysis' in data) || (data.analysis is string && data.analysis.size() < 1000000)) &&
             (!('solutionDesign' in data) || (data.solutionDesign is string && data.solutionDesign.size() < 1000000)) &&
             (!('generatedCode' in data) || (data.generatedCode is string && data.generatedCode.size() < 1000000)) &&
             (!('documentation' in data) || (data.documentation is string && data.documentation.size() < 1000000)) &&
             (!('presentation' in data) || (data.presentation is string && data.presentation.size() < 1000000)) &&
             (!('testCases' in data) || (data.testCases is list && data.testCases.size() < 100)) &&
             (!('testSuite' in data) || (data.testSuite is map)) &&
             (!('exports' in data) || (data.exports is map)) &&
             (!('usageReport' in data) || (data.usageReport is map)) &&
             // Roadmap 7.1, same reasoning as usageReport directly above: an
             // imported ATC worklist is server-written only (POST
             // /api/projects/{projectId}/commands, `record-atc-report`).
             //
             // What actually keeps a browser out is in the rules, not in
             // TypeScript: `allow create` above lists the six keys a client may
             // create with, and `allow update` lists the client-writable fields.
             // `atcReport` is in neither, so this line only fixes the *type* of a
             // field the Admin SDK writes — it is not the thing that makes it
             // server-only. Saying that imprecisely once already produced a false
             // "client can write atcReport" finding in the QA review of
             // a81b30dc12a9, so the enforcing rule is named here.
             (!('atcReport' in data) || (data.atcReport is map)) &&
             (!('nonFunctionalRequirements' in data) || (data.nonFunctionalRequirements is map));
    }

    match /projects/{projectId} {
      // Nobody but the owner reads a project. The administrator used to be able
      // to, and Sonny took that away on 16.09.2026: a customer's ABAP is the
      // most private thing in this product, and "the operator can look" is a
      // sentence the trust card would otherwise have to carry.
      //
      // There is no client path left for an emergency either. An emergency —
      // a report of malicious code in an upload — is handled server-side
      // through the Admin SDK, which bypasses these rules by design; that is a
      // deliberate act with a record, not a console anyone can open.
      //
      // Roadmap 5.4 adds exactly one more reader, and not a kind of account:
      // the individual uid of a person the owner invited and who accepted. The
      // administrator is still not among them — the roadmap line for 5.4 was
      // written on 15.09.2026, one day before Sonny took the operator's read
      // away, and the later decision wins. An operator who wants to read a
      // project has the same route as anyone else: be invited.
      allow read: if isAuthenticated() && resource != null &&
                  (resource.data.userId == request.auth.uid || invitedReader(resource.data));
      // Quota enforcement and field validation are server-side
      allow create: if isAuthenticated() && 
                    request.resource.data.keys().hasAll(['name', 'status', 'userId', 'createdAt']) &&
                    request.resource.data.keys().hasOnly(['name', 'status', 'userId', 'createdAt', 'legacyCode', 'fromExample']) &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status in ['uploaded', 'created'] &&
                    request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 255;
      // F-01: Owner may update their project, but userId and createdAt are immutable.
      // Field-level size validation is enforced by isValidProject().
      // The administrator cannot write a project either: reading was the
      // permission in question, and an operator editing someone's evidence is
      // the worse half of the same thing.
      allow update: if isAuthenticated() && (
                    (
                      resource.data.userId == request.auth.uid &&
                      // Strict allowlist of client-writable draft & interactive fields (Finding P1)
                      //
                      // Roadmap 0.7: six fields left this list and are written
                      // exclusively by POST /api/projects/{projectId}/commands
                      // (Admin SDK, after a verified token, the second factor
                      // and a validated transition); roadmap 7.1 adds a seventh
                      // the same way, before it was ever on this list at all:
                      //
                      //   targetArchitecture · approvedByArchitect ·
                      //   architectJustifiedOverride · architectSignOffAt ·
                      //   approvedBy   — the five release fields. The browser
                      //   used to decide whose address went into `approvedBy`;
                      //   it now comes off the ID token.
                      //
                      //   usageReport  — validated as `is map` and nothing
                      //   else, so any structure of any size could be put on a
                      //   project document (security audit of v2.11.0). The
                      //   route holds it to the model's key set and a ceiling.
                      //
                      //   atcReport    — the imported ATC worklist (roadmap
                      //   7.1). Held to the same discipline from the start:
                      //   never client-writable, held to the model's key set
                      //   and a ceiling by the same route.
                      //
                      // The list here and `SERVER_ONLY_PROJECT_FIELDS` in
                      // lib/project-commands.ts are held apart by
                      // tests/project-command-boundary.spec.ts.
                      //
                      // `readers` (roadmap 5.4) is not on this list and must
                      // never be: it is what the read rule above believes, so a
                      // browser that could write it could grant itself, or
                      // anyone, the right to read the project. hasOnly() covers
                      // the case that is easy to forget — `readers` smuggled in
                      // as one key of a write whose other keys are allowed.
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status', 'legacyCode', 's4Deployment', 'extensibilityRoute', 'solutionDesign',
                        'generatedCode', 'documentation', 'businessDocumentation', 'presentation',
                        'testCases', 'testSuite', 'coverageEstimate', 'manualTestingRequirements',
                        'worklist', 'exports', 'updatedAt', 's4Environment',
                        'nonFunctionalRequirements'
                      ])
                    )) && isValidProject(request.resource.data, true);
      // F-03: project deletion is server-only via the Admin SDK (recursiveDelete
      // through DELETE /api/projects/{projectId}). A client deleteDoc() would orphan
      // the immutable runs/{runId} subcollection, so client delete is disabled here.
      allow delete: if false;
    }

    match /projects/{projectId}/runs/{runId} {
      // A run carries the source it was computed from, so it follows the
      // project: owner only.
      //
      // Roadmap 5.4 deliberately does NOT widen this one. A run document would
      // have to carry its own copy of `readers` for a rule here to answer
      // without a get(), and then a revocation would have to succeed in N
      // documents instead of one: a revocation that must land everywhere is
      // weaker than a revocation that lands in a single place. An invited
      // reader gets the run's contents through GET /api/projects/{projectId},
      // which re-reads `readers` off the project document on every request —
      // same single source of truth, and it stops answering the moment the
      // owner revokes.
      allow read: if isAuthenticated() && resource != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Roadmap 5.2/5.4/5.5 — the invitations of a project. Server-only, in both
    // directions, and the read half is the point: an invitation carries the
    // e-mail address of the person it was sent to, so a project's invitation
    // list is a list of other people's addresses. Somebody with Einsicht into
    // the project has no business reading it; the owner sees it through
    // GET /api/projects/{projectId}/readers, which returns the accepted ones
    // and nothing else. Written only by the Admin SDK.
    //
    // Default-deny would already cover this — no match block means no access —
    // but the deny is written down so that a later rule for a sibling
    // subcollection cannot widen it by accident, and so that the intent is
    // visible to anyone auditing the file.
    match /projects/{projectId}/invitations/{invitationId} {
      allow read, write: if false;
    }

    // Validate SupportTicket
    function isValidSupportTicket(data) {
      return data.userId == request.auth.uid &&
             data.subject is string && data.subject.size() > 0 &&
             data.message is string && data.message.size() > 0 &&
             data.status in ['open', 'in_progress', 'closed'] &&
             data.createdAt is timestamp;
    }

    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() &&
                    isValidSupportTicket(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Validate FileEntry entity
    function isValidFileEntry(data, isUpdate) {
      return (isUpdate || (data.name is string && data.name.size() > 0 && data.name.size() < 255)) &&
             (isUpdate || (data.content is string && data.content.size() < 1000000)) &&
             (isUpdate || (data.userId is string && data.userId == request.auth.uid)) &&
             (isUpdate || (data.createdAt is timestamp));
    }

    match /files/{fileId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() && 
                    request.resource.data.keys().hasAll(['name', 'content', 'userId', 'createdAt']) &&
                    isValidFileEntry(request.resource.data, false);
      allow update: if isAuthenticated() &&
                    (('userId' in resource.data && resource.data.userId == request.auth.uid) || isAdmin()) &&
                    isValidFileEntry(request.resource.data, true) &&
                    (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) &&
                    (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAuthenticated() && (('userId' in resource.data && resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Validate ABAPExample entity
    function isValidABAPExample(data, isUpdate) {
      return (isUpdate || (data.name is string && data.name.size() > 0 && data.name.size() < 255)) &&
             (isUpdate || (data.code is string && data.code.size() < 1000000)) &&
             (isUpdate || (data.userId is string && data.userId == request.auth.uid)) &&
             (isUpdate || (data.createdAt is timestamp));
    }

    match /abap_examples/{exampleId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() && 
                    request.resource.data.keys().hasAll(['name', 'code', 'userId', 'createdAt']) &&
                    isValidABAPExample(request.resource.data, false);
      allow update: if isAuthenticated() &&
                    (('userId' in resource.data && resource.data.userId == request.auth.uid) || isAdmin()) &&
                    isValidABAPExample(request.resource.data, true) &&
                    (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) &&
                    (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      // The dashboard offers the owner a delete of their own example and calls
      // deleteDoc for it, and there was no delete rule — so the call hit
      // default-deny and the row stayed, with the owner unable to remove what
      // they uploaded (security audit of b88c77b, SEC-b88c77b-61, verified at
      // the line on 21.09.2026). Owner or admin, the same condition the update
      // rule uses and the same one /files carries.
      allow delete: if isAuthenticated() &&
                    (('userId' in resource.data && resource.data.userId == request.auth.uid) || isAdmin());
    }

    match /registration_requests/{requestId} {
      allow read: if isAuthenticated() && (requestId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && requestId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /tenant_access_requests/{requestId} {
      allow read: if isAuthenticated() && (requestId == request.auth.uid || isAdmin());
      allow create: if (isAuthenticated() && requestId == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // F-03: S/4HANA-Credentials: ausschließlich serverseitig (Admin SDK). Clients nie.
    match /s4_credentials/{uid} {
      allow read, write: if false;
    }

    // MFA Option B: MFA Secrets ausschließlich serverseitig (Admin SDK). Clients nie.
    match /mfa_secrets/{uid} {
      allow read, write: if false;
    }

    // F-08: MFA pending tokens: server-only via Admin SDK. Explicit deny for audit clarity.
    match /mfa_pending/{uid} {
      allow read, write: if false;
    }

    // Audit events: server-only via Admin SDK. No client access.
    match /audit_events/{eventId} {
      allow read, write: if false;
    }

    // Bulk-mail opt-outs — written only by POST /api/unsubscribe via the Admin SDK,
    // read only by the sender script. A client that could read this would have a
    // list of addresses; one that could write it could suppress anyone's mail.
    match /email_suppressions/{suppressionId} {
      allow read, write: if false;
    }

    // Per-campaign send log, written by scripts/send-community-mail.ts via the
    // Admin SDK. It exists so an interrupted send resumes without mailing anyone
    // twice; clients have no business reading a list of who was contacted.
    match /email_sends/{sendId} {
      allow read, write: if false;
    }

    // Weekly admin usage snapshots, written by scripts/send-usage-report.ts via the
    // Admin SDK. They contain every account's name and email, so no client reads them.
    match /usage_reports/{reportId} {
      allow read, write: if false;
    }

    // Delivery events for every mail the platform sends, written only by
    // POST /api/webhooks/resend via the Admin SDK. They carry recipient
    // addresses, so no client reads them — the admin console reads through a
    // server route like every other privileged view.
    match /email_events/{messageId} {
      allow read, write: if false;
    }

    // F-16: append-only Terms/Privacy consent events — server-only via Admin SDK
    // (POST /api/consent). The client cannot forge or read consent records.
    match /consent_events/{eventId} {
      allow read, write: if false;
    }

    // User secrets (e.g. BYOK keys): server-only via Admin SDK. No client access.
    match /user_secrets/{uid}/{document=**} {
      allow read, write: if false;
    }

    match /rate_limits/{key} {
      allow read, write: if false;
    }
  }
}
