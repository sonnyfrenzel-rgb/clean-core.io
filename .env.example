# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY=

# RESEND_API_KEY: Required for transactional email sending (approval/revoke notifications).
RESEND_API_KEY=

# NEXT_PUBLIC_APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
NEXT_PUBLIC_APP_URL=

# S4_ENCRYPTION_KEY: 32-byte base64 key for AES-256-GCM encryption of S/4HANA credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
S4_ENCRYPTION_KEY=

# MFA_BACKUP_CODE_PEPPER: Server-side pepper for MFA backup-code hashing.
# Minimum 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_BACKUP_CODE_PEPPER=

# PILOT_APPROVAL_SECRET: HMAC secret for action-bound approval links.
# Minimum 16 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PILOT_APPROVAL_SECRET=

# AUDIT_SIGNING_KEY: HMAC secret that signs immutable runs and server-generated
# audit packs (the root of the trust chain). Also asserted by /api/health and the
# deploy pipeline. Minimum 32 characters — a weak key weakens every signature.
#
# REQUIRED in every environment, including local development. There used to be a
# committed fallback constant for when this was unset; because it was committed,
# anyone could forge an audit pack that /api/export/verify would call genuine on
# any instance running without a key. There is no fallback now — the three
# signing routes return 500 instead. Set it once and forget it.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUDIT_SIGNING_KEY=

# AUDIT_SIGNING_PRIVATE_KEY: Ed25519 private key (base64 of the PKCS#8 PEM) that
# signs audit packs *in addition to* the HMAC above.
#
# OPTIONAL. Without it everything behaves as before: packs carry the HMAC
# signature only and /.well-known/clean-core-io-signing.json answers 503.
#
# Why it exists: HMAC is symmetric, so the only party who can verify a pack is
# the one holding the key that could also forge it — which made "anyone can
# verify" true of nobody. With this key set, packs carry a second signature that
# anyone can check against the published public key, offline, with no secret:
#   node scripts/verify-pack.mjs pack.zip
#
# Generate one:
#   node -e "const c=require('crypto');const{privateKey}=c.generateKeyPairSync('ed25519');console.log(Buffer.from(privateKey.export({format:'pem',type:'pkcs8'})).toString('base64'))"
#
# Treat it as a signing key: leaking it lets anyone issue packs that verify as
# genuine. Losing it only stops new packs being signed asymmetrically — set a new
# one and the key id in every later pack changes with it.
AUDIT_SIGNING_PRIVATE_KEY=

# NEXT_PUBLIC_FIRESTORE_DB_ID: ID of the named Firestore database for this
# environment. Leave empty to use the project's "(default)" database. In Cloud Run
# each environment (dev/release/main) points at its own named database.
NEXT_PUBLIC_FIRESTORE_DB_ID=

# FIREBASE_SERVICE_ACCOUNT_KEY (optional, local dev only): JSON service-account
# key for the Firebase Admin SDK when Application Default Credentials aren't
# available locally. In Cloud Run, prefer ADC / Workload Identity — do NOT set this.
FIREBASE_SERVICE_ACCOUNT_KEY=

# S4_HOST_ALLOWLIST: Comma-separated host suffixes allowed for S/4HANA SSRF validation.
# Leave empty to allow all public hosts (blocklist-only mode).
# Example: .s4hana.cloud,.hana.ondemand.com,.sapcloud.cn,sandbox.api.sap.com
S4_HOST_ALLOWLIST=

# S4_TEST_RUNNER_EGRESS_ENFORCED: Set to true only when the test-runner runtime
# has deny-by-default network egress with an explicit SAP/token-endpoint allowlist.
#
# This variable states an intent. It does not grant anything on its own: before a
# live run is allowed, the runtime probes the cloud metadata endpoint and a public
# address, and refuses if either answers. Setting this on a container that still
# has egress leaves live execution disabled and says so in the response.
#
# It used to be the entire gate, and it also deleted the sandbox's network guard
# as a side effect — so setting it in the belief that it merely enabled live mode
# put tenant credentials in a process that could read the metadata endpoint. The
# guard is now always loaded; on an attested live run it narrows to
# S4_HOST_ALLOWLIST instead of being removed.
S4_TEST_RUNNER_EGRESS_ENFORCED=false

# Signing secret for POST /api/webhooks/resend, from the Resend dashboard
# (Webhooks -> your endpoint -> Signing Secret). Starts with `whsec_`.
# Without it the route answers 503 rather than accepting unsigned events: an
# endpoint that writes to Firestore on anyone's say-so is worse than none.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
